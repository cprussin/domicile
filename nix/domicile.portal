# The portal interfaces Domicile implements itself.
#
# `xdg-desktop-portal` reads this from `share/xdg-desktop-portal/portals/` and
# matches `UseIn` against its own `XDG_CURRENT_DESKTOP`, not the client's. The
# compositor exports that variable to the D-Bus and systemd activation
# environments (`portals::say_which_desktop`). A portal already running
# under another desktop's name keeps that name.
#
# Domicile implements `Settings`, `Access`, `AppChooser`, `FileChooser`,
# `Notification`, `Inhibit`, `RemoteDesktop`, `Clipboard`, `InputCapture`,
# `Account`, `Email`, `Lockdown`, `GlobalShortcuts`, `Background`,
# `Wallpaper`, `DynamicLauncher`, `Usb`, `ScreenCast`, `Print` and
# `Screenshot`: every interface but `Secret`, which goes to the keyring.
# Listing an interface Domicile does not implement would take it from the
# backend that does.
#
# `Settings` carries `org.freedesktop.appearance`'s `color-scheme`, which GTK4,
# Qt6, Electron and Firefox read to follow the theme, and its accent color,
# contrast and reduced motion. `Access` and `Account` are questions the shell
# draws. `AppChooser` is the app list the shell draws for `OpenURI` and "Open
# with", and `FileChooser` its file picker. `Notification` feeds the shell's
# notification drawer. `Inhibit` holds off blanking and lists logout and
# suspend inhibitors for the shell. `RemoteDesktop`, its `Clipboard` and
# `InputCapture` take input over EIS after a grant the shell draws. `Email`
# opens the `mailto:` handler. `Lockdown` reports the config's `lockdown`
# section. `GlobalShortcuts` binds chords the shell reviews and grabs.
# `Background` reports windows and writes autostart entries; `Wallpaper` hands
# the shell a picture. `DynamicLauncher` and `Usb` are an install confirm
# and a device grant the shell draws. `ScreenCast` casts windows, monitors and
# regions to PipeWire, picked in a dialog the shell draws. `Print` sends jobs
# to CUPS after a print dialog the shell draws. `Screenshot` saves the desk, or
# a picked area or color of it. See
# `packages/domicile-compositor/src/portals/` and
# `docs/architecture/PORTALS.md`.
[portal]
DBusName=org.freedesktop.impl.portal.desktop.domicile
Interfaces=org.freedesktop.impl.portal.Settings;org.freedesktop.impl.portal.Access;org.freedesktop.impl.portal.AppChooser;org.freedesktop.impl.portal.FileChooser;org.freedesktop.impl.portal.Notification;org.freedesktop.impl.portal.Inhibit;org.freedesktop.impl.portal.RemoteDesktop;org.freedesktop.impl.portal.Clipboard;org.freedesktop.impl.portal.InputCapture;org.freedesktop.impl.portal.Account;org.freedesktop.impl.portal.Email;org.freedesktop.impl.portal.Lockdown;org.freedesktop.impl.portal.GlobalShortcuts;org.freedesktop.impl.portal.Background;org.freedesktop.impl.portal.Wallpaper;org.freedesktop.impl.portal.DynamicLauncher;org.freedesktop.impl.portal.Usb;org.freedesktop.impl.portal.ScreenCast;org.freedesktop.impl.portal.Print;org.freedesktop.impl.portal.Screenshot;
UseIn=domicile
