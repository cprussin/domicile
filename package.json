{
  "catalog": {
    "@biomejs/biome": "^2.5.7",
    "@cprussin/tsconfig": "^5.0.0",
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/bun": "^1.3.14",
    "electron": "^43.3.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=24"
  },
  "name": "domicile",
  "packageManager": "bun@1.3.11",
  "private": true,
  "scripts": {
    "build:install-modules": "[ $CI$CLAUDE_CODE_REMOTE ] && true || bun install",
    "fix:lint": "biome check --max-diagnostics=none --write",
    "test:dependencies": "bun outdated -r",
    "test:lint": "biome check --max-diagnostics=none",
    "turbo": "[ ! -d node_modules ] && bun install --frozen-lockfile; node_modules/.bin/turbo"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
