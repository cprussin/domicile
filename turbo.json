{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "BIOME_BINARY",
    "DOMICILE_CHROME_SOCKET",
    "ELECTRON_OVERRIDE_DIST_PATH",
    "ELECTRON_SKIP_BINARY_DOWNLOAD",
    "FORCE_COLOR",
    "WAYLAND_DISPLAY",
    "XDG_RUNTIME_DIR",
    "XDG_SESSION_TYPE"
  ],
  "tasks": {
    "//#build": {
      "dependsOn": ["//#build:install-modules"]
    },
    "//#build:install-modules": {
      "inputs": ["**/package.json", "bunfig.toml", "!**/dist/**"],
      "outputs": ["bun.lock"]
    },

    "//#fix": {
      "with": ["//#fix:lint"]
    },
    "//#fix:lint": {
      "cache": false,
      "dependsOn": ["//#build"]
    },

    "//#test": {
      "with": ["//#test:dependencies", "//#test:lint"]
    },
    "//#test:dependencies": {
      "cache": false,
      "dependsOn": ["//#build"]
    },
    "//#test:lint": {
      "dependsOn": ["//#build"]
    },

    "build:storybook": {
      "dependsOn": ["//#build", "^prepare", "prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.test.*"],
      "outputs": ["storybook-static/**"]
    },

    "build:vite": {
      "dependsOn": ["//#build", "^build:vite", "^prepare", "prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.test.*"],
      "outputs": [".vite/**"]
    },

    "prepare": {
      "dependsOn": ["//#build"],
      "inputs": ["panda.config.ts", "src/**/*.{ts,tsx}", "package.json"],
      "outputs": ["styled-system/**"]
    },

    "start:dev": {
      "cache": false,
      "dependsOn": ["//#build", "^prepare", "prepare"],
      "persistent": true
    },

    "start:prod": {
      "cache": false,
      "dependsOn": ["build:storybook"],
      "persistent": true
    },

    "test": {
      "with": ["test:types", "test:unit", "build:vite"]
    },
    "test:types": {
      "dependsOn": ["//#build", "^prepare", "prepare"]
    },
    "test:unit": {
      "dependsOn": ["//#build", "^prepare", "prepare"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"]
    }
  },
  "ui": "tui"
}
