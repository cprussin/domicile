{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "BIOME_BINARY",
    "DOMICILE_COMPOSITOR",
    "DOMICILE_ROOT",
    "DOMICILE_SESSION",
    "FORCE_COLOR",
    "WAYLAND_DISPLAY",
    "XDG_RUNTIME_DIR",
    "XDG_SESSION_TYPE"
  ],
  "tasks": {
    "//#build": {
      "dependsOn": ["//#build:install-modules"]
    },
    "//#build:install-modules": {
      "inputs": ["**/package.json", "bunfig.toml", "!**/dist/**"],
      "outputs": ["bun.lock"]
    },
    "//#fix": {
      "with": ["//#fix:lint"]
    },
    "//#fix:lint": {
      "cache": false,
      "dependsOn": ["//#build"]
    },
    "//#test": {
      "with": ["//#test:dependencies", "//#test:lint"]
    },
    "//#test:dependencies": {
      "cache": false,
      "dependsOn": ["//#build"]
    },
    "//#test:lint": {
      "dependsOn": ["//#build"]
    },
    "build": {
      "dependsOn": ["//#build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.test.*"],
      "outputs": ["dist/**"]
    },
    "build:next": {
      "dependsOn": ["^build", "//#build", "^prepare", "prepare"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!**/*.test.*",
        "$TURBO_ROOT$/docs/media/**"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build:storybook": {
      "dependsOn": ["^build", "//#build", "^prepare", "prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.test.*"],
      "outputs": ["storybook-static/**"]
    },
    "build:vite": {
      "dependsOn": ["^build", "//#build", "^build:vite", "^prepare", "prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!**/*.test.*"],
      "outputs": [".vite/**"]
    },
    "prepare": {
      "dependsOn": ["^build", "//#build"],
      "inputs": ["panda.config.ts", "src/**/*.{ts,tsx}", "package.json"],
      "outputs": ["styled-system/**"]
    },
    "start:dev": {
      "cache": false,
      "dependsOn": ["^build", "//#build", "^prepare", "prepare"],
      "persistent": true
    },
    "start:prod": {
      "cache": false,
      "dependsOn": ["build:storybook"],
      "persistent": true
    },
    "test": {
      "with": [
        "test:types",
        "test:unit",
        "test:shell",
        "build:vite",
        "build:next"
      ]
    },
    "test:shell": {
      "env": ["DOMICILE_CHECK_ALLOW_SKIP", "DOMICILE_CHECK_STRICT"],
      "passThroughEnv": ["DOMICILE_CHECK_LOG_DIR"]
    },
    "test:types": {
      "dependsOn": ["^build", "//#build", "^prepare", "prepare"]
    },
    "test:unit": {
      "dependsOn": ["^build", "//#build", "^prepare", "prepare"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/packages/*/tests/*.sh",
        "$TURBO_ROOT$/packages/domicile-protocol/wire/**"
      ]
    }
  },
  "ui": "tui"
}
