{
  "description": "The Electron host's half of a Domicile chrome: the window it is drawn in, the compositor socket, and the channel a renderer cannot serve itself.",
  "devDependencies": {
    "@cprussin/tsconfig": "catalog:",
    "@types/bun": "catalog:",
    "electron": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./chrome-failure": {
      "types": "./dist/chrome-failure.d.ts",
      "default": "./dist/chrome-failure.js"
    },
    "./chrome-window": {
      "types": "./dist/chrome-window.d.ts",
      "default": "./dist/chrome-window.js"
    },
    "./compositor-socket": {
      "types": "./dist/compositor-socket.d.ts",
      "default": "./dist/compositor-socket.js"
    },
    "./socket-path": {
      "types": "./dist/socket-path.d.ts",
      "default": "./dist/socket-path.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "name": "@domicile/electron-chrome-host",
  "peerDependencies": {
    "electron": "catalog:"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:types": "tsc --noEmit",
    "test:unit": "bun test"
  },
  "type": "module",
  "version": "0.1.0"
}
