{
  "dependencies": {
    "@domicile/chrome-sdk": "workspace:*",
    "@domicile/component-library": "workspace:*",
    "@domicile/electron-chrome-host": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "description": "The bundled reference Domicile chrome: a tab rail and a stage that mounts app portals.",
  "devDependencies": {
    "@cprussin/tsconfig": "catalog:",
    "@domicile/test-support": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "main": ".vite/build/main.js",
  "name": "@domicile/shell-manganese",
  "private": true,
  "productName": "domicile-shell-manganese",
  "scripts": {
    "build:vite": "vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build -c vite.renderer.config.ts",
