{
  "dependencies": {
    "@cprussin/option-result": "catalog:",
    "@domicile-desktop/component-library": "workspace:*",
    "@domicile-desktop/sdk": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "lowlight": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "description": "Domicile's default desktop shell, as a library: runManganese(), its bar items and its keybindings, so you can compose your own.",
  "devDependencies": {
    "@cprussin/tsconfig": "catalog:",
    "@domicile-desktop/test-support": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.mjs"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.mjs"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.mjs"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.mjs"
    }
  },
  "files": [
    "panda.config.ts",
    "src/**",
    "styled-system/**",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "license": "MIT",
  "name": "@domicile-desktop/manganese",
  "private": false,
  "productName": "domicile-shell-manganese",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/shell-manganese",
    "type": "git",
    "url": "git+https://github.com/cprussin/domicile.git"
  },
  "scripts": {
    "build:vite": "vite build",
    "prepare": "panda codegen --silent && panda cssgen --silent",
    "start:dev": "../../scripts/dev-shell.sh manganese",
    "test:types": "tsc --noEmit",
    "test:unit": "bun test"
  },
  "type": "module",
  "version": "0.0.0"
}
