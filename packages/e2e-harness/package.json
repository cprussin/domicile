{
  "dependencies": {
    "@domicile-desktop/sdk": "workspace:*",
    "zod": "catalog:"
  },
  "description": "Headless chrome stand-ins that drive the repo's end-to-end scripts, and the check on those scripts' own machinery.",
  "devDependencies": {
    "@cprussin/tsconfig": "catalog:",
    "@domicile-desktop/check-runner": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "exports": {
    "./chrome-socket": "./src/chrome-socket.ts",
    "./mock-chrome": "./src/mock-chrome.ts"
  },
  "files": [
    "src/**/*"
  ],
  "license": "MIT",
  "name": "@domicile-desktop/e2e-harness",
  "private": true,
  "scripts": {
    "test:e2e": "check-runner tests/*.sh",
    "test:types": "tsc --noEmit",
    "test:unit": "bun test"
  },
  "type": "module",
  "version": "0.0.2"
}
