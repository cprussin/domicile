# Ends a Domicile desk's graphical session.
#
# Stopping `domicile-session.target` is not enough: a running portal has
# `Requisite=graphical-session.target`, which keeps that target up. This target
# has `Conflicts=graphical-session.target`, so starting it stops that target and
# the portal. The launcher starts it with
# `replace-irreversibly` when the desk exits
# (`domicile_launch::graphical_session`). niri's `niri-shutdown.target` does
# the same.
[Unit]
Description=Domicile desk has ended
DefaultDependencies=no
StopWhenUnneeded=true
Conflicts=graphical-session.target graphical-session-pre.target
After=graphical-session.target graphical-session-pre.target
