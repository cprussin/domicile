{
  "dependencies": {
    "@cprussin/option-result": "catalog:",
    "@domicile-desktop/react": "workspace:*",
    "@domicile-desktop/sdk": "workspace:*",
    "zod": "catalog:"
  },
  "description": "Screen brightness for a Domicile shell: reads /sys/class/backlight, watches it and sets it through logind, and reads the ambient light sensor through iio-sensor-proxy, on @domicile-desktop/sdk/system.",
  "devDependencies": {
    "@cprussin/tsconfig": "catalog:",
    "@domicile-desktop/test-support": "workspace:*",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "exports": {
    "./read-backlight": {
      "types": "./dist/read-backlight.d.ts",
      "default": "./dist/read-backlight.js"
    },
    "./set-brightness": {
      "types": "./dist/set-brightness.d.ts",
      "default": "./dist/set-brightness.js"
    },
    "./watch-ambient-light": {
      "types": "./dist/watch-ambient-light.d.ts",
      "default": "./dist/watch-ambient-light.js"
    },
    "./watch-brightness": {
      "types": "./dist/watch-brightness.d.ts",
      "default": "./dist/watch-brightness.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./shared-backlight": {
      "types": "./dist/shared-backlight.d.ts",
      "default": "./dist/shared-backlight.js"
    },
    "./fixture": {
      "types": "./dist/fixture.d.ts",
      "default": "./dist/fixture.js"
    },
    "./auto-brightness": {
      "types": "./dist/auto-brightness.d.ts",
      "default": "./dist/auto-brightness.js"
    },
    "./auto-brightness-curve": {
      "types": "./dist/auto-brightness-curve.d.ts",
      "default": "./dist/auto-brightness-curve.js"
    },
    "./learned-offset": {
      "types": "./dist/learned-offset.d.ts",
      "default": "./dist/learned-offset.js"
    },
    "./host-ambient-light": {
      "types": "./dist/host-ambient-light.d.ts",
      "default": "./dist/host-ambient-light.js"
    },
    "./host-backlight": {
      "types": "./dist/host-backlight.d.ts",
      "default": "./dist/host-backlight.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "license": "MIT",
  "name": "@domicile-desktop/system-backlight",
  "peerDependencies": {
    "react": "catalog:"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "packages/system-backlight",
    "type": "git",
    "url": "git+https://github.com/cprussin/domicile.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:types": "tsc --noEmit",
    "test:unit": "bun test"
  },
  "type": "module",
  "version": "1.1.0"
}
