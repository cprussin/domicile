{
  "dependencies": {
    "@domicile/chrome-sdk": "workspace:*",
    "@domicile/component-library": "workspace:*",
    "zod": "catalog:"
  },
  "description": "A Domicile desktop with nothing in it but windows: floating windows moved and resized with the Alt key, and Alt+Enter for a terminal.",
  "devDependencies": {
    "@cprussin/tsconfig": "catalog:",
    "@domicile/test-support": "workspace:*",
    "@pandacss/dev": "catalog:",
    "@pandacss/preset-panda": "catalog:",
    "@types/bun": "catalog:",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "name": "@domicile/shell-simple",
  "private": true,
  "productName": "domicile-shell-simple",
  "scripts": {
    "build:vite": "vite build -c vite.renderer.config.ts",
    "prepare": "panda codegen --silent && panda cssgen --silent",
    "start:dev": "../../scripts/dev-shell.sh simple",
    "test:types": "tsc --noEmit",
    "test:unit": "bun test"
  },
  "type": "module",
  "version": "0.0.0"
}
