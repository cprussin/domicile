diff --git a/chrome/browser/chrome_browser_interface_binders.cc b/chrome/browser/chrome_browser_interface_binders.cc
index ae2d77825d359..d55fad9fefd13 100644
--- a/chrome/browser/chrome_browser_interface_binders.cc
+++ b/chrome/browser/chrome_browser_interface_binders.cc
@@ -4,6 +4,11 @@
 
 #include "chrome/browser/chrome_browser_interface_binders.h"
 
+#include "components/domicile/browser/control_channel.h"
+#include "content/public/browser/browser_thread.h"
+#include "mojo/public/cpp/bindings/message.h"
+#include "components/domicile/common/domicile_scheme.h"
+
 #include <utility>
 
 #include "base/feature_list.h"
@@ -466,6 +471,41 @@ void PopulateChromeFrameBinders(
     map->Add<pwc::mojom::PrivilegedBridge>(&pwc::BindPrivilegedBridge);
     map->Add<geic::mojom::GeicApi>(&geic::BindGeicApi);
   }
+  // Domicile's engine fork: the shell's control channel to the compositor.
+  //
+  // Registered unconditionally and gated at BIND time, not here. This map is
+  // built when the RenderFrameHost is created, before any document has
+  // committed, so GetLastCommittedOrigin() is empty at this point -- gating
+  // here silently registers nothing and the renderer is then killed for
+  // requesting an interface with no binder. That is how this was found.
+  //
+  // THE CHECK IN THE CALLBACK IS THE WHOLE OF THE ACCESS CONTROL. It works
+  // because domicile:// is registered neither web-safe nor CORS-enabled, so no
+  // ordinary web content can hold that origin, and because a document's
+  // committed origin is fixed by the time it can ask for anything. If it is
+  // ever loosened, this is worse than the loopback TCP port it replaced,
+  // because it looks safe.
+  map->Add<domicile::mojom::ControlChannel>(base::BindRepeating(
+      [](content::RenderFrameHost* frame,
+         mojo::PendingReceiver<domicile::mojom::ControlChannel> receiver) {
+        if (frame->GetLastCommittedOrigin().scheme() !=
+            domicile::kDomicileScheme) {
+          // Not the shell. Reporting it rather than dropping quietly: a
+          // document that is not the shell asking for the desktop's control
+          // plane is not a mistake to absorb.
+          mojo::ReportBadMessage(
+              "domicile: only a domicile:// document may control the "
+              "compositor.");
+          return;
+        }
+        // On the IO thread: the channel talks to a unix socket through
+        // net::SocketPosix, which DCHECKs that it is on a thread with an IO
+        // message pump. Binders run on the UI thread, so this has to hop.
+        content::GetIOThreadTaskRunner({})->PostTask(
+            FROM_HERE, base::BindOnce(&domicile::BindControlChannel,
+                                      std::move(receiver)));
+      }));
+
   map->Add<image_annotation::mojom::Annotator>(&BindImageAnnotator);
 
   map->Add<blink::mojom::ScriptToolHost>(
diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 7a4cef2435e82..29a0f4d6bda01 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -4,6 +4,9 @@
 
 #include "chrome/browser/chrome_content_browser_client.h"
 
+#include "components/domicile/browser/shell_url_loader_factory.h"
+#include "components/domicile/common/domicile_scheme.h"
+
 #include <algorithm>
 #include <iterator>
 #include <map>
@@ -2540,6 +2543,25 @@ void ChromeContentBrowserClient::SiteInstanceGotProcessAndSite(
 
   const GURL& site_url =
       site_instance->GetSecurityPrincipal().GetDeprecatedSiteURL();
+
+  // Domicile's engine fork. A renderer hosting the shell has to be allowed to
+  // request its own subresources: domicile:// is deliberately not web-safe, so
+  // without this grant ChildProcessSecurityPolicy refuses every script,
+  // stylesheet and image the shell's document asks for -- the navigation
+  // commits and then the page is inert, which is how this was found.
+  //
+  // Granted per process rather than by RegisterWebSafeIsolatedScheme, which
+  // would let *any* renderer request domicile:// URLs. This grants only the
+  // process that is already hosting the shell, so a compromised renderer of
+  // some other origin gains nothing. Request only, never GrantCommitScheme:
+  // committing a domicile:// document is what confers the origin, and the
+  // origin is what the control channel's binder keys on.
+  if (site_url.SchemeIs(domicile::kDomicileScheme)) {
+    content::ChildProcessSecurityPolicy::GetInstance()->GrantRequestScheme(
+        site_instance->GetProcess()->GetDeprecatedID(),
+        domicile::kDomicileScheme);
+  }
+
   if (search::IsNTPURL(site_url)) {
     site_instance->GetProcess()->SetUserData(search::kIsNTPProcessKey,
                                              std::make_unique<NTPUserData>());
@@ -6051,10 +6073,31 @@ ChromeContentBrowserClient::CreateURLLoaderThrottlesForKeepAlive(
   return result;
 }
 
+namespace {
+
+// Where the shell's files are. Empty when the engine was started without
+// --domicile-shell-root, and a factory on an empty root refuses everything --
+// the honest answer when there is no shell, and better than guessing.
+base::FilePath DomicileShellRoot() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+      domicile::kDomicileShellRootSwitch);
+}
+
+}  // namespace
+
 mojo::PendingRemote<network::mojom::URLLoaderFactory>
 ChromeContentBrowserClient::CreateNonNetworkNavigationURLLoaderFactory(
     const std::string& scheme,
     content::FrameTreeNodeId frame_tree_node_id) {
+  // Domicile's engine fork. Answered before anything below, because the shell
+  // is not a profile's: there is one shell root, given on the command line,
+  // and it is the same whichever BrowserContext asks. Everything past this
+  // point resolves a Profile first, and a scheme that does not need one should
+  // not inherit the ways that can fail.
+  if (scheme == domicile::kDomicileScheme) {
+    return domicile::ShellURLLoaderFactory::Create(DomicileShellRoot());
+  }
+
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE) || BUILDFLAG(IS_CHROMEOS) || \
     !BUILDFLAG(IS_ANDROID)
   content::WebContents* web_contents =
@@ -6470,6 +6513,18 @@ void ChromeContentBrowserClient::
         int render_frame_id,
         const std::optional<url::Origin>& request_initiator_origin,
         NonNetworkURLLoaderFactoryMap* factories) {
+  // Domicile's engine fork. This is the half that makes the scheme usable
+  // rather than merely navigable: without it the shell's document commits and
+  // then every script, stylesheet and image in it fails, which reads as a
+  // blank shell rather than as a loader that is missing.
+  //
+  // The navigation twin returns one factory; this fills a map. Same job, two
+  // shapes -- and the shapes diverged upstream, which is exactly the kind of
+  // thing that makes writing one and forgetting the other easy.
+  factories->emplace(
+      domicile::kDomicileScheme,
+      domicile::ShellURLLoaderFactory::Create(DomicileShellRoot()));
+
 #if BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(ENABLE_EXTENSIONS_CORE) || \
     !BUILDFLAG(IS_ANDROID)
   content::RenderFrameHost* frame_host =
