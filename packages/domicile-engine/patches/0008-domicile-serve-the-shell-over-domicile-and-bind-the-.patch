index 0b8d0aabf04ed..644b8d08de7e3 100644
--- a/chrome/browser/ui/startup/startup_browser_creator.cc
+++ b/chrome/browser/ui/startup/startup_browser_creator.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/startup/startup_browser_creator.h"
 
+#include "components/domicile/common/domicile_scheme.h"
+
 #include <stddef.h>
 
 #include <optional>
@@ -395,8 +397,22 @@ bool MaybeLaunchAppShortcutWindow(const base::CommandLine& command_line,
   if (!url.is_empty() && url.is_valid()) {
     content::ChildProcessSecurityPolicy* policy =
         content::ChildProcessSecurityPolicy::GetInstance();
+    // Domicile's engine fork. `--app=domicile://shell/` is how a desktop is
+    // launched, and domicile:// is deliberately not web-safe -- so without
+    // this the switch is dropped here, the browser goes on to start as though
+    // it had never been given, and what the user gets is an ordinary window on
+    // the New Tab page. That is the whole of "the shell does not load", and
+    // nothing on either side says so: the engine never navigates, so the page
+    // never runs, so the control channel is never bound and the compositor
+    // waits for a chrome that is sitting on about:newtab.
+    //
+    // The twin of the hunk in url_util.cc, and there for the same reason: a
+    // command line is trusted, because whoever writes it already runs as the
+    // user. Two separate checks asking the same question, which is why the
+    // first one was patched and this one was not.
     if (policy->IsWebSafeScheme(url.GetScheme()) ||
-        url.SchemeIs(url::kFileScheme)) {
+        url.SchemeIs(url::kFileScheme) ||
+        url.SchemeIs(domicile::kDomicileScheme)) {
       const content::WebContents* web_contents =
           apps::OpenExtensionAppShortcutWindow(profile, url);
       if (web_contents) {
diff --git a/chrome/browser/ui/startup/url_util.cc b/chrome/browser/ui/startup/url_util.cc
index 2dd42fefa3899..89e5495afe67e 100644
--- a/chrome/browser/ui/startup/url_util.cc
+++ b/chrome/browser/ui/startup/url_util.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/startup/url_util.h"
 
+#include "components/domicile/common/domicile_scheme.h"
+
 #include "base/logging.h"
 #include "build/build_config.h"
 #include "chrome/common/url_constants.h"
@@ -79,9 +81,21 @@ bool ValidateLaunchUrlWebUnsafe(const GURL& url) {
   url_scheme_is_content = url.SchemeIs(url::kContentScheme);
 #endif  // BUILDFLAG(IS_ANDROID)
 
+  // Domicile's engine fork. The shell is launched by URL on the command line,
+  // and domicile:// is deliberately NOT web-safe -- that is the whole security
+  // property, and making it web-safe to get past this check would hand the
+  // scheme back to any web page.
+  //
+  // These two lists answer different questions and only look alike. Web-safe is
+  // "may a web page navigate here". This is "may the command line ask for
+  // this", and the command line is trusted: whoever writes it already runs as
+  // the user. chrome:// sits here for the same reason, under a headless flag.
+  const bool url_scheme_is_domicile = url.SchemeIs(domicile::kDomicileScheme);
+
   auto* policy = content::ChildProcessSecurityPolicy::GetInstance();
   return policy->IsWebSafeScheme(url.GetScheme()) ||
          url.SchemeIs(url::kFileScheme) || url_scheme_is_chrome ||
+         url_scheme_is_domicile ||
          url_scheme_is_content || url_points_to_an_approved_settings_page ||
          url.spec() == url::kAboutBlankURL;
 }
