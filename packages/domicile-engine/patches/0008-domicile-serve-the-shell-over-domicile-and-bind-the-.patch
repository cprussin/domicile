+
 #include <stdint.h>
 
 #include <memory>
@@ -204,6 +206,18 @@ void ChromeContentClient::AddAdditionalSchemes(Schemes* schemes) {
   for (auto* standard_scheme : kChromeStandardURLSchemes)
     schemes->standard_schemes.push_back(standard_scheme);
 
+  // Domicile's engine fork. domicile:// serves the shell, so the page has a
+  // real origin without a TCP port behind it.
+  //
+  // Standard, because an origin is the whole reason the shell was on
+  // http://127.0.0.1 to begin with. Secure, so it is a trustworthy origin.
+  // Deliberately absent from cors_enabled_schemes and deliberately not
+  // web-safe, so ordinary web content can neither fetch it nor navigate to it.
+  // This scheme is not a smaller door onto the same room; it is the removal of
+  // that room's door onto the street.
+  schemes->standard_schemes.push_back(domicile::kDomicileScheme);
+  schemes->secure_schemes.push_back(domicile::kDomicileScheme);
+
 #if BUILDFLAG(IS_ANDROID)
   schemes->referrer_schemes.push_back(content::kAndroidAppScheme);
   schemes->referrer_schemes.push_back(dom_distiller::kDomDistillerScheme);
