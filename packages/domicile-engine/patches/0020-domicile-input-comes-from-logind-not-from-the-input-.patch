       imposter_checker_(new ImposterCheckerEvdev()),
       input_device_opener_(std::move(input_device_opener)),
       input_controller_(input_controller) {
+  // THE OPENER'S WAY BACK IN, handed over here because an opener is built in
+  // order to be given to this factory and so cannot be given this factory
+  // first. `base::Unretained` is safe for the same reason: the opener is owned
+  // here and cannot outlive what owns it.
+  //
+  // Closing a device and opening it again is the only thing that re-arms the
+  // watch on it -- `AttachInputDevice` is the sole caller of
+  // `EventConverterEvdev::Start()` -- and an opener whose descriptors can be
+  // revoked under it (Domicile's, from logind, on a console switch) has no
+  // other way to get a device reading again. The explicit detach ahead of the
+  // open matters: `AttachInputDevice` would detach too, but it runs a task
+  // later, which would leave the dead converter watching in between.
+  input_device_opener_->SetDeviceReopener(base::BindRepeating(
+      [](InputDeviceFactoryEvdev* factory, int id, const base::FilePath& path) {
+        factory->RemoveInputDevice(path);
+        factory->AddInputDevice(id, path);
+      },
+      base::Unretained(this)));
 }
 
