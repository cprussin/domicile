diff --git a/ui/ozone/public/ozone_platform.h b/ui/ozone/public/ozone_platform.h
index 0d911ff..7bdde5b 100644
--- a/ui/ozone/public/ozone_platform.h
+++ b/ui/ozone/public/ozone_platform.h
@@ -132,6 +132,27 @@ struct DomicileWhitePoint {
   float blue = 1.f;
 };
 
+// DOMICILE: one event of emulated input (EIS) for the desk, as a pointer or
+// keyboard of the platform's own would send it. See
+// docs/architecture/A-HEADLESS-DESKTOP.md.
+struct DomicileDeskInput {
+  enum class Kind {
+    // The pointer moved to `x`, `y`, a point on the desk in pixels.
+    kPointer,
+    // Button `code`, an evdev code, went down or up.
+    kButton,
+    // A scroll by `x`, `y` pixels: right and down are positive.
+    kScroll,
+    // Key `code`, an evdev code, went down or up.
+    kKey,
+  };
+  Kind kind = Kind::kPointer;
+  double x = 0;
+  double y = 0;
+  uint32_t code = 0;
+  bool pressed = false;
+};
+
 // Base class for Ozone platform implementations.
 //
 // Ozone platforms must override this class and implement the virtual
@@ -426,6 +447,10 @@ class COMPONENT_EXPORT(OZONE) OzonePlatform {
   // CRTC. DRM only, like the layout above: a nested desktop's monitors are
   // the host session's.
   virtual void SetDomicileWhitePoint(const DomicileWhitePoint& white_point) {}
+  // DOMICILE: emulated input for the desk host, which it hears as it hears
+  // the platform's own devices. A headless desk only: it has no devices, and
+  // DRM's EIS input still goes to the compositor's seat.
+  virtual void InjectDomicileInput(const DomicileDeskInput& input) {}
   // DOMICILE: what the compositor says is on one of the desktop's clipboards.
   //
   // THE BROWSER IS TOLD RATHER THAN ASKED. The compositor reads every
