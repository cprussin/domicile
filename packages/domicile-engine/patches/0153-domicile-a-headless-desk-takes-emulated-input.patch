     KeyboardLayoutEngineManager::SetKeyboardLayoutEngine(
         keyboard_layout_engine_.get());
+    if (desk) {
+      // Unretained: the platform outlives every event it injects.
+      desk_input_ = std::make_unique<HeadlessDeskInput>(
