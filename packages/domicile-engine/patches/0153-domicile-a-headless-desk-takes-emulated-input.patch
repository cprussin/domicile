     gpu_platform_support_host_.reset(CreateStubGpuPlatformSupportHost());
 
     return true;
@@ -197,6 +243,27 @@ class OzonePlatformHeadlessImpl : public OzonePlatformHeadless {
     desk_screen_->SetDomicileDesk(desk.displays);
   }
 
+  // DOMICILE: hands an injected event, located in desk pixels, to the
+  // shell's window. Dropped before the shell has one.
+  void DeliverToDesk(Event* event) {
+    HeadlessWindow* window =
+        window_manager_ ? window_manager_->GetWindow(desk_host_) : nullptr;
+    if (!window) {
+      return;
+    }
+    if (event->IsLocatedEvent()) {
+      LocatedEvent* located = event->AsLocatedEvent();
+      const gfx::Rect bounds = window->GetBoundsInPixels();
+      const gfx::Vector2dF origin(bounds.x(), bounds.y());
+      located->set_location_f(located->location_f() - origin);
+      located->set_root_location_f(located->root_location_f() - origin);
+    }
+    window->DispatchDomicileEvent(event);
+  }
+
+#if BUILDFLAG(USE_XKBCOMMON)
+  XkbEvdevCodes xkb_evdev_code_converter_;
+#endif
   std::unique_ptr<KeyboardLayoutEngine> keyboard_layout_engine_;
   std::unique_ptr<HeadlessWindowManager> window_manager_;
   std::unique_ptr<HeadlessSurfaceFactory> surface_factory_;
@@ -213,6 +280,10 @@ class OzonePlatformHeadlessImpl : public OzonePlatformHeadless {
   std::vector<DomicileVirtualDisplay> virtual_;
   std::vector<DomicileDisplayLayout> layout_;
   base::flat_map<int64_t, std::string> connectors_;
+  // DOMICILE: the shell's window, and the desk's emulated pointer and keyboard,
+  // made by `InitializeUI` with the desk switch.
+  gfx::AcceleratedWidget desk_host_ = gfx::kNullAcceleratedWidget;
+  std::unique_ptr<HeadlessDeskInput> desk_input_;
 };
 
