   }
@@ -167,13 +190,36 @@ class OzonePlatformHeadlessImpl : public OzonePlatformHeadless {
     // This unbreaks tests that create their own.
     if (!PlatformEventSource::GetInstance())
       platform_event_source_ = std::make_unique<HeadlessPlatformEventSource>();
-    keyboard_layout_engine_ = std::make_unique<StubKeyboardLayoutEngine>();
+    const bool desk = base::CommandLine::ForCurrentProcess()->HasSwitch(
+        kDomicileHeadlessDesk);
+#if BUILDFLAG(USE_XKBCOMMON)
+    // DOMICILE: a desk's keys type what the compositor's keymap says.
+    if (desk) {
+      keyboard_layout_engine_ =
+          std::make_unique<XkbKeyboardLayoutEngine>(xkb_evdev_code_converter_);
+    }
+#endif
+    if (!keyboard_layout_engine_) {
