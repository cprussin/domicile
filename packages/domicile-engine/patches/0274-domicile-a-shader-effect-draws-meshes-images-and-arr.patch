+void CompositorFilterOperations::SetDomicileShaderArrays(
+    uint32_t effect,
+    base::span<const float> arrays) {
+  std::vector<cc::FilterOperation> operations =
+      filter_operations_.operations();
+  for (cc::FilterOperation& operation : operations) {
+    if (operation.type() == cc::FilterOperation::SHADER &&
+        operation.shader_effect() == effect) {
+      operation.set_shader_arrays(
+          std::vector<float>(arrays.begin(), arrays.end()));
+    }
+  }
+  filter_operations_ = cc::FilterOperations(std::move(operations));
+}
