+// Domicile: the outsets of `operations`' shader effects, in order, when
+// they are all that moves pixels; null when another filter moves them.
+std::optional<Vector<float>> DomicileShaderOutsets(
+    const FilterOperations& operations) {
+  Vector<float> outsets;
+  for (const auto& operation : operations.Operations()) {
+    if (operation->GetType() ==
+        FilterOperation::OperationType::kDomicileShader) {
+      outsets.push_back(
+          static_cast<const DomicileShaderFilterOperation&>(*operation)
+              .Outset());
+    } else if (operation->MovesPixels()) {
+      return std::nullopt;
+    }
+  }
+  return outsets;
+}
