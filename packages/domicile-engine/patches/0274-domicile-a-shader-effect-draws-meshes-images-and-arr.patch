+FilterOperations FilterOperations::WithShaderArraysOf(
+    const FilterOperations& committed) const {
+  FilterOperations kept = *this;
+  for (size_t i = 0; i < kept.size() && i < committed.size(); ++i) {
+    FilterOperation& op = kept.operations_[i];
+    const FilterOperation& page = committed.at(i);
+    if (op.type() == FilterOperation::SHADER &&
+        page.type() == FilterOperation::SHADER &&
+        op.shader_effect() == page.shader_effect()) {
+      op.set_shader_arrays(page.shader_arrays());
+    }
+  }
+  return kept;
+}
