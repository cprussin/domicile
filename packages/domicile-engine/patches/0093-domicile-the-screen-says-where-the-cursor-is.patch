+gfx::Point DrmWindowHost::ToScreenInDIP(const gfx::PointF& location) const {
+  // aura's own arithmetic for an event at `location`: the root transform turns
+  // the window's pixels into its DIPs, and `GetBoundsInDIP` is where the
+  // screen position client puts the root window.
+  const gfx::PointF in_window = delegate_->ConvertScreenPointToLocalDIP(
+      bounds_.origin() + gfx::ToFlooredPoint(location).OffsetFromOrigin());
+  return GetBoundsInDIP().origin() +
+         gfx::ToFlooredPoint(in_window).OffsetFromOrigin();
+}
+
 void DrmWindowHost::ConfineCursorToBounds(const gfx::Rect& bounds) {
   if (cursor_confined_bounds_ == bounds)
     return;
