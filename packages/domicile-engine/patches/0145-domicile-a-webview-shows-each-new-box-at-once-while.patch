From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Sun, 25 Oct 2026 00:00:00 +0000
Subject: [PATCH] domicile: a <webview> shows each new box at once while
 resizing

A shell's <webview> embeds its page's surface with the default deadline,
so each resize holds the shell's frame until the page draws at the new
size. During an interactive resize the box changes every frame, which
holds the whole shell to the page's pace.

While the <webview> has the `resizing` attribute, as an <app> already
does, RemoteFrame embeds each new surface with deadline 0 and the
child's latest frame stretches to the box until the page catches up.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on crux.
---
 .../core/frame/child_frame_compositing_helper.cc      |  9 ++++++---
 .../core/frame/child_frame_compositing_helper.h       |  5 ++++-
 third_party/blink/renderer/core/frame/remote_frame.cc | 11 ++++++++++-
 3 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/third_party/blink/renderer/core/frame/child_frame_compositing_helper.cc b/third_party/blink/renderer/core/frame/child_frame_compositing_helper.cc
index 8608cedc..f196674d 100644
--- a/third_party/blink/renderer/core/frame/child_frame_compositing_helper.cc
+++ b/third_party/blink/renderer/core/frame/child_frame_compositing_helper.cc
@@ -49,7 +49,8 @@ void ChildFrameCompositingHelper::ChildFrameGone(float device_scale_factor) {
 
 void ChildFrameCompositingHelper::SetSurfaceId(
     const viz::SurfaceId& surface_id,
-    AllowPaintHolding allow_paint_holding) {
+    AllowPaintHolding allow_paint_holding,
+    bool without_waiting) {
   if (surface_id_ == surface_id)
     return;
 
@@ -62,8 +63,10 @@ void ChildFrameCompositingHelper::SetSurfaceId(
   surface_layer_->SetSurfaceHitTestable(true);
   surface_layer_->SetBackgroundColor(SkColors::kTransparent);
 
-  surface_layer_->SetSurfaceId(surface_id,
-                               cc::DeadlinePolicy::UseDefaultDeadline());
+  surface_layer_->SetStretchContentToFillBounds(without_waiting);
+  surface_layer_->SetSurfaceId(
+      surface_id, without_waiting ? cc::DeadlinePolicy::UseSpecifiedDeadline(0u)
+                                  : cc::DeadlinePolicy::UseDefaultDeadline());
   MaybeSetUpPaintHolding(current_surface_id, allow_paint_holding);
 
   // TODO(lfg): Investigate if it's possible to propagate the information
diff --git a/third_party/blink/renderer/core/frame/child_frame_compositing_helper.h b/third_party/blink/renderer/core/frame/child_frame_compositing_helper.h
index 330859de..4200f9aa 100644
--- a/third_party/blink/renderer/core/frame/child_frame_compositing_helper.h
+++ b/third_party/blink/renderer/core/frame/child_frame_compositing_helper.h
@@ -33,8 +33,11 @@ class CORE_EXPORT ChildFrameCompositingHelper : public cc::ContentLayerClient {
   ~ChildFrameCompositingHelper() override;
 
   enum class AllowPaintHolding { kYes, kNo };
+  // Domicile: `without_waiting` embeds with deadline 0 and stretches the
+  // child's latest frame to the box, as an <app> does while resizing.
   void SetSurfaceId(const viz::SurfaceId& surface_id,
-                    AllowPaintHolding allow_paint_holding);
+                    AllowPaintHolding allow_paint_holding,
+                    bool without_waiting = false);
   void UpdateVisibility(bool visible);
   void ChildFrameGone(float device_scale_factor);
 
diff --git a/third_party/blink/renderer/core/frame/remote_frame.cc b/third_party/blink/renderer/core/frame/remote_frame.cc
index 5b0aae0e..5430cded 100644
--- a/third_party/blink/renderer/core/frame/remote_frame.cc
+++ b/third_party/blink/renderer/core/frame/remote_frame.cc
@@ -46,6 +46,7 @@
 #include "third_party/blink/renderer/core/html/domicile/html_web_view_element.h"
 #include "third_party/blink/renderer/core/html/fenced_frame/html_fenced_frame_element.h"
 #include "third_party/blink/renderer/core/html/html_frame_owner_element.h"
+#include "third_party/blink/renderer/core/html_names.h"
 #include "third_party/blink/renderer/core/inspector/console_message.h"
 #include "third_party/blink/renderer/core/layout/geometry/physical_rect.h"
 #include "third_party/blink/renderer/core/layout/layout_embedded_content.h"
@@ -1033,7 +1034,15 @@ bool RemoteFrame::SynchronizeVisualProperties(
   DCHECK(surface_id.is_valid());
   DCHECK(!remote_process_gone_);
 
-  compositing_helper_->SetSurfaceId(surface_id, allow_paint_holding);
+  // Domicile: while the shell resizes a <webview>'s window (`resizing`), its
+  // box changes every frame. Waiting for the page each time would hold the
+  // whole shell to the page's pace, so its latest frame stretches to the box
+  // instead. See HTMLAppElement::Embed.
+  HTMLFrameOwnerElement* owner = DeprecatedLocalOwner();
+  compositing_helper_->SetSurfaceId(
+      surface_id, allow_paint_holding,
+      IsA<HTMLWebViewElement>(owner) &&
+          owner->FastHasAttribute(html_names::kResizingAttr));
 
   bool rect_changed = !sent_visual_properties_ ||
                       sent_visual_properties_->rect_in_local_root !=
