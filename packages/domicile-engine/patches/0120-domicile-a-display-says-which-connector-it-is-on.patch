 .../mojom/display_snapshot_mojom_traits.cc    |  6 ++++++
 .../mojom/display_snapshot_mojom_traits.h     |  5 +++++
 ui/display/types/display_snapshot.cc          |  1 +
 ui/display/types/display_snapshot.h           | 11 +++++++++++
 ui/ozone/platform/drm/BUILD.gn                |  3 +++
 ui/ozone/platform/drm/common/drm_util.cc      |  8 +++++++-
 ui/ozone/platform/drm/ozone_platform_drm.cc   | 19 ++++++++++++++++---
 ui/ozone/public/ozone_platform.cc             |  5 +++++
 ui/ozone/public/ozone_platform.h              |  5 +++++
 10 files changed, 61 insertions(+), 4 deletions(-)

diff --git a/ui/display/mojom/display_snapshot.mojom b/ui/display/mojom/display_snapshot.mojom
index f2867668..79db6d06 100644
--- a/ui/display/mojom/display_snapshot.mojom
+++ b/ui/display/mojom/display_snapshot.mojom
@@ -56,4 +56,6 @@ struct DisplaySnapshot {
   // and corresponding lists of modifiers for each one.
   [EnableIf=is_chromeos]
   map<uint32, array<uint64>> drm_formats_and_modifiers;
+  // DOMICILE: the kernel's name for the connector ("HDMI-A-1"), or empty.
+  string domicile_connector;
 };
diff --git a/ui/display/mojom/display_snapshot_mojom_traits.cc b/ui/display/mojom/display_snapshot_mojom_traits.cc
index 0bec6d21..84c4908b 100644
--- a/ui/display/mojom/display_snapshot_mojom_traits.cc
+++ b/ui/display/mojom/display_snapshot_mojom_traits.cc
@@ -186,6 +186,12 @@ bool StructTraits<display::mojom::DisplaySnapshotDataView,
       std::move(edid), current_mode, native_mode, data.product_code(),
       data.year_of_manufacture(), maximum_cursor_size,
       variable_refresh_rate_state, drm_formats_and_modifiers);
+
+  std::string domicile_connector;
+  if (!data.ReadDomicileConnector(&domicile_connector)) {
+    return false;
+  }
+  (*out)->set_domicile_connector(domicile_connector);
   return true;
 }
 
diff --git a/ui/display/mojom/display_snapshot_mojom_traits.h b/ui/display/mojom/display_snapshot_mojom_traits.h
index 15e8f377..80b02a46 100644
--- a/ui/display/mojom/display_snapshot_mojom_traits.h
+++ b/ui/display/mojom/display_snapshot_mojom_traits.h
@@ -184,6 +184,11 @@ struct StructTraits<display::mojom::DisplaySnapshotDataView,
     return snapshot->GetDRMFormatsAndModifiers();
   }
 
+  static const std::string& domicile_connector(
+      const std::unique_ptr<display::DisplaySnapshot>& snapshot) {
+    return snapshot->domicile_connector();
+  }
+
   static bool Read(display::mojom::DisplaySnapshotDataView data,
                    std::unique_ptr<display::DisplaySnapshot>* out);
 };
diff --git a/ui/display/types/display_snapshot.cc b/ui/display/types/display_snapshot.cc
index f58fecf3..5dff7d67 100644
--- a/ui/display/types/display_snapshot.cc
+++ b/ui/display/types/display_snapshot.cc
@@ -127,6 +127,7 @@ std::unique_ptr<DisplaySnapshot> DisplaySnapshot::Clone() const {
   // Set current mode in case it is non-native (because non-native modes are not
   // cloned).
   clone->set_current_mode(current_mode_);
+  clone->set_domicile_connector(domicile_connector_);
 
   return clone;
 }
diff --git a/ui/display/types/display_snapshot.h b/ui/display/types/display_snapshot.h
index 3415cf4a..0f6e8286 100644
--- a/ui/display/types/display_snapshot.h
+++ b/ui/display/types/display_snapshot.h
@@ -143,6 +143,14 @@ class DISPLAY_TYPES_EXPORT DisplaySnapshot {
   const DrmFormatsAndModifiers& GetDRMFormatsAndModifiers() const {
     return drm_formats_and_modifiers_;
   }
+  // DOMICILE: the kernel's name for this display's connector ("HDMI-A-1"), or
+  // empty if the platform did not set it. Domicile's compositor names a
+  // monitor with no EDID name after it. A setter rather than a constructor
+  // argument, so the constructor's many callers are untouched.
+  const std::string& domicile_connector() const { return domicile_connector_; }
+  void set_domicile_connector(const std::string& connector) {
+    domicile_connector_ = connector;
+  }
 
   // Clones display state.
   std::unique_ptr<DisplaySnapshot> Clone() const;
@@ -282,6 +290,9 @@ class DISPLAY_TYPES_EXPORT DisplaySnapshot {
   // A list of supported Linux DRM formats and corresponding lists of modifiers
   // for each one.
   const DrmFormatsAndModifiers drm_formats_and_modifiers_;
+
+  // DOMICILE: see `domicile_connector()`.
+  std::string domicile_connector_;
 };
 
 }  // namespace display
