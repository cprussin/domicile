diff --git a/content/browser/renderer_host/render_widget_host_impl.cc b/content/browser/renderer_host/render_widget_host_impl.cc
index f863df8..a96148d 100644
--- a/content/browser/renderer_host/render_widget_host_impl.cc
+++ b/content/browser/renderer_host/render_widget_host_impl.cc
@@ -3226,6 +3226,10 @@ void RenderWidgetHostImpl::OnInputEventPreDispatch(
     return;
   }
 
+  if (dispatch_keeps_focus_) {
+    return;
+  }
+
   if (event.GetType() == WebInputEvent::Type::kMouseDown ||
       event.GetType() == WebInputEvent::Type::kTouchStart ||
       event.GetType() == WebInputEvent::Type::kGestureTap) {
diff --git a/content/browser/renderer_host/render_widget_host_impl.h b/content/browser/renderer_host/render_widget_host_impl.h
index 71bba03..41f694e 100644
--- a/content/browser/renderer_host/render_widget_host_impl.h
+++ b/content/browser/renderer_host/render_widget_host_impl.h
@@ -578,6 +578,12 @@ class CONTENT_EXPORT RenderWidgetHostImpl
   // Focus()/Blur().
   void SetPageFocus(bool focused);
 
+  // domicile: while set, a press this widget dispatches leaves the focused
+  // WebContents where it is, rather than focusing this widget's. An agent's
+  // DevTools input into a browser window sets it, so the agent never moves the
+  // user's focus. See OnInputEventPreDispatch.
+  void set_dispatch_keeps_focus(bool keeps) { dispatch_keeps_focus_ = keeps; }
+
   // Returns true if the RenderWidgetHost thinks it is active. This
   // is different than `is_focused` but must always be true if `is_focused`
   // is true. All RenderWidgetHosts in an active tab are considered active,
@@ -1731,6 +1737,9 @@ class CONTENT_EXPORT RenderWidgetHostImpl
   // causing HasFocus to return false when is_focused_ is true.
   bool is_focused_ = false;
 
+  // domicile: see set_dispatch_keeps_focus().
+  bool dispatch_keeps_focus_ = false;
+
   bool focus_emulation_enabled_ = false;
 
   // Indicates whether what the last focus active state that was sent to the
