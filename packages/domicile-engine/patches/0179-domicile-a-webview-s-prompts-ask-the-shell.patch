+namespace {
+ExtensionInstallPrompt::ShowDialogCallback& GetDomicileShowDialogOverride() {
+  static base::NoDestructor<ExtensionInstallPrompt::ShowDialogCallback> show;
+  return *show;
+}
+}  // namespace
+
+// static
+void ExtensionInstallPrompt::SetDefaultShowDialogOverride(
+    ShowDialogCallback show) {
+  GetDomicileShowDialogOverride() = std::move(show);
+}
