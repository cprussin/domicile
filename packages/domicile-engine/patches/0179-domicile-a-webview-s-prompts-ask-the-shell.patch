diff --git a/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h b/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
index 7d3717f..91a4271 100644
--- a/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
+++ b/chrome/browser/file_system_access/chrome_file_system_access_permission_context.h
@@ -74,6 +74,35 @@ class ChromeFileSystemAccessPermissionContext
 #endif
 {
  public:
+  // Domicile: asks in place of Chrome's file access prompt and dialogs, which
+  // are drawn on the outermost WebContents' window. Set once, before any is
+  // asked. See //chrome/browser/domicile/domicile_prompts.h.
+  struct DomicilePrompts {
+    // A page with no FileSystemAccessPermissionRequestManager (a <webview>
+    // guest) asks for read or write access to `path`.
+    void (*ask_access)(
+        content::WebContents* web_contents,
+        const url::Origin& origin,
+        const base::FilePath& path,
+        HandleType handle_type,
+        bool write,
+        base::OnceCallback<void(permissions::PermissionAction)> callback) = nullptr;
+    // The page picked a folder it may not open.
+    void (*ask_restricted)(
+        content::WebContents* web_contents,
+        const url::Origin& origin,
+        HandleType handle_type,
+        base::OnceCallback<void(SensitiveEntryResult)> callback) = nullptr;
+    // The page would save a file Safe Browsing calls dangerous.
+    void (*ask_dangerous)(
+        content::WebContents* web_contents,
+        const url::Origin& origin,
+        const base::FilePath& path,
+        base::OnceCallback<void(SensitiveEntryResult)> callback) = nullptr;
+  };
+  static void SetDomicilePrompts(const DomicilePrompts& prompts);
+  static const DomicilePrompts& GetDomicilePrompts();
+
   using FileCreatedFromShowSaveFilePickerCallbackList =
       base::RepeatingCallbackList<void(const GURL&,
                                        const storage::FileSystemURL&)>;
