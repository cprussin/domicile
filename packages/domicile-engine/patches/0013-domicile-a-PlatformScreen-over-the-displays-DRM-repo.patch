   # `ui/display/manager/test/fake_display_snapshot.h` is the one thing this
diff --git a/ui/ozone/platform/drm/host/drm_window_host_manager.cc b/ui/ozone/platform/drm/host/drm_window_host_manager.cc
index c2b53e7a..24f44e1c 100644
--- a/ui/ozone/platform/drm/host/drm_window_host_manager.cc
+++ b/ui/ozone/platform/drm/host/drm_window_host_manager.cc
@@ -51,6 +51,10 @@ DrmWindowHost* DrmWindowHostManager::GetWindow(gfx::AcceleratedWidget widget) {
   NOTREACHED() << "Attempting to get non-existing window " << widget;
 }
 
+bool DrmWindowHostManager::HasWindow(gfx::AcceleratedWidget widget) const {
+  return window_map_.find(widget) != window_map_.end();
+}
+
 DrmWindowHost* DrmWindowHostManager::GetWindowAt(const gfx::Point& location) {
   for (auto it = window_map_.begin(); it != window_map_.end(); ++it)
     if (it->second->GetBoundsInPixels().Contains(location))
diff --git a/ui/ozone/platform/drm/host/drm_window_host_manager.h b/ui/ozone/platform/drm/host/drm_window_host_manager.h
index ca23c512..32c035ba 100644
--- a/ui/ozone/platform/drm/host/drm_window_host_manager.h
+++ b/ui/ozone/platform/drm/host/drm_window_host_manager.h
@@ -44,6 +44,14 @@ class DrmWindowHostManager {
   // only be called if a valid window has been associated.
   DrmWindowHost* GetWindow(gfx::AcceleratedWidget widget);
 
+  // Domicile's engine fork: whether |widget| has a window, asked without
+  // consequence. GetWindow() above is NOTREACHED() on a widget it does not
+  // hold -- every other ozone platform's manager returns null instead -- and
+  // PlatformScreen::GetDisplayForAcceleratedWidget is handed widgets it does
+  // not own. Asking first is what keeps that a lookup rather than a crash in
+  // the browser process. See ui/ozone/platform/drm/domicile/drm_screen.cc.
+  bool HasWindow(gfx::AcceleratedWidget widget) const;
+
   // Returns the window containing the specified screen location, or NULL.
   DrmWindowHost* GetWindowAt(const gfx::Point& location);
 
diff --git a/ui/ozone/platform/drm/ozone_platform_drm.cc b/ui/ozone/platform/drm/ozone_platform_drm.cc
index fb0426dc..662ee090 100644
--- a/ui/ozone/platform/drm/ozone_platform_drm.cc
+++ b/ui/ozone/platform/drm/ozone_platform_drm.cc
@@ -46,6 +46,7 @@
 #include "ui/ozone/platform/drm/host/drm_display_host_manager.h"
 #include "ui/ozone/platform/drm/host/drm_native_display_delegate.h"
 #include "ui/ozone/platform/drm/host/drm_window_host.h"
+#include "ui/ozone/platform/drm/domicile/drm_screen.h"
 #include "ui/ozone/platform/drm/host/drm_window_host_manager.h"
 #include "ui/ozone/platform/drm/host/host_drm_device.h"
 #include "ui/ozone/platform/drm/mojom/drm_device.mojom.h"
@@ -91,8 +92,20 @@ class OzonePlatformDrm : public OzonePlatform {
     return event_factory_ozone_->input_controller();
   }
 
-  std::unique_ptr<PlatformScreen> CreateScreen() override { NOTREACHED(); }
-  void InitScreen(PlatformScreen* screen) override { NOTREACHED(); }
+  // Domicile's engine fork. On ChromeOS ash installs display::Screen itself
+  // and never asks; a views browser on Linux goes DesktopScreenOzone ->
+  // ScreenOzone -> CreateScreen() and hit the NOTREACHED() that was here.
+  // See docs/architecture/A-DESKTOP-ON-A-TTY.md in the Domicile repository.
+  std::unique_ptr<PlatformScreen> CreateScreen() override {
+    return std::make_unique<DrmScreen>(window_manager_.get());
+  }
+  void InitScreen(PlatformScreen* screen) override {
+    // The display list arrives from DrmNativeDisplayDelegate, which the
+    // modeset driver owns; until it has run there are no snapshots, and
+    // DrmScreen answers with the displayless fallback its header describes
+    // rather than with nothing.
+    static_cast<DrmScreen*>(screen)->OnDisplaysChanged({});
+  }
 
   GpuPlatformSupportHost* GetGpuPlatformSupportHost() override {
     return drm_device_connector_.get();
