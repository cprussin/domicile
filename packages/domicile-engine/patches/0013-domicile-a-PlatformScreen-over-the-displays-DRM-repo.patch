 ui/ozone/platform/drm/BUILD.gn                  |  3 +++
 .../drm/host/drm_window_host_manager.cc         |  4 ++++
 .../platform/drm/host/drm_window_host_manager.h |  8 ++++++++
 ui/ozone/platform/drm/ozone_platform_drm.cc     | 17 +++++++++++++++--
 4 files changed, 30 insertions(+), 2 deletions(-)

