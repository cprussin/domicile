+// DOMICILE: the constructor's color setup, as a method, so a modeset can drive
+// a connector in HDR10 after the display is made. See DomicileSetHdr.
+void DrmDisplay::DomicileDriveColor(bool hdr10) {
+  domicile_hdr_ = hdr10;
+  SkColorSpacePrimaries output_primaries = domicile_edid_primaries_;
+  if (hdr10) {
+    output_primaries = SkNamedPrimaries::kRec2020;
+    SetColorspaceProperty(kColorSpaceBT2020RGBEnumName);
+    SetHdrOutputMetadata(gfx::ColorSpace::CreateHDR10());
+  } else {
+    // The interpretation of kColorSpaceDefaultEnumName is left up to the
+    // driver. For some devices, this is assumed to be Rec709. For others,
+    // (especially wide color gamut devices), this is assumed to be P3.
+    // TODO(https://crbug.com/471224089): Remove this feature flag, and
+    // more robustly signal colorimetry.
+    // `display::features::kDrmColorSpaceDefaultIsRec709` is declared inside a
+    // `#if BUILDFLAG(IS_CHROMEOS)` in ui/display/display_features.h, so off
+    // ChromeOS there is no flag to consult and the honest answer is the one a
+    // disabled flag gives: leave the interpretation of
+    // kColorSpaceDefaultEnumName to the driver, as the comment above says.
+#if BUILDFLAG(IS_CHROMEOS)
+    if (base::FeatureList::IsEnabled(
+            display::features::kDrmColorSpaceDefaultIsRec709)) {
+      output_primaries = SkNamedPrimaries::kRec709;
+    }
+#endif
+    SetColorspaceProperty(kColorSpaceDefaultEnumName);
+    ClearHdrOutputMetadata();
+  }
+  for (const auto& crtc_connector_pair : crtc_connector_pairs_) {
+    drm_->plane_manager()->SetOutputColorSpace(crtc_connector_pair.crtc_id,
+                                               output_primaries);
+  }
+}
+
+bool DrmDisplay::DomicileSetHdr(bool hdr) {
+  // SetHdrOutputMetadata CHECKs both; the browser asks only where the EDID
+  // says the panel takes PQ, so this is the guard against a stale ask.
+  const bool takes_pq =
+      hdr_static_metadata_.has_value() &&
+      hdr_static_metadata_->IsEotfSupported(
+          gfx::HDRStaticMetadata::Eotf::kPq);
+  if (hdr && !takes_pq) {
+    LOG(ERROR) << "domicile: display " << display_id_
+               << " was asked for HDR, but its EDID takes no PQ";
+    return false;
+  }
+  // Every modeset asks, and most change nothing: leave the connector be.
+  if (hdr != domicile_hdr_) {
+    DomicileDriveColor(hdr);
+  }
+  return true;
+}
