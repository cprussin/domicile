From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 00:00:00 +0000
Subject: [PATCH] domicile: modifiers wait for a keymap

A Wayland host may send wl_keyboard.modifiers before wl_keyboard.keymap.
sway does so to a new client when the seat's last keyboard has gone.

Upstream XkbKeyboardLayoutEngine::UpdateModifiers now returns early while
there is no xkb state, so the fork carries only the test.

WaylandKeyboardWithoutKeymapTest sends modifiers before a keymap, then
a keymap and a key, and checks the key carries no modifiers.
---
 .../wayland/host/wayland_keyboard_unittest.cc | 53 +++++++++++++++++++
 1 file changed, 53 insertions(+)

diff --git a/ui/ozone/platform/wayland/host/wayland_keyboard_unittest.cc b/ui/ozone/platform/wayland/host/wayland_keyboard_unittest.cc
index babf740..3a0c884 100644
--- a/ui/ozone/platform/wayland/host/wayland_keyboard_unittest.cc
+++ b/ui/ozone/platform/wayland/host/wayland_keyboard_unittest.cc
@@ -225,6 +225,59 @@ TEST_F(WaylandKeyboardTest, CapsLockModifier) {
   EXPECT_EQ(ui::VKEY_A, key_event->key_code());
   EXPECT_EQ(EventType::kKeyPressed, key_event->type());
 }
+
+// A seat with a keyboard whose host has sent no keymap yet. sway sends
+// modifiers to a new client before any keymap when the seat's last keyboard
+// has gone.
+class WaylandKeyboardWithoutKeymapTest : public WaylandTestSimple {
+ public:
+  void SetUp() override {
+    WaylandTestSimple::SetUp();
+
+    PostToServerAndWait([](wl::TestWaylandServerThread* server) {
+      wl_seat_send_capabilities(server->seat()->resource(),
+                                WL_SEAT_CAPABILITY_KEYBOARD);
+    });
+    ASSERT_TRUE(connection_->seat()->keyboard());
+  }
+};
+
+TEST_F(WaylandKeyboardWithoutKeymapTest, IgnoresModifiersBeforeAKeymap) {
+  PostToServerAndWait([](wl::TestWaylandServerThread* server) {
+    wl_keyboard_send_modifiers(server->seat()->keyboard()->resource(),
+                               server->GetNextSerial(),
+                               4 /* mods_depressed */, 0 /* mods_latched */,
+                               0 /* mods_locked */, 0 /* group */);
+  });
+
+  MaybeSetUpXkb();
+
+  std::unique_ptr<Event> event;
+  EXPECT_CALL(delegate_, DispatchEvent(_)).WillOnce(CloneEvent(&event));
+
+  PostToServerAndWait([surface_id = window_->root_surface()->get_surface_id()](
+                          wl::TestWaylandServerThread* server) {
+    auto* const keyboard = server->seat()->keyboard()->resource();
+    auto* const surface =
+        server->GetObject<wl::MockSurface>(surface_id)->resource();
+
+    wl::ScopedWlArray empty({});
+    wl_keyboard_send_enter(keyboard, server->GetNextSerial(), surface,
+                           empty.get());
+    wl_keyboard_send_repeat_info(keyboard, 0, 0);
+
+    wl_keyboard_send_key(keyboard, server->GetNextSerial(),
+                         server->GetNextTime(), 30 /* a */,
+                         WL_KEYBOARD_KEY_STATE_PRESSED);
+  });
+
+  ASSERT_TRUE(event);
+  ASSERT_TRUE(event->IsKeyEvent());
+
+  auto* key_event = event->AsKeyEvent();
+  EXPECT_EQ(ui::EF_NONE, key_event->flags());
+  EXPECT_EQ(ui::VKEY_A, key_event->key_code());
+}
 #endif
 
 TEST_F(WaylandKeyboardTest, EventAutoRepeat) {
