--- a/third_party/blink/renderer/core/html/build.gni
+++ b/third_party/blink/renderer/core/html/build.gni
@@ -98,6 +98,8 @@ blink_core_sources_html = [
   "domicile/domicile_file_chooser_event.h",
   "domicile/domicile_context_menu_event.cc",
