From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Tue, 6 Oct 2026 12:30:00 +0000
Subject: [PATCH] domicile: a monitor's tile out of memory falls back to the
 page's

Over its tile budget, TileManager marks the required tiles it could not
raster out of memory, so activation and draw go ahead without them. An
out-of-memory tile counts as ready to draw, and draws as a solid color.
A monitor's tiling is required for activation (0079), and 0072 draws the
monitor's part of a layer from it, so a resize or a layer crossing onto
a monitor flashes that monitor solid where the page's own tile was ready.

- TilingSetCoverageIterator passes over a ready tile its tiling does not
  draw, for the next tiling to cover.
- A monitor's tiling does not draw a tile out of memory
  (DomicileDrawsTile), so the page's tile is drawn there, shrunk.
- The marking itself stays: it is what lets activation go ahead, and the
  tile is still rastered once memory frees up.

See cc/domicile/display_regions.h; the series is read for this by
scripts/test-the-desk-does-not-flash-between-densities.sh.
---
 cc/tiles/picture_layer_tiling.h         |  7 +++++++
 cc/tiles/tiling_set_coverage_iterator.h | 15 ++++++++++++++-
 2 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/cc/tiles/picture_layer_tiling.h b/cc/tiles/picture_layer_tiling.h
index 7e78f66e5e..d27e7cd2ba 100644
--- a/cc/tiles/picture_layer_tiling.h
+++ b/cc/tiles/picture_layer_tiling.h
@@ -21,6 +21,7 @@
 #include "cc/base/region.h"
 #include "cc/base/tiling_data.h"
 #include "cc/cc_export.h"
+#include "cc/domicile/display_regions.h"
 #include "cc/paint/paint_worklet_input.h"
 #include "cc/paint/scroll_offset_map.h"
 #include "cc/raster/raster_source.h"
@@ -135,6 +136,12 @@ class CC_EXPORT PictureLayerTiling {
     domicile_clip_in_layer_space_ = clip_in_layer_space;
   }
   float domicile_display_ratio() const { return domicile_display_ratio_; }
+  // DOMICILE: whether `tile`, ready, is drawn, or passed over for the next
+  // tiling to cover. A monitor's tile out of memory is passed over, so the
+  // page's tile is drawn there instead of a solid color.
+  bool DomicileDrawsTile(const Tile& tile) const {
+    return cc::DomicileDrawsTile(domicile_display_ratio_, tile.IsOOM());
+  }
   void set_can_require_tiles_for_activation(bool can_require_tiles) {
     can_require_tiles_for_activation_ = can_require_tiles;
   }
diff --git a/cc/tiles/tiling_set_coverage_iterator.h b/cc/tiles/tiling_set_coverage_iterator.h
index 3ff2be1a35..a0e95ca73a 100644
--- a/cc/tiles/tiling_set_coverage_iterator.h
+++ b/cc/tiles/tiling_set_coverage_iterator.h
@@ -130,6 +130,19 @@ class TilingSetCoverageIterator {
 
  private:
   using TilingIterator = typename Container::const_iterator;
+
+  // DOMICILE: whether the current tiling draws `tile`, ready, or passes it
+  // over for the next tiling to cover. See cc/domicile/display_regions.h.
+  bool DomicileDrawsTile(const Tile* tile) const {
+    if constexpr (requires(const T& tiling, const Tile& t) {
+                    tiling.DomicileDrawsTile(t);
+                  }) {
+      return (***current_tiling_).DomicileDrawsTile(*tile);
+    } else {
+      return true;
+    }
+  }
+
   static TilingIterator FindIdealTiling(const Container& tilings,
                                         float ideal_contents_scale) {
     if (tilings.empty()) {
@@ -180,7 +193,7 @@ class TilingSetCoverageIterator {
       absl::InlinedVector<SkIRect, 64> missing_batch;
       for (; tiling_iter_.IsValid(); ++tiling_iter_) {
         Tile* const tile = (**current_tiling_)->TileAt(tiling_iter_.index());
-        if (tile && tile->IsReadyToDraw()) {
+        if (tile && tile->IsReadyToDraw() && DomicileDrawsTile(tile)) {
           missing_region_.Union(missing_batch);
           return;
         }
