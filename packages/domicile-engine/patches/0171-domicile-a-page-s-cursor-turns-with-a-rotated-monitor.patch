 .../renderer_host/render_widget_host_view_aura.h |  3 +++
 content/common/BUILD.gn                          |  5 ++++-
 content/common/cursors/webcursor_aura.cc         | 16 +++++++++++++++-
 ui/base/cursor/cursor_factory.cc                 |  4 ++++
 ui/base/cursor/cursor_factory.h                  |  6 ++++++
 6 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/content/browser/renderer_host/render_widget_host_view_aura.cc b/content/browser/renderer_host/render_widget_host_view_aura.cc
index 1a9419f..48d4cce 100644
--- a/content/browser/renderer_host/render_widget_host_view_aura.cc
+++ b/content/browser/renderer_host/render_widget_host_view_aura.cc
@@ -2972,6 +2972,17 @@ void RenderWidgetHostViewAura::OnSystemCursorSizeChanged(
   UpdateSystemCursorSize(system_cursor_size);
 }
 
+void RenderWidgetHostViewAura::OnCursorDisplayChanged(
+    const display::Display& display) {
+  // DOMICILE: the pointer crossed onto another monitor. A page's cursor image
+  // is turned for that monitor's panel (WebCursor::UpdateDisplayInfoForWindow).
+  if (current_cursor_.cursor().type() != ui::mojom::CursorType::kCustom) {
+    return;
+  }
+  current_cursor_.UpdateDisplayInfoForWindow(window_);
+  UpdateCursorIfOverSelf();
+}
