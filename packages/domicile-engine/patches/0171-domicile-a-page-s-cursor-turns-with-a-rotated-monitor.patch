+++ b/ui/base/cursor/cursor_factory.cc
@@ -77,6 +77,10 @@ scoped_refptr<PlatformCursor> CursorFactory::GetTurnedDefaultCursor(
   return GetDefaultCursor(type, scale);
 }
 
+bool CursorFactory::ShowsCursorsUnturned() const {
+  return false;
+}
