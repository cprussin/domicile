diff --git a/content/common/cursors/webcursor_aura.cc b/content/common/cursors/webcursor_aura.cc
index 74957e2..e63189f 100644
--- a/content/common/cursors/webcursor_aura.cc
+++ b/content/common/cursors/webcursor_aura.cc
@@ -5,6 +5,8 @@
 #include "base/check_op.h"
 #include "build/build_config.h"
 #include "content/common/cursors/webcursor.h"
+#include "ui/aura/client/cursor_client.h"
+#include "ui/aura/window.h"
 #include "ui/base/cursor/cursor.h"
 #include "ui/base/cursor/cursor_factory.h"
 #include "ui/base/cursor/mojom/cursor_type.mojom-shared.h"
@@ -47,11 +49,23 @@ void WebCursor::UpdateDisplayInfoForWindow(aura::Window* window) {
   float preferred_scale =
       display::Screen::Get()->GetPreferredScaleFactorForWindow(window).value_or(
           1.0f);
-  if (device_scale_factor_ == preferred_scale) {
+  // DOMICILE: on a tty nothing turns a page's cursor image for a rotated
+  // panel. Turn it as wm::CursorLoader turns the themed cursors: by the
+  // display of the cursor client, which follows the pointer across monitors.
+  display::Display::Rotation rotation = display::Display::ROTATE_0;
+  aura::Window* root = window ? window->GetRootWindow() : nullptr;
+  aura::client::CursorClient* cursor_client =
+      root ? aura::client::GetCursorClient(root) : nullptr;
+  if (cursor_client &&
+      ui::CursorFactory::GetInstance()->ShowsCursorsUnturned()) {
+    rotation = cursor_client->GetDisplay().panel_rotation();
+  }
+  if (device_scale_factor_ == preferred_scale && rotation_ == rotation) {
     return;
   }
 
   device_scale_factor_ = preferred_scale;
+  rotation_ = rotation;
   custom_cursor_.reset();
 }
 
diff --git a/ui/base/cursor/cursor_factory.cc b/ui/base/cursor/cursor_factory.cc
index 391c1ac..c3edf3b 100644
