@@ -396,6 +396,9 @@ class CONTENT_EXPORT RenderWidgetHostViewAura
   // Overridden from aura::client::CursorClientObserver:
   void OnSystemCursorSizeChanged(const gfx::Size& cursor_size) override;
 
+  // Overridden from aura::client::CursorClientObserver:
+  void OnCursorDisplayChanged(const display::Display& display) override;
