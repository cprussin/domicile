diff --git a/third_party/blink/renderer/core/layout/layout_view.cc b/third_party/blink/renderer/core/layout/layout_view.cc
index eedb085667..a39164121e 100644
--- a/third_party/blink/renderer/core/layout/layout_view.cc
+++ b/third_party/blink/renderer/core/layout/layout_view.cc
@@ -246,6 +246,20 @@ LayoutUnit LayoutView::ComputeMinimumWidth() {
       .sizes.min_size;
 }
 
+LayoutUnit LayoutView::ComputeMaximumWidth() {
+  NOT_DESTROYED();
+  const ComputedStyle& style = StyleRef();
+  WritingMode mode = style.GetWritingMode();
+  ConstraintSpaceBuilder builder(mode, style.GetWritingDirection(),
+                                 /* is_new_fc */ true);
+  builder.SetContainsAnnotations(contains_annotations_);
+  return BlockNode(this)
+      .ComputeMinMaxSizes(mode, SizeType::kIntrinsic,
+                          builder.ToConstraintSpace(),
+                          MinMaxSizesInput::Unconstrained())
+      .sizes.max_size;
+}
