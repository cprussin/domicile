+// Domicile: whether a shader effect in `a` has other arrays than the same
+// effect at the same place in `b`.
+bool DomicileShaderArraysChanged(const CompositorFilterOperations& a,
+                                 const CompositorFilterOperations& b) {
+  const cc::FilterOperations& before = a.AsCcFilterOperations();
+  const cc::FilterOperations& after = b.AsCcFilterOperations();
+  for (size_t i = 0; i < before.size() && i < after.size(); ++i) {
+    const cc::FilterOperation& was = before.at(i);
+    const cc::FilterOperation& is = after.at(i);
+    if (was.type() == cc::FilterOperation::SHADER &&
+        is.type() == cc::FilterOperation::SHADER &&
+        was.shader_effect() == is.shader_effect() &&
+        was.shader_arrays() != is.shader_arrays()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Domicile: the change to filters `a` to `b` while the compositor animates
+// them. Their values are the animation's, but a shader effect's arrays are
+// the page's: the compositor keeps the arrays the page last committed
+// (cc::EffectTree::OnFilterAnimated). A composited value schedules no
+// PaintArtifactCompositor update, so new arrays are a simple value, which
+// PaintPropertyTreeBuilder writes to the cc effect node directly.
+PaintPropertyChangeType ComputeAnimatedFilterChange(
+    const CompositorFilterOperations& a,
+    const CompositorFilterOperations& b) {
+  return DomicileShaderArraysChanged(a, b)
+             ? PaintPropertyChangeType::kChangedOnlySimpleValues
+             : PaintPropertyChangeType::kChangedOnlyCompositedValues;
+}
