+// Domicile: writes the arrays of the shader effects in `effect`'s filters to
+// its cc effect node, when they changed while the compositor animates the
+// filters (see EffectPaintPropertyNode's ComputeAnimatedFilterChange). A
+// running animation keeps them (cc::EffectTree::OnFilterAnimated). Downgrades
+// the change if successful, unless `opacity_may_have_changed`, which leaves it
+// for DirectlyUpdateCcOpacity(). If unsuccessful, the change is a full
+// PaintArtifactCompositor update.
+static void DirectlyUpdateCcShaderArrays(const LayoutObject& object,
+                                         const EffectPaintPropertyNode& effect,
+                                         bool filter_animation_on_compositor,
+                                         bool opacity_may_have_changed,
+                                         PaintPropertyChangeType& change_type) {
+  if (change_type != PaintPropertyChangeType::kChangedOnlySimpleValues ||
+      !filter_animation_on_compositor) {
+    return;
+  }
+  auto* paint_artifact_compositor =
+      object.GetFrameView()->GetPaintArtifactCompositor();
+  if (!paint_artifact_compositor ||
+      !paint_artifact_compositor->DirectlyUpdateShaderArrays(effect)) {
+    change_type = PaintPropertyChangeType::kChangedOnlyValues;
+    return;
+  }
+  if (!opacity_may_have_changed) {
+    change_type = PaintPropertyChangeType::kChangedOnlyCompositedValues;
+    effect.CompositorSimpleValuesUpdated();
+  }
+}
