+bool PropertyTreeManager::DirectlyUpdateShaderArrays(
+    cc::LayerTreeHost& host,
+    const EffectPaintPropertyNode& effect) {
+  auto* property_trees = host.property_trees();
+  int cc_id = effect.CcNodeId(property_trees->sequence_number());
+  if (cc_id == cc::kInvalidPropertyNodeId) {
+    return false;
+  }
+
+  auto& cc_effect = property_trees->effect_tree_mutable().MutableNode(cc_id);
+  if (const auto* filter = effect.Filter()) {
+    cc_effect.filters =
+        cc_effect.filters.WithShaderArraysOf(filter->AsCcFilterOperations());
+  }
+  if (const auto* backdrop_filter = effect.BackdropFilter()) {
+    cc_effect.backdrop_filters = cc_effect.backdrop_filters.WithShaderArraysOf(
+        backdrop_filter->AsCcFilterOperations());
+  }
+  cc_effect.SetEffectChanged(cc::DamageReason::kUntracked);
+  property_trees->effect_tree_mutable().set_needs_update(true);
+  host.SetNeedsCommit();
+  return true;
+}
