+// `struct drm_file`, so master dropped through this is dropped for the GPU's
+// copy too, while a fresh `open` would be a different file and not master at
+// all. See `DrmMaster`.
+base::ScopedFD DupForMaster(const base::ScopedFD& fd) {
+  return base::ScopedFD(HANDLE_EINTR(dup(fd.get())));
+}
+
 struct DisplayCard {
   base::FilePath path;
   std::optional<std::string> driver;
@@ -394,6 +403,18 @@ void DrmDisplayHostManager::TakeDisplayControl(
   take_display_control_callback_ = std::move(callback);
   display_control_change_pending_ = true;
 
+  // OUR SET FIRST, AND THE GPU IS NOT ASKED IF IT FAILS. `drmSetMaster` is
+  // only legal in the process that opened the card, so it happens here or
+  // nowhere; and a GPU process told it has the display back while the kernel
+  // says otherwise goes on submitting flips that cannot land, which arms
+  // `PageFlipWatchdog` and kills it fifteen seconds later. Reporting the
+  // failure is what keeps `DrmVtSwitcher` in the one state that leaves a way
+  // off the console.
+  if (!drm_master_.Take()) {
+    GpuTookDisplayControl(false);
+    return;
+  }
+
   if (!proxy_->GpuTakeDisplayControl())
     GpuTookDisplayControl(false);
 }
