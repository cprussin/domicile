+#if defined(USE_LIBINPUT)
+using LibInputKeyboardPathTest = EventConverterEvdevImplTest;
+
+TEST_F(LibInputKeyboardPathTest, NativeMicMuteUsesItsKeycodeWithoutAScanCode) {
+  const auto key =
+      ui::LibInputKeyboardKey(KEY_MICMUTE, true, base::TimeTicks());
+  device()->ProcessEvents(&key, 1);
+  ASSERT_EQ(size(), 1u);
+  EXPECT_EQ(dispatched_event(0)->type(), ui::EventType::kKeyPressed);
+  EXPECT_EQ(dispatched_event(0)->key_code(), ui::VKEY_MICROPHONE_MUTE_TOGGLE);
+  EXPECT_EQ(dispatched_event(0)->scan_code(), 0u);
+  device()->SetEnabled(false);
+  ASSERT_EQ(size(), 2u);
+  EXPECT_EQ(dispatched_event(1)->type(), ui::EventType::kKeyReleased);
+  EXPECT_EQ(dispatched_event(1)->key_code(), ui::VKEY_MICROPHONE_MUTE_TOGGLE);
+}
+
+TEST_F(LibInputKeyboardPathTest, NativeKeysKeepFiltersTimeAndReleaseState) {
+  SetTestNowSeconds(2);
+  const auto timestamp = base::TimeTicks() + base::Microseconds(1234567);
+  device()->SetKeyFilter(true, {ui::DomCode::BACKSPACE});
+  for (const auto& input :
+       {ui::LibInputKeyboardKey(KEY_A, true, timestamp),
+        ui::LibInputKeyboardKey(KEY_BACKSPACE, true, timestamp),
+        ui::LibInputKeyboardKey(KEY_BACKSPACE, true, timestamp)}) {
+    device()->ProcessEvents(&input, 1);
+  }
+  ASSERT_EQ(size(), 1u);
+  EXPECT_EQ(dispatched_event(0)->type(), ui::EventType::kKeyPressed);
+  EXPECT_EQ(dispatched_event(0)->key_code(), ui::VKEY_BACK);
+  EXPECT_EQ(dispatched_event(0)->time_stamp(), timestamp);
+  EXPECT_EQ(dispatched_event(0)->scan_code(), 0u);
+
+  device()->SetKeyFilter(false, {});
+  device()->SetBlockModifiers(true);
+  const auto modifier = ui::LibInputKeyboardKey(KEY_LEFTSHIFT, true, timestamp);
+  device()->ProcessEvents(&modifier, 1);
+  EXPECT_EQ(size(), 1u);
+
+  device()->SetEnabled(false);
+  ASSERT_EQ(size(), 2u);
+  EXPECT_EQ(dispatched_event(1)->type(), ui::EventType::kKeyReleased);
+  EXPECT_EQ(dispatched_event(1)->key_code(), ui::VKEY_BACK);
+  device()->SetEnabled(false);
+  EXPECT_EQ(size(), 2u);
+}
+#endif
