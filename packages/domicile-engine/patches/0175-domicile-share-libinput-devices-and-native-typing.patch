+class DeferredInputDeviceOpenerEvdev : public InputDeviceOpenerEvdev {
+ public:
+  void Complete(size_t index, base::ScopedFD fd) {
+    std::move(opened_[index]).Run(std::move(fd));
+  }
+
+ protected:
+  void OpenDeviceFd(const OpenInputDeviceParams&,
+                    OpenedDeviceFd opened) override {
+    opened_.push_back(std::move(opened));
+  }
+
+ private:
+  std::vector<OpenedDeviceFd> opened_;
+};
+
+class ReopeningInputDeviceOpenerEvdev : public InputDeviceOpener {
+ public:
+  void OpenInputDevice(const OpenInputDeviceParams&,
+                       OpenInputDeviceCallback opened) override {
+    ++open_count_;
+    std::move(opened).Run(nullptr);
+  }
+  void Reopen(int id, const base::FilePath& path) {
+    reopen_device().Run(id, path);
+  }
+  unsigned open_count() const { return open_count_; }
+
+ private:
+  unsigned open_count_ = 0;
+};
