 }
@@ -137,7 +143,24 @@ InputDeviceFactoryEvdev::~InputDeviceFactoryEvdev() = default;
 
 void InputDeviceFactoryEvdev::AddInputDevice(int id,
                                              const base::FilePath& path) {
+  DetachInputDevice(path);
+  const auto request = base::UnguessableToken::Create();
+  open_requests_.insert_or_assign(path, request);
   OpenInputDeviceParams params;
+  params.is_current = base::BindRepeating(
+      [](base::WeakPtr<InputDeviceFactoryEvdev> factory,
+         const base::FilePath& path, base::UnguessableToken request) {
+        if (factory) {
+          const auto current = factory->open_requests_.find(path);
+          return current != factory->open_requests_.end() &&
+                 current->second == request;
+        }
+        return false;
+      },
+      weak_ptr_factory_.GetWeakPtr(), path, request);
+#if defined(USE_LIBINPUT)
+  params.libinput_seat = libinput_seat_.get();
+#endif
   params.id = id;
   params.path = path;
   params.cursor = cursor_;
@@ -150,15 +173,15 @@ void InputDeviceFactoryEvdev::AddInputDevice(int id,
 
   ++pending_device_changes_;
 
-  // DOMICILE: the opener may answer later, so the attach is its answer.
-  // Posted either way, as it always was.
+  // The opener answers on this sequence. Attach before another open can
+  // register the same path with the shared libinput seat.
   input_device_opener_->OpenInputDevice(
-      params, base::BindPostTaskToCurrentDefault(
-                  base::BindOnce(&InputDeviceFactoryEvdev::AttachInputDevice,
-                                 weak_ptr_factory_.GetWeakPtr())));
+      params, base::BindOnce(&InputDeviceFactoryEvdev::AttachInputDevice,
+                             weak_ptr_factory_.GetWeakPtr()));
 }
 
 void InputDeviceFactoryEvdev::RemoveInputDevice(const base::FilePath& path) {
+  open_requests_.erase(path);
   DetachInputDevice(path);
 }
 
