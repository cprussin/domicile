 class InputDeviceFactoryEvdevTest : public testing::Test {
  public:
   InputDeviceFactoryEvdevTest() = default;
@@ -272,6 +308,76 @@ class InputDeviceFactoryEvdevTest : public testing::Test {
   base::RunLoop fetch_run_loop_;
 };
 
+using InputDeviceOpenCancellationTest = InputDeviceFactoryEvdevTest;
+
+TEST_F(InputDeviceOpenCancellationTest,
+       RemovedDevicesCancelBeforeInspectingTheDescriptor) {
+  auto opener = std::make_unique<DeferredInputDeviceOpenerEvdev>();
+  auto* pending = opener.get();
+  auto* dispatcher =
+      static_cast<StubDeviceEventDispatcherEvdev*>(dispatcher_.get());
+  InputDeviceFactoryEvdev factory(std::move(dispatcher_), nullptr,
+                                  std::move(opener), &input_controller_);
+  const base::FilePath path("/dev/input/canceled-keyboard");
+  factory.AddInputDevice(1, path);
+  factory.OnStartupScanComplete();
+  factory.RemoveInputDevice(path);
+
+  base::ScopedFD read_fd, write_fd;
+  ASSERT_TRUE(base::CreatePipe(&read_fd, &write_fd));
+  base::test::MockLog log;
+  EXPECT_CALL(log, Log(logging::LOGGING_ERROR, testing::_, testing::_,
+                       testing::_, testing::_))
+      .Times(0);
+  log.StartCapturingLogs();
+  pending->Complete(0, std::move(read_fd));
+  task_environment.RunUntilIdle();
+  log.StopCapturingLogs();
+  EXPECT_EQ(dispatcher->complete_count(), 1u);
+  EXPECT_TRUE(keyboards_.empty());
+}
+
+TEST_F(InputDeviceOpenCancellationTest, RemovedDevicesIgnoreALateReopen) {
+  auto opener = std::make_unique<ReopeningInputDeviceOpenerEvdev>();
+  auto* reopening = opener.get();
+  InputDeviceFactoryEvdev factory(std::move(dispatcher_), nullptr,
+                                  std::move(opener), &input_controller_);
+  const base::FilePath path("/dev/input/removed-keyboard");
+  factory.AddInputDevice(1, path);
+  factory.RemoveInputDevice(path);
+  reopening->Reopen(1, path);
+  task_environment.RunUntilIdle();
+  EXPECT_EQ(reopening->open_count(), 1u);
+}
+
+TEST_F(InputDeviceOpenCancellationTest,
+       SupersededOpensCancelBeforeInspectingTheDescriptor) {
+  auto opener = std::make_unique<DeferredInputDeviceOpenerEvdev>();
+  auto* pending = opener.get();
+  auto* dispatcher =
+      static_cast<StubDeviceEventDispatcherEvdev*>(dispatcher_.get());
+  InputDeviceFactoryEvdev factory(std::move(dispatcher_), nullptr,
+                                  std::move(opener), &input_controller_);
+  const base::FilePath path("/dev/input/replaced-keyboard");
+  factory.AddInputDevice(1, path);
+  factory.AddInputDevice(2, path);
+  factory.OnStartupScanComplete();
+
+  base::ScopedFD read_fd, write_fd;
+  ASSERT_TRUE(base::CreatePipe(&read_fd, &write_fd));
+  base::test::MockLog log;
+  EXPECT_CALL(log, Log(logging::LOGGING_ERROR, testing::_, testing::_,
+                       testing::_, testing::_))
+      .Times(0);
+  log.StartCapturingLogs();
+  pending->Complete(0, std::move(read_fd));
+  pending->Complete(1, base::ScopedFD());
+  task_environment.RunUntilIdle();
+  log.StopCapturingLogs();
+  EXPECT_EQ(dispatcher->complete_count(), 1u);
+  EXPECT_TRUE(keyboards_.empty());
+}
+
