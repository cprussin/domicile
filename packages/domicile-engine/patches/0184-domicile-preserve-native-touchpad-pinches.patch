diff --git a/third_party/blink/renderer/core/input/mouse_wheel_event_manager.cc b/third_party/blink/renderer/core/input/mouse_wheel_event_manager.cc
index ea0aa44..1045412 100644
--- a/third_party/blink/renderer/core/input/mouse_wheel_event_manager.cc
+++ b/third_party/blink/renderer/core/input/mouse_wheel_event_manager.cc
@@ -49,6 +49,17 @@ WebInputEventResult MouseWheelEventManager::HandleWheelEvent(
   if (!view)
     return WebInputEventResult::kNotHandled;
 
+  if (event.has_native_pinch &&
+      event.native_pinch.phase == ui::NativePinchPhase::kBegin) {
+    native_pinch_claimed_ = false;
+  }
+  if (event.has_native_pinch && native_pinch_claimed_ && !wheel_target_) {
+    if (event.native_pinch.phase == ui::NativePinchPhase::kEnd) {
+      native_pinch_claimed_ = false;
+    }
+    return WebInputEventResult::kHandledSuppressed;
+  }
+
   const int kWheelEventPhaseEndedEventMask =
       WebMouseWheelEvent::kPhaseEnded | WebMouseWheelEvent::kPhaseCancelled;
 
@@ -56,13 +67,16 @@ WebInputEventResult MouseWheelEventManager::HandleWheelEvent(
       (event.momentum_phase & kWheelEventPhaseEndedEventMask)) {
     // Native clients need axis termination; browser content keeps its existing
     // phase-end handling without a DOM wheel event.
-    if ((event.axis_stop_x || event.axis_stop_y) &&
+    const bool consumed_pinch = event.has_native_pinch && native_pinch_claimed_;
+    if ((event.axis_stop_x || event.axis_stop_y || event.has_native_pinch) &&
         IsA<HTMLAppElement>(wheel_target_.Get())) {
       wheel_target_->DispatchEvent(*WheelEvent::Create(
           event, *wheel_target_->GetDocument().domWindow()));
     }
     UpdateWheelTarget(/*wheel_target=*/nullptr);
-    return WebInputEventResult::kNotHandled;
+    native_pinch_claimed_ = false;
+    return consumed_pinch ? WebInputEventResult::kHandledSystem
+                          : WebInputEventResult::kNotHandled;
   }
 
   if (Element* pointer_locked_element =
@@ -121,7 +135,11 @@ WebInputEventResult MouseWheelEventManager::HandleWheelEvent(
     if (dom_event_result != DispatchEventResult::kNotCanceled) {
       // Reset the target if the dom event is cancelled to make sure that new
       // targeting happens for the next wheel event.
-      UpdateWheelTarget(nullptr);
+      if (event.has_native_pinch && dom_event->DefaultHandled()) {
+        native_pinch_claimed_ = true;
+      } else if (!event.has_native_pinch) {
+        UpdateWheelTarget(nullptr);
+      }
 
       bool is_vertical = dom_event->NativeEvent().event_action ==
                          WebMouseWheelEvent::EventAction::kScrollVertical;
@@ -136,6 +154,11 @@ WebInputEventResult MouseWheelEventManager::HandleWheelEvent(
     }
   }
 
+  // A listener can remove an already claimed <app> during this dispatch.
+  // Its cancellation retires the client, while this update remains claimed.
+  if (event.has_native_pinch && native_pinch_claimed_) {
+    return WebInputEventResult::kHandledSuppressed;
+  }
   return WebInputEventResult::kNotHandled;
 }
 
