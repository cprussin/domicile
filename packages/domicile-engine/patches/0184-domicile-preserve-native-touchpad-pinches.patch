diff --git a/components/input/touchpad_pinch_event_queue.cc b/components/input/touchpad_pinch_event_queue.cc
index c5f2c17..c6773d0 100644
--- a/components/input/touchpad_pinch_event_queue.cc
+++ b/components/input/touchpad_pinch_event_queue.cc
@@ -21,6 +21,9 @@ blink::WebMouseWheelEvent CreateSyntheticWheelFromTouchpadPinchEvent(
     blink::WebMouseWheelEvent::Phase phase,
     bool cancelable) {
   DCHECK(
+      (pinch_event.has_native_pinch &&
+       pinch_event.GetType() ==
+           blink::WebInputEvent::Type::kGesturePinchBegin) ||
       pinch_event.GetType() ==
           blink::WebInputEvent::Type::kGesturePinchUpdate ||
       pinch_event.GetType() == blink::WebInputEvent::Type::kGesturePinchEnd ||
@@ -56,6 +59,8 @@ blink::WebMouseWheelEvent CreateSyntheticWheelFromTouchpadPinchEvent(
   wheel_event.SetPositionInWidget(pinch_event.PositionInWidget());
   wheel_event.SetPositionInScreen(pinch_event.PositionInScreen());
   wheel_event.delta_units = ui::ScrollGranularity::kScrollByPrecisePixel;
+  wheel_event.has_native_pinch = pinch_event.has_native_pinch;
+  wheel_event.native_pinch = pinch_event.native_pinch;
   wheel_event.delta_x = 0;
   wheel_event.delta_y = delta_y;
 
@@ -112,7 +117,8 @@ void TouchpadPinchEventQueue::QueueEvent(
 
   if (!pinch_queue_.empty()) {
     QueuedTouchpadPinchEvent* last_event = pinch_queue_.back().get();
-    if (last_event->CanCoalesceWith(event)) {
+    if (!event.event.has_native_pinch && !last_event->event.has_native_pinch &&
+        last_event->CanCoalesceWith(event)) {
       // Terminate the LatencyInfo of the event before it gets coalesced away.
       event.latency.Terminate();
 
@@ -141,11 +147,30 @@ void TouchpadPinchEventQueue::ProcessMouseWheelAck(
   if (!pinch_event_awaiting_ack_)
     return;
 
+  const auto& pinch = pinch_event_awaiting_ack_->event;
+  if (pinch.has_native_pinch) {
+    if (pinch.GetType() == blink::WebInputEvent::Type::kGesturePinchBegin) {
+      first_event_prevented_.reset();
+    }
+    // A removed native app can lose its blocking wheel region. Its remaining
+    // pinch updates must stay consumed instead of zooming the containing page.
+    if (ack_result == blink::mojom::InputEventResultState::kConsumed) {
+      first_event_prevented_ = true;
+    }
+    if (first_event_prevented_.value_or(false)) {
+      ack_result = blink::mojom::InputEventResultState::kConsumed;
+    }
+    if (pinch.GetType() == blink::WebInputEvent::Type::kGesturePinchEnd) {
+      first_event_prevented_.reset();
+    }
+  }
+
   if (pinch_event_awaiting_ack_->event.GetType() ==
           blink::WebInputEvent::Type::kGesturePinchUpdate &&
-      !first_event_prevented_.has_value())
+      !first_event_prevented_.has_value()) {
     first_event_prevented_ =
         (ack_result == blink::mojom::InputEventResultState::kConsumed);
+  }
 
   pinch_event_awaiting_ack_->latency.AddNewLatencyFrom(ack_event.latency);
   auto weak_this = weak_ptr_factory_.GetWeakPtr();
@@ -170,7 +195,8 @@ void TouchpadPinchEventQueue::TryForwardNextEventToRenderer() {
   pinch_queue_.pop_front();
 
   if (pinch_event_awaiting_ack_->event.GetType() ==
-      blink::WebInputEvent::Type::kGesturePinchBegin) {
+          blink::WebInputEvent::Type::kGesturePinchBegin &&
+      !pinch_event_awaiting_ack_->event.has_native_pinch) {
     auto weak_this = weak_ptr_factory_.GetWeakPtr();
     auto dispatch_callback =
         std::move(pinch_event_awaiting_ack_->dispatch_callback);
@@ -198,9 +224,18 @@ void TouchpadPinchEventQueue::TryForwardNextEventToRenderer() {
 
   if (pinch_event_awaiting_ack_->event.GetType() ==
       blink::WebInputEvent::Type::kGesturePinchEnd) {
-    first_event_prevented_.reset();
+    if (!pinch_event_awaiting_ack_->event.has_native_pinch) {
+      first_event_prevented_.reset();
+    }
     phase = blink::WebMouseWheelEvent::kPhaseEnded;
     cancelable = false;
+    if (pinch_event_awaiting_ack_->event.has_native_pinch &&
+        pinch_event_awaiting_ack_->event.native_pinch.canceled) {
+      phase = blink::WebMouseWheelEvent::kPhaseCancelled;
+    }
+  } else if (pinch_event_awaiting_ack_->event.GetType() ==
+             blink::WebInputEvent::Type::kGesturePinchBegin) {
+    phase = blink::WebMouseWheelEvent::kPhaseBegan;
   } else if (pinch_event_awaiting_ack_->event.GetType() ==
              blink::WebInputEvent::Type::kGestureDoubleTap) {
     phase = blink::WebMouseWheelEvent::kPhaseNone;
@@ -210,12 +245,13 @@ void TouchpadPinchEventQueue::TryForwardNextEventToRenderer() {
               blink::WebInputEvent::Type::kGesturePinchUpdate);
     // The first pinch update event should send a synthetic wheel with phase
     // began.
-    if (!first_event_prevented_.has_value()) {
+    if (!first_event_prevented_.has_value() &&
+        !pinch_event_awaiting_ack_->event.has_native_pinch) {
       phase = blink::WebMouseWheelEvent::kPhaseBegan;
       cancelable = true;
     } else {
       phase = blink::WebMouseWheelEvent::kPhaseChanged;
-      cancelable = first_event_prevented_.value();
+      cancelable = first_event_prevented_.value_or(true);
     }
   }
 
diff --git a/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc b/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
index d7c132d..70feec3 100644
--- a/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
+++ b/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
@@ -20,6 +20,39 @@
 namespace mojo {
 namespace {
 
+blink::mojom::NativePinchDataPtr PinchToMojo(bool present,
+                                             const ui::NativePinch& pinch) {
+  if (!present) {
+    return nullptr;
+  }
+  return blink::mojom::NativePinchData::New(
+      static_cast<uint8_t>(pinch.phase), pinch.device, pinch.time,
+      pinch.fingers, pinch.dx, pinch.dy, pinch.scale, pinch.rotation,
+      pinch.canceled);
+}
+
+bool PinchFromMojo(const blink::mojom::NativePinchData& data,
+                   ui::NativePinch& pinch) {
+  if (data.phase > static_cast<uint8_t>(ui::NativePinchPhase::kEnd) ||
+      (data.phase == static_cast<uint8_t>(ui::NativePinchPhase::kBegin) &&
+       data.fingers == 0) ||
+      !std::isfinite(data.dx) || !std::isfinite(data.dy) ||
+      !std::isfinite(data.scale) || data.scale <= 0 ||
+      !std::isfinite(data.rotation)) {
+    return false;
+  }
+  pinch = {static_cast<ui::NativePinchPhase>(data.phase),
+           data.device,
+           data.time,
+           data.fingers,
+           data.dx,
+           data.dy,
+           data.scale,
+           data.rotation,
+           data.canceled};
+  return true;
+}
+
 blink::mojom::PointerDataPtr PointerDataFromPointerProperties(
     const blink::WebPointerProperties& pointer,
     blink::mojom::MouseDataPtr mouse_data) {
@@ -136,6 +169,13 @@ bool StructTraits<blink::mojom::EventDataView,
 
     blink::WebGestureEvent* gesture_event =
         static_cast<blink::WebGestureEvent*>(input_event.get());
+    if (gesture_data->native_pinch) {
+      if (!PinchFromMojo(*gesture_data->native_pinch,
+                         gesture_event->native_pinch)) {
+        return false;
+      }
+      gesture_event->has_native_pinch = true;
+    }
     gesture_event->SetPositionInWidget(gesture_data->widget_position);
     gesture_event->SetPositionInScreen(gesture_data->screen_position);
     gesture_event->is_source_touch_event_set_blocking =
@@ -358,6 +398,13 @@ bool StructTraits<blink::mojom::EventDataView,
             static_cast<blink::WebMouseWheelEvent*>(mouse_event);
         blink::mojom::WheelDataPtr& wheel_data =
             pointer_data->mouse_data->wheel_data;
+        if (wheel_data->native_pinch) {
+          if (!PinchFromMojo(*wheel_data->native_pinch,
+                             wheel_event->native_pinch)) {
+            return false;
+          }
+          wheel_event->has_native_pinch = true;
+        }
         if (wheel_data->native_scroll_source >
             static_cast<uint8_t>(ui::NativeScrollSource::kWheelTilt)) {
           return false;
@@ -458,6 +505,7 @@ StructTraits<blink::mojom::EventDataView,
     const blink::WebMouseWheelEvent* wheel_event =
         static_cast<const blink::WebMouseWheelEvent*>(mouse_event);
     wheel_data = blink::mojom::WheelData::New(
+        PinchToMojo(wheel_event->has_native_pinch, wheel_event->native_pinch),
         static_cast<uint8_t>(wheel_event->native_scroll_source),
         wheel_event->axis_stop_x, wheel_event->axis_stop_y,
         wheel_event->has_native_axis_distance,
@@ -487,6 +535,8 @@ StructTraits<blink::mojom::EventDataView,
   const blink::WebGestureEvent* gesture_event =
       static_cast<const blink::WebGestureEvent*>(event->EventPointer());
   auto gesture_data = blink::mojom::GestureData::New();
+  gesture_data->native_pinch =
+      PinchToMojo(gesture_event->has_native_pinch, gesture_event->native_pinch);
   gesture_data->screen_position = gesture_event->PositionInScreen();
   gesture_data->widget_position = gesture_event->PositionInWidget();
   gesture_data->source_device = gesture_event->SourceDevice();
