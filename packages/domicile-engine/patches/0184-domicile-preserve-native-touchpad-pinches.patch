+void LibInputEventConverter::HandlePinch(libinput_event* native_event) {
+  auto* event = libinput_event_get_gesture_event(native_event);
+  const auto type = libinput_event_get_type(native_event);
+  const auto time =
+      base::TimeTicks() +
+      base::Microseconds(libinput_event_gesture_get_time_usec(event));
+  const bool blocked = typing_guard_ && typing_applies_ &&
+                       typing_guard_->DropsMotion(time, input_device_.id);
+  if (blocked) {
+    CancelPinch(time);
+    return;
+  }
+  NativePinch pinch;
+  pinch.device = input_device_.id;
+  pinch.time = libinput_event_gesture_get_time(event);
+  EventType event_type;
+  float incremental_scale = 1;
+  switch (type) {
+    case LIBINPUT_EVENT_GESTURE_PINCH_BEGIN:
+      CancelPinch(time);
+      pinch.phase = NativePinchPhase::kBegin;
+      pinch.fingers = libinput_event_gesture_get_finger_count(event);
+      pinch_scale_ = 1;
+      event_type = EventType::kGesturePinchBegin;
+      break;
+    case LIBINPUT_EVENT_GESTURE_PINCH_UPDATE:
+      // A gesture suppressed while typing stays suppressed until the next
+      // begin.
+      if (!pinch_scale_) {
+        return;
+      }
+      pinch.phase = NativePinchPhase::kUpdate;
+      pinch.dx = libinput_event_gesture_get_dx(event);
+      pinch.dy = libinput_event_gesture_get_dy(event);
+      pinch.scale = libinput_event_gesture_get_scale(event);
+      pinch.rotation = libinput_event_gesture_get_angle_delta(event);
+      incremental_scale = pinch.scale / *pinch_scale_;
+      pinch_scale_ = pinch.scale;
+      event_type = EventType::kGesturePinchUpdate;
+      break;
+    case LIBINPUT_EVENT_GESTURE_PINCH_END:
+      if (!pinch_scale_) {
+        return;
+      }
+      pinch.phase = NativePinchPhase::kEnd;
+      pinch.canceled = libinput_event_gesture_get_cancelled(event);
+      pinch_scale_.reset();
+      event_type = EventType::kGesturePinchEnd;
+      break;
+    default:
+      NOTREACHED();
+  }
+  PinchEventParams params(input_device_.id, event_type, cursor_->GetLocation(),
+                          incremental_scale, time);
+  params.native_pinch = pinch;
+  dispatcher_->DispatchPinchEvent(params);
+}
+
+void LibInputEventConverter::CancelPinch(base::TimeTicks time) {
+  if (!pinch_scale_) {
+    return;
+  }
+  pinch_scale_.reset();
+  NativePinch pinch;
+  pinch.phase = NativePinchPhase::kEnd;
+  pinch.device = input_device_.id;
+  pinch.time = static_cast<uint32_t>(time.since_origin().InMilliseconds());
+  pinch.canceled = true;
+  PinchEventParams params(input_device_.id, EventType::kGesturePinchEnd,
+                          cursor_->GetLocation(), 1, time);
+  params.native_pinch = pinch;
+  dispatcher_->DispatchPinchEvent(params);
+}
