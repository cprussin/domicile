+  // Domicile: embeds a client's window in an <app>. A frame binder rather than
+  // a process one, so the binder can refuse every frame but the shell.
+  map->Add<domicile::mojom::ExternalSurfaceProvider>(
+      &BindDomicileExternalSurfaceProvider);
