diff --git a/third_party/blink/renderer/core/css/resolver/style_adjuster.cc b/third_party/blink/renderer/core/css/resolver/style_adjuster.cc
index ab1d14067c863..f9d8ac88a8918 100644
--- a/third_party/blink/renderer/core/css/resolver/style_adjuster.cc
+++ b/third_party/blink/renderer/core/css/resolver/style_adjuster.cc
@@ -1603,11 +1603,20 @@ StyleAdjuster::ElementTypeForCache StyleAdjuster::GetElementTypeCacheKey(
     case ElementType::kHTMLFrameElement:
     case ElementType::kHTMLIFrameElement:
     case ElementType::kHTMLFencedFrameElement:
+    // Domicile's engine fork: <webview> is an HTMLFrameOwnerElement too.
+    case ElementType::kHTMLWebViewElement:
       // HTMLFrameOwnerElement descendants have special touch-action behavior.
       // There is also special handling of position and zoom, but this is moot,
       // as we exclude them anyway.
       return {ElementType::kIsNotElement};
 
+    case ElementType::kHTMLAppElement:
+      // Domicile's engine fork. Excluded for the same reason <canvas> is: an
+      // <app> is backed by a cc::SurfaceLayer recorded as a foreign layer, so
+      // its compositing and stacking do not follow from its computed style the
+      // way a sharable element's do.
+      return {ElementType::kIsNotElement};
+
     case ElementType::kHTMLFrameSetElement:
       // Special handling of position.
       return {element.GetElementType()};
