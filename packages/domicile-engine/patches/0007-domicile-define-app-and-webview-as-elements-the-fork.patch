diff --git a/third_party/blink/renderer/core/html/html_frame_element_base.h b/third_party/blink/renderer/core/html/html_frame_element_base.h
index a84b5c5a4bb16..292b88006b434 100644
--- a/third_party/blink/renderer/core/html/html_frame_element_base.h
+++ b/third_party/blink/renderer/core/html/html_frame_element_base.h
@@ -99,7 +99,9 @@ struct DowncastTraits<HTMLFrameElementBase> {
   }
   static bool AllowFrom(const HTMLElement& html_element) {
     return html_element.HasTagName(html_names::kFrameTag) ||
-           html_element.HasTagName(html_names::kIFrameTag);
+           html_element.HasTagName(html_names::kIFrameTag) ||
+           // Domicile's engine fork.
+           html_element.HasTagName(html_names::kWebviewTag);
   }
 };
 
diff --git a/third_party/blink/renderer/core/html/html_tag_names.json5 b/third_party/blink/renderer/core/html/html_tag_names.json5
index ffc9b7408770d..7d6a223f8f96d 100644
--- a/third_party/blink/renderer/core/html/html_tag_names.json5
+++ b/third_party/blink/renderer/core/html/html_tag_names.json5
@@ -36,6 +36,17 @@
       name: "address",
       interfaceName: "HTMLElement",
     },
+    {
+      // Domicile's engine fork. <app> is a window: a cc::SurfaceLayer
+      // embedding a viz surface that a Wayland compositor outside this
+      // renderer submits a client's dmabuf to. It cannot be a custom element,
+      // because a custom element's name must contain a hyphen, and the tag the
+      // shell authors write is <app>.
+      name: "app",
+      interfaceName: "HTMLAppElement",
+      interfaceHeaderDir: "third_party/blink/renderer/core/html/domicile",
+      runtimeEnabled: "DomicileExternalSurface",
+    },
     {
       name: "applet",
       interfaceName: "HTMLUnknownElement",
@@ -602,6 +613,15 @@
       JSInterfaceName: "HTMLElement",
       interfaceName: "HTMLWBRElement",
     },
+    {
+      // Domicile's engine fork. <webview> is web content in a browsing context
+      // of its own, the tag Electron's shells were written against. Same
+      // reason as <app> for not being a custom element: no hyphen.
+      name: "webview",
+      interfaceName: "HTMLWebViewElement",
+      interfaceHeaderDir: "third_party/blink/renderer/core/html/domicile",
+      runtimeEnabled: "DomicileExternalSurface",
+    },
     {
       name: "xmp",
       interfaceName: "HTMLPreElement",
diff --git a/third_party/blink/renderer/core/html/resources/html.css b/third_party/blink/renderer/core/html/resources/html.css
index 084168c268b74..3b5fe82c2e71d 100644
--- a/third_party/blink/renderer/core/html/resources/html.css
+++ b/third_party/blink/renderer/core/html/resources/html.css
@@ -177,7 +177,7 @@ video, canvas, img {
   overflow-clip-margin: content-box;
 }
 
-iframe, embed, object, fencedframe {
+iframe, embed, object, fencedframe, webview {
    overflow: clip !important;
    overflow-clip-margin: content-box !important;
 }
@@ -1841,6 +1841,17 @@ iframe {
     border: 2px inset
 }
 
+/* Domicile's engine fork. Both are replaced elements, so they take a box the
+   way an <img> does; neither gets a border, because a shell draws its own
+   chrome and a default frame border would be inside the window. */
+app {
+    display: inline-block
+}
+
+webview {
+    display: inline-block
+}
+
 fencedframe {
     border: 2px inset;
     object-fit: contain !important;
