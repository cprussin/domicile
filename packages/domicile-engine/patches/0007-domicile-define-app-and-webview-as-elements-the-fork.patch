@@ -105,7 +105,9 @@ class PLATFORM_EXPORT DisplayItem {
     kForeignLayerViewportScroll,
     kForeignLayerViewportScrollbar,
     kForeignLayerViewTransitionContent,
-    kForeignLayerLast = kForeignLayerViewTransitionContent,
