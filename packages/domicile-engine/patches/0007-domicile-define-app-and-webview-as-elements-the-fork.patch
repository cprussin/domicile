+    kForeignLayerAppSurface,
+    kForeignLayerLast = kForeignLayerAppSurface,
 
     kClipPaintPhaseFirst,
     kClipPaintPhaseLast = kClipPaintPhaseFirst + kPaintPhaseMax,
