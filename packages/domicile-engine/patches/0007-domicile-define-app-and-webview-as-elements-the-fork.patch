     DEBUG_STRING_CASE(ForeignLayerViewportScroll);
     DEBUG_STRING_CASE(ForeignLayerViewportScrollbar);
     DEBUG_STRING_CASE(ForeignLayerViewTransitionContent);
+    DEBUG_STRING_CASE(ForeignLayerAppSurface);
     DEFAULT_CASE;
   }
 }
