 .../core/css/resolver/style_adjuster.cc       |  9 +++++++++
 .../blink/renderer/core/html/build.gni        |  6 ++++++
 .../core/html/html_attribute_names.json5      |  1 +
 .../core/html/html_frame_element_base.h       |  4 +++-
 .../renderer/core/html/html_tag_names.json5   | 20 +++++++++++++++++++
 .../renderer/core/html/resources/html.css     | 13 +++++++++++-
 .../platform/graphics/paint/display_item.cc   |  1 +
 .../platform/graphics/paint/display_item.h    |  4 +++-
 11 files changed, 71 insertions(+), 4 deletions(-)

diff --git a/extensions/renderer/dispatcher.cc b/extensions/renderer/dispatcher.cc
index 09fd79e20ed13..9f4a3f1576770 100644
--- a/extensions/renderer/dispatcher.cc
+++ b/extensions/renderer/dispatcher.cc
@@ -1444,7 +1444,16 @@ void Dispatcher::EnableCustomElementAllowlist() {
   blink::WebCustomElement::AddEmbedderCustomElementName("appview");
 #endif
   blink::WebCustomElement::AddEmbedderCustomElementName("extensionoptions");
-  blink::WebCustomElement::AddEmbedderCustomElementName("webview");
+  // Domicile's engine fork defines <webview> as a builtin HTML tag, so it
+  // cannot also be an embedder custom element name: the two are mutually
+  // exclusive by construction, and AddEmbedderCustomElementName() DCHECKs
+  // !IsKnownBuiltinTagName() to say so. Registering it here killed every
+  // renderer at startup.
+  //
+  // The name being taken is worth stating plainly: <webview> was already
+  // Chromium's, for guest views in Chrome Apps. This engine runs no
+  // extensions and no Chrome Apps, so the fork takes the tag; a build that
+  // wanted both would have to rename one of them.
   for (const auto& api_provider : api_providers_) {
     api_provider->EnableCustomElementAllowlist();
   }
