-void DrmWindowHost::SetFullscreen(bool fullscreen, int64_t target_display_id) {}
+void DrmWindowHost::SetFullscreen(bool fullscreen, int64_t target_display_id) {
+  // Upstream is an empty body, on the same premise as the NOTREACHED()s above:
+  // ash sizes its own root window to the display, so nothing on ChromeOS ever
+  // asks a DRM window to go fullscreen. A views browser does -- it is how
+  // --start-fullscreen and --kiosk are implemented -- and on a tty it is the
+  // only thing that makes the window the size of the screen.
+  //
+  // WHICH IS THE WHOLE OF WHETHER ANYTHING IS DRAWN.
+  // ScreenManager::UpdateControllerToWindowMapping binds a window to a display
+  // controller through FindWindowAt, which compares the window's rectangle to
+  // gfx::Rect(controller->origin(), controller->GetModeSize()) for EXACT
+  // equality. A window that is not precisely the CRTC's rect is a window with
+  // no controller, and every frame it submits is dropped before it reaches the
+  // kernel -- a black screen with nothing wrong in any log. Chromium's default
+  // window is 1050x1900 at (10, 10) on a 2880x1920 panel, so out of the box a
+  // desktop on a tty draws nothing at all.
+  const PlatformWindowState next = fullscreen
+                                       ? PlatformWindowState::kFullScreen
+                                       : PlatformWindowState::kNormal;
+  if (state_ == next) {
+    return;
+  }
+
+  const PlatformWindowState previous = state_;
+  state_ = next;
+
+  const gfx::Rect next_bounds = BoundsForFullscreenChange(
+      fullscreen, bounds_, restored_bounds_, FullscreenBounds(target_display_id));
+  if (fullscreen) {
+    restored_bounds_ = bounds_;
+  } else {
+    restored_bounds_.reset();
+  }
+  SetBoundsInPixels(next_bounds);
+
+  delegate_->OnWindowStateChanged(previous, state_);
+}
+
+gfx::Rect DrmWindowHost::FullscreenBounds(int64_t target_display_id) const {
+  // The screen rather than this host's own display manager, because the two
+  // agree by construction and only one of them knows which display a window is
+  // on: DrmScreen builds its display list from the same DisplaySnapshots the
+  // modeset driver configures the CRTCs from, so a display's bounds and
+  // gfx::Rect(controller->origin(), controller->GetModeSize()) are the same
+  // rectangle -- including after a mode change or a hotplug.
+  //
+  // CHECKed rather than guarded: this is reached from a views browser going
+  // fullscreen, which cannot happen before the toolkit built a screen, and a
+  // fullscreen window sized from a screen that is not there would be a silent
+  // black display rather than a crash anybody could read.
+  display::Screen* screen = display::Screen::Get();
+  CHECK(screen) << "domicile: no screen to size a fullscreen window from";
+
+  display::Display target;
+  if (target_display_id != display::kInvalidDisplayId &&
+      screen->GetDisplayWithDisplayId(target_display_id, &target)) {
+    return target.bounds();
+  }
+  // No display named, or one that is no longer plugged in: the display this
+  // window is already on, which is what a fullscreen request without a target
+  // means.
+  return screen->GetDisplayMatching(bounds_).bounds();
+}
 
 void DrmWindowHost::Maximize() {}
 
@@ -134,7 +199,11 @@ void DrmWindowHost::Minimize() {}
 void DrmWindowHost::Restore() {}
 
 PlatformWindowState DrmWindowHost::GetPlatformWindowState() const {
-  return PlatformWindowState::kUnknown;
+  // Upstream answers kUnknown, which is honest on ChromeOS where nothing sets
+  // a state. Here SetFullscreen does, and views reads this back through
+  // DesktopWindowTreeHostPlatform::IsFullscreen() -- so answering kUnknown
+  // would make every fullscreen request look like the first one.
+  return state_;
 }
 
 void DrmWindowHost::Activate() {
diff --git a/ui/ozone/platform/drm/host/drm_window_host.h b/ui/ozone/platform/drm/host/drm_window_host.h
index 3250e6b7c9c23..916342495552f 100644
--- a/ui/ozone/platform/drm/host/drm_window_host.h
+++ b/ui/ozone/platform/drm/host/drm_window_host.h
@@ -107,6 +107,10 @@ class DrmWindowHost : public PlatformWindow,
  private:
   void SendBoundsChange();
 
+  // The rectangle a fullscreen window takes: the whole of the display it is
+  // on, which on this platform is the whole of a CRTC.
+  gfx::Rect FullscreenBounds(int64_t target_display_id) const;
+
   const raw_ptr<PlatformWindowDelegate> delegate_;        // Not owned.
   const raw_ptr<GpuThreadAdapter> sender_;                // Not owned.
   const raw_ptr<EventFactoryEvdev> event_factory_;        // Not owned.
@@ -124,6 +128,11 @@ class DrmWindowHost : public PlatformWindow,
   // them on ChromeOS. These are what two of the answers need.
   bool visible_ = false;
   std::optional<gfx::Rect> restored_bounds_;
+  // What this window last told views it is. Upstream answers kUnknown forever,
+  // which makes DesktopWindowTreeHostPlatform::IsFullscreen() permanently
+  // false -- so views re-enters fullscreen every time and the DCHECK_EQ in
+  // DesktopWindowTreeHostPlatform::SetFullscreen fails in a DCHECK build.
+  PlatformWindowState state_ = PlatformWindowState::kNormal;
 };
 
