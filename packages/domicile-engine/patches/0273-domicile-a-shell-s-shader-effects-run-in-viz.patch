+// Domicile: `domicile-shader(<custom-ident> [, <number>]{0,16})`, a shell's
+// shader effect and its arguments. Only the shell has it, as it has <app>.
+CSSFunctionValue* ConsumeDomicileShader(CSSParserTokenStream& stream,
+                                        const CSSParserContext& context,
+                                        CSSParserLocalContext& local_context) {
+  if (!RuntimeEnabledFeatures::DomicileExternalSurfaceEnabled(
+          context.GetExecutionContext())) {
+    return nullptr;
+  }
+  auto* filter_value =
+      MakeGarbageCollected<CSSFunctionValue>(CSSValueID::kDomicileShader);
+  {
+    CSSParserTokenStream::BlockGuard guard(stream);
+    stream.ConsumeWhitespace();
+    CSSCustomIdentValue* name =
+        ConsumeCustomIdent(stream, context, local_context);
+    if (!name) {
+      return nullptr;
+    }
+    filter_value->Append(*name);
+    while (ConsumeCommaIncludingWhitespace(stream)) {
+      CSSPrimitiveValue* argument =
+          ConsumeNumber(stream, context, local_context,
+                        CSSPrimitiveValue::ValueRange::kAll);
+      // The name, then at most 16 numbers.
+      if (!argument || filter_value->length() > 16) {
+        return nullptr;
+      }
+      filter_value->Append(*argument);
+    }
+    if (!stream.AtEnd()) {
+      return nullptr;
+    }
+  }
+  stream.ConsumeWhitespace();
+  return filter_value;
+}
