diff --git a/cc/paint/filter_operation.cc b/cc/paint/filter_operation.cc
index 7c90cb99..09e156b4 100644
--- a/cc/paint/filter_operation.cc
+++ b/cc/paint/filter_operation.cc
@@ -43,6 +43,13 @@ bool FilterOperation::operator==(const FilterOperation& other) const {
   if (type_ == OFFSET) {
     return offset_ == other.offset_;
   }
+  // Domicile: the compiled program follows from the effect, so it is left
+  // out.
+  if (type_ == SHADER) {
+    return shader_effect_ == other.shader_effect_ &&
+           amount_ == other.amount_ &&
+           shader_arguments_ == other.shader_arguments_;
+  }
   return amount_ == other.amount_;
 }
 
@@ -140,6 +147,22 @@ FilterOperation::FilterOperation(FilterType type, const ShapeRects& shape)
   matrix_.fill(0.0f);
 }
 
+FilterOperation::FilterOperation(FilterType type,
+                                 uint32_t effect,
+                                 float outset,
+                                 std::vector<float> arguments)
+    : type_(type),
+      amount_(outset),
+      offset_(0, 0),
+      drop_shadow_color_(SkColors::kTransparent),
+      zoom_inset_(0),
+      shader_effect_(effect),
+      shader_arguments_(std::move(arguments)) {
+  DCHECK_EQ(type_, SHADER);
+  DCHECK_LE(shader_arguments_.size(), kMaxShaderArguments);
+  matrix_.fill(0.0f);
+}
+
 FilterOperation::FilterOperation(const FilterOperation& other) = default;
 FilterOperation::~FilterOperation() = default;
 
@@ -182,6 +205,10 @@ static FilterOperation CreateNoOpFilter(FilterOperation::FilterType type) {
           FilterOperation::ShapeRects());
     case FilterOperation::OFFSET:
       return FilterOperation::CreateOffsetFilter(gfx::Point(0, 0));
+    // Domicile: no arguments leave content as it is, so Blend() starts an
+    // effect from zero arguments itself.
+    case FilterOperation::SHADER:
+      NOTREACHED();
   }
   NOTREACHED();
 }
@@ -209,6 +236,7 @@ static float ClampAmountForFilterType(float amount,
     case FilterOperation::COLOR_MATRIX:
     case FilterOperation::OFFSET:
     case FilterOperation::REFERENCE:
+    case FilterOperation::SHADER:
       NOTREACHED();
   }
   NOTREACHED();
@@ -223,6 +251,31 @@ FilterOperation FilterOperation::Blend(const FilterOperation* from,
   if (!from && !to)
     return blended_filter;
 
+  // Domicile: one effect's arguments interpolate, and a missing side is that
+  // effect with every argument zero, as Blink starts one. Two different
+  // filters step halfway, as a reference filter does.
+  if ((from && from->type() == SHADER) || (to && to->type() == SHADER)) {
+    if (from && to &&
+        (from->type() != to->type() ||
+         from->shader_effect() != to->shader_effect() ||
+         from->shader_arguments().size() != to->shader_arguments().size())) {
+      return progress > 0.5 ? *to : *from;
+    }
+    const FilterOperation& shader = from ? *from : *to;
+    const std::vector<float> zeros(shader.shader_arguments().size());
+    const std::vector<float>& from_arguments =
+        from ? from->shader_arguments() : zeros;
+    const std::vector<float>& to_arguments = to ? to->shader_arguments() : zeros;
+    std::vector<float> arguments(zeros.size());
+    for (size_t i = 0; i < arguments.size(); ++i) {
+      arguments[i] = gfx::Tween::FloatValueBetween(progress, from_arguments[i],
+                                                   to_arguments[i]);
+    }
+    FilterOperation blended = shader;
+    blended.set_shader_arguments(std::move(arguments));
+    return blended;
+  }
+
   const FilterOperation& from_op = from ? *from : CreateNoOpFilter(to->type());
   const FilterOperation& to_op = to ? *to : CreateNoOpFilter(from->type());
 
@@ -325,6 +378,15 @@ void FilterOperation::AsValueInto(base::trace_event::TracedValue* value) const {
     case FilterOperation::OFFSET:
       MathUtil::AddToTracedValue("offset", offset_, value);
       break;
+    case FilterOperation::SHADER:
+      value->SetInteger("effect", static_cast<int>(shader_effect_));
+      value->SetDouble("outset", amount_);
+      value->BeginArray("arguments");
+      for (const float& argument : shader_arguments_) {
+        value->AppendDouble(argument);
+      }
+      value->EndArray();
+      break;
   }
 }
 
@@ -394,6 +456,18 @@ gfx::Rect MapRectInternal(const FilterOperation& op,
           gfx::RectF(rect) +
           gfx::Vector2dF(mapped_offset.x(), mapped_offset.y()));
     }
+    // Domicile: an effect may draw up to its outset past the content, and
+    // read anywhere in it.
+    case FilterOperation::SHADER: {
+      SkVector outset = SkVector::Make(op.amount(), op.amount());
+      if (ctm) {
+        outset = ctm->mapVector(outset);
+      }
+      gfx::RectF result(rect);
+      result.Outset(
+          gfx::OutsetsF::VH(std::abs(outset.y()), std::abs(outset.x())));
+      return gfx::ToEnclosingRect(result);
+    }
     default:
       return rect;
   }
