   bool operator==(const FilterOperation& other) const;
 
   bool operator!=(const FilterOperation& other) const {
@@ -229,6 +264,22 @@ class CC_PAINT_EXPORT FilterOperation {
     blur_tile_mode_ = tile_mode;
   }
 
