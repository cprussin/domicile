+// DOMICILE: GetModesetPlanes for a device with no GBM. The buffer is filled
+// as a GBM one is: with what the CRTC shows, or black.
+DrmOverlayPlaneList DomicileGetDumbModesetPlanes(
+    const scoped_refptr<DrmDevice>& drm,
+    HardwareDisplayController* controller,
+    const gfx::Rect& bounds,
+    bool is_testing) {
+  std::optional<DrmScanoutBuffer> buffer =
+      AllocateDrmScanoutBuffer(drm, bounds.size());
+  if (!buffer) {
+    return DrmOverlayPlaneList();
+  }
+
+  if (!is_testing &&
+      !FillModesetBuffer(drm, controller, buffer->pixels->surface(),
+                         /*modifiers=*/{})) {
+    buffer->pixels->GetCanvas()->clear(SK_ColorBLACK);
+  }
+
+  const gfx::Rect rect(buffer->framebuffer->size());
+  DrmOverlayPlaneList modeset_planes;
+  modeset_planes.emplace_back(buffer->framebuffer, gfx::ColorSpace::CreateSRGB(),
+                              /*z_order=*/0, gfx::OVERLAY_TRANSFORM_NONE,
+                              /*damage_rect=*/rect, /*display_bounds=*/rect,
+                              /*crop_rect=*/gfx::RectF(0, 0, 1, 1),
+                              /*enable_blend=*/false,
+                              /*gpu_fence=*/nullptr);
+  return modeset_planes;
+}
