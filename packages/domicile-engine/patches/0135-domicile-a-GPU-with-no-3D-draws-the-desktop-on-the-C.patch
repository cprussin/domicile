+// DOMICILE: a software-composited window's side of the DRM thread.
+class DrmThreadCanvasDisplay : public DrmCanvas::Display {
+ public:
+  DrmThreadCanvasDisplay(gfx::AcceleratedWidget widget,
+                         DrmThreadProxy* drm_thread_proxy)
+      : widget_(widget),
+        drm_thread_proxy_(drm_thread_proxy),
+        window_(drm_thread_proxy->CreateDrmWindowProxy(widget)) {}
+
+  std::optional<DrmScanoutBuffer> Allocate(const gfx::Size& size) override {
+    return drm_thread_proxy_->DomicileCreateScanoutBuffer(widget_, size);
+  }
+
+  void Flip(scoped_refptr<DrmFramebuffer> framebuffer,
+            SwapCompletionOnceCallback submitted,
+            PresentationOnceCallback presented) override {
+    const gfx::Size size = framebuffer->size();
+    std::vector<DrmOverlayPlane> planes;
+    planes.emplace_back(framebuffer, gfx::ColorSpace::CreateSRGB(),
+                        /*z_order=*/0, gfx::OVERLAY_TRANSFORM_NONE,
+                        /*damage_rect=*/gfx::Rect(size),
+                        /*display_bounds=*/gfx::Rect(size),
+                        /*crop_rect=*/gfx::RectF(0, 0, 1, 1),
+                        /*enable_blend=*/false, /*gpu_fence=*/nullptr);
+    window_->SchedulePageFlip(std::move(planes), std::move(submitted),
+                              std::move(presented));
+  }
+
+ private:
+  const gfx::AcceleratedWidget widget_;
+  const raw_ptr<DrmThreadProxy> drm_thread_proxy_;
+  const std::unique_ptr<DrmWindowProxy> window_;
+};
