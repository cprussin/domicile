+
+    # `DrmVtSwitcherTest` includes `drm_vt_switcher.h`, which names
+    # `scoped_refptr<dbus::Bus>` and so includes `dbus/bus.h` -- and that pulls
+    # the system `<dbus/dbus.h>`, whose include directory only the `//dbus`
+    # target supplies. `:gbm` having the edge is not enough: an include
+    # directory reaches the translation units of the target that names it, and
+    # the test is its own target. `drm_logind_input.h` includes the same header
+    # and did not need this, because no test includes THAT one.
+    "//dbus",
+
+    # `DrmVtSwitcherTest` builds the `KeyEvent` it asks `VtForChord` about, so
+    # this target includes a `//ui/events` header directly rather than only
+    # through `:gbm`, and `gn check` wants the edge said out loud.
+    "//ui/events",
     "//ui/gfx",
     "//ui/gfx/linux:drm",
     "//ui/gfx/linux:gbm",
diff --git a/ui/ozone/platform/drm/host/drm_display_host_manager.cc b/ui/ozone/platform/drm/host/drm_display_host_manager.cc
index 9aa71a170b..2f8462b898 100644
--- a/ui/ozone/platform/drm/host/drm_display_host_manager.cc
+++ b/ui/ozone/platform/drm/host/drm_display_host_manager.cc
@@ -714,9 +714,10 @@ void DrmDisplayHostManager::GpuRelinquishedDisplayControl(bool status) {
   // arriving by the other door.
   //
   // A DROP THAT FAILS MAKES THE WHOLE RELINQUISH FAIL, even though the GPU
-  // succeeded. `DrmVtSwitcher` answers `VT_RELDISP(0)` to that and the switch
-  // is refused, which is correct: the console would otherwise go to the kernel
-  // while Chromium is still scanning out on it.
+  // succeeded. There is no refusing the switch -- logind owns the handshake
+  // and has handed the console over already -- so what this buys is that
+  // `DrmVtSwitcher` records a display it does not have and asks for it again
+  // on the way back, rather than believing a drop that did not happen.
   const bool relinquished = status && drm_master_.Drop();
 
   if (relinquished) {
