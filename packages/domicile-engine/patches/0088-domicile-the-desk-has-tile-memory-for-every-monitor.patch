   void SetDomicileDisplayRegions(DomicileDisplayRegions regions);
+  // DOMICILE: the tile memory those monitors need, which the compositor's
+  // budget is raised to. See cc/domicile/display_regions.h.
+  void SetDomicileTileBytes(size_t bytes);
 
   bool HasCompositorDrivenScrollAnimationForTesting() const {
     DCHECK(IsMainThread());
diff --git a/cc/trees/layer_tree_host_impl.cc b/cc/trees/layer_tree_host_impl.cc
index ade904e91a..8ec6717897 100644
--- a/cc/trees/layer_tree_host_impl.cc
+++ b/cc/trees/layer_tree_host_impl.cc
@@ -4027,6 +4027,9 @@ void LayerTreeHostImpl::SetNeedsRedraw(bool animation_only,
 
 ManagedMemoryPolicy LayerTreeHostImpl::ActualManagedMemoryPolicy() const {
   ManagedMemoryPolicy actual = cached_managed_memory_policy_;
+  // DOMICILE: raised, never lowered, so upstream's budget is a floor.
+  actual.bytes_limit_when_visible =
+      std::max(actual.bytes_limit_when_visible, domicile_tile_bytes_);
   // The following may lower the cutoff, but should never raise it.
   if (debug_state_.rasterize_only_visible_content) {
     actual.priority_cutoff_when_visible =
@@ -4040,6 +4043,14 @@ ManagedMemoryPolicy LayerTreeHostImpl::ActualManagedMemoryPolicy() const {
   return actual;
 }
 
+void LayerTreeHostImpl::SetDomicileTileBytes(size_t bytes) {
+  if (domicile_tile_bytes_ == bytes) {
+    return;
+  }
+  domicile_tile_bytes_ = bytes;
+  UpdateTileManagerMemoryPolicy(ActualManagedMemoryPolicy());
+}
