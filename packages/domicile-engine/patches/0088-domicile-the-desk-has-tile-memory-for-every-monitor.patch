 cc/trees/layer_tree_host.cc                       |  8 ++++++++
 cc/trees/layer_tree_host.h                        |  3 +++
 cc/trees/layer_tree_host_impl.cc                  | 11 +++++++++++
 cc/trees/layer_tree_host_impl.h                   |  4 ++++
 .../blink/renderer/platform/widget/widget_base.cc | 15 +++++++++++++++
 8 files changed, 47 insertions(+)

