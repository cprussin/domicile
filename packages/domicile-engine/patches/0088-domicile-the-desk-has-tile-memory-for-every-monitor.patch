+++ b/cc/trees/layer_tree_host.cc
@@ -1654,6 +1654,14 @@ void LayerTreeHost::SetDomicileDisplayRegions(DomicileDisplayRegions regions) {
   SetNeedsCommit();
 }
 
+void LayerTreeHost::SetDomicileTileBytes(size_t bytes) {
+  if (pending_commit_state()->domicile_tile_bytes == bytes) {
+    return;
+  }
+  pending_commit_state()->domicile_tile_bytes = bytes;
+  SetNeedsCommit();
+}
+
 void LayerTreeHost::SetDisplayColorSpaces(
     const gfx::DisplayColorSpaces& display_color_spaces) {
   if (pending_commit_state()->display_color_spaces == display_color_spaces)
diff --git a/cc/trees/layer_tree_host.h b/cc/trees/layer_tree_host.h
