 void LayerTreeHostImpl::ReleaseTreeResources() {
   active_tree_->ReleaseResources();
   if (pending_tree_) {
diff --git a/cc/trees/layer_tree_host_impl.h b/cc/trees/layer_tree_host_impl.h
index 8c949f917a..0e26d3983b 100644
--- a/cc/trees/layer_tree_host_impl.h
+++ b/cc/trees/layer_tree_host_impl.h
@@ -681,6 +681,9 @@ class CC_EXPORT LayerTreeHostImpl : public TileManagerClient,
   void SetNeedsRedraw(bool animation_only, bool skip_if_inside_draw) override;
 
   ManagedMemoryPolicy ActualManagedMemoryPolicy() const;
+  // DOMICILE: raises ActualManagedMemoryPolicy's budget to `bytes`, what the
+  // monitors the page is shown on need. See cc/domicile/display_regions.h.
+  void SetDomicileTileBytes(size_t bytes);
 
   const gfx::Transform& DrawTransform() const;
 
@@ -1168,6 +1171,7 @@ class CC_EXPORT LayerTreeHostImpl : public TileManagerClient,
   LayerTreeDebugState debug_state_;
   bool visible_ = false;
   ManagedMemoryPolicy cached_managed_memory_policy_;
+  size_t domicile_tile_bytes_ = 0;
 
   TileManager tile_manager_;
 
diff --git a/third_party/blink/renderer/platform/widget/widget_base.cc b/third_party/blink/renderer/platform/widget/widget_base.cc
index f6c271afb1..b0e20db6be 100644
--- a/third_party/blink/renderer/platform/widget/widget_base.cc
+++ b/third_party/blink/renderer/platform/widget/widget_base.cc
@@ -13,6 +13,8 @@
 #include "base/logging.h"
 #include "base/metrics/histogram_functions.h"
 #include "base/metrics/histogram_macros.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/system/sys_info.h"
 #include "base/task/common/task_annotator.h"
 #include "base/trace_event/trace_event.h"
 #include "build/build_config.h"
@@ -1983,6 +1985,19 @@ void WidgetBase::UpdateDomicileDisplayRegions() {
   }
   LayerTreeHost()->SetDomicileDisplayRegions(cc::DomicileDisplayRegionsOf(
       displays, widget_screen_rect_.origin(), GetOriginalDeviceScaleFactor()));
+  // A budget named on the command line is the budget, as upstream has it.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kForceGpuMemAvailableMb)) {
+    return;
+  }
+  // At most a quarter of RAM, as upstream caps its own budget.
+  const size_t ceiling_bytes =
+      base::checked_cast<size_t>(
+          base::SysInfo::AmountOfTotalPhysicalMemory().InMiB() / 4) *
+      1024 * 1024;
+  LayerTreeHost()->SetDomicileTileBytes(
+      cc::DomicileTileBytesFor(displays, widget_screen_rect_,
+                               GetOriginalDeviceScaleFactor(), ceiling_bytes));
 }
 
