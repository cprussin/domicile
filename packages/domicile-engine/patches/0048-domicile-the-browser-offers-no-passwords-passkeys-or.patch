From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Sat, 26 Sep 2026 16:11:35 +0000
Subject: [PATCH] domicile: the browser offers no passwords, passkeys or
 translations

Chrome's password manager, autofill and translate each draw a bubble or a
dropdown over the page, and on a desktop the page is the shell: a lock
screen's password field became a "save password?" prompt. A site in a
browser window asking for a passkey got Chrome's WebAuthn dialog, which has
no browser window to belong to.

- PostProfileInit turns the offers off in the profile's prefs, every start,
  before any window: domicile::TurnOffBrowserOffers, in
  //components/domicile:desktop_prefs where its test is.
- GetWebAuthenticationRequestDelegate answers null, which content turns into
  an error to the page with no UI.
- Blink's WebAuth feature is off, so a site finds no PublicKeyCredential and
  offers a password rather than a passkey that would be refused.
---
 chrome/browser/BUILD.gn                                     | 5 +++--
 chrome/browser/chrome_browser_main.cc                       | 6 ++++++
 chrome/browser/chrome_content_browser_client.cc             | 6 ++++--
 .../blink/renderer/platform/runtime_enabled_features.json5  | 4 +++-
 4 files changed, 16 insertions(+), 5 deletions(-)

diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
index ab055bd15a..a656fc08a6 100644
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -2385,11 +2385,12 @@ source_set("browser") {
 
     # Domicile's engine fork: serving the shell over domicile://, the
     # shell's control channel to the compositor, the keymap and the color
-    # scheme that channel carries, and the socket a running engine is told
-    # which shell to serve on.
+    # scheme that channel carries, the socket a running engine is told
+    # which shell to serve on, and the browser's offers turned off.
     "//chrome/browser/domicile",
     "//components/domicile:color_scheme",
     "//components/domicile:control_channel",
+    "//components/domicile:desktop_prefs",
     "//components/domicile:keyboard_layout",
     "//components/domicile:shell_scheme",
     "//components/domicile:web_view_guest",
diff --git a/chrome/browser/chrome_browser_main.cc b/chrome/browser/chrome_browser_main.cc
index 4c10686c62..e152b6e86d 100644
--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -6,6 +6,7 @@
 
 #include "chrome/browser/domicile/domicile_command_socket.h"
 #include "chrome/browser/domicile/domicile_shell_windows.h"
+#include "components/domicile/browser/desktop_prefs.h"
 
 #include <memory>
 #include <string>
@@ -1610,6 +1611,11 @@ void ChromeBrowserMainParts::PostProfileInit(Profile* profile,
     TRACE_EVENT0("startup", "ChromeBrowserMainParts::PostProfileInit");
   }
 
+  // Domicile's engine fork: no password, address, card or translate offers
+  // drawn over the desktop. Before any window, so the shell's first page
+  // already has none.
+  domicile::TurnOffBrowserOffers(*profile->GetPrefs());
+
   for (auto& chrome_extra_part : chrome_extra_parts_) {
     chrome_extra_part->PostProfileInit(profile, is_initial_profile);
   }
diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 0f7e122b59..7e4ce3c1bc 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -7312,8 +7312,10 @@ content::SensorDelegate* ChromeContentBrowserClient::GetSensorDelegate() {
 std::unique_ptr<content::AuthenticatorRequestClientDelegate>
 ChromeContentBrowserClient::GetWebAuthenticationRequestDelegate(
     content::RenderFrameHost* render_frame_host) {
-  return AuthenticatorRequestScheduler::CreateRequestDelegate(
-      render_frame_host);
+  // Domicile's engine fork: no passkey UI. Chrome's WebAuthn dialog is drawn
+  // over the desktop by the browser, so every request is refused before it
+  // gets one -- content answers a null delegate with an error to the page.
+  return nullptr;
 }
 #endif
 
diff --git a/third_party/blink/renderer/platform/runtime_enabled_features.json5 b/third_party/blink/renderer/platform/runtime_enabled_features.json5
index b70537c327..ccbcfca5ce 100644
--- a/third_party/blink/renderer/platform/runtime_enabled_features.json5
+++ b/third_party/blink/renderer/platform/runtime_enabled_features.json5
@@ -6919,9 +6919,11 @@
     },
     // WebAuth is disabled on Android versions prior to N (7.0) due to lack of
     // supporting APIs, see runtime_features.cc.
+    //
+    // Domicile's engine fork: off, so a site finds no PublicKeyCredential and
+    // offers a password instead of a passkey the browser would refuse.
     {
       name: "WebAuth",
-      status: "stable",
     },
     // When enabled adds the authenticator attachment used for registration and
     // authentication to the public key credential response.
