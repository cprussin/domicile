From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Sat, 26 Sep 2026 16:11:35 +0000
Subject: [PATCH] domicile: the browser offers no passwords, passkeys or
 translations

Chrome's password manager, autofill and translate each draw a bubble or a
dropdown over the page, and on a desktop the page is the shell: a lock
screen's password field became a "save password?" prompt. A site in a
browser window asking for a passkey got Chrome's WebAuthn dialog, which has
no browser window to belong to.

- PostProfileInit turns the offers off in the profile's prefs, every start,
  before any window: domicile::TurnOffBrowserOffers, in
  //components/domicile:desktop_prefs where its test is.
- GetWebAuthenticationRequestDelegate answers null, which content turns into
  an error to the page with no UI -- unless an extension has taken the
  origin's requests with chrome.webAuthenticationProxy, which content hands
  the request to before any dialog, and which needs a delegate to reach.
- No platform authenticator and no conditional UI: IsUVPAA and
  isConditionalMediationAvailable answer false, so a site does not offer a
  passkey sign-in the browser would refuse.
- Blink's WebAuth stays on. A password manager's passkeys reach a page by
  wrapping navigator.credentials from a content script, and a site that
  finds no PublicKeyCredential never calls it.
---
 chrome/browser/BUILD.gn                       |  5 +-
 chrome/browser/chrome_browser_main.cc         |  6 ++
 .../browser/chrome_content_browser_client.cc  | 11 ++++
 .../chrome_web_authentication_delegate.cc     | 60 ++-----------------
 4 files changed, 26 insertions(+), 56 deletions(-)

diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
index 693fc8376f..5f1cbae288 100644
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -2412,11 +2412,12 @@ source_set("browser") {
 
     # Domicile's engine fork: serving the shell over domicile://, the
     # shell's control channel to the compositor, the keymap and the color
-    # scheme that channel carries, and the socket a running engine is told
-    # which shell to serve on.
+    # scheme that channel carries, the socket a running engine is told
+    # which shell to serve on, and the browser's offers turned off.
     "//chrome/browser/domicile",
     "//components/domicile:color_scheme",
     "//components/domicile:control_channel",
+    "//components/domicile:desktop_prefs",
     "//components/domicile:keyboard_layout",
     "//components/domicile:shell_scheme",
     "//components/domicile:web_view_guest",
diff --git a/chrome/browser/chrome_browser_main.cc b/chrome/browser/chrome_browser_main.cc
index 4c10686c62..e152b6e86d 100644
--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -6,6 +6,7 @@
 
 #include "chrome/browser/domicile/domicile_command_socket.h"
 #include "chrome/browser/domicile/domicile_shell_windows.h"
+#include "components/domicile/browser/desktop_prefs.h"
 
 #include <memory>
 #include <string>
@@ -1610,6 +1611,11 @@ void ChromeBrowserMainParts::PostProfileInit(Profile* profile,
     TRACE_EVENT0("startup", "ChromeBrowserMainParts::PostProfileInit");
   }
 
+  // Domicile's engine fork: no password, address, card or translate offers
+  // drawn over the desktop. Before any window, so the shell's first page
+  // already has none.
+  domicile::TurnOffBrowserOffers(*profile->GetPrefs());
+
   for (auto& chrome_extra_part : chrome_extra_parts_) {
     chrome_extra_part->PostProfileInit(profile, is_initial_profile);
   }
diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 7e17dbe202..b5502fdd70 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -7419,6 +7419,17 @@ content::SensorDelegate* ChromeContentBrowserClient::GetSensorDelegate() {
 std::unique_ptr<content::AuthenticatorRequestClientDelegate>
 ChromeContentBrowserClient::GetWebAuthenticationRequestDelegate(
     content::RenderFrameHost* render_frame_host) {
+  // Domicile's engine fork: no passkey UI. Chrome's WebAuthn dialog is drawn
+  // over the desktop by the browser, so a request is refused before it gets
+  // one -- content answers a null delegate with an error to the page. Unless
+  // an extension has taken the origin's requests with
+  // chrome.webAuthenticationProxy: content hands those to it before any
+  // dialog, but only once it has a delegate.
+  if (!GetWebAuthenticationDelegate()->MaybeGetRequestProxy(
+          render_frame_host->GetBrowserContext(),
+          render_frame_host->GetLastCommittedOrigin())) {
+    return nullptr;
+  }
   return AuthenticatorRequestScheduler::CreateRequestDelegate(
       render_frame_host);
 }
diff --git a/chrome/browser/webauthn/chrome_web_authentication_delegate.cc b/chrome/browser/webauthn/chrome_web_authentication_delegate.cc
index 0f9b546cbb..8d3bfe9875 100644
--- a/chrome/browser/webauthn/chrome_web_authentication_delegate.cc
+++ b/chrome/browser/webauthn/chrome_web_authentication_delegate.cc
@@ -257,66 +257,18 @@ void ChromeWebAuthenticationDelegate::
     IsUserVerifyingPlatformAuthenticatorAvailableOverride(
         content::RenderFrameHost* render_frame_host,
         base::OnceCallback<void(std::optional<bool>)> callback) {
-  const bool is_google =
-      render_frame_host->GetLastCommittedOrigin().DomainIs("google.com");
+  // Domicile's engine fork: no platform authenticator and no conditional UI,
+  // because the browser draws neither. A site that asks is told no, so it
+  // offers what a passkey extension lends it rather than a sign-in the
+  // browser would refuse. The testing API's answer still wins, as upstream.
   content::WebAuthenticationDelegate::
       IsUserVerifyingPlatformAuthenticatorAvailableOverride(
           render_frame_host,
           base::BindOnce(
-              [](base::WeakPtr<ChromeWebAuthenticationDelegate>
-                     web_authentication_delegate,
-                 base::WeakPtr<content::BrowserContext> browser_context,
-                 const bool is_google,
-                 base::OnceCallback<void(std::optional<bool>)> callback,
+              [](base::OnceCallback<void(std::optional<bool>)> callback,
                  std::optional<bool> testing_api_override) {
-                if (!browser_context || !web_authentication_delegate) {
-                  return;
-                }
-
-                // If the testing API is active, its override takes precedence.
-                if (testing_api_override) {
-                  std::move(callback).Run(*testing_api_override);
-                  return;
-                }
-
-                // Chrome disables platform authenticators in Guest sessions.
-                // They may be available (behind an additional interstitial) in
-                // Incognito mode.
-                Profile* profile =
-                    Profile::FromBrowserContext(browser_context.get());
-                if (profile->IsGuestSession()) {
-                  std::move(callback).Run(false);
-                  return;
-                }
-
-                // The enclave won't allow credentials for an account to be
-                // stored in GPM _in_ that account. So we don't want to tell
-                // accounts.google.com that there is a platform authenticator
-                // if we're later going to reject a create() request for that
-                // reason. Thus we have to be conservative with IsUVPAA
-                // responses on google.com and ignore the possibility of using
-                // the enclave authenticator.
-                if (is_google) {
-                  std::move(callback).Run(std::nullopt);
-                  return;
-                }
-
-                web_authentication_delegate->BrowserProvidedPasskeysAvailable(
-                    browser_context.get(),
-                    base::BindOnce(
-                        [](base::OnceCallback<void(std::optional<bool>)>
-                               callback,
-                           bool available) {
-                          if (available) {
-                            std::move(callback).Run(true);
-                            return;
-                          }
-                          std::move(callback).Run(std::nullopt);
-                        },
-                        std::move(callback)));
+                std::move(callback).Run(testing_api_override.value_or(false));
               },
-              weak_ptr_factory_.GetWeakPtr(),
-              render_frame_host->GetBrowserContext()->GetWeakPtr(), is_google,
               std::move(callback)));
 }
 
