+  // that exit cost was not the instructions: it was every pixel.
+  if (!headless::IsHeadlessMode() && PlatformPresentsEveryWindow()) {
     presentation_watchdog_timer_.Start(
         FROM_HERE, base::Milliseconds(1500),
         base::BindOnce(&ExclusiveAccessBubbleViews::OnPresentationTimeout,
diff --git a/ui/ozone/platform/drm/ozone_platform_drm.cc b/ui/ozone/platform/drm/ozone_platform_drm.cc
index 80b99ef..dff327e 100644
--- a/ui/ozone/platform/drm/ozone_platform_drm.cc
+++ b/ui/ozone/platform/drm/ozone_platform_drm.cc
@@ -238,6 +238,20 @@ class OzonePlatformDrm : public OzonePlatform {
 
     host_thread_ = base::PlatformThread::CurrentRef();
 
+    // ONE WINDOW PER CRTC REACHES THE SCREEN, AND THE REST ARE DROPPED.
+    // ScreenManager::FindWindowAt binds a window to a display controller only
+    // when the window's rectangle is EXACTLY the CRTC's, so a second top-level
+    // window -- a menu, a dialog, the fullscreen exit bubble -- takes
+    // DrmWindow::SchedulePageFlip's `if (!controller_)` branch and is answered
+    // gfx::PresentationFeedback::Failure() every frame for as long as it
+    // lives. Nothing is wrong when that happens; it is what this platform is.
+    //
+    // Set here rather than in InitializeGPU beside supports_native_pixmaps,
+    // because the process that has to know is the browser: out of
+    // single-process mode InitializeGPU never runs there, and a default that
+    // reached views would be the answer every windowed platform gives.
+    host_properties_.presents_every_window = false;
+
     device_manager_ = CreateDeviceManager();
     window_manager_ = std::make_unique<DrmWindowHostManager>();
     cursor_ = std::make_unique<DrmCursor>(window_manager_.get());
diff --git a/ui/ozone/public/ozone_platform.h b/ui/ozone/public/ozone_platform.h
index 4537244..d1ce2d9 100644
--- a/ui/ozone/public/ozone_platform.h
+++ b/ui/ozone/public/ozone_platform.h
@@ -211,6 +211,26 @@ class COMPONENT_EXPORT(OZONE) OzonePlatform {
     // ui::kStatusIconWmRoleName) are supported.
     bool supports_system_tray_windowing = false;
 
+    // Whether every window this platform takes a frame for can reach a
+    // display, or only some of them can.
+    //
+    // True wherever a window system is what puts pixels on a screen, which is
+    // why it is the default: the compositor hands a frame over and the server
+    // is answerable for it from there. False on ozone/drm, which IS the window
+    // system -- ScreenManager::FindWindowAt binds a window to a display
+    // controller only when the window's rectangle is EXACTLY
+    // gfx::Rect(controller->origin(), controller->GetModeSize()), so one
+    // window per CRTC is scanned out and every other one takes
+    // DrmWindow::SchedulePageFlip's `if (!controller_)` branch, which answers
+    // gfx::PresentationFeedback::Failure() for as long as the window lives.
+    //
+    // Ask before waiting on a window's presentation. A failed presentation
+    // keeps the successful-presentation callbacks pending rather than running
+    // them (cc/trees/presentation_time_callback_buffer.cc), so a timeout
+    // written to catch a wedged GPU is, on such a platform, a timer that
+    // always fires on a healthy one.
+    bool presents_every_window = true;
+
     // Allows overriding whether per window scaling is enabled in tests.
     static SupportsForTest override_supports_per_window_scaling_for_test;
 
