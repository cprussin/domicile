+bool LibInputEventConverter::HandleShellGesture(libinput_event* native_event) {
+  // libinput 1.19's hold gestures. Chromium's sysroot has an older libinput,
+  // whose header lacks them; the library on the machine sends them.
+  constexpr int kHoldBegin = 806;
+  constexpr int kHoldEnd = 807;
+  const int type = libinput_event_get_type(native_event);
+  NativeGesture gesture;
+  switch (type) {
+    case LIBINPUT_EVENT_GESTURE_SWIPE_BEGIN:
+    case LIBINPUT_EVENT_GESTURE_PINCH_BEGIN:
+    case kHoldBegin:
+      gesture.phase = NativeGesturePhase::kBegin;
+      break;
+    case LIBINPUT_EVENT_GESTURE_SWIPE_UPDATE:
+    case LIBINPUT_EVENT_GESTURE_PINCH_UPDATE:
+      gesture.phase = NativeGesturePhase::kUpdate;
+      break;
+    case LIBINPUT_EVENT_GESTURE_SWIPE_END:
+    case LIBINPUT_EVENT_GESTURE_PINCH_END:
+    case kHoldEnd:
+      gesture.phase = NativeGesturePhase::kEnd;
+      break;
+    default:
+      return false;
+  }
+  switch (type) {
+    case LIBINPUT_EVENT_GESTURE_SWIPE_BEGIN:
+    case LIBINPUT_EVENT_GESTURE_SWIPE_UPDATE:
+    case LIBINPUT_EVENT_GESTURE_SWIPE_END:
+      gesture.kind = NativeGestureKind::kSwipe;
+      break;
+    case LIBINPUT_EVENT_GESTURE_PINCH_BEGIN:
+    case LIBINPUT_EVENT_GESTURE_PINCH_UPDATE:
+    case LIBINPUT_EVENT_GESTURE_PINCH_END:
+      gesture.kind = NativeGestureKind::kPinch;
+      break;
+    default:
+      gesture.kind = NativeGestureKind::kHold;
+      break;
+  }
+  auto* event = libinput_event_get_gesture_event(native_event);
+  gesture.fingers =
+      static_cast<uint32_t>(libinput_event_gesture_get_finger_count(event));
+  switch (gesture.phase) {
+    case NativeGesturePhase::kBegin:
+      break;
+    case NativeGesturePhase::kUpdate:
+      gesture.dx = libinput_event_gesture_get_dx(event);
+      gesture.dy = libinput_event_gesture_get_dy(event);
+      if (gesture.kind == NativeGestureKind::kPinch) {
+        gesture.scale = libinput_event_gesture_get_scale(event);
+        gesture.rotation = libinput_event_gesture_get_angle_delta(event);
+      }
+      break;
+    case NativeGesturePhase::kEnd:
+      gesture.canceled = libinput_event_gesture_get_cancelled(event) != 0;
+      break;
+  }
+  // Two fingers are the page's, and a pinch the shell does not bind goes to
+  // the page too. A swipe or hold the shell does not bind goes nowhere: only
+  // the shell binds them.
+  const bool taken =
+      gesture.phase == NativeGesturePhase::kBegin
+          ? gesture.fingers >= kFewestShellGestureFingers &&
+                shell_gesture_.Begin(gesture)
+          : shell_gesture_.Continue(gesture);
+  return taken || gesture.kind != NativeGestureKind::kPinch;
+}
