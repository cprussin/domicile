index 8a9068b..096fe9c 100644
--- a/third_party/blink/renderer/bindings/generated_in_modules.gni
+++ b/third_party/blink/renderer/bindings/generated_in_modules.gni
@@ -2369,6 +2369,8 @@ generated_interface_sources_in_modules = [
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_extension.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_browser_window.cc",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_browser_window.h",
+  "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_cast_sink.cc",
+  "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_cast_sink.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_display.cc",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_display.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_shortcut_event.cc",
diff --git a/third_party/blink/renderer/bindings/idl_in_modules.gni b/third_party/blink/renderer/bindings/idl_in_modules.gni
index a59fcba..adc2c54 100644
--- a/third_party/blink/renderer/bindings/idl_in_modules.gni
+++ b/third_party/blink/renderer/bindings/idl_in_modules.gni
@@ -292,6 +292,7 @@ static_idl_files_in_modules = [
   "//third_party/blink/renderer/modules/domicile/domicile_fetch_header.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_fetch_response.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_browser_window.idl",
+  "//third_party/blink/renderer/modules/domicile/domicile_cast_sink.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_host.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_display.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_shortcut_event.idl",
