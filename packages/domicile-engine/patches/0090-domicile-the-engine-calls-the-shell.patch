From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] domicile: the engine calls the shell

The shell document no longer finds the desktop on `navigator.domicile`:
DomicileShell runs the shell itself and hands it the desktop, so neither
`navigator.domicile` nor `window.domicile` exists any more and their IDL
leaves the bindings list.

What cannot be a file under src/ is the hook that runs it: one line in
ModulesInitializer::OnClearWindowObjectInMainWorld, which every new
document's main world passes through before any of its script runs, and
which DomicileShell answers only for `domicile://shell/`.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on `crux`.
---
 third_party/blink/renderer/bindings/idl_in_modules.gni    | 2 --
 third_party/blink/renderer/modules/modules_initializer.cc | 2 ++
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/third_party/blink/renderer/bindings/idl_in_modules.gni b/third_party/blink/renderer/bindings/idl_in_modules.gni
--- a/third_party/blink/renderer/bindings/idl_in_modules.gni
+++ b/third_party/blink/renderer/bindings/idl_in_modules.gni
@@ -340,8 +340,6 @@ static_idl_files_in_modules = [
   "//third_party/blink/renderer/modules/domicile/domicile_notifications_event_init.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_locked_event.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_locked_event_init.idl",
-  "//third_party/blink/renderer/modules/domicile/navigator_domicile.idl",
-  "//third_party/blink/renderer/modules/domicile/window_domicile.idl",
   "//third_party/blink/renderer/modules/eyedropper/color_selection_options.idl",
   "//third_party/blink/renderer/modules/eyedropper/color_selection_result.idl",
   "//third_party/blink/renderer/modules/eyedropper/eye_dropper.idl",
diff --git a/third_party/blink/renderer/modules/modules_initializer.cc b/third_party/blink/renderer/modules/modules_initializer.cc
--- a/third_party/blink/renderer/modules/modules_initializer.cc
+++ b/third_party/blink/renderer/modules/modules_initializer.cc
@@ -60,6 +60,7 @@
 #include "third_party/blink/renderer/modules/dictation/dictation_agent_impl.h"
 #include "third_party/blink/renderer/modules/document_metadata/document_metadata_server.h"
 #include "third_party/blink/renderer/modules/document_picture_in_picture/picture_in_picture_controller_impl.h"
+#include "third_party/blink/renderer/modules/domicile/domicile_shell.h"
 #include "third_party/blink/renderer/modules/encryptedmedia/html_media_element_encrypted_media.h"
 #include "third_party/blink/renderer/modules/event_interface_modules_names.h"
 #include "third_party/blink/renderer/modules/event_modules_factory.h"
@@ -339,6 +340,7 @@ void ModulesInitializer::OnClearWindowObjectInMainWorld(
     Presentation::presentation(*window.navigator());
   }
   ManifestManager::From(window);
+  DomicileShell::Install(window);
 
 #if BUILDFLAG(IS_ANDROID)
   LocalFrame* frame = window.GetFrame();
-- 
