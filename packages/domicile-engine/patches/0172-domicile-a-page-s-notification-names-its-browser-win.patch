From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Fri, 6 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: a page's notification names its browser window

A page's Web Notification reached the desktop named only by its site's
origin, so the shell could not tell a site's own app window from its other
pages. Manganese's Gmail inbox notifies new mail itself, and wants to
clear what Gmail's page in that inbox's window sends, but not what a Gmail
page in another window sends.

- NotificationEventDispatcher::GetNonPersistentNotificationWebContents:
  the WebContents of the document a non-persistent notification's
  listener was registered with. Null once that document is gone, and for
  a worker's notification.
- NotificationPlatformBridgeLinux sends that page's browser window id as
  the `x-domicile-browser-window` hint, found through
  domicile::FindNotificationWindow, which //chrome/browser/domicile sets.
  Left out when no browser window's page showed it.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on `crux`. guard-notification-window.sh covers it.
---
 chrome/browser/notifications/BUILD.gn         |  4 ++++
 .../notification_platform_bridge_linux.cc     | 14 +++++++++++++
 .../notification_event_dispatcher_impl.cc     | 20 +++++++++++++++++++
 .../notification_event_dispatcher_impl.h      |  2 ++
 .../browser/notification_event_dispatcher.h   |  8 ++++++++
 5 files changed, 48 insertions(+)

diff --git a/chrome/browser/notifications/BUILD.gn b/chrome/browser/notifications/BUILD.gn
index 884370a..a4f80ee 100644
--- a/chrome/browser/notifications/BUILD.gn
+++ b/chrome/browser/notifications/BUILD.gn
@@ -338,6 +338,10 @@ source_set("impl") {
       deps += [
         "//chrome/app/theme:chrome_unscaled_resources_grit",
         "//chrome/browser/themes",
+
+        # Domicile's engine fork: which browser window a page's
+        # notification came from.
+        "//components/domicile:notification_window",
       ]
     }
   }
diff --git a/chrome/browser/notifications/notification_platform_bridge_linux.cc b/chrome/browser/notifications/notification_platform_bridge_linux.cc
index 498acbc..5a681f9 100644
--- a/chrome/browser/notifications/notification_platform_bridge_linux.cc
+++ b/chrome/browser/notifications/notification_platform_bridge_linux.cc
@@ -69,6 +69,7 @@
 #include "components/dbus/utils/read_value.h"
 #include "components/dbus/utils/variant.h"
 #include "components/dbus/xdg/portal.h"
+#include "components/domicile/browser/notification_window.h"
 #include "components/url_formatter/elide_url.h"
 #include "content/public/browser/browser_task_traits.h"
 #include "content/public/browser/browser_thread.h"
@@ -132,6 +133,8 @@ const char kCapabilityPersistence[] = "persistence";
 const char kCapabilityXKdeOriginName[] = "x-kde-origin-name";
 const char kCapabilityXKdeReplyPlaceholderText[] =
     "x-kde-reply-placeholder-text";
+// Domicile's engine fork: the hint naming a page's browser window.
+const char kDomicileBrowserWindowHint[] = "x-domicile-browser-window";
 
 // Button IDs.
 const char kCloseButtonId[] = "close";
@@ -1047,6 +1050,17 @@ class NotificationPlatformBridgeLinuxImpl : public NotificationPlatformBridge {
           dbus_utils::Variant::Wrap<"s">(std::move(context_display_text)));
     }
 
+    // Domicile's engine fork: the browser window whose page showed it, so
+    // the desktop can tell a site's window apart from its other pages.
+    if (notification_type == NotificationHandler::Type::WEB_NON_PERSISTENT) {
+      std::string window =
+          domicile::FindNotificationWindow(notification->id());
+      if (!window.empty()) {
+        hints.emplace(kDomicileBrowserWindowHint,
+                      dbus_utils::Variant::Wrap<"s">(std::move(window)));
+      }
+    }
+
     if (inline_reply_placeholder.has_value()) {
       hints.emplace(kCapabilityXKdeReplyPlaceholderText,
                     dbus_utils::Variant::Wrap<"s">(
diff --git a/content/browser/notifications/notification_event_dispatcher_impl.cc b/content/browser/notifications/notification_event_dispatcher_impl.cc
index a17db79..23328b7 100644
--- a/content/browser/notifications/notification_event_dispatcher_impl.cc
+++ b/content/browser/notifications/notification_event_dispatcher_impl.cc
@@ -22,6 +22,7 @@
 #include "content/public/browser/render_process_host.h"
 #include "content/public/browser/storage_partition.h"
 #include "content/public/browser/weak_document_ptr.h"
+#include "content/public/browser/web_contents.h"
 #include "content/public/common/persistent_notification_status.h"
 #include "third_party/blink/public/common/notifications/platform_notification_data.h"
 #include "third_party/blink/public/common/storage_key/storage_key.h"
@@ -591,6 +592,25 @@ void NotificationEventDispatcherImpl::OnNonPersistentCloseComplete(
   std::move(completed_closure).Run();
 }
 
+// Domicile's engine fork: none, for a dispatcher that keeps no documents.
+WebContents*
+NotificationEventDispatcher::GetNonPersistentNotificationWebContents(
+    const std::string& notification_id) {
+  return nullptr;
+}
+
+// Domicile's engine fork: the document the listener was registered with.
+WebContents*
+NotificationEventDispatcherImpl::GetNonPersistentNotificationWebContents(
+    const std::string& notification_id) {
+  auto listener = non_persistent_notification_listeners_.find(notification_id);
+  if (listener == non_persistent_notification_listeners_.end()) {
+    return nullptr;
+  }
+  RenderFrameHost* frame = listener->second.document.AsRenderFrameHostIfValid();
+  return frame ? WebContents::FromRenderFrameHost(frame) : nullptr;
+}
+
 void NotificationEventDispatcherImpl::
     HandleConnectionErrorForNonPersistentNotificationListener(
         const std::string& notification_id) {
diff --git a/content/browser/notifications/notification_event_dispatcher_impl.h b/content/browser/notifications/notification_event_dispatcher_impl.h
index 21d521b..cab83ec 100644
--- a/content/browser/notifications/notification_event_dispatcher_impl.h
+++ b/content/browser/notifications/notification_event_dispatcher_impl.h
@@ -57,6 +57,8 @@ class CONTENT_EXPORT NotificationEventDispatcherImpl
   void DispatchNonPersistentCloseEvent(
       const std::string& notification_id,
       base::OnceClosure completed_closure) override;
+  WebContents* GetNonPersistentNotificationWebContents(
+      const std::string& notification_id) override;
 
   // Registers the associated document weak pointer and the listener to receive
   // the show, click and close events of the non-persistent notification
diff --git a/content/public/browser/notification_event_dispatcher.h b/content/public/browser/notification_event_dispatcher.h
index bd89082..aeb5328 100644
--- a/content/public/browser/notification_event_dispatcher.h
+++ b/content/public/browser/notification_event_dispatcher.h
@@ -17,6 +17,7 @@ namespace content {
 
 class BrowserContext;
 enum class PersistentNotificationStatus;
+class WebContents;
 
 // This is the dispatcher to be used for firing events related to notifications.
 // This class is a singleton, the instance of which can be retrieved using the
@@ -65,6 +66,13 @@ class CONTENT_EXPORT NotificationEventDispatcher {
       const std::string& notification_id,
       base::OnceClosure completed_closure) = 0;
 
+  // Domicile's engine fork: the WebContents whose document showed
+  // non-persistent notification `notification_id`, so the desktop can tell
+  // which of its windows a notification came from. Null once that document
+  // is gone, and for one it never showed.
+  virtual WebContents* GetNonPersistentNotificationWebContents(
+      const std::string& notification_id);
+
  protected:
   virtual ~NotificationEventDispatcher() {}
 };
