 .../ozone/evdev/libinput_event_converter.cc   | 84 ++++++++++++++-----
 ui/events/types/BUILD.gn                      |  1 +
 .../wayland/host/wayland_event_source.cc      | 54 ++++++++++++
 .../wayland/host/wayland_event_source.h       |  7 ++
 .../platform/wayland/host/wayland_pointer.cc  |  5 +-
