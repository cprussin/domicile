diff --git a/ui/events/blink/web_input_event.cc b/ui/events/blink/web_input_event.cc
index 47601b4..fef0117 100644
--- a/ui/events/blink/web_input_event.cc
+++ b/ui/events/blink/web_input_event.cc
@@ -3,6 +3,7 @@
 // found in the LICENSE file.
 
 #include "ui/events/blink/web_input_event.h"
+#include "ui/events/domicile/scroll_metadata.h"
 
 #include <utility>
 
@@ -285,6 +286,16 @@ blink::WebMouseWheelEvent MakeWebMouseWheelEvent(const MouseWheelEvent& event) {
   const gfx::PointF screen_point = GetScreenLocationFromEvent(event);
   webkit_event.SetPositionInScreen(screen_point.x(), screen_point.y());
 
+  const NativeScrollMetadata metadata =
+      GetScrollMetadata(event, NativeScrollSource::kWheel);
+  webkit_event.native_scroll_source = metadata.source;
+  webkit_event.axis_stop_x = metadata.stop_x;
+  webkit_event.axis_stop_y = metadata.stop_y;
+  if (metadata.axis_distance) {
+    webkit_event.has_native_axis_distance = true;
+    webkit_event.native_axis_distance_x = (*metadata.axis_distance)[0];
+    webkit_event.native_axis_distance_y = (*metadata.axis_distance)[1];
+  }
   return webkit_event;
 }
 
@@ -309,6 +320,23 @@ blink::WebMouseWheelEvent MakeWebMouseWheelEvent(const ScrollEvent& event) {
   const gfx::PointF screen_point = GetScreenLocationFromEvent(event);
   webkit_event.SetPositionInScreen(screen_point.x(), screen_point.y());
 
+  const NativeScrollMetadata metadata =
+      GetScrollMetadata(event, NativeScrollSource::kFinger);
+  webkit_event.native_scroll_source = metadata.source;
+  webkit_event.axis_stop_x = metadata.stop_x;
+  webkit_event.axis_stop_y = metadata.stop_y;
+  if (metadata.axis_distance) {
+    webkit_event.has_native_axis_distance = true;
+    webkit_event.native_axis_distance_x = (*metadata.axis_distance)[0];
+    webkit_event.native_axis_distance_y = (*metadata.axis_distance)[1];
+  }
+  // Ozone reconstructs UI events without their ScrollEventPhase. Keep a native
+  // zero stop out of browser content's DOM wheel dispatch.
+  if ((metadata.stop_x || metadata.stop_y) && metadata.axis_distance &&
+      (*metadata.axis_distance)[0] == 0 && (*metadata.axis_distance)[1] == 0 &&
+      webkit_event.delta_x == 0 && webkit_event.delta_y == 0) {
+    webkit_event.phase = blink::WebMouseWheelEvent::kPhaseEnded;
+  }
   return webkit_event;
 }
 
@@ -475,9 +503,9 @@ blink::WebMouseWheelEvent MakeWebMouseWheelEventFromUiEvent(
   }
 
   webkit_event.wheel_ticks_x =
-      webkit_event.delta_x / MouseWheelEvent::kWheelDelta;
+      static_cast<float>(event.tick_120ths().x()) / 120;
   webkit_event.wheel_ticks_y =
-      webkit_event.delta_y / MouseWheelEvent::kWheelDelta;
+      static_cast<float>(event.tick_120ths().y()) / 120;
   webkit_event.tilt_x = event.pointer_details().tilt_x;
   webkit_event.tilt_y = event.pointer_details().tilt_y;
   webkit_event.force = event.pointer_details().force;
