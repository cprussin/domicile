diff --git a/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc b/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
index 0cd4983..d7c132d 100644
--- a/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
+++ b/third_party/blink/common/input/web_coalesced_input_event_mojom_traits.cc
@@ -5,6 +5,7 @@
 #include "third_party/blink/public/common/input/web_coalesced_input_event_mojom_traits.h"
 
 #include <algorithm>
+#include <cmath>
 #include <memory>
 
 #include "base/strings/string_util.h"
@@ -357,6 +358,25 @@ bool StructTraits<blink::mojom::EventDataView,
             static_cast<blink::WebMouseWheelEvent*>(mouse_event);
         blink::mojom::WheelDataPtr& wheel_data =
             pointer_data->mouse_data->wheel_data;
+        if (wheel_data->native_scroll_source >
+            static_cast<uint8_t>(ui::NativeScrollSource::kWheelTilt)) {
+          return false;
+        }
+        wheel_event->native_scroll_source = static_cast<ui::NativeScrollSource>(
+            wheel_data->native_scroll_source);
+        wheel_event->axis_stop_x = wheel_data->axis_stop_x;
+        wheel_event->axis_stop_y = wheel_data->axis_stop_y;
+        if (wheel_data->has_native_axis_distance &&
+            (!std::isfinite(wheel_data->native_axis_distance_x) ||
+             !std::isfinite(wheel_data->native_axis_distance_y))) {
+          return false;
+        }
+        wheel_event->has_native_axis_distance =
+            wheel_data->has_native_axis_distance;
+        wheel_event->native_axis_distance_x =
+            wheel_data->native_axis_distance_x;
+        wheel_event->native_axis_distance_y =
+            wheel_data->native_axis_distance_y;
         wheel_event->delta_x = wheel_data->delta_x;
         wheel_event->delta_y = wheel_data->delta_y;
         wheel_event->wheel_ticks_x = wheel_data->wheel_ticks_x;
@@ -438,7 +458,12 @@ StructTraits<blink::mojom::EventDataView,
     const blink::WebMouseWheelEvent* wheel_event =
         static_cast<const blink::WebMouseWheelEvent*>(mouse_event);
     wheel_data = blink::mojom::WheelData::New(
-        wheel_event->delta_x, wheel_event->delta_y, wheel_event->wheel_ticks_x,
+        static_cast<uint8_t>(wheel_event->native_scroll_source),
+        wheel_event->axis_stop_x, wheel_event->axis_stop_y,
+        wheel_event->has_native_axis_distance,
+        wheel_event->native_axis_distance_x,
+        wheel_event->native_axis_distance_y, wheel_event->delta_x,
+        wheel_event->delta_y, wheel_event->wheel_ticks_x,
         wheel_event->wheel_ticks_y, wheel_event->acceleration_ratio_x,
         wheel_event->acceleration_ratio_y, wheel_event->phase,
         wheel_event->momentum_phase, wheel_event->dispatch_type,
diff --git a/third_party/blink/common/input/web_mouse_wheel_event.cc b/third_party/blink/common/input/web_mouse_wheel_event.cc
index 9c5ab49..3dcb76c 100644
--- a/third_party/blink/common/input/web_mouse_wheel_event.cc
+++ b/third_party/blink/common/input/web_mouse_wheel_event.cc
@@ -34,6 +34,11 @@ bool WebMouseWheelEvent::CanCoalesce(const WebInputEvent& event) const {
 
   return GetModifiers() == mouse_wheel_event.GetModifiers() &&
          delta_units == mouse_wheel_event.delta_units &&
+         native_scroll_source == mouse_wheel_event.native_scroll_source &&
+         has_native_axis_distance ==
+             mouse_wheel_event.has_native_axis_distance &&
+         !axis_stop_x && !axis_stop_y && !mouse_wheel_event.axis_stop_x &&
+         !mouse_wheel_event.axis_stop_y &&
          HaveConsistentPhase(mouse_wheel_event);
 }
 
@@ -67,6 +72,8 @@ void WebMouseWheelEvent::Coalesce(const WebInputEvent& event) {
       GetUnacceleratedDelta(delta_y, acceleration_ratio_y) +
       GetUnacceleratedDelta(mouse_wheel_event.delta_y,
                             mouse_wheel_event.acceleration_ratio_y);
+  const double old_native_axis_distance_x = native_axis_distance_x;
+  const double old_native_axis_distance_y = native_axis_distance_y;
   float old_deltaX = delta_x;
   float old_deltaY = delta_y;
   float old_wheelTicksX = wheel_ticks_x;
@@ -76,6 +83,8 @@ void WebMouseWheelEvent::Coalesce(const WebInputEvent& event) {
   WebMouseWheelEvent::Phase old_phase = phase;
   WebInputEvent::DispatchType old_dispatch_type = dispatch_type;
   *this = mouse_wheel_event;
+  native_axis_distance_x += old_native_axis_distance_x;
+  native_axis_distance_y += old_native_axis_distance_y;
   delta_x += old_deltaX;
   delta_y += old_deltaY;
   wheel_ticks_x += old_wheelTicksX;
diff --git a/third_party/blink/public/common/input/web_mouse_wheel_event.h b/third_party/blink/public/common/input/web_mouse_wheel_event.h
index 5174190..7de4407 100644
--- a/third_party/blink/public/common/input/web_mouse_wheel_event.h
+++ b/third_party/blink/public/common/input/web_mouse_wheel_event.h
@@ -6,6 +6,7 @@
 #define THIRD_PARTY_BLINK_PUBLIC_COMMON_INPUT_WEB_MOUSE_WHEEL_EVENT_H_
 
 #include "third_party/blink/public/common/input/web_mouse_event.h"
+#include "ui/events/types/native_scroll_source.h"
 #include "ui/events/types/scroll_types.h"
 
 namespace blink {
@@ -59,6 +60,13 @@ class BLINK_COMMON_EXPORT WebMouseWheelEvent : public WebMouseEvent {
   float wheel_ticks_x = 0.0f;
   float wheel_ticks_y = 0.0f;
 
+  ui::NativeScrollSource native_scroll_source = ui::NativeScrollSource::kWheel;
+  bool axis_stop_x = false;
+  bool axis_stop_y = false;
+  bool has_native_axis_distance = false;
+  double native_axis_distance_x = 0;
+  double native_axis_distance_y = 0;
+
   float acceleration_ratio_x = 1.0f;
   float acceleration_ratio_y = 1.0f;
 
diff --git a/third_party/blink/public/mojom/input/input_handler.mojom b/third_party/blink/public/mojom/input/input_handler.mojom
index cf1a0b7..13022a9 100644
--- a/third_party/blink/public/mojom/input/input_handler.mojom
+++ b/third_party/blink/public/mojom/input/input_handler.mojom
@@ -73,6 +73,12 @@ struct PointerData {
 };
 
 struct WheelData {
+  uint8 native_scroll_source;
+  bool axis_stop_x;
+  bool axis_stop_y;
+  bool has_native_axis_distance;
+  double native_axis_distance_x;
+  double native_axis_distance_y;
   float delta_x;
   float delta_y;
   float wheel_ticks_x;
diff --git a/third_party/blink/renderer/core/input/mouse_wheel_event_manager.cc b/third_party/blink/renderer/core/input/mouse_wheel_event_manager.cc
index 3c3ddfd..ea0aa44 100644
--- a/third_party/blink/renderer/core/input/mouse_wheel_event_manager.cc
+++ b/third_party/blink/renderer/core/input/mouse_wheel_event_manager.cc
@@ -12,6 +12,7 @@
 #include "third_party/blink/renderer/core/events/wheel_event.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
 #include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/html/domicile/html_app_element.h"
 #include "third_party/blink/renderer/core/input/event_handler.h"
 #include "third_party/blink/renderer/core/input/event_handling_util.h"
 #include "third_party/blink/renderer/core/layout/hit_test_request.h"
@@ -53,6 +54,13 @@ WebInputEventResult MouseWheelEventManager::HandleWheelEvent(
 
   if ((event.phase & kWheelEventPhaseEndedEventMask) ||
       (event.momentum_phase & kWheelEventPhaseEndedEventMask)) {
+    // Native clients need axis termination; browser content keeps its existing
+    // phase-end handling without a DOM wheel event.
+    if ((event.axis_stop_x || event.axis_stop_y) &&
+        IsA<HTMLAppElement>(wheel_target_.Get())) {
+      wheel_target_->DispatchEvent(*WheelEvent::Create(
+          event, *wheel_target_->GetDocument().domWindow()));
+    }
     UpdateWheelTarget(/*wheel_target=*/nullptr);
     return WebInputEventResult::kNotHandled;
   }
