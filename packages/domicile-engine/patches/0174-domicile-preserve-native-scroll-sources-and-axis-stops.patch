@@ -373,6 +374,8 @@ void EventFactoryEvdev::DispatchMouseWheelEvent(
   event.set_location_f(params.location);
   event.set_root_location_f(params.location);
   event.set_source_device_id(params.device_id);
+  SetScrollMetadata(event, params.native_scroll_source, false, false,
+                    params.native_axis_distance);
   DispatchUiEvent(&event);
 }
 
@@ -400,6 +403,8 @@ void EventFactoryEvdev::DispatchScrollEvent(const ScrollEventParams& params) {
   event.set_location_f(params.location);
   event.set_root_location_f(params.location);
   event.set_source_device_id(params.device_id);
+  SetScrollMetadata(event, params.native_scroll_source, params.axis_stop_x,
+                    params.axis_stop_y, params.native_axis_distance);
   DispatchUiEvent(&event);
 }
 
diff --git a/ui/events/ozone/evdev/libinput_event_converter.cc b/ui/events/ozone/evdev/libinput_event_converter.cc
index f8b87d7..efeb7f9 100644
