@@ -257,9 +260,8 @@ void LibInputEventConverter::LibInputDevice::LogConfigStatus(
                  << key << " is not supported (requested " << value << ")";
       break;
     case LIBINPUT_CONFIG_STATUS_INVALID:
-      LOG(ERROR) << "libinput " << libinput_device_get_name(device_)
+      LOG(FATAL) << "libinput " << libinput_device_get_name(device_)
                  << ": invalid " << key << " = " << value;
-      break;
   }
 }
 
@@ -453,7 +455,11 @@ LibInputEventConverter::LibInputEventConverter(
       context_(std::move(ctx)),
       device_(context_.AddDevice(id, path)) {}
 
-LibInputEventConverter::~LibInputEventConverter() {}
+LibInputEventConverter::~LibInputEventConverter() {
+  if (typing_guard_) {
+    typing_guard_->RemoveDevice(input_device_.id);
+  }
+}
 
 void LibInputEventConverter::ApplyDeviceSettings(
     const InputDeviceSettingsEvdev& settings) {
@@ -587,35 +593,55 @@ void LibInputEventConverter::HandlePointerAxis(const LibInputEvent& evt) {
   // `MouseWheelEvent`, the way every other platform delivers one. Dispatched
   // as a scroll it would move a page by libinput's degrees -- 15 pixels a
   // click -- and fling like a pad.
-  if (libinput_event_pointer_get_axis_source(event) ==
-      LIBINPUT_POINTER_AXIS_SOURCE_WHEEL) {
+  const auto source = libinput_event_pointer_get_axis_source(event);
+  if (source == LIBINPUT_POINTER_AXIS_SOURCE_WHEEL ||
+      source == LIBINPUT_POINTER_AXIS_SOURCE_WHEEL_TILT) {
     HandleWheel(evt);
     return;
   }
 
-  if (typing_guard_ && typing_applies_ &&
-      typing_guard_->DropsMotion(Timestamp(evt), input_device_.id)) {
-    return;
-  }
-
   const auto h = GetAxisValue(event, LIBINPUT_POINTER_AXIS_SCROLL_HORIZONTAL);
   const auto v = GetAxisValue(event, LIBINPUT_POINTER_AXIS_SCROLL_VERTICAL);
+  const bool stop_x = libinput_event_pointer_has_axis(
+                          event, LIBINPUT_POINTER_AXIS_SCROLL_HORIZONTAL) &&
+                      h == 0;
+  const bool stop_y = libinput_event_pointer_has_axis(
+                          event, LIBINPUT_POINTER_AXIS_SCROLL_VERTICAL) &&
+                      v == 0;
+  const bool drop_motion =
+      typing_guard_ && typing_applies_ &&
+      typing_guard_->DropsMotion(Timestamp(evt), input_device_.id);
+  if (drop_motion && !stop_x && !stop_y) {
+    return;
+  }
   // Two fingers on the pad go through the accelerator, which also carries
   // the fraction this used to truncate away. Anything else -- a wheel, a
   // trackpoint's scroll button -- is dispatched as libinput reports it.
-  const gfx::Vector2d delta =
-      libinput_event_pointer_get_axis_source(event) ==
-              LIBINPUT_POINTER_AXIS_SOURCE_FINGER
-          ? scroll_accelerator_.Scroll(
-                gfx::Vector2dF(static_cast<float>(h), static_cast<float>(v)),
-                Timestamp(evt))
-          : gfx::Vector2d(h, v);
+  const gfx::Vector2dF raw_delta =
+      drop_motion ? gfx::Vector2dF() : gfx::Vector2dF(h, v);
+  scroll_accelerator_.Stop(stop_x, stop_y);
+  const gfx::Vector2dF delta =
+      source == LIBINPUT_POINTER_AXIS_SOURCE_FINGER && !raw_delta.IsZero()
+          ? scroll_accelerator_.Scroll(raw_delta, Timestamp(evt))
+          : gfx::Vector2dF(ScaleScrollAxis(raw_delta.x(), scroll_factor_),
+                           ScaleScrollAxis(raw_delta.y(), scroll_factor_));
 
   DVLOG(3) << "Pointer axis h:" << h << ", v:" << v;
 
-  dispatcher_->DispatchScrollEvent({input_device_.id, EventType::kScroll,
-                                    cursor_->GetLocation(), delta, delta, 2,
-                                    Timestamp(evt)});
+  ScrollEventParams params(input_device_.id, EventType::kScroll,
+                           cursor_->GetLocation(), delta, delta, 2,
+                           Timestamp(evt));
+  params.native_scroll_source = source == LIBINPUT_POINTER_AXIS_SOURCE_FINGER
+                                    ? NativeScrollSource::kFinger
+                                    : NativeScrollSource::kContinuous;
+  params.axis_stop_x = stop_x;
+  params.axis_stop_y = stop_y;
+  // A native client runs its own kinetic scrolling, as on any compositor, so
+  // it gets libinput's linear distance. Accelerated, its fling overshoots.
+  params.native_axis_distance =
+      std::array<double, 2>{ScaleScrollAxis(raw_delta.x(), scroll_factor_),
+                            ScaleScrollAxis(raw_delta.y(), scroll_factor_)};
