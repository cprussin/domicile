diff --git a/ui/events/ozone/evdev/event_device_info.cc b/ui/events/ozone/evdev/event_device_info.cc
index c7ba170c..96c62fc0 100644
--- a/ui/events/ozone/evdev/event_device_info.cc
+++ b/ui/events/ozone/evdev/event_device_info.cc
@@ -740,6 +740,7 @@ bool EventDeviceInfo::HasDirect() const {
 
     case LegacyAbsoluteDeviceType::TABLET:
     case LegacyAbsoluteDeviceType::TOUCHPAD:
+    case LegacyAbsoluteDeviceType::MOUSE:
     case LegacyAbsoluteDeviceType::NONE:
       return false;
   }
@@ -759,6 +760,7 @@ bool EventDeviceInfo::HasPointer() const {
       return true;
 
     case LegacyAbsoluteDeviceType::TOUCHSCREEN:
+    case LegacyAbsoluteDeviceType::MOUSE:
     case LegacyAbsoluteDeviceType::NONE:
       return false;
   }
@@ -890,6 +892,11 @@ bool EventDeviceInfo::HasPointingStick() const {
   return HasRelXY() && HasProp(INPUT_PROP_POINTING_STICK);
 }
 
+bool EventDeviceInfo::HasAbsoluteMouse() const {
+  return !HasProp(INPUT_PROP_DIRECT) && !HasProp(INPUT_PROP_POINTER) &&
+         ProbeLegacyAbsoluteDevice() == LegacyAbsoluteDeviceType::MOUSE;
+}
+
 bool EventDeviceInfo::HasTouchpad() const {
   return HasAbsXY() && HasPointer() && !HasStylus();
 }
@@ -1043,8 +1050,15 @@ EventDeviceInfo::ProbeLegacyAbsoluteDevice() const {
 
   // ABS_Z mitigation for extra device on some Elo devices.
   if (HasKeyEvent(BTN_LEFT) && !HasAbsEvent(ABS_Z) &&
-      !IsDenylistedAbsoluteMouseDevice(input_id_))
-    return LegacyAbsoluteDeviceType::TOUCHSCREEN;
+      !IsDenylistedAbsoluteMouseDevice(input_id_)) {
+    // DOMICILE: a second button is a mouse's; a touch is one button. As a
+    // touchscreen, QEMU's USB tablet clicks as a tap and has no wheel, right
+    // or middle button, or hover. udev's `input_id` reads it as a mouse too.
+    // A touchscreen that clicks with `BTN_LEFT` alone, like the Elo, stays
+    // one.
+    return HasKeyEvent(BTN_RIGHT) ? LegacyAbsoluteDeviceType::MOUSE
+                                  : LegacyAbsoluteDeviceType::TOUCHSCREEN;
+  }
 
   return LegacyAbsoluteDeviceType::NONE;
 }
