                         GetLocationWithoutLock());
 }
 
+void DrmCursor::SetDomicileAbsoluteAreas(
+    base::flat_map<int, gfx::Rect> areas) {
+  DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
+  base::AutoLock lock(lock_);
+  absolute_areas_ = std::move(areas);
+}
+
 void DrmCursor::MoveCursorTo(gfx::AcceleratedWidget window,
                              const gfx::PointF& location) {
   TRACE_EVENT0("drmcursor", "DrmCursor::MoveCursorTo (window)");
@@ -271,8 +278,16 @@ void DrmCursor::MoveCursorToOnEvdevThread(const gfx::PointF& screen_location) {
 
   base::AutoLock lock(lock_);
 
-  // TODO(spang): Moving between windows doesn't work here, but
-  // is not needed for current uses.
+  // DOMICILE: onto the window under `screen_location`. An absolute mouse bound
+  // to another display moves the pointer there, and clamped into this window
+  // it would stop at the edge.
+  const std::optional<PointerHeard> under = PointerHeardAt(
+      screens_, layout_, gfx::kNullAcceleratedWidget, screen_location);
+  if (under.has_value() && under->window != window_) {
+    CrossLocked({under->window, under->location});
+    return;
+  }
+
   SetCursorLocationLocked(screen_location -
                           display_bounds_in_screen_.OffsetFromOrigin());
 
@@ -328,6 +343,14 @@ gfx::Rect DrmCursor::GetCursorConfinedBounds() {
   return confined_bounds_ + display_bounds_in_screen_.OffsetFromOrigin();
 }
 
+gfx::Rect DrmCursor::GetDomicileAbsoluteArea(int device_id) {
+  base::AutoLock lock(lock_);
+  const auto area = absolute_areas_.find(device_id);
+  return area != absolute_areas_.end()
+             ? area->second
+             : confined_bounds_ + display_bounds_in_screen_.OffsetFromOrigin();
+}
+
 void DrmCursor::InitializeOnEvdev() {
   DCHECK_CALLED_ON_VALID_THREAD(evdev_thread_checker_);
   base::AutoLock lock(lock_);
