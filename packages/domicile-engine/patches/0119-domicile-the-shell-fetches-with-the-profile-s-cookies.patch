From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 00:00:00 +0000
Subject: [PATCH] domicile: the shell fetches with the profile's cookies

ShellFetch GETs an https address from the browser process with the
cookies of the shell's profile, and can add the SAPISIDHASH Google's
first-party APIs take. It binds only for the shell's origin, like the
browser windows.

Blink lists DomicileFetchHeader and DomicileFetchResponse, the
dictionaries `DomicileHost.fetchWithCookies()` takes and resolves with.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on `crux`.
---
 .../browser/chrome_browser_interface_binders.cc | 17 +++++++++++++++++
 .../renderer/bindings/generated_in_modules.gni  |  4 ++++
 .../blink/renderer/bindings/idl_in_modules.gni  |  2 ++
 3 files changed, 23 insertions(+)

diff --git a/chrome/browser/chrome_browser_interface_binders.cc b/chrome/browser/chrome_browser_interface_binders.cc
index 378da36..9a226b5 100644
--- a/chrome/browser/chrome_browser_interface_binders.cc
+++ b/chrome/browser/chrome_browser_interface_binders.cc
@@ -9,6 +9,7 @@
 #include "chrome/browser/domicile/domicile_browser_windows.h"
 #include "chrome/browser/domicile/domicile_extension_tray.h"
 #include "chrome/browser/domicile/domicile_pointer_warp.h"
+#include "chrome/browser/domicile/domicile_shell_fetch.h"
 #include "chrome/browser/domicile/domicile_tab_helpers.h"
 #include "components/domicile/browser/app_channel.h"
 #include "components/domicile/browser/app_roots.h"
@@ -640,6 +641,22 @@ void PopulateChromeFrameBinders(
         domicile::BindBrowserWindows(frame, std::move(receiver));
       }));
 
+  // Domicile's engine fork: GETs with the profile's cookies, for the shell.
+  //
+  // Gated at BIND time like the browser windows, and for their reason: a page
+  // that could reach this could read any site as the signed-in user.
+  map->Add<domicile::mojom::ShellFetch>(base::BindRepeating(
+      [](content::RenderFrameHost* frame,
+         mojo::PendingReceiver<domicile::mojom::ShellFetch> receiver) {
+        if (!domicile::IsShellOrigin(frame->GetLastCommittedOrigin())) {
+          mojo::ReportBadMessage(
+              "domicile: only the shell may fetch with the profile's "
+              "cookies.");
+          return;
+        }
+        domicile::BindShellFetch(frame, std::move(receiver));
+      }));
+
   // Domicile's engine fork: an app module's channel to the compositor, system
   // calls only. See docs/architecture/APP-MODULES.md.
   //
