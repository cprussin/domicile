From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 00:00:00 +0000
Subject: [PATCH] domicile: only the shell's origin binds the shell's
 interfaces, and an app gets its own channel

An app module is a domicile:// document too (docs/architecture/
APP-MODULES.md), so the four binders that checked the scheme now check
the shell's origin: the control channel, guests, the extension tray and
the browser windows.

An app gets an AppChannel instead, which carries system calls only. It
binds for a document on an app's origin in a window pinned to that app;
the origin alone is not enough, because an app's host follows from its
path.

ModulesInitializer runs DomicileApp beside DomicileShell, and Blink lists
DomicileAppHost's IDL file and generated bindings.
---
 chrome/browser/BUILD.gn                       |  6 +-
 .../chrome_browser_interface_binders.cc       | 60 +++++++++++++------
 .../bindings/generated_in_modules.gni         |  2 +
 .../renderer/bindings/idl_in_modules.gni      |  1 +
 .../renderer/modules/modules_initializer.cc   |  2 +
 5 files changed, 53 insertions(+), 18 deletions(-)

diff --git a/chrome/browser/BUILD.gn b/chrome/browser/BUILD.gn
index a4e64d9b..0664a98c 100644
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -2712,12 +2712,16 @@ source_set("browser") {
     # Domicile's engine fork: serving the shell over domicile://, the
     # shell's control channel to the compositor, the keymap and the color
     # scheme that channel carries, the socket a running engine is told
-    # which shell to serve on, and the browser's offers turned off.
+    # which shell to serve on, the browser's offers turned off, and app
+    # modules' channels.
     "//chrome/browser/domicile",
+    "//components/domicile:app_channel",
+    "//components/domicile:app_roots",
     "//components/domicile:color_scheme",
     "//components/domicile:control_channel",
     "//components/domicile:desktop_prefs",
     "//components/domicile:keyboard_layout",
+    "//components/domicile:shell_origin",
     "//components/domicile:shell_scheme",
     "//components/domicile:web_view_guest",
 
diff --git a/chrome/browser/chrome_browser_interface_binders.cc b/chrome/browser/chrome_browser_interface_binders.cc
index 4b81cf73..378da363 100644
--- a/chrome/browser/chrome_browser_interface_binders.cc
+++ b/chrome/browser/chrome_browser_interface_binders.cc
@@ -10,9 +10,12 @@
 #include "chrome/browser/domicile/domicile_extension_tray.h"
 #include "chrome/browser/domicile/domicile_pointer_warp.h"
 #include "chrome/browser/domicile/domicile_tab_helpers.h"
+#include "components/domicile/browser/app_channel.h"
+#include "components/domicile/browser/app_roots.h"
 #include "components/domicile/browser/color_scheme.h"
 #include "components/domicile/browser/control_channel.h"
 #include "components/domicile/browser/keyboard_layout.h"
+#include "components/domicile/browser/shell_origin.h"
 #include "components/domicile/browser/web_view_guest.h"
 #include "content/public/browser/browser_thread.h"
 #include "mojo/public/cpp/bindings/message.h"
@@ -503,21 +506,21 @@ void PopulateChromeFrameBinders(
   //
   // THE CHECK IN THE CALLBACK IS THE WHOLE OF THE ACCESS CONTROL. It works
   // because domicile:// is registered neither web-safe nor CORS-enabled, so no
-  // ordinary web content can hold that origin, and because a document's
-  // committed origin is fixed by the time it can ask for anything. If it is
+  // ordinary web content can hold the shell's origin, because no <webview> may
+  // show domicile://shell (MayShowInWebView), and because a document's
+  // committed origin is fixed by the time it can ask for anything. The shell's
+  // origin and not the scheme: an app module is domicile:// too. If it is
   // ever loosened, this is worse than the loopback TCP port it replaced,
   // because it looks safe.
   map->Add<domicile::mojom::ControlChannel>(base::BindRepeating(
       [](content::RenderFrameHost* frame,
          mojo::PendingReceiver<domicile::mojom::ControlChannel> receiver) {
-        if (frame->GetLastCommittedOrigin().scheme() !=
-            domicile::kDomicileScheme) {
+        if (!domicile::IsShellOrigin(frame->GetLastCommittedOrigin())) {
           // Not the shell. Reporting it rather than dropping quietly: a
           // document that is not the shell asking for the desktop's control
           // plane is not a mistake to absorb.
           mojo::ReportBadMessage(
-              "domicile: only a domicile:// document may control the "
-              "compositor.");
+              "domicile: only the shell may control the compositor.");
           return;
         }
         // On the IO thread: the channel talks to a unix socket through
@@ -591,10 +594,9 @@ void PopulateChromeFrameBinders(
   map->Add<domicile::mojom::WebViewGuestHost>(base::BindRepeating(
       [](content::RenderFrameHost* frame,
          mojo::PendingReceiver<domicile::mojom::WebViewGuestHost> receiver) {
-        if (frame->GetLastCommittedOrigin().scheme() !=
-            domicile::kDomicileScheme) {
+        if (!domicile::IsShellOrigin(frame->GetLastCommittedOrigin())) {
           mojo::ReportBadMessage(
-              "domicile: only a domicile:// document may ask for a guest.");
+              "domicile: only the shell may ask for a guest.");
           return;
         }
         // AND EVERY GUEST IS A TAB. The helpers an extension finds a tab by
@@ -615,11 +617,9 @@ void PopulateChromeFrameBinders(
   map->Add<domicile::mojom::ExtensionTray>(base::BindRepeating(
       [](content::RenderFrameHost* frame,
          mojo::PendingReceiver<domicile::mojom::ExtensionTray> receiver) {
-        if (frame->GetLastCommittedOrigin().scheme() !=
-            domicile::kDomicileScheme) {
+        if (!domicile::IsShellOrigin(frame->GetLastCommittedOrigin())) {
           mojo::ReportBadMessage(
-              "domicile: only a domicile:// document may hold the extension "
-              "tray.");
+              "domicile: only the shell may hold the extension tray.");
           return;
         }
         domicile::BindExtensionTray(frame, std::move(receiver));
@@ -632,16 +632,42 @@ void PopulateChromeFrameBinders(
   map->Add<domicile::mojom::BrowserWindows>(base::BindRepeating(
       [](content::RenderFrameHost* frame,
          mojo::PendingReceiver<domicile::mojom::BrowserWindows> receiver) {
-        if (frame->GetLastCommittedOrigin().scheme() !=
-            domicile::kDomicileScheme) {
+        if (!domicile::IsShellOrigin(frame->GetLastCommittedOrigin())) {
           mojo::ReportBadMessage(
-              "domicile: only a domicile:// document may hold the browser "
-              "windows.");
+              "domicile: only the shell may hold the browser windows.");
           return;
         }
         domicile::BindBrowserWindows(frame, std::move(receiver));
       }));
 
+  // Domicile's engine fork: an app module's channel to the compositor, system
+  // calls only. See docs/architecture/APP-MODULES.md.
+  //
+  // Gated at BIND time like the shell's channel. Both conditions are the
+  // access control: the document is on an app's origin, and its window was
+  // opened for that app (WebViewGuest::PinToApp). An app's host follows from
+  // its path, so the origin alone could be any directory's.
+  map->Add<domicile::mojom::AppChannel>(base::BindRepeating(
+      [](content::RenderFrameHost* frame,
+         mojo::PendingReceiver<domicile::mojom::AppChannel> receiver) {
+        const url::Origin& origin = frame->GetLastCommittedOrigin();
+        const domicile::WebViewGuest* guest =
+            domicile::WebViewGuest::FromWebContents(
+                content::WebContents::FromRenderFrameHost(frame));
+        if (origin.scheme() != domicile::kDomicileScheme ||
+            !domicile::IsAppHost(origin.host()) || guest == nullptr ||
+            guest->app_host() != origin.host()) {
+          mojo::ReportBadMessage(
+              "domicile: only an app's own document, in its own window, may "
+              "hold an app channel.");
+          return;
+        }
+        // On the IO thread, for the shell's channel's reason.
+        content::GetIOThreadTaskRunner({})->PostTask(
+            FROM_HERE,
+            base::BindOnce(&domicile::BindAppChannel, std::move(receiver)));
+      }));
+
   map->Add<image_annotation::mojom::Annotator>(&BindImageAnnotator);
 
   map->Add<blink::mojom::ScriptToolHost>(
