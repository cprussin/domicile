 ui/ozone/platform/headless/headless_screen.cc | 23 +++++++
 ui/ozone/platform/headless/headless_screen.h  |  4 ++
 .../headless/ozone_platform_headless.cc       | 63 ++++++++++++++++++-
 4 files changed, 97 insertions(+), 2 deletions(-)

