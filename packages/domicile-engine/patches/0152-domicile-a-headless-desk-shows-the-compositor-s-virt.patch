diff --git a/ui/ozone/platform/headless/headless_screen.cc b/ui/ozone/platform/headless/headless_screen.cc
index 8d7bd27..69e8d2f 100644
--- a/ui/ozone/platform/headless/headless_screen.cc
+++ b/ui/ozone/platform/headless/headless_screen.cc
@@ -240,4 +240,27 @@ bool HeadlessScreen::IsHeadless() const {
   return true;
 }
 
+void HeadlessScreen::SetDomicileDesk(
+    const std::vector<Display>& displays) {
+  CHECK(!displays.empty()) << "a screen always has a primary display";
+  // Primary first: DisplayList::AddDisplay DCHECKs it, as DrmScreen notes.
+  base::flat_set<int64_t> still_here;
+  DisplayList::Type type = DisplayList::Type::PRIMARY;
+  for (const Display& display : displays) {
+    display_list_.AddOrUpdateDisplay(display, type);
+    still_here.insert(display.id());
+    type = DisplayList::Type::NOT_PRIMARY;
+  }
+  // Collected first: RemoveDisplay erases from the list being read.
+  std::vector<int64_t> gone;
+  for (const Display& display : display_list_.displays()) {
+    if (!still_here.contains(display.id())) {
+      gone.push_back(display.id());
+    }
+  }
+  for (const int64_t id : gone) {
+    display_list_.RemoveDisplay(id);
+  }
+}
+
 }  // namespace ui
diff --git a/ui/ozone/platform/headless/headless_screen.h b/ui/ozone/platform/headless/headless_screen.h
index 2dfb61f..d652977 100644
