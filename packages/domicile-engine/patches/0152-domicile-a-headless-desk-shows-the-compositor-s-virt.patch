+++ b/ui/ozone/platform/headless/headless_screen.h
@@ -51,6 +51,10 @@ class HeadlessScreen : public PlatformScreen,
   void RemoveObserver(display::DisplayObserver* observer) override;
   bool IsHeadless() const override;
 
+  // DOMICILE: replaces the display list with a desk's, primary first. See
+  // ui/ozone/platform/headless/domicile/headless_desk.h.
+  void SetDomicileDesk(const std::vector<display::Display>& displays);
+
  private:
   void CreateDisplayList();
 
diff --git a/ui/ozone/platform/headless/ozone_platform_headless.cc b/ui/ozone/platform/headless/ozone_platform_headless.cc
index 559973c..6ac568e 100644
--- a/ui/ozone/platform/headless/ozone_platform_headless.cc
+++ b/ui/ozone/platform/headless/ozone_platform_headless.cc
@@ -5,9 +5,14 @@
 #include "ui/ozone/platform/headless/ozone_platform_headless.h"
 
 #include <memory>
+#include <optional>
+#include <string>
+#include <vector>
 
 #include "base/command_line.h"
+#include "base/containers/flat_map.h"
 #include "base/files/file_path.h"
+#include "base/memory/raw_ptr.h"
 #include "base/no_destructor.h"
 #include "build/build_config.h"
 #include "build/chromecast_buildflags.h"
@@ -17,8 +22,10 @@
 #include "ui/events/ozone/layout/keyboard_layout_engine_manager.h"
 #include "ui/events/ozone/layout/stub/stub_keyboard_layout_engine.h"
 #include "ui/events/platform/platform_event_source.h"
+#include "ui/gfx/display_color_spaces.h"
 #include "ui/ozone/common/bitmap_cursor_factory.h"
 #include "ui/ozone/common/stub_overlay_manager.h"
+#include "ui/ozone/platform/headless/domicile/headless_desk.h"
 #include "ui/ozone/platform/headless/headless_screen.h"
 #include "ui/ozone/platform/headless/headless_surface_factory.h"
 #include "ui/ozone/platform/headless/headless_window.h"
@@ -100,7 +107,36 @@ class OzonePlatformHeadlessImpl : public OzonePlatformHeadless {
   std::unique_ptr<PlatformScreen> CreateScreen() override {
     return std::make_unique<HeadlessScreen>();
   }
-  void InitScreen(PlatformScreen* screen) override {}
+  void InitScreen(PlatformScreen* screen) override {
+    if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+            kDomicileHeadlessDesk)) {
+      return;
+    }
+    // DOMICILE: the screen is Domicile's desk. What it shows before the
+    // compositor adds a display stays as the placeholder. See
+    // ui/ozone/platform/headless/domicile/headless_desk.h.
+    desk_screen_ = static_cast<HeadlessScreen*>(screen);
+    placeholder_ = desk_screen_->GetPrimaryDisplay();
+    ShowDesk();
+  }
+  // DOMICILE: where the compositor places each display.
+  void SetDomicileDisplayLayout(
+      const std::vector<DomicileDisplayLayout>& layout) override {
+    layout_ = layout;
+    ShowDesk();
+  }
+  // DOMICILE: the compositor's monitors, the only ones a headless desk has.
+  void SetDomicileVirtualDisplays(
+      std::vector<DomicileVirtualDisplay> displays) override {
+    virtual_ = std::move(displays);
+    ShowDesk();
+  }
+  base::flat_map<int64_t, std::string> GetDomicileConnectors() const override {
+    return connectors_;
+  }
+  const PlatformRuntimeProperties& GetPlatformRuntimeProperties() override {
+    return properties_;
+  }
   std::unique_ptr<InputMethod> CreateInputMethod(
       ImeKeyEventDispatcher* ime_key_event_dispatcher,
       gfx::AcceleratedWidget widget) override {
@@ -120,6 +156,12 @@ class OzonePlatformHeadlessImpl : public OzonePlatformHeadless {
 #endif
 
   bool InitializeUI(const InitParams& params) override {
+    // DOMICILE: a desk's captures show only the shell's windows, so a popup or
+    // tooltip is drawn inside its window, as on DRM. See
+    // PlatformRuntimeProperties::presents_every_window.
+    properties_.presents_every_window =
+        !base::CommandLine::ForCurrentProcess()->HasSwitch(
+            kDomicileHeadlessDesk);
     window_manager_ = std::make_unique<HeadlessWindowManager>();
     surface_factory_ = std::make_unique<HeadlessSurfaceFactory>(file_path_);
     // This unbreaks tests that create their own.
@@ -143,6 +185,18 @@ class OzonePlatformHeadlessImpl : public OzonePlatformHeadless {
   }
 
  private:
+  // DOMICILE: shows the desk the compositor's displays and layout make. Does
+  // nothing before `InitScreen`, or without the desk switch.
+  void ShowDesk() {
+    if (!desk_screen_) {
+      return;
+    }
+    HeadlessDesk desk = HeadlessDeskOf(*placeholder_, virtual_, layout_);
+    // Before the list changes, so its observers read the new connectors.
+    connectors_ = std::move(desk.connectors);
+    desk_screen_->SetDomicileDesk(desk.displays);
+  }
+
   std::unique_ptr<KeyboardLayoutEngine> keyboard_layout_engine_;
   std::unique_ptr<HeadlessWindowManager> window_manager_;
   std::unique_ptr<HeadlessSurfaceFactory> surface_factory_;
@@ -152,6 +206,13 @@ class OzonePlatformHeadlessImpl : public OzonePlatformHeadless {
   std::unique_ptr<GpuPlatformSupportHost> gpu_platform_support_host_;
   std::unique_ptr<OverlayManagerOzone> overlay_manager_;
   base::FilePath file_path_;
+  PlatformRuntimeProperties properties_;
+  // DOMICILE: the desk's screen, set by `InitScreen` with the desk switch.
+  raw_ptr<HeadlessScreen> desk_screen_ = nullptr;
+  std::optional<display::Display> placeholder_;
+  std::vector<DomicileVirtualDisplay> virtual_;
+  std::vector<DomicileDisplayLayout> layout_;
+  base::flat_map<int64_t, std::string> connectors_;
 };
 
 }  // namespace
