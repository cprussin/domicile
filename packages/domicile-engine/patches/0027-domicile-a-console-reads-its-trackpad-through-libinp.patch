 #include "ui/events/ozone/evdev/libinput_event_converter.h"
 
+#include <errno.h>
 #include <fcntl.h>
 
+#include <memory>
 #include <ostream>
 #include <string>
+#include <utility>
 
+#include "base/compiler_specific.h"
 #include "base/logging.h"
 #include "base/strings/string_util.h"
 #include "base/strings/stringprintf.h"
@@ -168,12 +172,14 @@ void LibInputEventConverter::LibInputDevice::SetTapToClickEnabled(
 
 LibInputEventConverter::LibInputContext::LibInputContext(
     LibInputContext&& other)
-    : li_(other.li_) {
+    : li_(other.li_), opened_(std::move(other.opened_)) {
   other.li_ = nullptr;
 }
 
-LibInputEventConverter::LibInputContext::LibInputContext(libinput* const li)
-    : li_(li) {
+LibInputEventConverter::LibInputContext::LibInputContext(
+    libinput* const li,
+    std::unique_ptr<OpenedDevice> opened)
+    : li_(li), opened_(std::move(opened)) {
   DCHECK(li_);
   libinput_log_set_handler(li_, LogHandler);
   libinput_log_set_priority(li_, LIBINPUT_LOG_PRIORITY_DEBUG);
@@ -186,14 +192,22 @@ LibInputEventConverter::LibInputContext::~LibInputContext() {
 }
 
 std::optional<LibInputEventConverter::LibInputContext>
-LibInputEventConverter::LibInputContext::Create() {
-  libinput* const li = libinput_path_create_context(&interface_, nullptr);
+LibInputEventConverter::LibInputContext::Create(base::ScopedFD fd) {
+  // THE POINTER, NOT THE CONTEXT, IS WHAT libinput KEEPS. It stores this as
+  // its user data and hands it back to `OpenRestricted` below; the context
+  // that owns the allocation is moved out of this function, so anything
+  // addressed relative to `this` would dangle by the time libinput asked.
+  auto opened = std::make_unique<OpenedDevice>();
+  opened->fd = std::move(fd);
+
+  libinput* const li = libinput_path_create_context(&interface_, opened.get());
   if (!li) {
     LOG(ERROR) << "libinput_path_create_context failed";
     return std::nullopt;
   }
 
-  return std::make_optional(LibInputEventConverter::LibInputContext(li));
+  return std::make_optional(
+      LibInputEventConverter::LibInputContext(li, std::move(opened)));
 }
 
 std::optional<LibInputEventConverter::LibInputDevice>
@@ -234,9 +248,21 @@ LibInputEventConverter::LibInputContext::NextEvent() const {
 int LibInputEventConverter::LibInputContext::OpenRestricted(const char* path,
                                                             int flags,
                                                             void* user_data) {
-  VLOG(1) << "Open input: " << path;
-  int fd = open(path, flags);
-  return fd;
+  // NOT `open(path, flags)`, WHICH IS WHAT THIS USED TO BE. On a console the
+  // browser is not root and holds no device node: logind opened this one and
+  // passed the descriptor over, and opening it again by name answers EACCES.
+  // One device per context is this class's own rule -- its header says so --
+  // so there is exactly one descriptor to hand over and a second ask is a bug
+  // rather than a case to fall back for.
+  auto* const opened = static_cast<OpenedDevice*>(user_data);
+  if (!opened || !opened->fd.is_valid()) {
+    LOG(ERROR) << "libinput asked for " << path
+               << " and this context has no descriptor left to give it";
+    return -EACCES;
+  }
+
+  VLOG(1) << "Open input: " << path << " (on the descriptor logind gave us)";
+  return opened->fd.release();
 }
 
 void LibInputEventConverter::LibInputContext::CloseRestricted(int fd,
@@ -249,17 +275,26 @@ void LibInputEventConverter::LibInputContext::LogHandler(
     enum libinput_log_priority priority,
     const char* format,
     va_list args) {
+  // SAFETY: `format` and `args` are libinput's own, handed to the log handler
+  // it was given: libinput's contract is a null-terminated printf format and
+  // the arguments that go with it, and this callback is reachable from
+  // nowhere else. The compiler cannot see that, so it refuses a format
+  // function whose format is not a literal -- a refusal that had never fired
+  // here because this file had never been compiled outside ChromeOS.
   switch (priority) {
     case LIBINPUT_LOG_PRIORITY_DEBUG:
-      VLOG(4) << "libinput: " << base::StringPrintV(format, args);
+      VLOG(4) << "libinput: "
+              << UNSAFE_BUFFERS(base::StringPrintV(format, args));
       break;
 
     case LIBINPUT_LOG_PRIORITY_INFO:
-      VLOG(1) << "libinput: " << base::StringPrintV(format, args);
+      VLOG(1) << "libinput: "
+              << UNSAFE_BUFFERS(base::StringPrintV(format, args));
       break;
 
     case LIBINPUT_LOG_PRIORITY_ERROR:
-      LOG(ERROR) << "libinput: " << base::StringPrintV(format, args);
+      LOG(ERROR) << "libinput: "
+                 << UNSAFE_BUFFERS(base::StringPrintV(format, args));
       break;
   }
 }
@@ -268,12 +303,13 @@ constexpr libinput_interface
     LibInputEventConverter::LibInputContext::interface_;
 
