 chrome/browser/ui/dialogs/browser_dialogs.h          |  9 +++++++++
 .../ui/views/permissions/chooser_bubble_ui.cc        |  5 +++++
 .../blink/renderer/bindings/generated_in_core.gni    |  4 ++++
 third_party/blink/renderer/bindings/idl_in_core.gni  |  2 ++
 third_party/blink/renderer/core/html/build.gni       |  2 ++
 6 files changed, 34 insertions(+)

diff --git a/chrome/browser/ui/dialogs/browser_dialogs.cc b/chrome/browser/ui/dialogs/browser_dialogs.cc
index 75e0992d..1117464e 100644
--- a/chrome/browser/ui/dialogs/browser_dialogs.cc
+++ b/chrome/browser/ui/dialogs/browser_dialogs.cc
@@ -33,6 +33,18 @@ void ShowWindowNamePromptForTesting(BrowserWindowInterface* browser,
 #endif
 
 #if defined(TOOLKIT_VIEWS)
+namespace {
+DeviceChooserOverride g_device_chooser_override = nullptr;
+}  // namespace
+
+void SetDeviceChooserOverride(DeviceChooserOverride show) {
+  g_device_chooser_override = show;
+}
+
+DeviceChooserOverride GetDeviceChooserOverride() {
+  return g_device_chooser_override;
+}
+
 void ShowTabModal(std::unique_ptr<ui::DialogModel> dialog_model,
                   content::WebContents* web_contents) {
   constrained_window::ShowWebModal(std::move(dialog_model), web_contents);
diff --git a/chrome/browser/ui/dialogs/browser_dialogs.h b/chrome/browser/ui/dialogs/browser_dialogs.h
index 37710070..19cd50d0 100644
--- a/chrome/browser/ui/dialogs/browser_dialogs.h
+++ b/chrome/browser/ui/dialogs/browser_dialogs.h
@@ -141,6 +141,15 @@ base::OnceClosure ShowDeviceChooserDialog(
     content::RenderFrameHost* owner,
     std::unique_ptr<permissions::ChooserController> controller);
 bool IsDeviceChooserShowingForTesting(BrowserWindowInterface* browser);
+
+// DOMICILE: shows device choosers in place of Chrome's bubble, which anchors to
+// a browser window that a <webview> guest has none of. Set once, before any
+// page asks. See //chrome/browser/domicile/domicile_device_chooser.h.
+using DeviceChooserOverride = base::OnceClosure (*)(
+    content::RenderFrameHost* owner,
+    std::unique_ptr<permissions::ChooserController> controller);
+void SetDeviceChooserOverride(DeviceChooserOverride show);
+DeviceChooserOverride GetDeviceChooserOverride();
 #endif
 
 // Show the prompt to set a window name for browser's window, optionally with
diff --git a/chrome/browser/ui/views/permissions/chooser_bubble_ui.cc b/chrome/browser/ui/views/permissions/chooser_bubble_ui.cc
index 6f672ac2..58ae6377 100644
--- a/chrome/browser/ui/views/permissions/chooser_bubble_ui.cc
+++ b/chrome/browser/ui/views/permissions/chooser_bubble_ui.cc
@@ -329,6 +329,11 @@ base::OnceClosure ShowDeviceChooserDialogForExtension(
 base::OnceClosure ShowDeviceChooserDialog(
     content::RenderFrameHost* owner,
     std::unique_ptr<permissions::ChooserController> controller) {
+  // DOMICILE: see SetDeviceChooserOverride.
+  if (DeviceChooserOverride show = GetDeviceChooserOverride()) {
+    return show(owner, std::move(controller));
+  }
+
   content::WeakDocumentPtr weak_document = owner->GetWeakDocumentPtr();
   auto* contents = content::WebContents::FromRenderFrameHost(owner);
 
