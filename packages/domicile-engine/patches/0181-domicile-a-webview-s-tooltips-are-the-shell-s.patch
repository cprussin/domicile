From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Fri, 6 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: a webview's tooltips are the shell's

Chrome drew a page's tooltips (a `title` attribute under the pointer)
with its own native tooltip window. A <webview>'s guest now hands each
to its element instead, and the shell draws it.

- `render_widget_host_delegate.{h,cc}`, `web_contents_impl.{h,cc}`,
  `web_contents_delegate.{h,cc}`: DomicileTooltip, from a render widget
  to its WebContents' delegate, naming the widget. True means the
  delegate shows it. A frame in another process, such as an extension's
  iframe, is its own widget, with its own coordinates.
- `render_widget_host_impl.cc`: UpdateTooltipUnderCursor asks it first
  and draws nothing when the delegate shows the tooltip.
---
 .../browser/renderer_host/render_widget_host_delegate.cc   | 5 +++++
 .../browser/renderer_host/render_widget_host_delegate.h    | 5 +++++
 content/browser/renderer_host/render_widget_host_impl.cc   | 5 +++++
 content/browser/web_contents/web_contents_impl.cc          | 5 +++++
 content/browser/web_contents/web_contents_impl.h           | 2 ++
 content/public/browser/web_contents_delegate.cc            | 6 ++++++
 content/public/browser/web_contents_delegate.h             | 7 +++++++
 7 files changed, 35 insertions(+)

diff --git a/content/browser/renderer_host/render_widget_host_delegate.cc b/content/browser/renderer_host/render_widget_host_delegate.cc
index 51fa48d..257811f 100644
--- a/content/browser/renderer_host/render_widget_host_delegate.cc
+++ b/content/browser/renderer_host/render_widget_host_delegate.cc
@@ -206,6 +206,11 @@ bool RenderWidgetHostDelegate::ShouldDoLearning() {
   return true;
 }
 
+bool RenderWidgetHostDelegate::DomicileTooltip(RenderWidgetHostImpl* widget,
+                                               const std::u16string& text) {
+  return false;
+}
+
 #if BUILDFLAG(IS_ANDROID)
 gfx::PointF RenderWidgetHostDelegate::GetCurrentTouchSequenceOffset() {
   return gfx::PointF();
diff --git a/content/browser/renderer_host/render_widget_host_delegate.h b/content/browser/renderer_host/render_widget_host_delegate.h
index 9d7adba..dd040a0 100644
--- a/content/browser/renderer_host/render_widget_host_delegate.h
+++ b/content/browser/renderer_host/render_widget_host_delegate.h
@@ -412,6 +412,11 @@ class CONTENT_EXPORT RenderWidgetHostDelegate {
   // shouldn't be used to improve typing suggestions for the user.
   virtual bool ShouldDoLearning();
 
+  // Domicile: the tooltip under the pointer in `widget` is now `text` ("" for
+  // none). True when the delegate shows it itself, so the view draws none.
+  virtual bool DomicileTooltip(RenderWidgetHostImpl* widget,
+                               const std::u16string& text);
+
 #if BUILDFLAG(IS_ANDROID)
   // Get the offset for the current touch sequence. e.g. visible top controls or
   // side UI will result in a nonzero offset being added to touch events.
diff --git a/content/browser/renderer_host/render_widget_host_impl.cc b/content/browser/renderer_host/render_widget_host_impl.cc
index dac75ae..187461d 100644
--- a/content/browser/renderer_host/render_widget_host_impl.cc
+++ b/content/browser/renderer_host/render_widget_host_impl.cc
@@ -3058,6 +3058,11 @@ void RenderWidgetHostImpl::UpdateTooltipUnderCursor(
     return;
   }
 
+  // Domicile: a <webview>'s shell draws its page's tooltips.
+  if (delegate_ && delegate_->DomicileTooltip(this, tooltip_text)) {
+    return;
+  }
+
   view_->UpdateTooltipUnderCursor(
       GetWrappedTooltipText(tooltip_text, text_direction_hint));
 }
diff --git a/content/browser/web_contents/web_contents_impl.cc b/content/browser/web_contents/web_contents_impl.cc
index 9fa62ad..ba8a904 100644
--- a/content/browser/web_contents/web_contents_impl.cc
+++ b/content/browser/web_contents/web_contents_impl.cc
@@ -5515,6 +5515,11 @@ bool WebContentsImpl::IsFullscreen() {
   return delegate_ && delegate_->IsFullscreenForTabOrPending(this);
 }
 
+bool WebContentsImpl::DomicileTooltip(RenderWidgetHostImpl* widget,
+                                      const std::u16string& text) {
+  return delegate_ && delegate_->DomicileTooltip(this, widget, text);
+}
+
 bool WebContentsImpl::ShouldShowStaleContentOnEviction() {
   if (WasDiscarded()) {
     return false;
diff --git a/content/browser/web_contents/web_contents_impl.h b/content/browser/web_contents/web_contents_impl.h
index 31c5a06..577e0a5 100644
--- a/content/browser/web_contents/web_contents_impl.h
+++ b/content/browser/web_contents/web_contents_impl.h
@@ -1168,6 +1168,8 @@ class CONTENT_EXPORT WebContentsImpl
                                 float ratio) override;
   void SetTopControlsGestureScrollInProgress(bool in_progress) override;
   void RenderWidgetCreated(RenderWidgetHostImpl* render_widget_host) override;
+  bool DomicileTooltip(RenderWidgetHostImpl* widget,
+                       const std::u16string& text) override;
   void RenderWidgetDeleted(RenderWidgetHostImpl* render_widget_host) override;
   void RenderWidgetWasResized(RenderWidgetHostImpl* render_widget_host,
                               bool width_changed) override;
diff --git a/content/public/browser/web_contents_delegate.cc b/content/public/browser/web_contents_delegate.cc
index 0b44d8b..ec5d8d7 100644
--- a/content/public/browser/web_contents_delegate.cc
+++ b/content/public/browser/web_contents_delegate.cc
@@ -211,6 +211,12 @@ bool WebContentsDelegate::IsFullscreenForTabOrPending(
   return false;
 }
 
+bool WebContentsDelegate::DomicileTooltip(WebContents* source,
+                                          RenderWidgetHost* widget,
+                                          const std::u16string& text) {
+  return false;
+}
+
 FullscreenState WebContentsDelegate::GetFullscreenState(
     const WebContents* web_contents) const {
   FullscreenState state;
diff --git a/content/public/browser/web_contents_delegate.h b/content/public/browser/web_contents_delegate.h
index b3c8934..2fadec5 100644
--- a/content/public/browser/web_contents_delegate.h
+++ b/content/public/browser/web_contents_delegate.h
@@ -572,6 +572,13 @@ class CONTENT_EXPORT WebContentsDelegate {
   // can name the page that keeps the screens on.
   virtual void ScreenWakeLockChanged(WebContents* source, bool held) {}
 
+  // Domicile: the tooltip under the pointer in `widget`, which draws some of
+  // `source`'s frames, is now `text` ("" for none). Return true to show it
+  // yourself; Chrome then draws none.
+  virtual bool DomicileTooltip(WebContents* source,
+                               RenderWidgetHost* widget,
+                               const std::u16string& text);
+
   // Returns true if `web_contents` is, or is transitioning to, tab-fullscreen.
   virtual bool IsFullscreenForTabOrPending(const WebContents* web_contents);
 
