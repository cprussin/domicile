+  base::AutoLock lock(lock_);
+  return PointerInWindow(screens_, layout_, screen_location, window);
+}
+
+void DrmCursor::SetDomicileDeskHost(gfx::AcceleratedWidget host) {
+  DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
+  base::AutoLock lock(lock_);
+  desk_host_ = host;
+}
+
 void DrmCursor::MoveCursorTo(gfx::AcceleratedWidget window,
                              const gfx::PointF& location) {
   TRACE_EVENT0("drmcursor", "DrmCursor::MoveCursorTo (window)");
   DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
   base::AutoLock lock(lock_);
+  // DOMICILE: A WARP GOES WHERE THE DESK PUTS IT. The page a desk is asks for
+  // the pointer in its host window's pixels, and anywhere on the desk is
+  // somewhere past that window's edge: on the monitor that holds it, as a hand
+  // moving there would be. Clamped into the host's own window, a warp to
+  // another monitor pulled the pointer back onto the host's, and a shell that
+  // warps on a focus change chased it there over and over.
+  if (const std::optional<PointerCrossing> crossing =
+          PointerCrossingFor(screens_, layout_, window, location)) {
+    CrossLocked(*crossing);
+    return;
+  }
   gfx::AcceleratedWidget old_window = window_;
 
   if (window != old_window) {
