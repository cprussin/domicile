@@ -485,8 +494,17 @@ uint32_t DrmWindowHost::DispatchEvent(const PlatformEvent& event) {
         window_manager_->MouseOnWindow(window_on_mouse);
     }
 
-    gfx::PointF location = located_event->location_f();
-    location -= gfx::Vector2dF(bounds_.OffsetFromOrigin());
+    // DOMICILE: THE DESK'S HOST HEARS THE POINTER WHERE THE DESK HAS IT,
+    // whichever monitor it is on. Upstream tells a window the pointer's place
+    // on the engine's row less its own corner -- panel pixels, every CRTC at
+    // y = 0 -- which on a desk of turned monitors at other densities is
+    // somewhere else entirely. On the host's own monitor it is the upstream
+    // arithmetic. See `PointerInWindow`.
+    const gfx::PointF location =
+        event->IsMouseEvent() || event->IsScrollEvent()
+            ? cursor_->ToWindow(widget_, located_event->location_f())
+            : located_event->location_f() -
+                  gfx::Vector2dF(bounds_.OffsetFromOrigin());
     located_event->set_location_f(location);
