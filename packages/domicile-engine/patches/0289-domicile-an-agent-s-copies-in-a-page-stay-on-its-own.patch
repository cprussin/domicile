+// domicile: while one lives, Clipboard::GetForCurrentThread() on this thread
+// answers `to`, a clipboard beside the thread's own: an agent's, for a copy or
+// paste in a page the agent drove. Null answers the thread's own. Nests.
+class COMPONENT_EXPORT(UI_BASE_CLIPBOARD) ScopedClipboardRedirect {
+ public:
+  explicit ScopedClipboardRedirect(Clipboard* to);
+
+  ScopedClipboardRedirect(const ScopedClipboardRedirect&) = delete;
+  ScopedClipboardRedirect& operator=(const ScopedClipboardRedirect&) = delete;
+
+  ~ScopedClipboardRedirect();
+
+ private:
+  raw_ptr<Clipboard> previous_;
+};
+
 }  // namespace ui
 
