--- a/ui/ozone/platform/drm/host/drm_cursor.cc
+++ b/ui/ozone/platform/drm/host/drm_cursor.cc
@@ -4,8 +4,11 @@
 
 #include "ui/ozone/platform/drm/host/drm_cursor.h"
 
+#include <algorithm>
 #include <memory>
+#include <optional>
 #include <utility>
+#include <vector>
 
 #include "base/memory/scoped_refptr.h"
 #include "base/task/current_thread.h"
@@ -102,6 +105,8 @@ void DrmCursor::OnWindowAdded(gfx::AcceleratedWidget window,
   DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
   base::AutoLock lock(lock_);
 
+  screens_.push_back({window, bounds_in_screen, display::Display::ROTATE_0});
+
   if (window_ == gfx::kNullAcceleratedWidget) {
     // First window added & cursor is not placed. Place it.
     window_ = window;
@@ -116,6 +121,10 @@ void DrmCursor::OnWindowRemoved(gfx::AcceleratedWidget window) {
   DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
   base::AutoLock lock(lock_);
 
+  std::erase_if(screens_, [window](const PointerScreen& screen) {
+    return screen.window == window;
+  });
+
   if (window_ == window) {
     // Try to find a new location for the cursor.
     DrmWindowHost* dest_window = window_manager_->GetPrimaryWindow();
@@ -144,6 +153,11 @@ void DrmCursor::CommitBoundsChange(
   DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
   base::AutoLock lock(lock_);
 
+  // Every window's, not only the one under the cursor: a hotplug moves the
+  // screens beside it too, and a stale rectangle is a pointer that crosses
+  // onto nothing or cannot cross at all.
+  ScreenLocked(window).bounds_in_screen = new_display_bounds_in_screen;
+
   if (window_ == window) {
     display_bounds_in_screen_ = new_display_bounds_in_screen;
     confined_bounds_ = new_confined_bounds;
@@ -154,6 +168,13 @@ void DrmCursor::CommitBoundsChange(
   }
 }
 
+void DrmCursor::OnWindowTurned(gfx::AcceleratedWidget window,
+                               display::Display::Rotation rotation) {
+  DCHECK_CALLED_ON_VALID_THREAD(ui_thread_checker_);
+  base::AutoLock lock(lock_);
+  ScreenLocked(window).rotation = rotation;
+}
+
 void DrmCursor::MoveCursorTo(gfx::AcceleratedWidget window,
                              const gfx::PointF& location) {
   TRACE_EVENT0("drmcursor", "DrmCursor::MoveCursorTo (window)");
@@ -238,8 +259,18 @@ void DrmCursor::MoveCursor(const gfx::Vector2dF& delta) {
   gfx::Vector2dF transformed_delta = delta;
   ui::CursorController::GetInstance()->ApplyCursorConfigForWindow(
       window_, &transformed_delta);
-  SetCursorLocationLocked(location_ + transformed_delta);
-  SendCursorMoveLocked();
+  // DOMICILE: a pointer at the edge of one monitor goes on to the next.
+  // Upstream this is ash's `ExtendedMouseWarpController`, and without ash
+  // the clamp below holds the pointer on whichever monitor it started on.
+  const gfx::PointF moved = location_ + transformed_delta;
+  const std::optional<PointerCrossing> crossing =
+      PointerCrossingFor(screens_, window_, moved);
+  if (crossing.has_value()) {
+    CrossLocked(*crossing);
+  } else {
+    SetCursorLocationLocked(moved);
+    SendCursorMoveLocked();
+  }
 }
 
 bool DrmCursor::IsCursorVisible() {
@@ -274,6 +305,28 @@ void DrmCursor::SetCursorLocationLocked(const gfx::PointF& location)
   location_ = clamped_location;
 }
 
+PointerScreen& DrmCursor::ScreenLocked(gfx::AcceleratedWidget window)
+    EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+  const auto screen =
+      std::ranges::find(screens_, window, &PointerScreen::window);
+  CHECK(screen != screens_.end());
+  return *screen;
+}
+
+// What `MoveCursorTo(window, location)` does for a window it moves onto, from
+// the thread a hand's motion arrives on. The window's own confinement is the
+// UI thread's to read, so it gets the whole window, which is what
+// `DrmWindowHost::GetCursorConfinedBounds` answers when nothing confined it.
+void DrmCursor::CrossLocked(const PointerCrossing& crossing)
+    EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+  SendCursorHideLocked();
+  window_ = crossing.window;
+  display_bounds_in_screen_ = ScreenLocked(crossing.window).bounds_in_screen;
+  confined_bounds_ = gfx::Rect(display_bounds_in_screen_.size());
+  SetCursorLocationLocked(crossing.location);
+  SendCursorShowLocked();
+}
+
 void DrmCursor::SendCursorShowLocked() EXCLUSIVE_LOCKS_REQUIRED(lock_) {
   if (!cursor_ || cursor_->type() == CursorType::kNone) {
     SendCursorHideLocked();
