 class SkBitmap;
 
@@ -76,6 +78,11 @@ class DrmCursor : public CursorDelegateEvdev {
                           const gfx::Rect& new_display_bounds_in_screen,
                           const gfx::Rect& new_confined_bounds);
 
+  // DOMICILE: which way the display under `window` is turned, so a pointer
+  // leaves it by the edge a hand was moving toward. See `PointerCrossingFor`.
+  void OnWindowTurned(gfx::AcceleratedWidget window,
+                      display::Display::Rotation rotation);
+
   // CursorDelegateEvdev:
   void MoveCursorTo(gfx::AcceleratedWidget window,
                     const gfx::PointF& location) override;
@@ -91,6 +98,8 @@ class DrmCursor : public CursorDelegateEvdev {
   void SendCursorShowLocked();
   void SendCursorHideLocked();
   void SendCursorMoveLocked();
+  PointerScreen& ScreenLocked(gfx::AcceleratedWidget window);
+  void CrossLocked(const PointerCrossing& crossing);
 
   void MoveCursorToOnEvdevThread(const gfx::PointF& screen_location);
   void MoveCursorToOnUiThread(const gfx::PointF& screen_location);
@@ -131,6 +140,11 @@ class DrmCursor : public CursorDelegateEvdev {
   // The bounds that the cursor is confined to in |window|.
   gfx::Rect confined_bounds_ GUARDED_BY(lock_);
 
+  // DOMICILE: every window the cursor could move onto. Kept here rather than
+  // asked of `window_manager_` because a hand's motion arrives on the evdev
+  // thread and the window manager is the UI thread's.
+  std::vector<PointerScreen> screens_ GUARDED_BY(lock_);
+
   const raw_ptr<DrmWindowHostManager> window_manager_
       GUARDED_BY_CONTEXT(ui_thread_checker_);  // Not owned.
 
diff --git a/ui/ozone/platform/drm/host/drm_window_host.cc b/ui/ozone/platform/drm/host/drm_window_host.cc
index 25da4460f4..1d1808cb40 100644
--- a/ui/ozone/platform/drm/host/drm_window_host.cc
+++ b/ui/ozone/platform/drm/host/drm_window_host.cc
@@ -22,6 +22,7 @@
 #include "ui/events/platform/platform_event_source.h"
 #include "ui/ozone/common/bitmap_cursor.h"
 #include "ui/ozone/platform/drm/domicile/drm_fullscreen.h"
+#include "ui/ozone/platform/drm/domicile/drm_pointer_crossing.h"
 #include "ui/ozone/platform/drm/host/drm_cursor.h"
 #include "ui/ozone/platform/drm/host/drm_display_host.h"
 #include "ui/ozone/platform/drm/host/drm_display_host_manager.h"
@@ -417,6 +418,13 @@ bool DrmWindowHost::CanDispatchEvent(const PlatformEvent& event) {
   }
 
   // TODO(spang): For non-ash builds we would need smarter keyboard focus.
+  //
+  // DOMICILE: a desk of several monitors is a window each, and every one of
+  // them said yes here, so the first window added took every key. The
+  // keyboard is on the monitor the pointer is on; see `HasTheKeyboard`.
+  if (event->IsKeyEvent()) {
+    return HasTheKeyboard(bounds_, cursor_->GetLocation());
+  }
   return true;
 }
 
@@ -524,10 +532,12 @@ void DrmWindowHost::FollowDisplayTurn() {
   // `panel_rotation`, which is what ash hands CursorController too, and the
   // scale left at one: the pointer is tracked in the panel's own pixels, and
   // a monitor's density is no reason for a hand to move it faster.
-  CursorController::GetInstance()->SetCursorConfigForWindow(
-      widget_,
-      display::Screen::Get()->GetDisplayMatching(bounds_).panel_rotation(),
-      /*scale=*/1.f);
+  const display::Display::Rotation turn =
+      display::Screen::Get()->GetDisplayMatching(bounds_).panel_rotation();
+  CursorController::GetInstance()->SetCursorConfigForWindow(widget_, turn,
+                                                            /*scale=*/1.f);
+  // And the cursor, which reads the turn to carry a pointer across monitors.
+  cursor_->OnWindowTurned(widget_, turn);
 }
 
