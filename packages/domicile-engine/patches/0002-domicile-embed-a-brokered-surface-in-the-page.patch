+ScriptPromise<IDLUndefined> HTMLCanvasElement::embedExternalSurface(
+    ScriptState* script_state,
+    ExceptionState& exception_state) {
+  LocalFrame* frame = GetDocument().GetFrame();
+  if (!frame || !frame->GetPage()) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kInvalidStateError,
+        "A frame-less canvas has no layer tree to embed into.");
+    return EmptyPromise();
+  }
+
+  // The bridge, and so the cc::SurfaceLayer under it, may already exist —
+  // transferControlToOffscreen() and a desynchronized context both build one.
+  // Embedding then would point that layer somewhere else and strand whatever
+  // was submitting to it, which is a mistake worth refusing rather than
+  // resolving in some order.
+  if (surface_layer_bridge_) {
+    exception_state.ThrowDOMException(
+        DOMExceptionCode::kInvalidStateError,
+        "This canvas already has a surface of its own.");
+    return EmptyPromise();
+  }
+  if (!CreateLayer()) {
+    exception_state.ThrowDOMException(DOMExceptionCode::kInvalidStateError,
+                                      "Could not create a layer.");
+    return EmptyPromise();
+  }
+
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLUndefined>>(script_state);
+  auto promise = resolver->Promise();
+
+  external_surface_embedder_ = std::make_unique<ExternalSurfaceEmbedder>();
+  external_surface_embedder_->Embed(
+      frame->GetPage()->GetChromeClient().GetFrameSinkId(frame), Size(),
+      BindOnce(&HTMLCanvasElement::OnExternalSurfaceEmbedded,
+                    WrapPersistent(this), WrapPersistent(resolver)));
+  return promise;
+}
+
+void HTMLCanvasElement::OnExternalSurfaceEmbedded(
+    ScriptPromiseResolver<IDLUndefined>* resolver,
+    const std::optional<viz::SurfaceId>& surface_id) {
+  if (!surface_id) {
+    resolver->RejectWithDOMException(
+        DOMExceptionCode::kInvalidStateError,
+        "The browser brokered no surface to embed.");
+    return;
+  }
+
+  // The whole of step 3 is this call. SurfaceLayerBridge::EmbedSurface() takes
+  // a SurfaceId and does not ask whose it is — and neither does
+  // cc::SurfaceLayer::SetSurfaceId under it, which stores a SurfaceRange and
+  // checks nothing about the FrameSinkId's namespace. From here the surface is
+  // an ordinary layer: HTMLCanvasPainter records it as a foreign layer, so the
+  // page's own property trees apply to it like any other.
+  surface_layer_bridge_->EmbedSurface(*surface_id);
+  resolver->Resolve();
+}
+
 void HTMLCanvasElement::OnWebLayerUpdated() {
   SetNeedsCompositingUpdate();
 }
