index 41ec8bf..89fe17f 100644
--- a/testing/variations/fieldtrial_testing_config.json
+++ b/testing/variations/fieldtrial_testing_config.json
@@ -5778,32 +5778,6 @@
             ]
         }
     ],
-    "CompositedAnimationsForceMainFrames": [
-        {
-            "platforms": [
-                "android",
-                "android_desktop",
-                "android_webview",
-                "chromeos",
-                "fuchsia",
-                "linux",
