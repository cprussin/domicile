+  // Domicile's engine fork. As getFloatFrequencyData.
+  DomicileFarbleAudio(GetExecutionContext(), array->AsSpan());
 }
 
 void AnalyserNode::getByteTimeDomainData(NotShared<DOMUint8Array> array) {
diff --git a/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc b/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
index a798c39c5263e..876fd8087694d 100644
--- a/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
+++ b/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
@@ -23,6 +23,7 @@
  * DAMAGE.
  */
 
+#include "third_party/blink/renderer/core/frame/domicile_device_details.h"
 #include "third_party/blink/renderer/modules/webaudio/offline_audio_context.h"
 
 #include <limits>
@@ -604,6 +605,14 @@ void OfflineAudioContext::OnChunkRendered() {
   Member<AudioBuffer> rendered_buffer = pending_render_targets_.front();
 
   CHECK(rendered_buffer);
+  // Domicile's engine fork. A page that hides the device's details hears
+  // its rendering a little off, once, before it can read it. See
+  // core/frame/domicile_device_details.h.
+  for (unsigned channel = 0; channel < rendered_buffer->numberOfChannels();
+       ++channel) {
+    DomicileFarbleAudio(GetExecutionContext(),
+                        rendered_buffer->getChannelData(channel)->AsSpan());
+  }
   // Keep the target queued across `Resolve()` so synchronous thenable getters
   // can enqueue more chunks without starting a duplicate render.
   resolver->Resolve(rendered_buffer.Get());
