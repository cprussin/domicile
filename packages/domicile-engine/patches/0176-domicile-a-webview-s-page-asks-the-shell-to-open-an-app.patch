+++ b/chrome/browser/external_protocol/external_protocol_handler.h
@@ -100,6 +100,17 @@ class ExternalProtocolHandler {
   // ExternalProtocolHandler::Delegate for testing code.
   static void SetDelegateForTesting(Delegate* delegate);
 
+  // DOMICILE: asks the shell in place of Chrome's dialog. Chrome's dialog
+  // anchors to the outermost WebContents, which for a <webview> guest is the
+  // shell's own window. Set once, before any page asks. See
+  // //chrome/browser/domicile/domicile_external_apps.h.
+  using DialogOverride =
+      void (*)(const GURL& url,
+               content::WebContents* web_contents,
+               const std::optional<url::Origin>& initiating_origin,
+               content::WeakDocumentPtr initiator_document);
+  static void SetDialogOverride(DialogOverride ask);
+
   // True if |initiating_origin| is not nullptr and is considered
   // potentially trustworthy.
   static bool MayRememberAllowDecisionsForThisOrigin(
