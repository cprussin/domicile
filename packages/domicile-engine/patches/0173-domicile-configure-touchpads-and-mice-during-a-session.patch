   const auto arg =
@@ -366,6 +457,15 @@ LibInputEventConverter::~LibInputEventConverter() {}
 
 void LibInputEventConverter::ApplyDeviceSettings(
     const InputDeviceSettingsEvdev& settings) {
+  scroll_factor_ = has_touchpad_
