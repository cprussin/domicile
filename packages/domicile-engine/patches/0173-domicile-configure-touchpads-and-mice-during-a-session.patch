+  typing_applies_ = DomicileTypingDeviceEligible(
+      settings.domicile_input.touchpad.disable_while_typing,
+      type() == InputDeviceType::INPUT_DEVICE_INTERNAL);
   if (device_ && has_mouse_) {
     // A mouse has a mouse's settings. The touchpad's would ask it for
     // tap-to-click, which libinput refuses and this logs as an error on
@@ -438,7 +538,8 @@ void LibInputEventConverter::HandlePointerMotion(const LibInputEvent& evt) {
   const double dx = libinput_event_pointer_get_dx(event);
   const double dy = libinput_event_pointer_get_dy(event);
 
-  if (typing_guard_ && typing_guard_->DropsMotion(Timestamp(evt))) {
+  if (typing_guard_ && typing_applies_ &&
+      typing_guard_->DropsMotion(Timestamp(evt), input_device_.id)) {
     return;
   }
 
@@ -470,7 +571,8 @@ void LibInputEventConverter::HandlePointerButton(const LibInputEvent& evt) {
   DVLOG(3) << "Button: " << button << ", pressed: " << down;
 
   if (typing_guard_ &&
-      typing_guard_->DropsButton(button, down, Timestamp(evt))) {
+      typing_guard_->DropsButton(button, down, Timestamp(evt), typing_applies_,
+                                 input_device_.id)) {
     return;
   }
 
@@ -491,7 +593,8 @@ void LibInputEventConverter::HandlePointerAxis(const LibInputEvent& evt) {
     return;
   }
 
-  if (typing_guard_ && typing_guard_->DropsMotion(Timestamp(evt))) {
+  if (typing_guard_ && typing_applies_ &&
+      typing_guard_->DropsMotion(Timestamp(evt), input_device_.id)) {
     return;
   }
 
