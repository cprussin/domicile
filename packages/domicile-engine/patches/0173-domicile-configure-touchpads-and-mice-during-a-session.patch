@@ -128,17 +108,117 @@ LibInputEventConverter::LibInputDevice::~LibInputDevice() {
 
 void LibInputEventConverter::LibInputDevice::ApplySettings(
     const InputDeviceSettingsEvdev& settings) const {
-  const auto& touchpad_settings = settings.GetTouchpadSettings(device_id_);
-  SetNaturalScrollEnabled(touchpad_settings.natural_scroll_enabled);
-  SetSensitivity(touchpad_settings.sensitivity);
-  SetTapToClickEnabled(touchpad_settings.tap_to_click_enabled);
+  const auto& pad = settings.domicile_input.touchpad;
+  ApplyCommonSettings(pad);
+  if (libinput_device_config_tap_get_finger_count(device_) > 0) {
+    SetTapToClickEnabled(pad.tap);
+    LogConfigStatus(
+        libinput_device_config_tap_set_button_map(
+            device_, pad.tap_button_map == DomicileTapButtonMap::kLrm
+                         ? LIBINPUT_CONFIG_TAP_MAP_LRM
+                         : LIBINPUT_CONFIG_TAP_MAP_LMR),
+        "tap-button-map", static_cast<int>(pad.tap_button_map));
+    LogConfigStatus(libinput_device_config_tap_set_drag_enabled(
+                        device_, pad.tap_drag ? LIBINPUT_CONFIG_DRAG_ENABLED
+                                              : LIBINPUT_CONFIG_DRAG_DISABLED),
+                    "tap-drag", pad.tap_drag);
+    LogConfigStatus(
+        libinput_device_config_tap_set_drag_lock_enabled(
+            device_, pad.drag_lock ? LIBINPUT_CONFIG_DRAG_LOCK_ENABLED
+                                   : LIBINPUT_CONFIG_DRAG_LOCK_DISABLED),
+        "drag-lock", pad.drag_lock);
+  } else if (pad.tap || pad.drag_lock) {
+    LOG(ERROR) << "domicile: " << libinput_device_get_name(device_)
+               << ": tapping is not supported";
+  }
+  const auto click = [&pad]() -> libinput_config_click_method {
+    switch (pad.click_method) {
+      case DomicileClickMethod::kDefault:
+        return LIBINPUT_CONFIG_CLICK_METHOD_NONE;
+      case DomicileClickMethod::kClickfinger:
+        return LIBINPUT_CONFIG_CLICK_METHOD_CLICKFINGER;
+      case DomicileClickMethod::kButtonAreas:
+        return LIBINPUT_CONFIG_CLICK_METHOD_BUTTON_AREAS;
+    }
+    NOTREACHED();
+  }();
+  const auto selected_click = SelectDomicileLibinputMethod(
+      click, libinput_device_config_click_get_methods(device_),
+      libinput_device_config_click_get_default_method(device_));
+  if (selected_click.has_value()) {
+    LogConfigStatus(libinput_device_config_click_set_method(
+                        device_, static_cast<libinput_config_click_method>(
+                                     *selected_click)),
+                    "click-method", *selected_click);
+  } else {
+    LOG(ERROR) << "domicile: " << libinput_device_get_name(device_)
+               << ": click-method: " << selected_click.error();
+  }
+  const auto scroll = [&pad]() -> libinput_config_scroll_method {
+    switch (pad.scroll_method) {
+      case DomicileScrollMethod::kDefault:
+        return LIBINPUT_CONFIG_SCROLL_NO_SCROLL;
+      case DomicileScrollMethod::kTwoFinger:
+        return LIBINPUT_CONFIG_SCROLL_2FG;
+      case DomicileScrollMethod::kEdge:
+        return LIBINPUT_CONFIG_SCROLL_EDGE;
+      case DomicileScrollMethod::kOnButtonDown:
+        return LIBINPUT_CONFIG_SCROLL_ON_BUTTON_DOWN;
+    }
+    NOTREACHED();
+  }();
+  const auto selected_scroll = SelectDomicileLibinputMethod(
+      scroll, libinput_device_config_scroll_get_methods(device_),
+      libinput_device_config_scroll_get_default_method(device_));
+  if (selected_scroll.has_value()) {
+    LogConfigStatus(libinput_device_config_scroll_set_method(
+                        device_, static_cast<libinput_config_scroll_method>(
+                                     *selected_scroll)),
+                    "scroll-method", *selected_scroll);
+  } else {
+    LOG(ERROR) << "domicile: " << libinput_device_get_name(device_)
+               << ": scroll-method: " << selected_scroll.error();
+  }
 }
 
 void LibInputEventConverter::LibInputDevice::ApplyMouseSettings(
     const InputDeviceSettingsEvdev& settings) const {
-  const auto& mouse_settings = settings.GetMouseSettings(device_id_);
-  SetNaturalScrollEnabled(mouse_settings.reverse_scroll_enabled);
-  SetSensitivity(mouse_settings.sensitivity);
+  ApplyCommonSettings(settings.domicile_input.mouse);
+}
+
+void LibInputEventConverter::LibInputDevice::ApplyCommonSettings(
+    const DomicileMouseSettings& settings) const {
+  if (libinput_device_config_scroll_has_natural_scroll(device_)) {
+    SetNaturalScrollEnabled(settings.natural_scroll);
+  } else if (settings.natural_scroll) {
+    LOG(ERROR) << "domicile: " << libinput_device_get_name(device_)
+               << ": natural scrolling is not supported";
+  }
+  if (libinput_device_config_accel_is_available(device_)) {
+    const auto profile = settings.accel_profile == DomicileAccelProfile::kFlat
+                             ? LIBINPUT_CONFIG_ACCEL_PROFILE_FLAT
+                             : LIBINPUT_CONFIG_ACCEL_PROFILE_ADAPTIVE;
+    LogConfigStatus(libinput_device_config_accel_set_profile(device_, profile),
+                    "acceleration-profile", profile);
+    LogConfigStatus(
+        libinput_device_config_accel_set_speed(device_, settings.speed),
+        "speed", settings.speed);
+  } else if (settings.speed != 0 ||
+             settings.accel_profile != DomicileAccelProfile::kAdaptive) {
+    LOG(ERROR) << "domicile: " << libinput_device_get_name(device_)
+               << ": pointer acceleration is not supported";
+  }
+  if (libinput_device_config_middle_emulation_is_available(device_)) {
+    LogConfigStatus(
+        libinput_device_config_middle_emulation_set_enabled(
+            device_, settings.middle_emulation
+                         ? LIBINPUT_CONFIG_MIDDLE_EMULATION_ENABLED
+                         : LIBINPUT_CONFIG_MIDDLE_EMULATION_DISABLED),
+        "middle-emulation", settings.middle_emulation);
+  } else if (settings.middle_emulation) {
+    LOG(ERROR) << "domicile: " << libinput_device_get_name(device_)
+               << ": middle emulation is not supported";
+  }
 }
 
 // Get a comma-separated string of the device's capabilities
@@ -163,6 +243,26 @@ std::string LibInputEventConverter::LibInputDevice::GetCapabilitiesString() {
   return base::JoinString(parts, ", ");
 }
 
+void LibInputEventConverter::LibInputDevice::LogConfigStatus(
+    libinput_config_status status,
+    const char* key,
+    double value) const {
+  switch (status) {
+    case LIBINPUT_CONFIG_STATUS_SUCCESS:
+      DVLOG(3) << "libinput " << libinput_device_get_name(device_) << ": "
+               << key << " = " << value;
+      break;
+    case LIBINPUT_CONFIG_STATUS_UNSUPPORTED:
+      LOG(ERROR) << "libinput " << libinput_device_get_name(device_) << ": "
+                 << key << " is not supported (requested " << value << ")";
+      break;
+    case LIBINPUT_CONFIG_STATUS_INVALID:
+      LOG(ERROR) << "libinput " << libinput_device_get_name(device_)
+                 << ": invalid " << key << " = " << value;
+      break;
+  }
+}
