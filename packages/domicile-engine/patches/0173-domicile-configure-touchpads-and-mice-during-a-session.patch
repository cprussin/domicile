+void InputControllerEvdev::SetDomicileInputConfig(
+    DomicileInputSettings settings) {
+  input_device_settings_.domicile_disable_while_typing =
+      settings.touchpad.disable_while_typing != DomicileTypingPolicy::kDisabled;
+  input_device_settings_.domicile_input = std::move(settings);
+  ++input_device_settings_.domicile_input_generation;
+  ScheduleUpdateDeviceSettings();
+}
+
 void InputControllerEvdev::SetDomicileDisableWhileTyping(bool enabled) {
   input_device_settings_.domicile_disable_while_typing = enabled;
   ScheduleUpdateDeviceSettings();
