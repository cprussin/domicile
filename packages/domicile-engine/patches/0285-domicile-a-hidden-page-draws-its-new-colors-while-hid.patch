From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Connor Prussin <connor@prussin.net>
Date: Thu, 26 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: a hidden page draws its new colors while hidden

A hidden page draws no frames, so the frame its <webview> shows when it is
shown again is the last it drew. After the desktop's theme turns, every
background tab and other workspace's window flashed the old theme the first
time it was shown.

- WebContentsImpl::HandleColorRelatedStateChanges: a hidden page takes a
  hidden capture once its new colors are sent, until its first frame after
  them, however long a busy page takes. The page stays `hidden` to its
  scripts.
- RenderWidgetHostViewChildFrame::CanBecomeVisible: an inner WebContents'
  main frame being captured paints when its <webview> is not rendered. A
  frame its own page hides stays hidden.
- WidgetBase::SetHidden logs (VLOG 1) when a widget is shown or hidden.

guard-webview-hidden-theme.sh checks it.
---
 content/browser/renderer_host/render_widget_host_view_child_frame.cc | 20 ++++++++++++++++++--
 content/browser/web_contents/web_contents_impl.cc                    | 52 ++++++++++++++++++++++++++++++++++++++++++++++++++++
 third_party/blink/renderer/platform/widget/widget_base.cc            |  4 ++++
 3 files changed, 74 insertions(+), 2 deletions(-)

diff --git a/content/browser/renderer_host/render_widget_host_view_child_frame.cc b/content/browser/renderer_host/render_widget_host_view_child_frame.cc
index 2349597..887503a 100644
--- a/content/browser/renderer_host/render_widget_host_view_child_frame.cc
+++ b/content/browser/renderer_host/render_widget_host_view_child_frame.cc
@@ -27,14 +27,18 @@
 #include "content/browser/gpu/compositor_util.h"
 #include "content/browser/renderer_host/cross_process_frame_connector.h"
 #include "content/browser/renderer_host/frame_connector.h"
+#include "content/browser/renderer_host/frame_tree.h"
+#include "content/browser/renderer_host/frame_tree_node.h"
 #include "content/browser/renderer_host/input/touch_selection_controller_client_child_frame.h"
 #include "content/browser/renderer_host/input/touch_selection_controller_input_observer.h"
+#include "content/browser/renderer_host/render_frame_host_impl.h"
 #include "content/browser/renderer_host/render_view_host_impl.h"
 #include "content/browser/renderer_host/render_widget_host_delegate.h"
 #include "content/browser/renderer_host/render_widget_host_impl.h"
 #include "content/browser/renderer_host/render_widget_host_view_event_handler.h"
 #include "content/browser/renderer_host/text_input_manager.h"
 #include "content/browser/renderer_host/unbounded_surface_window.h"
+#include "content/browser/web_contents/web_contents_impl.h"
 #include "content/common/features.h"
 #include "content/common/input/synthetic_gesture_target.h"
 #include "content/public/browser/render_process_host.h"
@@ -1267,8 +1271,20 @@ bool RenderWidgetHostViewChildFrame::CanBecomeVisible() {
   if (!frame_connector_)
     return true;
 
-  if (frame_connector_->IsHidden())
-    return false;
+  // Domicile's engine fork: a page being captured paints even when its
+  // <webview> is not rendered. A hidden capture is how a hidden page draws its
+  // new colors (DomicilePaintNewColorsWhileHidden in web_contents_impl.cc).
+  // Only an inner WebContents' main frame: a frame its own page hides stays
+  // hidden.
+  if (frame_connector_->IsHidden()) {
+    FrameTreeNode* root = host()->frame_tree()->root();
+    const bool paints =
+        root->current_frame_host()->GetRenderWidgetHost() == host() &&
+        WebContentsImpl::FromFrameTreeNode(root)->IsBeingCaptured();
+    VLOG(1) << "domicile: a frame its embedder does not render "
+            << (paints ? "paints" : "stays hidden");
+    return paints;
+  }
 
   RenderWidgetHostViewBase* parent_view = GetParentViewInput();
   if (!parent_view || !parent_view->IsRenderWidgetHostViewChildFrame()) {
diff --git a/content/browser/web_contents/web_contents_impl.cc b/content/browser/web_contents/web_contents_impl.cc
index c37c7f9..8797d33 100644
--- a/content/browser/web_contents/web_contents_impl.cc
+++ b/content/browser/web_contents/web_contents_impl.cc
@@ -726,6 +726,49 @@ HostZoomMapImpl* HostZoomMapForRenderFrameHost(const RenderFrameHost* rfh) {
       HostZoomMap::Get(rfh->GetSiteInstance()));
 }
 
+// Domicile's engine fork: a hidden page draws one frame in its new colors.
+//
+// A hidden page draws nothing, so the frame its embedder shows when it is
+// shown again is the one it drew before it was hidden. After the desktop's
+// theme turns, that frame is in the old theme until the page draws again, a
+// flash of the old theme on every tab and workspace shown for the first time.
+// A hidden capture makes the page paint without telling it that it is shown,
+// and RenderWidgetHostViewChildFrame::CanBecomeVisible lets that reach a
+// <webview> its embedder does not render. The capture ends with the first
+// frame after the new colors, however long a busy page takes to draw it. A
+// renderer that goes away first ends it too: InsertVisualStateCallback answers
+// `false` then.
+//
+// Posted after the colors are sent, so it runs after every WebContents has
+// sent its own: an outer WebContents sends its inner ones their preferences.
+void DomicilePaintNewColorsWhileHidden(base::WeakPtr<WebContents> weak) {
+  auto* contents = static_cast<WebContentsImpl*>(weak.get());
+  if (!contents || contents->IsBeingDestroyed() ||
+      contents->GetVisibility() != Visibility::HIDDEN ||
+      !contents->GetPrimaryMainFrame()->IsRenderFrameLive()) {
+    // Gone, shown already, or with no renderer to draw: a crashed page, or
+    // one unloaded to save memory, loads again in the new colors.
+    VLOG(1) << "domicile: page " << weak.get()
+            << " paints no new colors while hidden: "
+            << (!contents                        ? "gone"
+                : contents->IsBeingDestroyed()   ? "being destroyed"
+                : contents->GetVisibility() != Visibility::HIDDEN
+                    ? "no longer hidden"
+                    : "no live renderer");
+    return;
+  }
+  VLOG(1) << "domicile: hidden page " << contents
+          << " paints its new colors";
+  contents->GetPrimaryMainFrame()->InsertVisualStateCallback(base::BindOnce(
+      [](base::ScopedClosureRunner capture, bool drew) {
+        VLOG(1) << "domicile: a hidden page drew its new colors (" << drew
+                << "), its capture ends";
+      },
+      contents->IncrementCapturerCount(gfx::Size(), /*stay_hidden=*/true,
+                                       /*stay_awake=*/false,
+                                       /*is_activity=*/false)));
+}
+
 }  // namespace
 
 // This is a small helper class created while a JavaScript dialog is showing
@@ -13034,6 +13077,15 @@ void WebContentsImpl::HandleColorRelatedStateChanges() {
       }
     });
   }
+
+  // Domicile's engine fork: see DomicilePaintNewColorsWhileHidden.
+  VLOG(1) << "domicile: page " << this << " has new colors, visibility "
+          << static_cast<int>(GetVisibility());
+  if (GetVisibility() == Visibility::HIDDEN) {
+    GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE,
+        base::BindOnce(&DomicilePaintNewColorsWhileHidden, GetWeakPtr()));
+  }
 }
 
 void WebContentsImpl::OnNativeThemeUpdated(ui::NativeTheme* observed_theme) {
diff --git a/third_party/blink/renderer/platform/widget/widget_base.cc b/third_party/blink/renderer/platform/widget/widget_base.cc
index 8b27a28..6beb063 100644
--- a/third_party/blink/renderer/platform/widget/widget_base.cc
+++ b/third_party/blink/renderer/platform/widget/widget_base.cc
@@ -1628,6 +1628,10 @@ void WidgetBase::SetHidden(bool hidden) {
   // The status has changed.  Tell the RenderThread about it and ensure
   // throttled acks are released in case frame production ceases.
   is_hidden_ = hidden;
+  // Domicile's engine fork: says when a page's widget is shown or hidden, to
+  // follow a hidden page that paints (DomicilePaintNewColorsWhileHidden in
+  // web_contents_impl.cc).
+  VLOG(1) << "domicile: widget " << this << (hidden ? " hidden" : " shown");
 
   if (widget_scheduler_)
     widget_scheduler_->SetHidden(hidden);
