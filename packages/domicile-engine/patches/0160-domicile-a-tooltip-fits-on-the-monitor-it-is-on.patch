diff --git a/ui/aura/client/aura_constants.h b/ui/aura/client/aura_constants.h
index 0b58687..1596342 100644
--- a/ui/aura/client/aura_constants.h
+++ b/ui/aura/client/aura_constants.h
@@ -90,6 +90,14 @@ AURA_EXPORT extern const WindowProperty<bool>* const kCreatedByUserGesture;
 // A property key to indicate the uuid of the desk this window belongs to.
 AURA_EXPORT extern const WindowProperty<std::string*>* const kDeskUuidKey;
 
+// DOMICILE: a property key to store, on the root window of the desk's host,
+// each monitor of the desk in that root's coordinates. On a tty the desk is one
+// page spanning every monitor, shown in the host monitor's window, so the
+// root's popups may sit on any monitor. Screen coordinates there are CRTC
+// pixels, which do not place them. Set by //chrome/browser/domicile.
+AURA_EXPORT extern const WindowProperty<std::vector<gfx::Rect>*>* const
+    kDomicileDeskMonitorsKey;
+
 // A property key to indicate that a window should show that it deserves
 // attention.
 AURA_EXPORT extern const WindowProperty<bool>* const kDrawAttentionKey;
diff --git a/ui/views/corewm/tooltip_aura.cc b/ui/views/corewm/tooltip_aura.cc
index 2c7eea4..66c10ca 100644
--- a/ui/views/corewm/tooltip_aura.cc
+++ b/ui/views/corewm/tooltip_aura.cc
@@ -6,6 +6,7 @@
 
 #include <algorithm>
 #include <utility>
+#include <vector>
 
 #include "base/i18n/rtl.h"
 #include "base/memory/raw_ptr.h"
@@ -65,6 +66,38 @@ bool ShouldIgnoreScreenBounds() {
 #endif
 }
 
+// DOMICILE: the bounds, in screen coordinates, a tooltip at `anchor_point`
+// fits in.
+//
+// On a tty the desk's host root holds the page's tooltips for every monitor,
+// and its screen coordinates are CRTC pixels, not the desk's. So the display
+// nearest the anchor is often another monitor, and fitting the tooltip there
+// moves it far from the pointer and across a seam. The host's root names its
+// monitors instead (`kDomicileDeskMonitorsKey`).
+gfx::Rect FitBoundsAt(const aura::Window* window,
+                      const gfx::Point& anchor_point) {
+  const aura::Window* root = window->GetRootWindow();
+  const std::vector<gfx::Rect>* monitors =
+      root->GetProperty(aura::client::kDomicileDeskMonitorsKey);
+  if (monitors == nullptr || monitors->empty()) {
+    return display::Screen::Get()
+        ->GetDisplayNearestPoint(anchor_point)
+        .bounds();
+  }
+  aura::client::ScreenPositionClient* screen_position_client =
+      aura::client::GetScreenPositionClient(root);
+  CHECK(screen_position_client);
+  gfx::Point in_root = anchor_point;
+  screen_position_client->ConvertPointFromScreen(root, &in_root);
+  const gfx::Rect monitor = *std::ranges::min_element(
+      *monitors, {}, [&in_root](const gfx::Rect& one) {
+        return one.ManhattanDistanceToPoint(in_root);
+      });
+  gfx::Point origin = monitor.origin();
+  screen_position_client->ConvertPointToScreen(root, &origin);
+  return gfx::Rect(origin, monitor.size());
+}
+
 }  // namespace
 
 namespace views::corewm {
@@ -168,9 +201,7 @@ gfx::Rect TooltipAura::GetTooltipBounds(const gfx::Size& tooltip_size,
     return tooltip_rect;
   }
 
-  display::Screen* screen = display::Screen::Get();
-  gfx::Rect display_bounds(
-      screen->GetDisplayNearestPoint(anchor_point).bounds());
+  gfx::Rect display_bounds = FitBoundsAt(tooltip_window_, anchor_point);
 
   // If tooltip is out of bounds on the x axis, we simply shift it
   // horizontally by the offset variation.
