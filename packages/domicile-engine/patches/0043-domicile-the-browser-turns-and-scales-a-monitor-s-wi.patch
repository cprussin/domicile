+void DrmWindowHost::FollowDisplayTurn() {
+  // No screen is a unit test that built a window and nothing else; there is
+  // no display to be turned with, and nothing is tracking a pointer.
+  if (!display::Screen::HasScreen()) {
+    return;
+  }
+  // `panel_rotation`, which is what ash hands CursorController too, and the
+  // scale left at one: the pointer is tracked in the panel's own pixels, and
+  // a monitor's density is no reason for a hand to move it faster.
