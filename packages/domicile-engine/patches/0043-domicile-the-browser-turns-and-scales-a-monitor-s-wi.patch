+gfx::Transform DesktopWindowTreeHostPlatform::GetScaleTransform() const {
   // TODO(crbug.com/40218466): This can use wrong scale during initialization.
   // Revisit this as a part of 'use dip' work.
 
@@ -982,7 +1016,65 @@ void DesktopWindowTreeHostPlatform::HideImpl() {
