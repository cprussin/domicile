 gfx::Rect DesktopWindowTreeHostPlatform::CalculateRootWindowBounds() const {
-  return gfx::Rect(platform_window()->GetBoundsInDIP().size());
+  gfx::Rect bounds(platform_window()->GetBoundsInDIP().size());
+  // DOMICILE: a quarter turn stands the root window on its side.
+  const display::Display::Rotation turn = GetDisplayTurn();
+  if (turn == display::Display::ROTATE_90 ||
+      turn == display::Display::ROTATE_270) {
+    bounds.Transpose();
+  }
+  return bounds;
+}
+
+void DesktopWindowTreeHostPlatform::OnDisplayMetricsChanged(
+    const display::Display& display,
+    uint32_t metrics) {
+  WindowTreeHostPlatform::OnDisplayMetricsChanged(display, metrics);
+  // DOMICILE: a display turned under a window that stayed put -- a reloaded
+  // profile stands a monitor on its side and moves nothing. The scale is the
+  // base class's, which rescales on DISPLAY_METRIC_DEVICE_SCALE_FACTOR.
+  if ((metrics & DISPLAY_METRIC_ROTATION) == 0 || !TurnsWithDisplay() ||
+      !platform_window() || display.id() != GetDisplayId()) {
+    return;
+  }
+  FollowDisplayTurn();
+  OnHostResizedInPixels(GetBoundsInPixels().size());
+  // And the pointer drawn over it, which wm::CursorLoader turns with the
+  // display it is told about -- and is told only when the pointer crosses into
+  // a window, which this one did not.
+  aura::client::CursorClient* cursor = aura::client::GetCursorClient(window());
+  if (cursor) {
+    cursor->SetDisplay(display);
+  }
+}
+
+void DesktopWindowTreeHostPlatform::OnBoundsChanged(
+    const BoundsChange& change) {
+  // DOMICILE: before the base class resizes the compositor, which it sizes
+  // standing up or lying down by the turn it has been handed.
+  FollowDisplayTurn();
+  WindowTreeHostPlatform::OnBoundsChanged(change);
+}
+
+display::Display::Rotation DesktopWindowTreeHostPlatform::GetDisplayTurn()
+    const {
+  return platform_window() && TurnsWithDisplay()
+             ? GetDisplayNearestRootWindow().panel_rotation()
+             : display::Display::ROTATE_0;
+}
+
+void DesktopWindowTreeHostPlatform::FollowDisplayTurn() {
+  // Only where the platform turns windows. Everywhere else the hint is the
+  // platform's own to give -- Wayland hands one over from the compositor it
+  // is a client of -- and answering it with "upright" would undo it.
+  if (!TurnsWithDisplay()) {
+    return;
+  }
+  // The frame is rendered upright and turned onto the panel on its way out,
+  // which is how ash turns a rotated display: viz adds the turn as a pass of
+  // its own, or hands it to the plane where the hardware can do it.
+  SetDisplayTransformHint(
+      display::DisplayRotationToOverlayTransform(GetDisplayTurn()));
 }
 
