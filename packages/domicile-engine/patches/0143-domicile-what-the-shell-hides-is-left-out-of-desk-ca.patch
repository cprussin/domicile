+++ b/content/browser/media/capture/sub_capture_target_id_web_contents_helper.cc
@@ -15,6 +15,8 @@
 #include "base/token.h"
 #include "base/uuid.h"
 #include "build/build_config.h"
+#include "components/domicile/browser/shell_origin.h"
+#include "components/viz/service/display/domicile/hidden_from_captures_id.h"
 #include "content/browser/renderer_host/render_frame_host_impl.h"
 #include "content/common/content_export.h"
 #include "content/public/browser/browser_thread.h"
@@ -101,6 +103,18 @@ std::string SubCaptureTargetIdWebContentsHelper::ProduceId(Type type) {
   std::vector<base::Token>& ids =
       (type == Type::kCropTarget) ? crop_ids_ : restriction_ids_;
 
+  // Domicile: every element of the shell's gets the one id captures of the
+  // desk leave out. See
+  // //components/viz/service/display/domicile/hidden_from_captures.h.
+  if (type == Type::kRestrictionTarget &&
+      ::domicile::IsShellOrigin(
+          web_contents()->GetPrimaryMainFrame()->GetLastCommittedOrigin())) {
+    if (!IsAssociatedWith(viz::domicile::kHiddenFromCaptures, type)) {
+      ids.push_back(viz::domicile::kHiddenFromCaptures);
+    }
+    return viz::domicile::kHiddenFromCapturesGuid;
+  }
+
   // Prevent Web-applications from producing an excessive number of IDs.
   if (ids.size() >= kMaxIdsPerWebContents) {
     return std::string();
