+void WidgetBase::UpdateDomicileDisplayRegions() {
+  if (!LayerTreeHost()) {
+    return;
+  }
+  std::vector<cc::DomicileDisplay> displays;
+  for (const display::ScreenInfo& info : screen_infos_.screen_infos) {
+    if (info.label == cc::kDomicileDisplayLabel) {
+      displays.push_back({info.rect, info.device_scale_factor});
+    }
+  }
+  LayerTreeHost()->SetDomicileDisplayRegions(cc::DomicileDisplayRegionsOf(
+      displays, widget_screen_rect_.origin(), GetOriginalDeviceScaleFactor()));
 }
 
