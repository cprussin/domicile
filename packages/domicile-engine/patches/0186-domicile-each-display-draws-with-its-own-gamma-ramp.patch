+  (*out)->set_domicile_gamma_size(data.domicile_gamma_size());
   return true;
 }
 
diff --git a/ui/display/mojom/display_snapshot_mojom_traits.h b/ui/display/mojom/display_snapshot_mojom_traits.h
index 80b02a4..5ca71fb 100644
