+++ b/ui/display/mojom/display_snapshot_mojom_traits.h
@@ -189,6 +189,11 @@ struct StructTraits<display::mojom::DisplaySnapshotDataView,
     return snapshot->domicile_connector();
   }
 
+  static uint32_t domicile_gamma_size(
+      const std::unique_ptr<display::DisplaySnapshot>& snapshot) {
+    return snapshot->domicile_gamma_size();
+  }
+
   static bool Read(display::mojom::DisplaySnapshotDataView data,
