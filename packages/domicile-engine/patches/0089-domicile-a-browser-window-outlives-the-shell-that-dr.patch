From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Sun, 4 Oct 2026 12:00:00 +0000
Subject: [PATCH] domicile: a browser window outlives the shell that drew it

The desk's browser windows are the browser's -- see
components/domicile/mojom/browser_windows.mojom -- so `domicile
load-shell` keeps them. What that needs from files Chromium owns, and
nothing else:

- kAttachUnownedInnerWebContents on by default, and
  domicile::WebViewGuest a friend of UnownedInnerWebContentsClient: a
  browser window's page is attached to the <webview window> that shows
  it without being given to the shell's document, and content detaches
  it, alive, when that document goes.
- The frame binders bind BrowserWindows for the shell, gated at bind
  time on the domicile:// origin exactly as the tray is.
  `domicile::BindBrowserWindows` is in //chrome/browser/domicile.
- The IDL lists name DomicileBrowserWindow and its binding, and no
  longer name the three events a window is no longer asked for through:
  DomicileOpenUrlEvent and its init, DomicileNewWindowEvent and
  DomicilePopupWindowEvent. The browser opens those windows itself now.

Everything else is new files under src/.

WRITTEN BY HAND, AGAINST THE SERIES RATHER THAN IN A CHECKOUT: the file
each hunk applies to was rebuilt from the pin and the patches before it.
---
 .../chrome_browser_interface_binders.cc        | 18 ++++++++++++++++++
 .../unowned_inner_web_contents_client.h        |  7 +++++++
 content/public/common/content_features.cc      |  4 +++-
 .../renderer/bindings/generated_in_core.gni    |  4 ----
 .../renderer/bindings/generated_in_modules.gni |  6 ++----
 .../blink/renderer/bindings/idl_in_core.gni    |  2 --
 .../blink/renderer/bindings/idl_in_modules.gni |  3 +--
 third_party/blink/renderer/core/html/build.gni |  4 ----
 8 files changed, 31 insertions(+), 17 deletions(-)

diff --git a/chrome/browser/chrome_browser_interface_binders.cc b/chrome/browser/chrome_browser_interface_binders.cc
index a9bfcfd..f855cca 100644
--- a/chrome/browser/chrome_browser_interface_binders.cc
+++ b/chrome/browser/chrome_browser_interface_binders.cc
@@ -6,6 +6,7 @@
 
 #include "base/task/bind_post_task.h"
 #include "chrome/browser/domicile/domicile_extension_installer.h"
+#include "chrome/browser/domicile/domicile_browser_windows.h"
 #include "chrome/browser/domicile/domicile_extension_tray.h"
 #include "chrome/browser/domicile/domicile_pointer_warp.h"
 #include "chrome/browser/domicile/domicile_tab_helpers.h"
@@ -605,6 +606,23 @@ void PopulateChromeFrameBinders(
         domicile::BindExtensionTray(frame, std::move(receiver));
       }));
 
+  // Domicile's engine fork: the desk's browser windows, for the shell.
+  //
+  // Gated at BIND time like the tray, and for its reason: a page that could
+  // reach this could open, close and list every browser window on the desk.
+  map->Add<domicile::mojom::BrowserWindows>(base::BindRepeating(
+      [](content::RenderFrameHost* frame,
+         mojo::PendingReceiver<domicile::mojom::BrowserWindows> receiver) {
+        if (frame->GetLastCommittedOrigin().scheme() !=
+            domicile::kDomicileScheme) {
+          mojo::ReportBadMessage(
+              "domicile: only a domicile:// document may hold the browser "
+              "windows.");
+          return;
+        }
+        domicile::BindBrowserWindows(frame, std::move(receiver));
+      }));
+
   map->Add<image_annotation::mojom::Annotator>(&BindImageAnnotator);
 
   map->Add<blink::mojom::ScriptToolHost>(
diff --git a/content/public/browser/unowned_inner_web_contents_client.h b/content/public/browser/unowned_inner_web_contents_client.h
index ef2822c..58d4f68 100644
--- a/content/public/browser/unowned_inner_web_contents_client.h
+++ b/content/public/browser/unowned_inner_web_contents_client.h
@@ -8,6 +8,10 @@
 #include "base/types/pass_key.h"
 #include "content/common/content_export.h"
 
+namespace domicile {
+class WebViewGuest;
+}  // namespace domicile
+
 namespace guest_contents {
 class GuestContentsHandle;
 }  // namespace guest_contents
@@ -30,6 +34,9 @@ class CONTENT_EXPORT UnownedInnerWebContentsClient {
 
  private:
   friend class guest_contents::GuestContentsHandle;
+  // Domicile's engine fork: a browser window's page, shown in a <webview>
+  // without being given to the shell's document, so that it outlives one.
+  friend class domicile::WebViewGuest;
 
   static PassKey GetPassKey();
 };
diff --git a/content/public/common/content_features.cc b/content/public/common/content_features.cc
index 361a8bd..eb4c7fd 100644
--- a/content/public/common/content_features.cc
+++ b/content/public/common/content_features.cc
@@ -155,7 +155,9 @@ const base::FeatureParam<bool>
 // Whether to allow attaching an inner WebContents not owned by the outer
 // WebContents. This is for prototyping purposes and should not be enabled in
 // production.
-BASE_FEATURE(kAttachUnownedInnerWebContents, base::FEATURE_DISABLED_BY_DEFAULT);
+// Domicile's engine fork: enabled, because a desk's browser windows are
+// attached this way -- see components/domicile/browser/web_view_guest.h.
+BASE_FEATURE(kAttachUnownedInnerWebContents, base::FEATURE_ENABLED_BY_DEFAULT);
 
 // Runs the audio service in a separate process.
 BASE_FEATURE(kAudioServiceOutOfProcess,
