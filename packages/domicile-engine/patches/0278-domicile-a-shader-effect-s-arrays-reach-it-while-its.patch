From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 25 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: a shader effect's arrays reach it while its filter
 animates

An array the shell set with updateShaderEffect() never reached viz while
the element's filter animated on the compositor. The cloth close effect
sets its points every frame under a compositor-run fade, so it drew the
window flat and only faded it.

Setting an array rebuilds the element's filters with it, but
EffectPaintPropertyNode::State::ComputeChange calls any filter change a
composited value while a filter animation runs on the compositor. A
composited value is the animation's: it schedules no
PaintArtifactCompositor update, so cc's effect node kept the arrays it
had when the animation started.

The page sets an effect's arrays, never the animation, and cc keeps the
arrays the page committed through an animation (patch 0274's
EffectTree::OnFilterAnimated). So a change to a shader effect's arrays is
now a value change the main thread commits, on filters and backdrop
filters alike, while the animation keeps running on the compositor.

Verified: not built. This repository cannot build Chromium; the engine job builds it on `crux`.
---
 .../paint/effect_paint_property_node.cc       | 32 +++++++++++++++++--
 1 file changed, 30 insertions(+), 2 deletions(-)

diff --git a/third_party/blink/renderer/platform/graphics/paint/effect_paint_property_node.cc b/third_party/blink/renderer/platform/graphics/paint/effect_paint_property_node.cc
index f9f5e54..a199f78 100644
--- a/third_party/blink/renderer/platform/graphics/paint/effect_paint_property_node.cc
+++ b/third_party/blink/renderer/platform/graphics/paint/effect_paint_property_node.cc
@@ -6,6 +6,8 @@
 
 #include "base/memory/values_equivalent.h"
 #include "base/no_destructor.h"
+#include "cc/paint/filter_operation.h"
+#include "cc/paint/filter_operations.h"
 #include "third_party/blink/renderer/platform/graphics/paint/clip_paint_property_node.h"
 #include "third_party/blink/renderer/platform/graphics/paint/property_tree_state.h"
 #include "third_party/blink/renderer/platform/heap/persistent.h"
@@ -15,6 +17,28 @@ namespace blink {
 
 namespace {
 
+// Domicile: whether a shader effect in `a` has other arrays than the same
+// effect at the same place in `b`. The page sets an effect's arrays, never a
+// filter animation: the compositor keeps the arrays the page last committed
+// (cc::EffectTree::OnFilterAnimated). So a change to them is the main
+// thread's to commit, even while the compositor runs the filter's animation.
+bool DomicileShaderArraysChanged(const CompositorFilterOperations& a,
+                                 const CompositorFilterOperations& b) {
+  const cc::FilterOperations& before = a.AsCcFilterOperations();
+  const cc::FilterOperations& after = b.AsCcFilterOperations();
+  for (size_t i = 0; i < before.size() && i < after.size(); ++i) {
+    const cc::FilterOperation& was = before.at(i);
+    const cc::FilterOperation& is = after.at(i);
+    if (was.type() == cc::FilterOperation::SHADER &&
+        is.type() == cc::FilterOperation::SHADER &&
+        was.shader_effect() == is.shader_effect() &&
+        was.shader_arrays() != is.shader_arrays()) {
+      return true;
+    }
+  }
+  return false;
+}
+
 PaintPropertyChangeType ComputeFilterChange(
     const EffectPaintPropertyNode::FilterInfo* a,
     const EffectPaintPropertyNode::FilterInfo* b,
@@ -29,7 +53,10 @@ PaintPropertyChangeType ComputeFilterChange(
     return PaintPropertyChangeType::kChangedOnlyValues;
   }
   if (a->operations != b->operations) {
-    return is_running_filter_animation_on_compositor
+    // Domicile: a composited value is the animation's, and nothing pushes it
+    // to cc, so new shader arrays would be dropped until it ends.
+    return is_running_filter_animation_on_compositor &&
+                   !DomicileShaderArraysChanged(a->operations, b->operations)
                ? PaintPropertyChangeType::kChangedOnlyCompositedValues
                : PaintPropertyChangeType::kChangedOnlyValues;
   }
@@ -46,7 +73,8 @@ PaintPropertyChangeType ComputeBackdropFilterChange(
       a->mask_element_id != b->mask_element_id)
     return PaintPropertyChangeType::kChangedOnlyValues;
   if (a->operations != b->operations) {
-    return is_running_backdrop_filter_animation_on_compositor
+    return is_running_backdrop_filter_animation_on_compositor &&
+                   !DomicileShaderArraysChanged(a->operations, b->operations)
                ? PaintPropertyChangeType::kChangedOnlyCompositedValues
                : PaintPropertyChangeType::kChangedOnlyValues;
   }
