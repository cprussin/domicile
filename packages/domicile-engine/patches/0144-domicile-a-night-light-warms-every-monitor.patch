From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 00:00:00 +0000
Subject: [PATCH] domicile: a night light warms every monitor

A night light needs every monitor's white point, and on a tty only the
browser holds the CRTCs.

- The compositor sends a white point, the gain of each channel
  (`SetDomicileWhitePoint`).
- `DrmModeset` sets it on every display of the last reading as a gamma
  ramp (`NativeDisplayDelegate::SetGammaAdjustment`), so it works on
  drivers with no CTM. Colors as they are clear the ramp. It sets it
  again after each confirmed modeset, since a resume or a console
  switch can leave another process's ramp on the CRTCs.
- Every other platform ignores it: a nested desktop's monitors are the
  host session's.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on `crux`.
---
 ui/ozone/platform/drm/ozone_platform_drm.cc |  8 ++++++++
 ui/ozone/public/ozone_platform.h            | 14 ++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/ui/ozone/platform/drm/ozone_platform_drm.cc b/ui/ozone/platform/drm/ozone_platform_drm.cc
index 4b6de12..92af7cf 100644
--- a/ui/ozone/platform/drm/ozone_platform_drm.cc
+++ b/ui/ozone/platform/drm/ozone_platform_drm.cc
@@ -174,6 +174,14 @@ class OzonePlatformDrm : public OzonePlatform {
     }
   }
 
+  // DOMICILE: a white point before `InitScreen` is dropped, as a layout is.
+  // The compositor sends it again with each display report.
+  void SetDomicileWhitePoint(const DomicileWhitePoint& white_point) override {
+    if (modeset_) {
+      modeset_->SetWhitePoint(white_point);
+    }
+  }
+
   void SetDomicileDeskHost(gfx::AcceleratedWidget host) override {
     if (window_manager_) {
       window_manager_->set_desk_host(host);
diff --git a/ui/ozone/public/ozone_platform.h b/ui/ozone/public/ozone_platform.h
index 63ea79f..0d911ff 100644
--- a/ui/ozone/public/ozone_platform.h
+++ b/ui/ozone/public/ozone_platform.h
@@ -123,6 +123,15 @@ struct DomicileVirtualDisplay {
   std::string name;
 };
 
+// DOMICILE: what each channel is multiplied by on every display, for a night
+// light. 1 leaves a channel as it is. See
+// ui/ozone/platform/drm/domicile/drm_modeset.h.
+struct DomicileWhitePoint {
+  float red = 1.f;
+  float green = 1.f;
+  float blue = 1.f;
+};
+
 // Base class for Ozone platform implementations.
 //
 // Ozone platforms must override this class and implement the virtual
@@ -412,6 +421,11 @@ class COMPONENT_EXPORT(OZONE) OzonePlatform {
   // like the layout above.
   virtual void SetDomicileVirtualDisplays(
       std::vector<DomicileVirtualDisplay> displays) {}
+
+  // DOMICILE: the white point every display draws with, as a gamma ramp per
+  // CRTC. DRM only, like the layout above: a nested desktop's monitors are
+  // the host session's.
+  virtual void SetDomicileWhitePoint(const DomicileWhitePoint& white_point) {}
   // DOMICILE: what the compositor says is on one of the desktop's clipboards.
   //
   // THE BROWSER IS TOLD RATHER THAN ASKED. The compositor reads every
