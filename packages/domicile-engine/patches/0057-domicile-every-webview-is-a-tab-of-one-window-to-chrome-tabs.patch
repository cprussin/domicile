 chrome/browser/extensions/BUILD.gn                  |  2 ++
 .../extensions/chrome_extension_function_details.cc |  8 ++++++++
 chrome/browser/extensions/extension_tab_util.cc     | 13 +++++++++++++
 4 files changed, 27 insertions(+)

