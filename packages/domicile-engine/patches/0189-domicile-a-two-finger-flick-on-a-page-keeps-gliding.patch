diff --git a/ui/events/ozone/evdev/libinput_event_converter.cc b/ui/events/ozone/evdev/libinput_event_converter.cc
index 40e39d8..895fa85 100644
--- a/ui/events/ozone/evdev/libinput_event_converter.cc
+++ b/ui/events/ozone/evdev/libinput_event_converter.cc
@@ -27,6 +27,11 @@ namespace ui {
 
 namespace {
 
+// libinput 1.19's hold gestures. Chromium's sysroot has an older libinput,
+// whose header lacks them; the library on the machine sends them.
+constexpr int kHoldBegin = 806;
+constexpr int kHoldEnd = 807;
+
 double GetAxisValue(libinput_event_pointer* const event,
                     const libinput_pointer_axis axis) {
   // Check has_axis before get_axis_value to avoid spamming the logs
@@ -413,6 +418,12 @@ void LibInputEventConverter::HandleEvent(libinput_event* native_event) {
   if (!IsEnabled()) {
     return;
   }
+  // Fingers resting on the pad catch a gliding page.
+  if (libinput_event_get_type(native_event) == kHoldBegin) {
+    CancelFling(base::TimeTicks() +
+                base::Microseconds(libinput_event_gesture_get_time_usec(
+                    libinput_event_get_gesture_event(native_event))));
+  }
   if (HandleShellGesture(native_event)) {
     return;
   }
@@ -538,6 +549,18 @@ void LibInputEventConverter::HandlePointerAxis(const LibInputEvent& evt) {
 
   DVLOG(3) << "Pointer axis h:" << h << ", v:" << v;
 
+  const bool finger = source == LIBINPUT_POINTER_AXIS_SOURCE_FINGER;
+  if (finger && !raw_delta.IsZero()) {
+    // Fingers moving again without resting first.
+    CancelFling(Timestamp(evt));
+    // The glide follows the fingers' own speed. Accelerated, it would carry
+    // the acceleration on after the fingers lift and overshoot.
+    fling_tracker_.Scroll(
+        gfx::Vector2dF(ScaleScrollAxis(raw_delta.x(), scroll_factor_),
+                       ScaleScrollAxis(raw_delta.y(), scroll_factor_)),
+        Timestamp(evt));
+  }
+
   ScrollEventParams params(input_device_.id, EventType::kScroll,
                            cursor_->GetLocation(), delta, delta, 2,
                            Timestamp(evt));
@@ -554,6 +577,28 @@ void LibInputEventConverter::HandlePointerAxis(const LibInputEvent& evt) {
   active_scroll_axes_.Observe(params.native_scroll_source, delta.x() != 0,
                               delta.y() != 0, stop_x, stop_y);
   dispatcher_->DispatchScrollEvent(params);
+
+  // libinput's stop is the fingers lifting. A native client runs its own
+  // momentum from the stop above; a page glides only if told to.
+  if (finger && raw_delta.IsZero() && (stop_x || stop_y)) {
+    const gfx::Vector2dF velocity = fling_tracker_.Release(Timestamp(evt));
+    if (!velocity.IsZero()) {
+      flinging_ = true;
+      dispatcher_->DispatchScrollEvent(ScrollEventParams(
+          input_device_.id, EventType::kScrollFlingStart,
+          cursor_->GetLocation(), velocity, velocity, 2, Timestamp(evt)));
+    }
+  }
+}
+
+void LibInputEventConverter::CancelFling(base::TimeTicks time) {
+  if (!flinging_) {
+    return;
+  }
+  flinging_ = false;
+  dispatcher_->DispatchScrollEvent(ScrollEventParams(
+      input_device_.id, EventType::kScrollFlingCancel, cursor_->GetLocation(),
+      gfx::Vector2dF(), gfx::Vector2dF(), 2, time));
 }
 
 void LibInputEventConverter::HandleWheel(const LibInputEvent& evt) {
@@ -583,10 +628,6 @@ void LibInputEventConverter::HandleWheel(const LibInputEvent& evt) {
 }
 
 bool LibInputEventConverter::HandleShellGesture(libinput_event* native_event) {
-  // libinput 1.19's hold gestures. Chromium's sysroot has an older libinput,
-  // whose header lacks them; the library on the machine sends them.
-  constexpr int kHoldBegin = 806;
-  constexpr int kHoldEnd = 807;
   const int type = libinput_event_get_type(native_event);
   NativeGesture gesture;
   switch (type) {
diff --git a/ui/events/ozone/evdev/libinput_event_converter.h b/ui/events/ozone/evdev/libinput_event_converter.h
