@@ -16,6 +16,7 @@
 #include "base/memory/raw_ptr.h"
 #include "ui/events/domicile/native_gesture_sink.h"
 #include "ui/events/ozone/evdev/domicile/active_scroll_axes.h"
+#include "ui/events/ozone/evdev/domicile/fling_tracker.h"
 #include "ui/events/ozone/evdev/domicile/input_settings.h"
 #include "ui/events/ozone/evdev/domicile/libinput_keyboard_event_converter.h"
 #include "ui/events/ozone/evdev/domicile/scroll_accelerator.h"
@@ -121,6 +122,8 @@ class LibInputEventConverter : public LibInputKeyboardEventConverter {
   MouseButtonMapType ButtonMap() const;
   void HandlePointerAxis(const LibInputEvent& evt);
   void HandleWheel(const LibInputEvent& evt);
+  // Stops the page gliding from this device's last flick, if it is.
+  void CancelFling(base::TimeTicks time);
   // Whether `event` was a touchpad gesture handled here: one of the shell's
   // (see `NativeGestureSink`), or a swipe or hold, which only the shell binds.
   bool HandleShellGesture(libinput_event* event);
@@ -142,6 +145,9 @@ class LibInputEventConverter : public LibInputKeyboardEventConverter {
 
   ActiveScrollAxes active_scroll_axes_;
   ScrollAccelerator scroll_accelerator_;
+  FlingTracker fling_tracker_;
+  // A page is gliding from this device's last flick.
+  bool flinging_ = false;
   double scroll_factor_ = 1;
   std::optional<double> pinch_scale_;
   NativeGestureSequence shell_gesture_;
