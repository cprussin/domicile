From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Tue, 29 Sep 2026 12:00:00 +0000
Subject: [PATCH] domicile: every webview is a tab, and the shell has a tray

Three things docs/architecture/EXTENSIONS.md's slice 1 needs from files
Chromium owns, and nothing else:

- The frame binders hand BindWebViewGuestHost
  `domicile::AttachTabHelpers`, which gives every <webview>'s guest the
  SessionTabHelper and extensions::TabHelper a Chrome tab has. The
  helpers are //chrome's and //components/domicile:web_view_guest must
  not depend on //chrome, so they cross as a callback.
- They bind ExtensionTray for the shell, gated at bind time on the
  domicile:// origin exactly as ControlChannel and WebViewGuestHost are.
  `domicile::BindExtensionTray` is in //chrome/browser/domicile.
- `idl_in_modules.gni` and `generated_in_modules.gni` name the three new
  IDL files -- DomicileExtension, DomicileExtensionsEvent and its init --
  and the bindings they generate.

Everything else is new files under src/: the mojom, the tray, the tab
helpers, the Blink event and element halves, and
WebViewGuest::CloseContents, which sends WebViewGuestClient.CloseRequested
so a <webview> dispatches `domicile-close`.

WRITTEN BY HAND, AGAINST THE SERIES RATHER THAN IN A CHECKOUT: the file
each hunk applies to was rebuilt from the pin and the patches before it,
and both blobs are that file's.
---
 .../chrome_browser_interface_binders.cc       | 29 ++++++++++++++++++-
 .../bindings/generated_in_modules.gni         |  6 ++++
 .../renderer/bindings/idl_in_modules.gni      |  3 ++
 3 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/chrome_browser_interface_binders.cc b/chrome/browser/chrome_browser_interface_binders.cc
index fb71a7d67c..3d9daaaeb6 100644
--- a/chrome/browser/chrome_browser_interface_binders.cc
+++ b/chrome/browser/chrome_browser_interface_binders.cc
@@ -6,7 +6,9 @@
 
 #include "base/task/bind_post_task.h"
 #include "chrome/browser/domicile/domicile_extension_installer.h"
+#include "chrome/browser/domicile/domicile_extension_tray.h"
 #include "chrome/browser/domicile/domicile_pointer_warp.h"
+#include "chrome/browser/domicile/domicile_tab_helpers.h"
 #include "components/domicile/browser/color_scheme.h"
 #include "components/domicile/browser/control_channel.h"
 #include "components/domicile/browser/keyboard_layout.h"
@@ -571,7 +573,32 @@ void PopulateChromeFrameBinders(
               "domicile: only a domicile:// document may ask for a guest.");
           return;
         }
-        domicile::BindWebViewGuestHost(frame, std::move(receiver));
+        // AND EVERY GUEST IS A TAB. The helpers an extension finds a tab by
+        // are //chrome's, which the guest's own target cannot depend on, so
+        // they are handed in here -- see domicile_tab_helpers.h.
+        domicile::BindWebViewGuestHost(
+            frame, std::move(receiver),
+            base::BindRepeating(&domicile::AttachTabHelpers));
+      }));
+
+  // Domicile's engine fork: the extensions' tray, for the shell.
+  //
+  // Registered unconditionally and gated at BIND time, exactly as the two
+  // above and for their reason. The check is the same one, and the same whole
+  // of the access control: an extension's popup is a chrome-extension:// page
+  // in a <webview>, and a page that could reach this could click any other
+  // extension's action.
+  map->Add<domicile::mojom::ExtensionTray>(base::BindRepeating(
+      [](content::RenderFrameHost* frame,
+         mojo::PendingReceiver<domicile::mojom::ExtensionTray> receiver) {
+        if (frame->GetLastCommittedOrigin().scheme() !=
+            domicile::kDomicileScheme) {
+          mojo::ReportBadMessage(
+              "domicile: only a domicile:// document may hold the extension "
+              "tray.");
+          return;
+        }
+        domicile::BindExtensionTray(frame, std::move(receiver));
       }));
 
   map->Add<image_annotation::mojom::Annotator>(&BindImageAnnotator);
