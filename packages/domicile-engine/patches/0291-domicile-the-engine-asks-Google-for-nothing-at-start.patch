diff --git a/chrome/browser/navigation_predictor/search_engine_preconnector.cc b/chrome/browser/navigation_predictor/search_engine_preconnector.cc
index f6aae9f370322..97d5bdfa23987 100644
--- a/chrome/browser/navigation_predictor/search_engine_preconnector.cc
+++ b/chrome/browser/navigation_predictor/search_engine_preconnector.cc
@@ -148,7 +148,10 @@ namespace features {
 // Feature to control preconnect to search.
 
 BASE_FEATURE(kPreconnectFromKeyedService, base::FEATURE_ENABLED_BY_DEFAULT);
-BASE_FEATURE(kPreconnectToSearch, base::FEATURE_ENABLED_BY_DEFAULT);
+// Domicile: off. It connects to the default search engine at start and keeps
+// the connection warm, so an idle engine talks to Google, whether or not
+// anyone searches.
+BASE_FEATURE(kPreconnectToSearch, base::FEATURE_DISABLED_BY_DEFAULT);
 
 // Feature to control binding the receivers every time we attempt to
 // preconnect. This will trigger the destruction of the previous receiver
diff --git a/components/component_updater/component_updater_service.cc b/components/component_updater/component_updater_service.cc
index 22662f538fe7a..56e6d7b533fc1 100644
--- a/components/component_updater/component_updater_service.cc
+++ b/components/component_updater/component_updater_service.cc
@@ -11,6 +11,7 @@
 #include <memory>
 #include <optional>
 #include <string>
+#include <string_view>
 #include <utility>
 #include <vector>
 
@@ -182,6 +183,23 @@ bool CrxUpdateService::RegisterComponent(
       !component.installer) {
     return false;
   }
+  // Domicile: only the components a page needs to load and play are
+  // updated, whoever registers them: CRLSet, PKI metadata, origin trials,
+  // the autoplay preload list, hyphenation, Screen AI and Widevine.
+  // Registration is spread across Chrome's features, and each one this
+  // refuses was a download from Google at start.
+  static constexpr std::string_view kDomicileKept[] = {
+      "hfnkpimlhhgieaddgfemjhofmfblmnib", "efniojlnjndmcbiieegkicadnoecjjef",
+      "llkgjffcdpffmhiakmfcdcblohccpfmo", "laoigpblnllgcgjnjnllmfolckpjlhki",
+      "jamhcnnkihinmdlkakkaopbjbbcngflc", "mfhmdacoffpmifoibamicehhklffanao",
+      "oimompecagnajdejgnnjijobebaeigek",
+  };
+  if (std::ranges::find(kDomicileKept, component.app_id) ==
+      std::end(kDomicileKept)) {
+    VLOG(1) << "domicile: component " << component.app_id
+            << " is not updated";
+    return false;
+  }
 
   // Cancel any pending unregistration for this component.
   std::erase(components_pending_unregistration_, component.app_id);
diff --git a/components/network_time/network_time_tracker.cc b/components/network_time/network_time_tracker.cc
index 6a2c71f8c367e..a2535e1ba0aac 100644
--- a/components/network_time/network_time_tracker.cc
+++ b/components/network_time/network_time_tracker.cc
@@ -72,13 +72,9 @@
 
 namespace network_time {
 
-// Network time queries are enabled on Android and all desktop platforms except
-// Chrome OS, which uses tlsdated to set the system time.
-#if BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_IOS)
+// Domicile: off everywhere. The engine never asks Google for the time; the
+// system clock, which NixOS keeps with timesyncd, is the time.
 BASE_FEATURE(kNetworkTimeServiceQuerying, base::FEATURE_DISABLED_BY_DEFAULT);
-#else
-BASE_FEATURE(kNetworkTimeServiceQuerying, base::FEATURE_ENABLED_BY_DEFAULT);
-#endif
 
 namespace {
 
