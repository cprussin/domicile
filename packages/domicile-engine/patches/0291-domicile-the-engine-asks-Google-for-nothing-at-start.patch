+++ b/chrome/browser/component_updater/optimization_guide_on_device_model_installer.cc
@@ -71,6 +71,11 @@ class OnDeviceModelUpdater {
 
 namespace {
 
+// Domicile: off, so on-device models are never downloaded. Their manifest
+// is the first of them, gigabytes follow it, and nothing in the engine uses
+// them.
+BASE_FEATURE(kDomicileOnDeviceModels, base::FEATURE_DISABLED_BY_DEFAULT);
+
 // This model asset predates Manifest and has a special install path.
 // Extension id is fklghjjljmnfjoepjmlobpekiapffcja.
 constexpr base::FilePath::CharType kLegacyBaseModelPath[] =
@@ -457,6 +462,10 @@ class ManifestProviderImpl final : public optimization_guide::ManifestProvider {
 
  private:
   void MaybeRegisterManifestComponent() {
+    // Domicile: see kDomicileOnDeviceModels.
+    if (!base::FeatureList::IsEnabled(kDomicileOnDeviceModels)) {
+      return;
+    }
     if (manifest_registered_ || !g_browser_process) {
       return;
     }
@@ -735,7 +744,9 @@ class ManifestAssetManagerDelegateImpl final
                                  const std::string& component_name) override {
     CHECK_CURRENTLY_ON(content::BrowserThread::UI, base::NotFatalUntil::M161);
     update_tracker_.InvalidatePendingUpdate(public_key_hex);
-    if (!g_browser_process) {
+    // Domicile: see kDomicileOnDeviceModels.
+    if (!base::FeatureList::IsEnabled(kDomicileOnDeviceModels) ||
+        !g_browser_process) {
       return;
     }
 
