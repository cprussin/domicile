 chrome/browser/component_updater/registration.cc                                 | 35 ++++++-----------------------------
 chrome/browser/navigation_predictor/search_engine_preconnector.cc                |  5 ++++-
 components/component_updater/component_updater_service.cc                        | 18 ++++++++++++++++++
 components/network_time/network_time_tracker.cc                                  |  8 ++------
 components/omnibox/browser/aim_eligibility_service_features.cc                   |  5 ++++-
 testing/variations/fieldtrial_testing_config.json                                | 23 -----------------------
 7 files changed, 46 insertions(+), 61 deletions(-)

