From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Fri, 2 Oct 2026 18:00:00 +0000
Subject: [PATCH] domicile: the desk does not flash between densities

0072 draws a less dense monitor's part of a layer from a tiling at that
monitor's scale, falling back to the page's own tiles, shrunk, where one
of its tiles is not ready. That tiling lived on the active tree alone, so
activation invalidated it: every commit that repainted anything -- a
hover, a focus color, a new wallpaper -- left the monitor the page's
tiles there until its own were rastered again, a region going soft and
then sharp. And a layer that took a surface of its own, a window dragged
at an opacity, gave its tilings up, so they came back empty on the drop.

So the pending tree keeps a monitor's tiling too, as a twin of the
active one: it rasters what the commit invalidated, activation waits on
those tiles as it does on the page's own (IsTileRequiredForActivation,
TilingSetRasterQueueRequired), and hands the tiling on as the monitor's.
A layer keeps its tilings, found through its screen space transform,
whether or not it can draw from them -- through a surface of its own, and
while it moves, which it now draws from them through.

See cc/domicile/display_regions.h; the series is read for this by
scripts/test-the-desk-does-not-flash-between-densities.sh.
---
 cc/layers/picture_layer_impl.cc              | 70 +++++++++++++-----
 cc/layers/picture_layer_impl.h               |  3 +
 cc/tiles/picture_layer_tiling.cc             |  3 +
 cc/tiles/picture_layer_tiling.h              |  6 +-
 cc/tiles/tiling_set_raster_queue_required.cc | 76 ++++++++++++++++----
 cc/tiles/tiling_set_raster_queue_required.h  | 18 ++++-
 6 files changed, 139 insertions(+), 37 deletions(-)

diff --git a/cc/layers/picture_layer_impl.cc b/cc/layers/picture_layer_impl.cc
index a4466e4ff7..2a8c56103c 100644
--- a/cc/layers/picture_layer_impl.cc
+++ b/cc/layers/picture_layer_impl.cc
@@ -134,7 +134,8 @@ void PictureLayerImpl::CopyPropertiesTo(LayerImpl* base_layer) const {
     DCHECK(!solid_color() || tilings_->num_tilings() == 0);
 
     // The pending tree should have at most a single tiling.
-    DCHECK_LE(tilings_->num_tilings(), 1u);
+    // DOMICILE: besides one for each less dense monitor it is shown on.
+    DCHECK_LE(tilings_->num_tilings() - NumDomicileDisplayTilings(), 1u);
 
     layer_impl->set_gpu_raster_max_texture_size(gpu_raster_max_texture_size_);
 
@@ -1552,15 +1553,33 @@ void PictureLayerImpl::CleanUpTilingsOnActiveLayer() {
   }
 }
 
+DomicileLayer PictureLayerImpl::AsDomicileLayer() const {
+  return {
+      .to_page_is_scale_or_translation =
+          ScreenSpaceTransform().IsScaleOrTranslation(),
+      .draws_into_page =
+          render_target() == layer_tree_impl()->RootRenderSurface() &&
+          draw_properties().target_space_transform.IsScaleOrTranslation(),
+      .is_directly_composited_image = IsDirectlyCompositedImage(),
+  };
+}
+
+size_t PictureLayerImpl::NumDomicileDisplayTilings() const {
+  size_t count = 0;
+  for (size_t i = 0; i < tilings_->num_tilings(); ++i) {
+    if (tilings_->tiling_at(i)->domicile_display_ratio() != 0.f) {
+      ++count;
+    }
+  }
+  return count;
+}
+
 bool PictureLayerImpl::DomicileDrawsPerDisplay() const {
-  // Only what is drawn straight into the page, unmoving: a surface of its own
-  // is drawn into the page by a transform this cannot see past, and a moving
-  // layer would make and drop tilings every frame.
+  // Moving too: its tilings follow it, and a layer that dropped to the page's
+  // scale while it moved would snap back to its monitors' when it stopped.
   return !layer_tree_impl()->domicile_display_regions().empty() &&
          layer_tree_impl()->IsActiveTree() &&
-         render_target() == layer_tree_impl()->RootRenderSurface() &&
-         draw_properties().target_space_transform.IsScaleOrTranslation() &&
-         !screen_space_transform_is_animating() && !IsDirectlyCompositedImage();
+         DomicileDrawsFromDisplayTilings(AsDomicileLayer());
 }
 
 void PictureLayerImpl::UpdateDomicileDisplayTilings() {
@@ -1568,27 +1587,41 @@ void PictureLayerImpl::UpdateDomicileDisplayTilings() {
       layer_tree_impl()->domicile_display_regions();
   const PictureLayerTiling* high_res =
       tilings_->FindTilingWithResolution(HIGH_RESOLUTION);
+  // On both trees, so that activation waits on a monitor's tiles as it does on
+  // the page's own; and whether or not the layer can draw from them this
+  // frame, so that none is given up and rebuilt empty. Found through the
+  // screen space transform, which reaches the page through a surface too.
+  const gfx::Transform to_page = ScreenSpaceTransform();
   std::vector<float> ratios;
-  if (high_res != nullptr && DomicileDrawsPerDisplay()) {
+  if (high_res != nullptr && DomicileKeepsDisplayTilings(AsDomicileLayer())) {
     ratios = DomicileRatiosMeeting(
-        regions,
-        MathUtil::MapEnclosingClippedRect(
-            draw_properties().target_space_transform, visible_layer_rect()));
+        regions, MathUtil::MapEnclosingClippedRect(to_page,
+                                                   visible_layer_rect()));
   }
   const auto scale_key_at = [&](float ratio) {
     return high_res->contents_scale_key() * ratio;
   };
 
   // A monitor's tiling no longer wanted, or at a raster scale since replaced,
-  // is an ordinary non-ideal tiling again: drawn from until the new one is
-  // ready, then cleaned up.
+  // is an ordinary non-ideal tiling again on the active tree: drawn from until
+  // the new one is ready, then cleaned up. The pending tree drops it, as it
+  // does every non-ideal tiling.
+  std::vector<PictureLayerTiling*> to_remove;
   for (size_t i = 0; i < tilings_->num_tilings(); ++i) {
     PictureLayerTiling* tiling = tilings_->tiling_at(i);
     const float ratio = tiling->domicile_display_ratio();
-    if (ratio != 0.f && (!std::ranges::contains(ratios, ratio) ||
-                         tiling->contents_scale_key() != scale_key_at(ratio))) {
-      tiling->SetDomicileDisplay(0.f, std::nullopt);
+    if (ratio == 0.f || (std::ranges::contains(ratios, ratio) &&
+                         tiling->contents_scale_key() == scale_key_at(ratio))) {
+      continue;
     }
+    tiling->SetDomicileDisplay(0.f, std::nullopt);
+    if (layer_tree_impl()->IsPendingTree() &&
+        tiling->resolution() != HIGH_RESOLUTION) {
+      to_remove.push_back(tiling);
+    }
+  }
+  for (PictureLayerTiling* tiling : to_remove) {
+    tilings_->Remove(tiling);
   }
 
   for (const float ratio : ratios) {
@@ -1607,9 +1640,8 @@ void PictureLayerImpl::UpdateDomicileDisplayTilings() {
       tiling = AddTiling(raster);
       tiling->set_resolution(NON_IDEAL_RESOLUTION);
     }
-    tiling->SetDomicileDisplay(
-        ratio, DomicileRegionInLayer(regions, ratio,
-                                     draw_properties().target_space_transform));
+    tiling->SetDomicileDisplay(ratio,
+                               DomicileRegionInLayer(regions, ratio, to_page));
   }
 }
 
diff --git a/cc/layers/picture_layer_impl.h b/cc/layers/picture_layer_impl.h
