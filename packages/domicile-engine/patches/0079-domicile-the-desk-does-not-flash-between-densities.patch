   void CleanUpTilingsOnActiveLayer();
   // DOMICILE: a tiling for each less dense monitor this layer is shown on.
   // See cc/domicile/display_regions.h.
+  DomicileLayer AsDomicileLayer() const;
+  size_t NumDomicileDisplayTilings() const;
   bool DomicileDrawsPerDisplay() const;
   void UpdateDomicileDisplayTilings();
   float MinimumContentsScale() const;
diff --git a/cc/tiles/picture_layer_tiling.cc b/cc/tiles/picture_layer_tiling.cc
index dbd0d307bd..5302716567 100644
--- a/cc/tiles/picture_layer_tiling.cc
+++ b/cc/tiles/picture_layer_tiling.cc
@@ -143,6 +143,9 @@ void PictureLayerTiling::TakeTilesAndPropertiesFrom(
   RemoveTilesInRegion(layer_invalidation, false /* recreate tiles */);
 
   resolution_ = pending_twin->resolution_;
+  // DOMICILE: and which monitor it is for, and where that monitor is.
+  domicile_display_ratio_ = pending_twin->domicile_display_ratio_;
+  domicile_clip_in_layer_space_ = pending_twin->domicile_clip_in_layer_space_;
 
   while (!pending_twin->tiles_.empty()) {
     auto pending_iter = pending_twin->tiles_.begin();
diff --git a/cc/tiles/picture_layer_tiling.h b/cc/tiles/picture_layer_tiling.h
index a487d76016..7e78f66e5e 100644
--- a/cc/tiles/picture_layer_tiling.h
+++ b/cc/tiles/picture_layer_tiling.h
@@ -304,8 +304,12 @@ class CC_EXPORT PictureLayerTiling {
                                    VisibilityChecker is_visible,
                                    bool is_tile_occluded) const {
     if (tree_ == PENDING_TREE) {
+      // DOMICILE: a less dense monitor's tiling too, so that a commit never
+      // leaves the monitor the page's tiles, shrunk, where its own were. See
+      // cc/domicile/display_regions.h.
       if (!can_require_tiles_for_activation_ ||
-          resolution_ != HIGH_RESOLUTION || is_tile_occluded) {
+          (resolution_ != HIGH_RESOLUTION && domicile_display_ratio_ == 0.f) ||
+          is_tile_occluded) {
         return false;
       }
 
diff --git a/cc/tiles/tiling_set_raster_queue_required.cc b/cc/tiles/tiling_set_raster_queue_required.cc
index 9620d9fd65..465c59ff7d 100644
--- a/cc/tiles/tiling_set_raster_queue_required.cc
+++ b/cc/tiles/tiling_set_raster_queue_required.cc
@@ -7,6 +7,7 @@
 #include <stddef.h>
 
 #include <utility>
+#include <vector>
 
 #include "cc/base/features.h"
 #include "cc/tiles/picture_layer_tiling_set.h"
@@ -40,35 +41,56 @@ TilingSetRasterQueueRequired::Create(PictureLayerTilingSet* tiling_set,
   } else {
     tiling = tiling_set->FindTilingWithResolution(HIGH_RESOLUTION);
   }
+  if (tiling && tiling->all_tiles_done()) {
+    tiling = nullptr;
+  }
+
+  // DOMICILE: activation waits on each less dense monitor's tiling as well, on
+  // the pending tree or on the active one when its pending twin is one. See
+  // cc/domicile/display_regions.h.
+  std::vector<PictureLayerTiling*> domicile_display_tilings;
+  if (type == RasterTilePriorityQueue::Type::REQUIRED_FOR_ACTIVATION) {
+    for (size_t i = 0; i < tiling_set->num_tilings(); ++i) {
+      PictureLayerTiling* candidate = tiling_set->tiling_at(i);
+      const PictureLayerTiling* pending =
+          tiling_set->tree() == ACTIVE_TREE
+              ? tiling_set->client()->GetPendingOrActiveTwinTiling(candidate)
+              : candidate;
+      if (candidate != tiling && pending &&
+          pending->domicile_display_ratio() != 0.f &&
+          !candidate->all_tiles_done()) {
+        domicile_display_tilings.push_back(candidate);
+      }
+    }
+  }
 
-  if (!tiling || tiling->all_tiles_done()) {
+  if (!tiling && domicile_display_tilings.empty()) {
     if (features::IsCCSlimmingEnabled()) {
       return nullptr;
     }
     return base::WrapUnique(new TilingSetRasterQueueRequired());
   }
-  return base::WrapUnique(new TilingSetRasterQueueRequired(tiling, type));
+  return base::WrapUnique(
+      new TilingSetRasterQueueRequired(tiling, domicile_display_tilings, type));
 }
 
 TilingSetRasterQueueRequired::TilingSetRasterQueueRequired() = default;
 
 TilingSetRasterQueueRequired::TilingSetRasterQueueRequired(
     PictureLayerTiling* tiling,
+    const std::vector<PictureLayerTiling*>& domicile_display_tilings,
     RasterTilePriorityQueue::Type type)
     : type_(type) {
-  DCHECK(tiling);
-  DCHECK(!tiling->all_tiles_done());
+  DCHECK(tiling || !domicile_display_tilings.empty());
+  DCHECK(!tiling || !tiling->all_tiles_done());
 
-  if (type == RasterTilePriorityQueue::Type::REQUIRED_FOR_ACTIVATION) {
-    iterator_ = TilingIterator(tiling, &tiling->tiling_data_,
-                               tiling->pending_visible_rect());
-  } else {
-    iterator_ = TilingIterator(tiling, &tiling->tiling_data_,
-                               tiling->current_visible_rect());
+  if (tiling) {
+    iterator_ = IteratorOver(tiling);
   }
-
-  while (!iterator_.done() && !IsTileRequired(*iterator_))
-    ++iterator_;
+  for (PictureLayerTiling* display_tiling : domicile_display_tilings) {
+    domicile_display_tilings_.push_back(display_tiling);
+  }
+  SkipToRequiredTile();
 }
 
 TilingSetRasterQueueRequired::~TilingSetRasterQueueRequired() = default;
@@ -80,8 +102,32 @@ bool TilingSetRasterQueueRequired::IsEmpty() const {
 void TilingSetRasterQueueRequired::Pop() {
   DCHECK(!IsEmpty());
   ++iterator_;
-  while (!iterator_.done() && !IsTileRequired(*iterator_))
-    ++iterator_;
+  SkipToRequiredTile();
+}
+
+TilingSetRasterQueueRequired::TilingIterator
+TilingSetRasterQueueRequired::IteratorOver(PictureLayerTiling* tiling) const {
+  if (type_ == RasterTilePriorityQueue::Type::REQUIRED_FOR_ACTIVATION) {
+    return TilingIterator(tiling, &tiling->tiling_data_,
+                          tiling->pending_visible_rect());
+  }
+  return TilingIterator(tiling, &tiling->tiling_data_,
+                        tiling->current_visible_rect());
+}
+
+void TilingSetRasterQueueRequired::SkipToRequiredTile() {
+  while (true) {
+    while (!iterator_.done() && !IsTileRequired(*iterator_)) {
+      ++iterator_;
+    }
+    // DOMICILE: then the monitors' tilings, in any order: every one of their
+    // required tiles is required.
+    if (!iterator_.done() || domicile_display_tilings_.empty()) {
+      return;
+    }
+    iterator_ = IteratorOver(domicile_display_tilings_.back());
+    domicile_display_tilings_.pop_back();
+  }
 }
 
 const PrioritizedTile& TilingSetRasterQueueRequired::Top() const {
diff --git a/cc/tiles/tiling_set_raster_queue_required.h b/cc/tiles/tiling_set_raster_queue_required.h
index e817720787..5b41726b82 100644
--- a/cc/tiles/tiling_set_raster_queue_required.h
+++ b/cc/tiles/tiling_set_raster_queue_required.h
@@ -6,7 +6,9 @@
 #define CC_TILES_TILING_SET_RASTER_QUEUE_REQUIRED_H_
 
 #include <memory>
+#include <vector>
 
+#include "base/memory/raw_ptr.h"
 #include "base/memory/raw_ptr_exclusion.h"
 #include "cc/cc_export.h"
 #include "cc/tiles/picture_layer_tiling_set.h"
@@ -58,13 +60,25 @@ class CC_EXPORT TilingSetRasterQueueRequired {
   };
 
   TilingSetRasterQueueRequired();
-  TilingSetRasterQueueRequired(PictureLayerTiling* tiling,
-                               RasterTilePriorityQueue::Type type);
+  // DOMICILE: `tiling` may be null when `domicile_display_tilings`, the less
+  // dense monitors' tilings activation waits on too, are not empty. See
+  // cc/domicile/display_regions.h.
+  TilingSetRasterQueueRequired(
+      PictureLayerTiling* tiling,
+      const std::vector<PictureLayerTiling*>& domicile_display_tilings,
+      RasterTilePriorityQueue::Type type);
 
   bool IsTileRequired(const PrioritizedTile& prioritized_tile) const;
+  TilingIterator IteratorOver(PictureLayerTiling* tiling) const;
+  // Moves `iterator_` on to a required tile, through the monitors' tilings
+  // once its own runs out.
+  void SkipToRequiredTile();
 
   TilingIterator iterator_;
   RasterTilePriorityQueue::Type type_;
+  // DOMICILE: those not yet iterated.
+  std::vector<raw_ptr<PictureLayerTiling, UnprotectedInRelease>>
+      domicile_display_tilings_;
 };
 
 }  // namespace cc
