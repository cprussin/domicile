From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 8 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: a touchpad pinch zooms the window under it, not the
 desk

A pinch over a browser window that its page left alone went up to the
outermost page, which is the desk: the whole desktop zoomed. Upstream's
ChildFrameInputHelper hands an inner WebContents' unconsumed touchpad
pinch to GetPinchZoomTarget, and that walks up to the root view.

- `render_widget_host_view_child_frame.cc`: a touchpad pinch update over
  an inner WebContents that its page did not consume goes to that
  WebContents' delegate as DomicilePinchZoom, and the rest of the pinch
  stops there.
- `web_contents_delegate.h`: DomicilePinchZoom, defaulting to drop it.
  The <webview> guest zooms its page by the update's scale.
- `render_widget_host_view_aura.cc`: the root view no longer page-scales
  from a touchpad pinch at all. The outermost page is the desk.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on `crux`.
---
 .../render_widget_host_view_aura.cc           |  4 +++-
 .../render_widget_host_view_child_frame.cc    | 19 +++++++++++++++++++
 .../public/browser/web_contents_delegate.h    |  5 +++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/content/browser/renderer_host/render_widget_host_view_aura.cc b/content/browser/renderer_host/render_widget_host_view_aura.cc
index caf30a7..300f7f6 100644
--- a/content/browser/renderer_host/render_widget_host_view_aura.cc
+++ b/content/browser/renderer_host/render_widget_host_view_aura.cc
@@ -1455,7 +1455,9 @@ void RenderWidgetHostViewAura::GestureEventAck(
 
   event_handler_->GestureEventAck(event, ack_result);
 
-  ForwardTouchpadZoomEventIfNecessary(event, ack_result);
+  // Domicile: no ForwardTouchpadZoomEventIfNecessary. The outermost page is
+  // the desk, which a touchpad pinch never zooms, whether over the shell or
+  // handed up from a <webview> (see RenderWidgetHostViewChildFrame).
 }
 
 void RenderWidgetHostViewAura::ProcessAckedTouchEvent(
diff --git a/content/browser/renderer_host/render_widget_host_view_child_frame.cc b/content/browser/renderer_host/render_widget_host_view_child_frame.cc
index 49dd25c..64e663e 100644
--- a/content/browser/renderer_host/render_widget_host_view_child_frame.cc
+++ b/content/browser/renderer_host/render_widget_host_view_child_frame.cc
@@ -33,10 +33,12 @@
 #include "content/browser/renderer_host/render_widget_host_impl.h"
 #include "content/browser/renderer_host/render_widget_host_view_event_handler.h"
 #include "content/browser/renderer_host/text_input_manager.h"
+#include "content/browser/web_contents/web_contents_impl.h"
 #include "content/common/features.h"
 #include "content/common/input/synthetic_gesture_target.h"
 #include "content/public/browser/render_process_host.h"
 #include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents_delegate.h"
 #include "third_party/blink/public/common/frame/frame_visual_properties.h"
 #include "third_party/blink/public/common/input/web_touch_event.h"
 #include "third_party/blink/public/mojom/frame/intrinsic_sizing_info.mojom.h"
@@ -813,6 +815,23 @@ void RenderWidgetHostViewChildFrame::GestureEventAck(
 #if !BUILDFLAG(IS_ANDROID)
   HandleSwipeToMoveCursorGestureAck(event);
 #endif
+
+  // Domicile: a touchpad pinch a <webview>'s page left alone zooms that page.
+  // ChildFrameInputHelper would hand it to the outermost page, the desk.
+  if (event.IsTouchpadZoomEvent()) {
+    WebContentsImpl* contents =
+        WebContentsImpl::FromRenderWidgetHostImpl(host());
+    if (contents && contents->GetOuterWebContents()) {
+      if (event.GetType() == blink::WebInputEvent::Type::kGesturePinchUpdate &&
+          ack_result != blink::mojom::InputEventResultState::kConsumed &&
+          !event.data.pinch_update.zoom_disabled && contents->GetDelegate()) {
+        contents->GetDelegate()->DomicilePinchZoom(
+            contents, event.data.pinch_update.scale);
+      }
+      return;
+    }
+  }
+
   input_helper_->GestureEventAckHelper(event, ack_source, ack_result);
 }
 
diff --git a/content/public/browser/web_contents_delegate.h b/content/public/browser/web_contents_delegate.h
index 2fadec5..1bd642c 100644
--- a/content/public/browser/web_contents_delegate.h
+++ b/content/public/browser/web_contents_delegate.h
@@ -579,6 +579,11 @@ class CONTENT_EXPORT WebContentsDelegate {
                                RenderWidgetHost* widget,
                                const std::u16string& text);
 
+  // Domicile: a touchpad pinch over `source`, an inner WebContents, that its
+  // page left alone. `scale` is this update's change, as a GesturePinchUpdate's
+  // is. Chrome would zoom the outermost page; the default drops it.
+  virtual void DomicilePinchZoom(WebContents* source, float scale) {}
+
   // Returns true if `web_contents` is, or is transitioning to, tab-fullscreen.
   virtual bool IsFullscreenForTabOrPending(const WebContents* web_contents);
 
