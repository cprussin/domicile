index 1bff144b66..2c24c9c267 100644
--- a/ui/ozone/platform/drm/BUILD.gn
+++ b/ui/ozone/platform/drm/BUILD.gn
@@ -277,6 +277,7 @@ source_set("gbm_unittests") {
     # linked only into `events_unittests`, which no job here builds, and the
