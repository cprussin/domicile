From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Thu, 1 Oct 2026 00:00:00 +0000
Subject: [PATCH] domicile: a <webview>'s guest is a guest to PageLoadMetrics

performance_manager's PageLoadMetricsWebContentsObserver DCHECKs that a
commit arrives during a load, and skips guests, but only a
GuestViewBase. A <webview>'s guest is an inner WebContents just as one
is and was not skipped, and guard-webview-tabs.sh's popup took the
browser down on that DCHECK.

The observer now skips a domicile::WebViewGuest the same way.
---
 chrome/browser/performance_manager/BUILD.gn              | 1 +
 .../observers/page_load_metrics_observer.cc              | 9 +++++++++
 2 files changed, 10 insertions(+)

diff --git a/chrome/browser/performance_manager/BUILD.gn b/chrome/browser/performance_manager/BUILD.gn
index 1b1c214..2381f2c 100644
--- a/chrome/browser/performance_manager/BUILD.gn
+++ b/chrome/browser/performance_manager/BUILD.gn
@@ -179,6 +179,7 @@ source_set("impl") {
     "//chrome/browser/ui/browser_window",
     "//chrome/common:buildflags",
     "//chrome/common:chrome_features",
+    "//components/domicile:web_view_guest",
     "//components/favicon/content",
     "//components/guest_view/browser",
     "//components/guest_view/buildflags",
diff --git a/chrome/browser/performance_manager/observers/page_load_metrics_observer.cc b/chrome/browser/performance_manager/observers/page_load_metrics_observer.cc
index 861a63c..8c350a8 100644
--- a/chrome/browser/performance_manager/observers/page_load_metrics_observer.cc
+++ b/chrome/browser/performance_manager/observers/page_load_metrics_observer.cc
@@ -7,6 +7,7 @@
 #include "base/metrics/histogram_functions.h"
 #include "build/build_config.h"
 #include "chrome/browser/preloading/prefetch/no_state_prefetch/no_state_prefetch_manager_factory.h"
+#include "components/domicile/browser/web_view_guest.h"
 #include "components/guest_view/buildflags/buildflags.h"
 #include "components/no_state_prefetch/browser/no_state_prefetch_manager.h"
 #include "components/performance_manager/public/performance_manager.h"
@@ -293,6 +294,14 @@ void PageLoadMetricsWebContentsObserver::DidFinishNavigation(
   }
 #endif
 
+  // Domicile's engine fork: nor within a <webview>'s guest, which is an inner
+  // WebContents as a GuestViewBase is but is not one, so the check above
+  // misses it. A guest's commit can arrive with no load started, and the
+  // DCHECK below then takes the browser down.
+  if (domicile::WebViewGuest::FromWebContents(web_contents())) {
+    return;
+  }
+
   DCHECK(is_loading_);
 
   if (navigation_handle->IsInPrimaryMainFrame() &&
-- 
2.43.0

