From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lillecarl <carl.andersson@dynamist.se>
Date: Tue, 24 Nov 2026 00:00:00 +0000
Subject: [PATCH] domicile: an extension may take any key

Chrome keeps its own accelerators from extensions, Ctrl+Shift+L for its
vertical tabs among them. A desk has none of them: the desk's own shortcuts come
before an extension's keys.
---
 chrome/browser/extensions/commands/command_service.cc | 5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/extensions/commands/command_service.cc b/chrome/browser/extensions/commands/command_service.cc
--- a/chrome/browser/extensions/commands/command_service.cc
+++ b/chrome/browser/extensions/commands/command_service.cc
@@ -19,7 +19,6 @@
 #include "chrome/browser/extensions/extension_commands_global_registry.h"
 #include "chrome/browser/extensions/extension_keybinding_registry.h"
 #include "chrome/browser/profiles/profile.h"
-#include "chrome/browser/ui/accelerator_utils.h"
 #include "chrome/common/pref_names.h"
 #include "components/pref_registry/pref_registry_syncable.h"
 #include "components/prefs/scoped_user_pref_update.h"
@@ -571,8 +570,8 @@
             command.accelerator().key_code() <= ui::VKEY_9);
   }
 
-  // Not a global command, check if the command is a Chrome shortcut.
-  return !IsChromeAccelerator(command.accelerator());
+  // Not a global command. A desk has no Chrome shortcuts to keep it from.
+  return true;
 }
 
 void CommandService::UpdateExtensionSuggestedCommandPrefs(
