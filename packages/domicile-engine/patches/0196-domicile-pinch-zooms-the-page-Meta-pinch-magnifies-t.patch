   void DispatchTouchpadGestureEvent(
       RenderWidgetHostViewInput* root_view,
       RenderWidgetHostViewInput* target,
@@ -430,6 +439,9 @@ class COMPONENT_EXPORT(INPUT) RenderWidgetHostInputEventRouter final
   bool touchscreen_gesture_target_moved_recently_ = false;
   bool touchscreen_gesture_target_moved_recently_for_iov2_ = false;
   raw_ptr<RenderWidgetHostViewInput> touchpad_gesture_target_ = nullptr;
+  // domicile: whether the touchpad pinch in progress began with Meta held,
+  // and so magnifies the desk.
+  bool desk_pinch_ = false;
   raw_ptr<RenderWidgetHostViewInput> bubbling_gesture_scroll_target_ = nullptr;
   raw_ptr<RenderWidgetHostViewInput> bubbling_gesture_scroll_origin_ = nullptr;
   // Used to target wheel events for the duration of a scroll.
diff --git a/content/browser/renderer_host/cross_process_frame_connector.cc b/content/browser/renderer_host/cross_process_frame_connector.cc
index 52af995..fe0d533 100644
--- a/content/browser/renderer_host/cross_process_frame_connector.cc
+++ b/content/browser/renderer_host/cross_process_frame_connector.cc
@@ -472,6 +472,13 @@ CrossProcessFrameConnector::GetRootRenderWidgetHostView() {
 
 input::RenderWidgetHostViewInput*
 CrossProcessFrameConnector::GetPinchZoomTarget() {
+  // domicile: a <webview>'s page is the main frame of an inner WebContents,
+  // and magnifies itself, as a browser tab does. Upstream hands its pinch to
+  // the outermost page, which here is the desk.
+  RenderFrameHostImpl* child = current_child_frame_host();
+  if (child && child->is_main_frame()) {
+    return view_;
+  }
   input::RenderWidgetHostViewInput* parent = GetParentViewInput();
   return parent ? parent->GetPinchZoomTarget() : nullptr;
 }
