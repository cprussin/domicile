   int page_flip_count() const { return page_flip_count_; }
 
+  // DOMICILE: whether the callback is still to be answered.
+  bool waiting() const { return !callback_.is_null(); }
+
+  // DOMICILE: answers the callback now, as presented at `now` but failed, and
+  // ignores the page flip events still to come. For a flip the driver never
+  // completes, such as one a DisplayLink dock (evdi) drops. Only while
+  // `waiting()`.
+  void Abandon(base::TimeTicks now);
+
  private:
   void Signal(unsigned int frame, base::TimeTicks timestamp);
 
