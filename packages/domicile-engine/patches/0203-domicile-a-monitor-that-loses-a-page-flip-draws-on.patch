 namespace {
 
+// DOMICILE: how long a page flip may take before it is given up on. Far above
+// any refresh interval, and far below the kernel's own 10 s `flip_done` wait.
+constexpr base::TimeDelta kPageFlipTimeout = base::Seconds(1);
+
+// DOMICILE: how long after giving up on a flip a failed commit is blamed on
+// the kernel still holding it, past its 10 s `flip_done` wait and cleanup.
+constexpr base::TimeDelta kLostFlipGrace = base::Seconds(15);
+
 void CompletePageFlip(
     base::WeakPtr<HardwareDisplayController> hardware_display_controller_,
+    uint64_t flip,
     int modeset_sequence,
     PresentationOnceCallback callback,
     DrmOverlayPlaneList plane_list,
     const gfx::PresentationFeedback& presentation_feedback) {
   if (hardware_display_controller_) {
     hardware_display_controller_->OnPageFlipComplete(
-        modeset_sequence, std::move(plane_list), presentation_feedback);
+        flip, modeset_sequence, std::move(plane_list),
+        presentation_feedback);
   }
   std::move(callback).Run(presentation_feedback);
 }
@@ -285,6 +296,19 @@ void HardwareDisplayController::SchedulePageFlip(
       }
     }
 
+    // DOMICILE: the kernel refuses a commit while it still holds a flip given
+    // up on, until its own wait for that flip runs out. Skip the frame, as
+    // without master, rather than arm the watchdog.
+    if (!lost_flip_at_.is_null() &&
+        base::TimeTicks::Now() - lost_flip_at_ < kLostFlipGrace) {
+      std::move(submission_callback)
+          .Run(gfx::SwapResult::SWAP_ACK,
+               /*release_fence=*/gfx::GpuFenceHandle());
+      std::move(presentation_callback)
+          .Run(gfx::PresentationFeedback::Failure());
+      return;
+    }
+
     // No outdated buffers detected which makes this a true page flip failure.
     // Alert the watchdog.
     watchdog_.ArmForFailedCommit();
@@ -311,14 +335,44 @@ void HardwareDisplayController::SchedulePageFlip(
       .Run(gfx::SwapResult::SWAP_ACK, std::move(release_fence));
 
   watchdog_.OnSuccessfulPageFlip();
+  lost_flip_at_ = base::TimeTicks();
   // Everything was submitted successfully, wait for asynchronous completion.
   page_flip_request->TakeCallback(
       base::BindOnce(&CompletePageFlip, weak_ptr_factory_.GetWeakPtr(),
+                     ++page_flips_,
                      GetDrmDevice()->modeset_sequence_id(),
                      std::move(presentation_callback), std::move(plane_list)));
+  // DOMICILE: one timeout for each flip, because a modeset forgets the pending
+  // flip but not its callback, and the next flip does not wait for it. It
+  // runs without this controller too, because the window still waits.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&HardwareDisplayController::OnPageFlipTimedOut,
+                     weak_ptr_factory_.GetWeakPtr(), page_flip_request),
+      kPageFlipTimeout);
   page_flip_request_ = std::move(page_flip_request);
 }
 
+// static
+void HardwareDisplayController::OnPageFlipTimedOut(
+    base::WeakPtr<HardwareDisplayController> controller,
+    scoped_refptr<PageFlipRequest> request) {
+  if (!request->waiting()) {
+    return;  // Its event came in time.
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  // Not a flip a modeset forgot: the kernel let go of that one.
+  if (controller && controller->page_flip_request_ == request) {
+    LOG(ERROR) << "domicile: CRTC " << controller->crtc_controllers_[0]->crtc()
+               << " never finished a page flip in "
+               << kPageFlipTimeout.InMilliseconds()
+               << " ms; drawing on without it";
+    // Before the callback, which can submit the next frame right away.
+    controller->lost_flip_at_ = now;
+  }
+  request->Abandon(now);
+}
