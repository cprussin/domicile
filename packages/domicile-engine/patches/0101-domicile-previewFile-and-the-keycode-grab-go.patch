From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: domicile CI <ci@domicile.invalid>
Date: Wed, 7 Oct 2026 00:00:00 +0000
Subject: [PATCH] domicile: previewFile and the keycode grab go

A shell previews a file with its own system calls, and grabs a chord by
name, so `previewFile()` and the `grabShortcut(DomicileShortcut)`
overload leave the module, and DomicileFilePreview's and
DomicileShortcut's IDL and generated bindings leave the lists here.

Verified: not built. This repository cannot build Chromium; the engine
job builds it on `crux`.
---
 ...link/renderer/bindings/generated_in_modules.gni | 4 ----
 ...arty/blink/renderer/bindings/idl_in_modules.gni | 2 --
 2 files changed, 6 deletions(-)

diff --git a/third_party/blink/renderer/bindings/generated_in_modules.gni b/third_party/blink/renderer/bindings/generated_in_modules.gni
--- a/third_party/blink/renderer/bindings/generated_in_modules.gni
+++ b/third_party/blink/renderer/bindings/generated_in_modules.gni
@@ -316,10 +316,6 @@
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_app_event_init.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_file_search.cc",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_file_search.h",
-  "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_file_preview.cc",
-  "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_file_preview.h",
-  "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_shortcut.cc",
-  "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_shortcut.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_shortcut_event_init.cc",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_domicile_shortcut_event_init.h",
   "$root_gen_dir/third_party/blink/renderer/bindings/modules/v8/v8_color_selection_options.cc",
diff --git a/third_party/blink/renderer/bindings/idl_in_modules.gni b/third_party/blink/renderer/bindings/idl_in_modules.gni
--- a/third_party/blink/renderer/bindings/idl_in_modules.gni
+++ b/third_party/blink/renderer/bindings/idl_in_modules.gni
@@ -284,11 +284,9 @@
   "//third_party/blink/renderer/modules/domicile/domicile_clipboard_entry.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_extension.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_file_search.idl",
-  "//third_party/blink/renderer/modules/domicile/domicile_file_preview.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_browser_window.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_host.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_display.idl",
-  "//third_party/blink/renderer/modules/domicile/domicile_shortcut.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_shortcut_event.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_shortcut_event_init.idl",
   "//third_party/blink/renderer/modules/domicile/domicile_theme.idl",
