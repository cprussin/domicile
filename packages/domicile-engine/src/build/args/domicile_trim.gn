# Arguments every engine build imports, to leave out what a desk never runs
# or should not.
#
# Under `src/` so a change to it changes the series identity and rebuilds the
# release.

# V8 code caches for Chrome's WebUI pages, 3.5 MB of resources.pak. They only
# speed up a WebUI page's first load.
enable_webui_generate_code_cache = false

# Chromium's field trial testing config, which turns on experiments meant for
# Chromium's own bots. One, `CompositedAnimationsForceMainFrames` with
# `intersection-observer`, runs a main frame and a commit for every frame of a
# transform animation in a document with a `<webview>`, so every workspace
# slide redoes the desk's paint each frame. Shipped Chrome runs none of them. See
# guard-animation-main-frames.sh.
disable_fieldtrial_testing_config = true

# Not here: `enable_compose`, `enable_on_device_translation` and
# `use_on_device_model_service`. Only Android builds turn them off, and desktop
# targets depend on their code unconditionally: with either of the first two
# off, `gn gen` fails on an assert.
