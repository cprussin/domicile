# Throwaway smoke test written in C, which also checks that the header is valid
# C.
executable("engine_smoke") {
  output_name = "domicile_engine_smoke"

  sources = [ "engine_smoke.c" ]

  # The raw_ptr plugin wants raw_ptr<T> for `void* user_data` in the C ABI,
  # but a C header cannot use it. Disabled here rather than in Chromium's
  # build/config/raw_ptr_plugin_config.yaml to avoid patching that file.
  configs -= [ "//build/config/clang:find_bad_constructs" ]

  deps = [ ":domicile_engine" ]
}

# Checks whether a color appears on the browser's page. Used by
# guard-webview-framing.sh; needs no Wayland client.
executable("engine_color_probe") {
  output_name = "domicile_color_probe"

  sources = [ "engine_color_probe.cc" ]

  deps = [
    ":domicile_engine",
    "//base",
  ]
}

# Captures the browser's window through the C ABI and reads the frames back.
