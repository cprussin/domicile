# libdomicile_engine.so: the C ABI library between domicile-compositor and the
# browser. It is built with GN because cargo cannot build mojom bindings. See
# docs/architecture/ENGINE-FORK.md#the-c-abi in the Domicile repository.
#
# Nothing in `chrome` depends on it; build it by name:
#
#   autoninja -C out/Domicile domicile_engine

# The library's event queue to the compositor, split out so it can be tested
# without a browser.
source_set("event_queue") {
  sources = [
    "engine_event_queue.cc",
    "engine_event_queue.h",
  ]

  public_deps = [ "//base" ]
}

# Converts a client's window geometry to texture coordinates.
source_set("surface_crop") {
  sources = [
    "surface_crop.cc",
    "surface_crop.h",
  ]

  public_deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

source_set("surface_crop_unit_tests") {
  testonly = true

  sources = [ "surface_crop_unittest.cc" ]

  deps = [
    ":surface_crop",
    "//base",
    "//testing/gtest",
    "//ui/gfx/geometry",
  ]
}

