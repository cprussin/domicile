# libdomicile_engine.so: the C ABI library between domicile-compositor and the
# browser. It is built with GN because cargo cannot build mojom bindings. See
# docs/architecture/ENGINE-FORK.md#the-c-abi in the Domicile repository.
#
# Nothing in `chrome` depends on it; build it by name:
#
#   autoninja -C out/Domicile domicile_engine

import("//build/config/sanitizers/alloc_token.gni")

