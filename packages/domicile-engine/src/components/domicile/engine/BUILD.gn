# Sends the library's allocations to the process's allocator. See
# process_allocator.c.
source_set("process_allocator") {
  if (use_alloc_token) {
    sources = [ "process_allocator.c" ]
  }

  # Otherwise each wrapper's own call would be rewritten back into itself.
  configs -= [ "//build/config/sanitizers:alloc_token" ]
}

_alloc_token_functions = [
  "__alloc_token_aligned_alloc",
  "__alloc_token_calloc",
  "__alloc_token_malloc",
  "__alloc_token_memalign",
  "__alloc_token_posix_memalign",
  "__alloc_token_pvalloc",
  "__alloc_token_realloc",
  "__alloc_token_reallocarray",
  "__alloc_token_valloc",
  "__alloc_token__Znam",
  "__alloc_token__ZnamRKSt9nothrow_t",
  "__alloc_token__ZnamSt11align_val_t",
  "__alloc_token__ZnamSt11align_val_tRKSt9nothrow_t",
  "__alloc_token__Znwm",
  "__alloc_token__ZnwmRKSt9nothrow_t",
  "__alloc_token__ZnwmSt11align_val_t",
  "__alloc_token__ZnwmSt11align_val_tRKSt9nothrow_t",
]

shared_library("domicile_engine") {
  output_name = "domicile_engine"

  if (use_alloc_token) {
    ldflags = []
    foreach(f, _alloc_token_functions) {
      ldflags += [ "-Wl,--wrap=$f" ]
    }
  }

  sources = [
    "domicile_engine.cc",
    "domicile_engine.h",
    "domicile_engine_spike.h",
  ]

  deps = [
    ":buffer_color",
    ":event_queue",
    ":probe_wait",
    ":process_allocator",
    ":surface_alpha",
    ":surface_crop",
    ":surface_frames",
    ":surface_holds",
    ":surface_submits",
    ":surface_transform",
    "//base",
    "//components/domicile:synced_frame",
    "//components/domicile/mojom",
    "//components/domicile/spike/mojom",
    "//components/viz/common",
    "//gpu/command_buffer/client",
    "//gpu/ipc/common:interfaces",
    "//mojo/core/embedder",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/platform",
    "//mojo/public/cpp/system",
    "//services/viz/public/mojom",
    "//ui/gfx/geometry",
  ]
}

# Throwaway smoke test written in C, which also checks that the header is valid
# C.
executable("engine_smoke") {
  output_name = "domicile_engine_smoke"

  sources = [ "engine_smoke.c" ]

  # The raw_ptr plugin wants raw_ptr<T> for `void* user_data` in the C ABI,
  # but a C header cannot use it. Disabled here rather than in Chromium's
  # build/config/raw_ptr_plugin_config.yaml to avoid patching that file.
  configs -= [ "//build/config/clang:find_bad_constructs" ]

  deps = [ ":domicile_engine" ]
}

