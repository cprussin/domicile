# The browser-process half of Domicile's engine fork: brokering viz frame sinks
# to a compositing producer that is not a renderer. See
# docs/architecture/ENGINE-FORK.md in the Domicile repository.
#
# This deliberately does not depend on //content. It takes the
# HostFrameSinkManager and the FrameSinkId allocator from whoever instantiates
# it, which keeps the privilege where it belongs — with the embedder — and
# keeps this testable without a browser.
source_set("browser") {
  sources = [
    "browser/brokered_frame_sink.cc",
    "browser/brokered_frame_sink.h",
    "browser/external_surface_provider.cc",
    "browser/external_surface_provider.h",
    "browser/frame_sink_broker.cc",
    "browser/frame_sink_broker.h",
  ]

  public_deps = [
    "//base",
    "//components/domicile/mojom",
    "//components/viz/common",
    "//components/viz/host",
    "//gpu/command_buffer/client",
    "//mojo/public/cpp/bindings",
    "//ui/gfx",
    "//ui/gfx/geometry",
  ]
}

# The scheme's name, its one host, and the switch that points at the shell.
#
# Header-only and dependency-free on purpose. chrome/common needs it to register
# the scheme in every process, and must not acquire //content to do that.
source_set("common") {
  sources = [ "common/domicile_scheme.h" ]
}

# The cursors a client can ask for, and the codec between their wire names and
# the enum.
#
# Its own target rather than part of :common, which is the scheme and nothing
# else -- and this is wanted by two places that share nothing else: the browser
# reading the compositor's socket, and Blink handing a name to the page. Header
# only, and templated over the enum so the same list serves
# `mojom::CursorShape` and its `-blink` variant without this depending on
# either.
source_set("cursor_shape") {
  sources = [ "common/cursor_shape.h" ]

  public_deps = [ "//base" ]
}

# Serving the shell over domicile://.
#
# A target of its own rather than part of :browser, because this depends on
# //content and :browser deliberately does not -- that is a property worth
# keeping, and the one thing here that needs content is its file loader.
source_set("shell_scheme") {
  sources = [
    "browser/shell_url_loader_factory.cc",
    "browser/shell_url_loader_factory.h",
  ]

  public_deps = [
    ":common",
    ":shell_source",
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

# Which shell the browser is serving, for the life of the process.
#
# Its own target beside :shell_scheme rather than part of it, because it is the
# half of serving a shell that needs neither //content nor a mojo pipe -- and
# because it is what `domicile load-shell` writes to, so the thing that carries
# that command in will want it without wanting a URLLoaderFactory. //base and
# the switch names, which is all state about one directory and one filename can
# need.
source_set("shell_source") {
  sources = [
    "browser/shell_source.cc",
    "browser/shell_source.h",
  ]

  public_deps = [
    ":common",
    "//base",
  ]
}

# What a running engine can be told about the shell it serves.
#
# Its own target beside :shell_source rather than part of it, because a line of
# JSON and the state it names are two different things -- and because this is
# the half of the command socket that can be tested with a string. What cannot
# is in //chrome/browser/domicile, which is where the socket and the shell's
# window are. //base and the switch names; no //content and no socket.
source_set("command_protocol") {
  sources = [
    "browser/command_protocol.cc",
    "browser/command_protocol.h",
  ]

  public_deps = [
    ":common",
    "//base",
  ]
}

# The chords the shell claimed for the desktop, and who to tell when one fires.
#
# Its own target between :control_channel and :web_view_guest because it is the
# one thing both of them touch, and because it is the only piece of this that
# can be tested without a browser at all -- which is where the matching rules
# are asserted. Like :browser and :control_channel it does not depend on
# //content: a chord is a keycode and four booleans.
source_set("shortcut_registry") {
  sources = [
    "browser/shortcut_registry.cc",
    "browser/shortcut_registry.h",
  ]

  public_deps = [ "//base" ]
}

# The page behind a <webview>.
#
# Its own target beside :shell_scheme rather than part of it, for the reason
# every target here is separate: this is the one thing in the fork that needs
# content's guest machinery, and a target boundary is what says so. Like
# :shell_scheme it depends on //content, which is why neither is part of
# :browser.
source_set("web_view_guest") {
  sources = [
    "browser/web_view_guest.cc",
    "browser/web_view_guest.h",
  ]

  public_deps = [
    ":shortcut_registry",
    "//base",
    "//components/domicile/mojom",
    "//components/input",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/events:dom_keycode_converter",
    "//url",
  ]
}

# The shell's control channel, in the browser process.
#
# Its own target so the slice can meet a compiler before the Blink half exists,
# and because what it needs is //net, which nothing else here wants. Like
# :browser, it does not depend on //content.
source_set("control_channel") {
  sources = [
    "browser/control_channel.cc",
    "browser/control_channel.h",
  ]

  public_deps = [
    ":common",
    ":cursor_shape",
    ":shortcut_registry",
    "//base",
    "//components/domicile/mojom",
    "//mojo/public/cpp/bindings",
    "//net",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "browser/command_protocol_unittest.cc",
    "browser/frame_sink_broker_unittest.cc",
    "browser/shell_source_unittest.cc",
    "browser/shell_url_loader_factory_unittest.cc",
    "browser/shortcut_registry_unittest.cc",
    "common/cursor_shape_unittest.cc",
    "spike/window_diff_unittest.cc",
  ]

  deps = [
    ":browser",
    ":command_protocol",
    ":cursor_shape",
    ":shell_scheme",
    ":shell_source",
    ":shortcut_registry",
    "//components/domicile/mojom",
    "//components/domicile/engine:event_queue_unit_tests",
    "//base",
    "//base/test:test_support",
    "//components/domicile/spike:window_diff",
    "//components/viz/service",
    "//components/viz/test:test_support",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/geometry",
  ]
}

# THROWAWAY. The spike's producer and its two measurements.
#
# Both are executables nothing depends on, and GN only loads a BUILD.gn that
# something references. This group is what makes them reachable, so that
# carrying the tools costs no edit to a file Chromium owns.
group("spike") {
  deps = [
    "//components/domicile/spike:css_parity",
    "//components/domicile/spike:solid_color_submitter",
  ]
}

# Phase 1's library, reachable the same way and for the same reason: GN only
# loads a BUILD.gn something references.
group("engine") {
  deps = [
    "//components/domicile/engine:domicile_engine",
    "//components/domicile/engine:engine_colour_probe",
    "//components/domicile/engine:engine_dmabuf_smoke",
    "//components/domicile/engine:engine_smoke",
  ]
}
