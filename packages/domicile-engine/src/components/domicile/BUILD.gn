import("//testing/test.gni")

# For `use_xkbcommon`, which decides whether there is an
# XkbKeyboardLayoutEngine for the keymap's tests to assert against.
import("//ui/base/ui_features.gni")

# The browser-process half of Domicile's engine fork: brokering viz frame sinks
# to a compositing producer that is not a renderer. See
# docs/architecture/ENGINE-FORK.md in the Domicile repository.
#
# This deliberately does not depend on //content. It takes the
# HostFrameSinkManager and the FrameSinkId allocator from whoever instantiates
# it, which keeps the privilege where it belongs — with the embedder — and
# keeps this testable without a browser.
source_set("browser") {
  sources = [
    "browser/brokered_frame_sink.cc",
    "browser/brokered_frame_sink.h",
    "browser/display_list.cc",
    "browser/display_list.h",
    "browser/external_surface_provider.cc",
    "browser/external_surface_provider.h",
    "browser/frame_sink_broker.cc",
    "browser/frame_sink_broker.h",
  ]

  # //ui/display is here for `browser/display_list.cc` and for nothing else: a
  # display::Display is what ozone's screen reads the monitors into, and
  # turning that into what a wl_output states is the one piece of this target
  # that is arithmetic rather than plumbing. It is still not //content.
  public_deps = [
    "//base",
    "//components/domicile/mojom",
    "//components/viz/common",
    "//components/viz/host",
    "//gpu/command_buffer/client",
    "//mojo/public/cpp/bindings",
    "//ui/display",
    "//ui/gfx",
    "//ui/gfx/geometry",
  ]
}

# The scheme's name, its one host, and the switch that points at the shell.
#
# Header-only and dependency-free on purpose. chrome/common needs it to register
# the scheme in every process, and must not acquire //content to do that.
# Which displays want a shell window, and which windows are left over.
#
# A TARGET OF ITS OWN so that //chrome/browser/domicile can have the answer
# without taking the frame sink broker with it: `browser` above pulls viz, gpu
# and mojo, and this is a set difference over display ids. It is the same split
# `command_protocol` is on the other side of -- the decision here where it has
# tests, the window it is carried out on over in //chrome, which is the only
# place a Browser can be made.
source_set("shell_windows") {
  sources = [
    "browser/shell_windows.cc",
    "browser/shell_windows.h",
  ]

  public_deps = [ "//ui/display" ]
}

# Where the cursor goes when a page asks for it to be moved.
#
# A target of its own beside :shell_windows for the same reason that one is
# one: the arithmetic and the refusals are here, where a test can reach them
# with no browser and no window, and carrying it out is in
# //chrome/browser/domicile, which is the only place a window's root can be
# found. //ui/gfx/geometry and nothing else -- a rectangle and a point.
source_set("pointer_warp") {
  sources = [
    "browser/pointer_warp.cc",
    "browser/pointer_warp.h",
  ]

  public_deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

source_set("common") {
  sources = [ "common/domicile_scheme.h" ]
}

# The cursors a client can ask for, and the codec between their wire names and
# the enum.
#
# Its own target rather than part of :common, which is the scheme and nothing
# else -- and this is wanted by two places that share nothing else: the browser
# reading the compositor's socket, and Blink handing a name to the page. Header
# only, and templated over the enum so the same list serves
# `mojom::CursorShape` and its `-blink` variant without this depending on
# either.
source_set("cursor_shape") {
  sources = [ "common/cursor_shape.h" ]

  public_deps = [ "//base" ]
}

# Which way up a monitor is, and the wire names for it. The same shape as
# :cursor_shape above and wanted by the same two places -- the browser reading
# the compositor's socket, and Blink handing a name to the page. Header only,
# and templated over the enum so the same list serves `mojom::DisplayTransform`
# and its `-blink` variant without this depending on either.
source_set("display_transform") {
  sources = [ "common/display_transform.h" ]

  public_deps = [ "//base" ]
}

# Which way round the desktop is drawn, and the wire names for it. The same
# shape as :cursor_shape and :display_transform above and wanted by the same
# two places -- the browser reading the compositor's socket, and Blink handing
# a name to the page. Header only, and templated over the enum so the same list
# serves `mojom::Theme` and its `-blink` variant without this depending on
# either.
source_set("theme") {
  sources = [ "common/theme.h" ]

  public_deps = [ "//base" ]
}

# Serving the shell over domicile://.
#
# A target of its own rather than part of :browser, because this depends on
# //content and :browser deliberately does not -- that is a property worth
# keeping, and the one thing here that needs content is its file loader.
source_set("shell_scheme") {
  sources = [
    "browser/shell_url_loader_factory.cc",
    "browser/shell_url_loader_factory.h",
  ]

  public_deps = [
    ":common",
    ":shell_source",
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

# Which shell the browser is serving, for the life of the process.
#
# Its own target beside :shell_scheme rather than part of it, because it is the
# half of serving a shell that needs neither //content nor a mojo pipe -- and
# because it is what `domicile load-shell` writes to, so the thing that carries
# that command in will want it without wanting a URLLoaderFactory. //base and
# the switch names, which is all state about one directory and one filename can
# need.
source_set("shell_source") {
  sources = [
    "browser/shell_source.cc",
    "browser/shell_source.h",
  ]

  public_deps = [
    ":common",
    "//base",
  ]
}

# What a running engine can be told about the shell it serves.
#
# Its own target beside :shell_source rather than part of it, because a line of
# JSON and the state it names are two different things -- and because this is
# the half of the command socket that can be tested with a string. What cannot
# is in //chrome/browser/domicile, which is where the socket and the shell's
# window are. //base and the switch names; no //content and no socket.
source_set("command_protocol") {
  sources = [
    "browser/command_protocol.cc",
    "browser/command_protocol.h",
  ]

  public_deps = [
    ":common",
    "//base",
  ]
}

# The chords the shell claimed for the desktop, and who to tell when one fires.
#
# Its own target between :control_channel and :web_view_guest because it is the
# one thing both of them touch, and because it is the only piece of this that
# can be tested without a browser at all -- which is where the matching rules
# are asserted. Like :browser and :control_channel it does not depend on
# //content: a chord is a keycode and four booleans.
source_set("shortcut_registry") {
  sources = [
    "browser/shortcut_registry.cc",
    "browser/shortcut_registry.h",
  ]

  public_deps = [ "//base" ]
}

# The page behind a <webview>.
#
# Its own target beside :shell_scheme rather than part of it, for the reason
# every target here is separate: this is the one thing in the fork that needs
# content's guest machinery, and a target boundary is what says so. Like
# :shell_scheme it depends on //content, which is why neither is part of
# :browser.
source_set("web_view_guest") {
  sources = [
    "browser/web_view_guest.cc",
    "browser/web_view_guest.h",
  ]

  public_deps = [
    ":shortcut_registry",
    "//base",
    "//components/domicile/mojom",
    "//components/input",
    # THE LOCK A BROWSER WINDOW DRAWS, and the reason it is Chromium's own
    # answer rather than the fork's. `security_state` is what Chrome's omnibox
    # is driven by: `content` builds a VisibleSecurityState out of the visible
    # entry's SSLStatus and `core` turns it into the level. A fork deriving one
    # from a URL scheme would be drawing a padlock nobody checked a certificate
    # for.
    "//components/security_state/content",
    "//components/security_state/core",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common",
    "//ui/base",
    "//ui/events:dom_keycode_converter",
    "//url",
  ]
}

# The keymap the browser process decodes a key press with.
#
# Its own target beside :control_channel rather than part of it, for the reason
# :shortcut_registry is one: it is the piece of this that can be asserted
# against a real XkbKeyboardLayoutEngine with no socket, no mojo and no
# browser, which is where the whole of the bug is written down as a test. What
# it needs is //ui/events/ozone/layout and that is all -- no //content and no
# //net.
source_set("keyboard_layout") {
  sources = [
    "browser/keyboard_layout.cc",
    "browser/keyboard_layout.h",
  ]

  public_deps = [
    "//base",
    "//ui/events/ozone/layout",
  ]
}

# Newline-framed lines out of a socket read a buffer at a time.
#
# Its own target beside :control_channel rather than part of it, for the
# reason :shortcut_registry is one: it is the piece of the channel that can be
# tested with a string, and the one whose cost was a bug -- see the header.
# //base-free, because splitting bytes on a newline wants nothing.
source_set("line_framer") {
  sources = [
    "browser/line_framer.cc",
    "browser/line_framer.h",
  ]
}

# The shell's control channel, in the browser process.
#
# Its own target so the slice can meet a compiler before the Blink half exists,
# and because what it needs is //net, which nothing else here wants. Like
# :browser, it does not depend on //content.
source_set("control_channel") {
  sources = [
    "browser/control_channel.cc",
    "browser/control_channel.h",
  ]

  public_deps = [
    ":common",
    ":cursor_shape",
    ":display_transform",
    ":line_framer",
    ":shortcut_registry",
    ":theme",
    "//base",
    "//components/domicile/mojom",
    "//mojo/public/cpp/bindings",
    "//net",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [
    "browser/command_protocol_unittest.cc",
    "browser/display_list_unittest.cc",
    "browser/frame_sink_broker_unittest.cc",
    "browser/line_framer_unittest.cc",
    "browser/pointer_warp_unittest.cc",
    "browser/shell_source_unittest.cc",
    "browser/shell_url_loader_factory_unittest.cc",
    "browser/shell_windows_unittest.cc",
    "browser/shortcut_registry_unittest.cc",
    "common/cursor_shape_unittest.cc",
    "common/display_transform_unittest.cc",
    "common/theme_unittest.cc",
    "spike/window_diff_unittest.cc",
  ]

  # The keymap's own tests need an XkbKeyboardLayoutEngine to assert against,
  # and that class -- and the xkbcommon headers its own header reaches for
  # through scoped_xkb.h -- are in //ui/events/ozone/layout only when
  # xkbcommon is. The function under test takes the abstract
  # KeyboardLayoutEngine and needs neither, which is why only the test is
  # conditional. The config is the one //ui/events/ozone/layout:unittests adds
  # for the same include, by the same name.
  if (use_xkbcommon) {
    sources += [ "browser/keyboard_layout_unittest.cc" ]
    configs += [ "//ui/events/ozone/layout:xkbcommon" ]
  }

  deps = [
    ":browser",
    ":command_protocol",
    ":cursor_shape",
    ":display_transform",
    ":keyboard_layout",
    ":line_framer",
    ":pointer_warp",
    ":shell_scheme",
    ":shell_source",
    ":shell_windows",
    ":shortcut_registry",
    ":theme",
    "//components/domicile/mojom",
    "//components/domicile/engine:event_queue_unit_tests",
    "//base",
    "//base/test:test_support",
    "//components/domicile/spike:window_diff",
    "//components/viz/service",
    "//components/viz/test:test_support",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/display",
    # The keymap test's four: the engine it asserts against, the DomCode and
    # DomKey it decodes to, the KeyboardCode beside them, and the xkbcommon
    # declarations `xkb_keyboard_layout_engine.h` includes through
    # `scoped_xkb.h`. //ui/events/ozone/layout:unittests names the same set.
    "//ui/events",
    "//ui/events:dom_keycode_converter",
    "//ui/events:event_constants",
    "//ui/events/keycodes:xkb",
    "//ui/events/ozone/layout",
    "//ui/gfx/geometry",
  ]
}

# The fork's tests without the rest of components_unittests, which CI no
# longer builds: that suite was most of an hour of every cold build.
test("domicile_unittests") {
  deps = [
    ":unit_tests",
    "//mojo/core/test:run_all_unittests",
  ]
}

# THROWAWAY. The spike's producer and its two measurements.
#
# Both are executables nothing depends on, and GN only loads a BUILD.gn that
# something references. This group is what makes them reachable, so that
# carrying the tools costs no edit to a file Chromium owns.
group("spike") {
  deps = [
    "//components/domicile/spike:css_parity",
    "//components/domicile/spike:solid_color_submitter",
  ]
}

# Phase 1's library, reachable the same way and for the same reason: GN only
# loads a BUILD.gn something references.
group("engine") {
  deps = [
    "//components/domicile/engine:domicile_engine",
    "//components/domicile/engine:engine_color_probe",
    "//components/domicile/engine:engine_dmabuf_smoke",
    "//components/domicile/engine:engine_smoke",
  ]
}
