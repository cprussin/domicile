module domicile.mojom;

import "third_party/blink/public/mojom/tokens/tokens.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";
import "url/mojom/url.mojom";

// A <webview> requests a guest from the browser.
//
// The element must ask because <webview> reports
// FrameOwnerElementType::kIframe, so the browser cannot otherwise tell it from
// an <iframe>. A guest's main frame has no ancestor for X-Frame-Options or
// frame-ancestors, keeps its own history, and gets first-party storage. See
// components/domicile/browser/web_view_guest.h.
//
// Bound only for shell-origin documents, as ControlChannel is.

// The guest's security level from security_state::GetSecurityLevel, as
// Chrome's omnibox lock uses.
//
// A separate enum so a new Chromium level fails to compile in the mapping
// switch in web_view_guest.cc.
enum WebViewSecurity {
  // No claim either way: about:blank, a file, an error page, or a non-network
  // scheme.
  kNeutral,
  // HTTPS with a valid certificate and nothing on the page that weakens it.
  kSecure,
  // The browser would show a "Not secure" warning: plain HTTP, or an HTTPS
  // page it considers insecure.
  kWarning,
  // A serious problem: a certificate that failed to validate, active mixed
  // content, an HTTPS connection that failed.
  kDangerous,
};

// Whether the guest's page has a renderer, and if not, why it went away.
// Named after Electron's `render-process-gone` reasons.
//
// A separate enum from base::TerminationStatus so a new Chromium status fails
// to compile in RenderProcessOf (components/domicile/browser/render_process.h).
enum WebViewRenderProcess {
  kRunning,
  // It exited with status 0.
  kCleanExit,
  // It exited with a nonzero status.
  kAbnormalExit,
  // A signal such as SIGKILL or SIGTERM ended it.
  kKilled,
  // A signal such as SIGSEGV or SIGABRT ended it.
  kCrashed,
  // It ran out of memory.
  kOom,
  // It never started.
  kLaunchFailed,
  // The browser ended it to free memory.
  kMemoryEviction,
};

// What a page in a <webview> needs picked.
//
// Blink's five modes reduced to four: folder upload and folder open look the
// same to the user.
enum WebViewFileChooserMode {
  // One existing file.
  kOpen,
  // One or more existing files.
  kOpenMultiple,
  // One existing directory.
  kOpenFolder,
  // One path to write, which need not exist.
  kSave,
};

// The kind of element under a context menu's click.
enum WebViewMediaType {
  kNone,
  kImage,
  kVideo,
  kAudio,
  kCanvas,
  kFile,
  kPlugin,
};

// A right click the page did not cancel: what was under it, and what the page
// reports can be done there. The shell draws the menu from it.
struct WebViewContextMenu {
  // Identifies the menu to RunContextMenuAction. Increases for the guest's
  // life; a newer menu replaces an older one.
  int32 id;

  // Where the click was, in CSS pixels from the top left of the page's box.
  int32 x;
  int32 y;

  // The link under the click and its text, or an empty URL for none. Filtered
  // by content: a link the guest's process may not request is
  // about:blank#blocked, so opening it in a new window grants nothing.
  // "Copy link address" copies the unfiltered link, as Chrome does.
  url.mojom.Url link_url;
  string link_text;

  // The image, video or audio under the click, and what it is.
  url.mojom.Url src_url;
  WebViewMediaType media_type;
  // Whether an image has pixels to copy. A broken image has none.
  bool has_image_contents;

  // The selected text, empty for none.
  string selection_text;

  // Whether the click was in an editable element, and Blink's edit flags.
  bool is_editable;
  bool can_undo;
  bool can_redo;
  bool can_cut;
  bool can_copy;
  bool can_paste;
  bool can_delete;
  bool can_select_all;
};

// What a shell's context menu can ask the browser to do.
enum WebViewContextMenuAction {
  // Blink's edit commands, on the focused frame.
  kUndo,
  kRedo,
  kCut,
  kCopy,
  kPaste,
  kPasteAndMatchStyle,
  kDelete,
  kSelectAll,
  // Copy the link's address, or save the link. A save asks the shell where.
  kCopyLinkAddress,
  kSaveLinkAs,
  // Copy the image's pixels.
  kCopyImage,
  // Copy the image, video or audio address, or save the file.
  kCopyMediaAddress,
  kSaveMediaAs,
  // Open DevTools on the element under the click. See WebViewGuest.Inspect.
  kInspect,
};

// A permission a site asks for, and the shell shows in its site permissions.
//
// Chrome's permission types reduced to the ones a shell offers. A request for
// any other type is ignored, as before the shell could answer: the page sees
// no grant and nothing is stored.
enum WebViewPermission {
  // getUserMedia's video.
  kCamera,
  // getUserMedia's audio.
  kMicrophone,
  // The Geolocation API.
  kLocation,
  kNotifications,
  // Reading the clipboard.
  kClipboard,
  // Web MIDI with system exclusive messages.
  kMidi,
  // The Window Management API: the screens' details, and placing windows on
  // them.
  kWindowManagement,
  // The Local Font Access API: `queryLocalFonts()`.
  kLocalFonts,
  // The Idle Detection API.
  kIdleDetection,
  // Downloading several files without a click for each.
  kAutomaticDownloads,
};

// A site's stored choice for a permission.
enum WebViewPermissionSetting {
  // The site must ask; the shell is asked.
  kAsk,
  kAllow,
  kBlock,
};

// The shell's answer to a permission request.
enum WebViewPermissionAnswer {
  // Stored as allowed for the site.
  kAllow,
  // Stored as blocked for the site.
  kDeny,
  // The user closed the request without choosing. Nothing is stored, but
  // Chrome blocks a site for a while after several dismissals.
  kDismiss,
};

// One permission's setting for the page's site.
struct WebViewSitePermission {
  WebViewPermission permission;
  WebViewPermissionSetting setting;
};

// The kind of dialog a page in a <webview> opened with `alert()`, `confirm()`
// or `prompt()`, or with a `beforeunload` handler that asks to stay.
enum WebViewDialogType {
  // A message with one button. The answer is ignored.
  kAlert,
  // A message with OK and Cancel.
  kConfirm,
  // A message, a text field and OK and Cancel.
  kPrompt,
  // Whether to leave the page, which is closing, navigating or reloading.
  // There is no message. OK leaves; Cancel stays.
  kBeforeUnload,
};

// What a PromptRequested asks. Each is a question Chrome would ask with a
// dialog of its own, drawn on the shell's window. See
// //chrome/browser/domicile/domicile_prompts.h.
enum WebViewPromptKind {
  // Let the site view the file or folder named `subject`; `details` holds its
  // full path. Accept allows.
  kFileView,
  // Let the site edit (save changes to) the file or folder named `subject`;
  // `details` holds its full path. Accept allows.
  kFileEdit,
  // The site picked a folder that holds system files, which it may not open.
  // Accept picks another; dismiss gives up.
  kFileRestricted,
  // The site would save the file named `subject`, which Safe Browsing calls
  // dangerous; `details` holds its full path. Accept saves anyway; dismiss
  // does not.
  kFileDangerous,
  // The site asks for a certificate to sign in with. `details` are the
  // certificates, each "name\nissuer"; `choice` is the one picked. Dismiss
  // continues without one.
  kClientCertificate,
  // The Bluetooth device `subject` needs a PIN to pair; `text` is it.
  kBluetoothPin,
  // Pair with the Bluetooth device `subject`. `pin`, when not empty, must
  // match the one the device shows.
  kBluetoothConfirm,
  // The extension `subject` asks for more permissions, listed in `details`.
  kExtensionPermissions,
  // Add the extension `subject`, with the permissions in `details`.
  kExtensionInstall,
  // Turn the extension `subject` back on, with the permissions in `details`.
  kExtensionReEnable,
  // Reloading would send the page's form again. Accept resends; dismiss
  // keeps the page as it is.
  kResendForm,
  // The page stopped responding. Accept ends it (the page then shows as
  // crashed); dismiss waits for it. Withdrawn when it responds again.
  kUnresponsive,
};

// A question for the shell to ask over the page. `origin` is the site that
// asked, or an empty URL for none (an extension's own page).
struct WebViewPrompt {
  WebViewPromptKind kind;
  url.mojom.Url origin;
  string subject;
  array<string> details;
  string pin;
};

// Why the page in a <webview> failed to load. The engine draws no error or
// warning page for it: the page is left blank and the shell draws one.
// What a page's form control asks the shell to pick. The engine draws no
// picker of its own for these: the shell does.
enum WebViewPickerKind {
  // `<input type="color">`. The value is "#rrggbb".
  kColor,
  // `<input type="date">`, "time", "datetime-local", "month" and "week". The
  // value is the input's, in its HTML format: "2026-11-06", "13:45",
  // "2026-11-06T13:45", "2026-11" and "2026-W45".
  kDate,
  kTime,
  kDateTimeLocal,
  kMonth,
  kWeek,
  // A text input's `<datalist>`. The value is the typed text; the answer is
  // one of `options`' values.
  kList,
};

// One suggestion a picker offers: a `<datalist>` option, or a color one.
struct WebViewPickerOption {
  string value;
  // The option's label, or empty for none.
  string label;
};

// A picker for the shell to draw over the page.
struct WebViewPicker {
  WebViewPickerKind kind;
  // The control's value now, or empty.
  string value;
  // The control's `min`, `max` and `step` attributes as written, or empty.
  string min;
  string max;
  string step;
  array<WebViewPickerOption> options;
  // The control's box, which the picker hangs from. From the renderer, in
  // its frame's local root's DIPs; from the guest, in the element's CSS
  // pixels.
  gfx.mojom.Rect anchor;
};

// What an IdentityRequested shows: a step of a site's "Sign in with" (FedCM)
// request. Chrome draws each as a dialog of its own; the engine draws none.
// See //components/domicile/browser/identity_dialog.h.
enum WebViewIdentityStep {
  // Waiting for the providers' accounts after the page's sign-in button.
  // kDismiss cancels.
  kLoading,
  // The accounts to pick from. kChoose with an index into `accounts` signs in
  // with it. kSignInToProvider with an index into `providers` opens that
  // provider's sign-in page, for a provider the user is signed out of or for
  // another account. kDismiss cancels.
  kAccounts,
  // The user is signed out of `providers[0]`. kSignInToProvider (index 0)
  // opens its sign-in page. kDismiss cancels.
  kSignedOut,
  // Signing in with `accounts[0]`. Nothing to answer: withdrawn or replaced
  // when it ends.
  kVerifying,
  // The provider refused the sign-in. kMoreDetails opens its page about the
  // error, when there is one. kDismiss closes it.
  kError,
};

// What the site says signing in is for, which the title words. FedCM's
// `context`.
enum WebViewIdentityPurpose {
  kSignIn,
  kSignUp,
  kUse,
  kContinue,
};

// What signing up with an account shares with the site.
enum WebViewIdentityField {
  kName,
  kEmail,
  kUsername,
  kPhoneNumber,
  kPicture,
};

// An identity provider an IdentityRequested offers, such as google.com.
struct WebViewIdentityProvider {
  // Its site, as Chrome names it: "google.com".
  string name;
  // Its icon as a data: URL, or empty for none.
  string icon;
  // The signing-in site's privacy policy and terms of service, as the
  // provider lists them, or empty URLs.
  url.mojom.Url privacy_policy;
  url.mojom.Url terms_of_service;
  // The user is signed out of it, so it has no accounts to offer: offer to
  // sign in to it instead.
  bool signed_out;
  // It can sign in another account.
  bool add_account;
};

// An account an IdentityRequested offers.
struct WebViewIdentityAccount {
  // Its provider: an index into the request's `providers`.
  int32 provider;
  // The name the provider shows, and its email or other identifier.
  string name;
  string identifier;
  // Its picture as a data: URL, or empty for none.
  string picture;
  // The user signed in to the site with it before.
  bool returning;
  // What signing in with it shares with the site, to say so; empty when
  // there is nothing to say, as for a returning account.
  array<WebViewIdentityField> shared;
};

// A step of a site's "Sign in with" request, for the shell to show over the
// page.
struct WebViewIdentityRequest {
  WebViewIdentityStep step;
  // The page asked from its own sign-in button (FedCM's active mode): show
  // it over the page. Otherwise the site offers it unasked: leave the page
  // usable.
  bool button;
  // The site signing in, as Chrome names it: "medium.com". `frame_site` is
  // the frame asking when it is another site's, or empty.
  string site;
  string frame_site;
  WebViewIdentityPurpose purpose;
  array<WebViewIdentityProvider> providers;
  // kAccounts: those to pick from. kVerifying: the one signing in.
  array<WebViewIdentityAccount> accounts;
  // kVerifying: signing in without the user picking, to a site they signed
  // in to before (FedCM's auto re-authentication).
  bool automatic;
  // kError: the provider's error code, such as "access_denied", or empty;
  // and its page about the error, or an empty URL.
  string error;
  url.mojom.Url error_url;
};

// The shell's answer to an IdentityRequested. See WebViewIdentityStep.
enum WebViewIdentityAction {
  // Not answered: no listener, withdrawn or replaced.
  kNone,
  // The user closed it.
  kDismiss,
  kChoose,
  kSignInToProvider,
  kMoreDetails,
};

enum WebViewPageFailureKind {
  // The page could not be reached: no network, no such host, refused, timed
  // out, or blocked. `error` says which.
  kNetwork,
  // The server answered `http_status` with nothing to show.
  kHttp,
  // The site's certificate is not trusted, as Chrome's "Your connection is not
  // private" page says.
  kCertificate,
  // Chrome warned before loading it: Safe Browsing, a lookalike address, or a
  // site with no secure connection under HTTPS-First.
  kWarning,
};

// What a page in a <webview> failed with. See PageFailureChanged.
struct WebViewPageFailure {
  WebViewPageFailureKind kind;
  // The address that failed.
  url.mojom.Url url;
  // Chromium's name for the error, e.g. "ERR_NAME_NOT_RESOLVED".
  string error;
  // For kHttp, the status; otherwise 0.
  int32 http_status;
  // Whether WebViewGuest.ProceedPastWarning loads it anyway: a certificate
  // the user may override, or a warning.
  bool can_proceed;
};

// A device a page in a <webview> may be given, as the shell lists it.
struct WebViewDevice {
  // Names the device in the answer to DeviceRequested. Stays the device's own
  // while it is listed, and is never reused. See
  // components/domicile/browser/device_choices.h.
  int32 id;
  // The name Chrome's chooser shows, such as "Nano X".
  string name;
};

// A camera or microphone, as WebViewGuest.ListMediaDevices lists it.
struct WebViewMediaDevice {
  // The system's id for it, which SetMediaDevice takes.
  string id;
  // The name the system gives it, such as "USB Camera".
  string name;
};

// Each kind's devices, most preferred first. A page that names no device gets
// the first.
struct WebViewMediaDevices {
  array<WebViewMediaDevice> cameras;
  array<WebViewMediaDevice> microphones;
};

// Which list a media device is in.
enum WebViewMediaDeviceKind {
  kCamera,
  kMicrophone,
};

// Renderer -> browser, bound per document.
interface WebViewGuestHost {
  // Gives `placeholder_frame` a guest page.
  //
  // `placeholder_frame` is the child frame the <webview> created. It stays on
  // about:blank because attaching replaces it, and a beforeunload handler
  // would block that. The browser refuses a frame that is not a child of the
  // asking document.
  //
  // Returns nothing: attaching is asynchronous, and Navigate is safe before it
  // finishes.
  //
  // `client` is passed here, not set later, so no history change is missed
  // between creation and connection.
  //
  // `window` is the element's `window` attribute, a browser window id
  // (browser_windows.mojom). The browser attaches that window's page and
  // ignores `src` on connect; a later `src` navigates it. Null creates a page
  // owned by the element. An unknown window, or one another element shows, is
  // refused: the pipes close and the browser logs why.
  //
  // `extension_popup` is the element's `extensionpopup` attribute. The guest
  // is then an extension action popup, as in Chrome: popup view type, no tab
  // id, no window. Extensions that lay out differently in a popup (e.g.
  // Bitwarden) then work. See //chrome/browser/domicile/domicile_tab_helpers.h.
  // Ignored with `window`.
  //
  // `private_browsing` is the element's `private` attribute. The guest's page
  // is then in the profile's off-the-record profile: nothing it stores
  // outlives the browser, and it shares nothing with the user's pages.
  // Ignored with `window`, whose page already has its profile.
  //
  // `partition` is the element's `partition` attribute, empty for none. The
  // guest's page then has storage of its own: "persist:<name>" kept on disk,
  // any other name in memory. See
  // components/domicile/browser/web_view_partition.h. "persist:" with no name
  // is refused as an unknown `window` is. Ignored with `window`.
  CreateGuest(blink.mojom.LocalFrameToken placeholder_frame,
              pending_receiver<WebViewGuest> guest,
              pending_remote<WebViewGuestClient> client,
              string? window,
              bool extension_popup,
              bool private_browsing,
              string partition);
};

// Browser -> renderer: guest state only the browser has.
//
// Pushed rather than fetched, so reading it on the element never blocks on a
// browser round trip.
interface WebViewGuestClient {
  // Whether the guest's history can go back or forward.
  //
  // Sent only when the pair changes, because NavigationStateChanged also fires
  // for titles, favicons and audio. A fresh guest sends nothing until its first
  // commit gives it an entry to go back to.
  HistoryChanged(bool can_go_back, bool can_go_forward);

  // Whether the guest is loading, for an address bar spinner.
  //
  // Uses `should_show_loading_ui`, as Chrome's throbber does, so same-document
  // navigations do not count. Sent only when it changes. A fresh guest sends
  // nothing until its first load starts.
  LoadingChanged(bool is_loading);

  // How far the guest's page has loaded, from 0.1 when a load starts to 1 when
  // it finishes or stops, for an address bar progress bar.
  //
  // Content's own progress, as Chrome on Android draws it, throttled by
  // content. Sent only when it changes. A fresh guest sends nothing until its
  // first load starts.
  LoadProgressChanged(double progress);

  // The guest's current URL and security level, for an address bar.
  //
  // Both come from the same `GetVisibleEntry()`, so the lock always describes
  // the URL shown; mixing entries enables address bar spoofing. The URL is the
  // virtual URL, as browsers display (e.g. `view-source:`).
  //
  // Sent only when the pair changes. Two hooks drive it,
  // NavigationStateChanged and DidChangeVisibleSecurityState, so both compare
  // against the last pair sent. A fresh guest sends nothing.
  PageChanged(url.mojom.Url url, WebViewSecurity security);

  // A key with Ctrl, Alt or Meta that the page did not handle, for browser
  // shortcuts.
  //
  // Unhandled guest keys stop at the guest's WebContentsDelegate, so the shell
  // cannot see them otherwise. Comes from HandleKeyboardEvent, which runs only
  // if the page did not call preventDefault, so sites keep their own chords.
  //
  // Chords only, so ordinary typing, including passwords, is not copied into
  // the shell's document.
  //
  // `key` and `code` are KeyboardEvent values.
  UnhandledKeyDown(string key, string code, bool alt_key, bool ctrl_key,
                   bool shift_key, bool meta_key, bool repeat);

  // The page's zoom factor; 1 is 100%.
  //
  // From HostZoomMap, keyed by host as in Chrome, so it also changes when
  // another window on the site zooms or the page navigates. Sent only when it
  // changes; a fresh guest sends nothing.
  ZoomChanged(double factor);

  // The best icon the page declares: an SVG, else the largest of its icon and
  // touch icon links, else `/favicon.ico`. Empty when it has none, and sent
  // empty on each commit before the head is parsed.
  //
  // Exists because some sites show their icon only to signed-in users, which
  // the compositor's anonymous fetch cannot see. Sent only when it changes.
  FaviconChanged(url.mojom.Url icon);

  // The page's `<meta name="description">`, trimmed. Empty when it has none,
  // and sent empty on each commit.
  //
  // Read on DOMContentLoaded and on each title change, since a single-page app
  // changes both together. Sent only when it changes.
  DescriptionChanged(string description);

  // The address of the link under the pointer, for a status bubble like
  // Chrome's. Empty when the pointer leaves the link or the page, or the page
  // navigates. Sent only when it changes.
  TargetUrlChanged(url.mojom.Url url);

  // The user pressed Ctrl+wheel and the page did not consume the wheel.
  //
  // A request, not a zoom: unlike Chrome, the shell applies the step so
  // Ctrl+wheel and Ctrl+plus share one path and one indicator.
  ZoomRequested(bool zoom_in);

  // The page needs a file picked: an `<input type="file">` or a download.
  //
  // The shell draws the picker, because the shell owns all desktop UI.
  //
  // `accept` is lower-case extensions without the dot; the browser expands
  // MIME types like `image/*`. Empty accepts anything. `suggested_name` is set
  // only for saves. `home` is the absolute home directory, which the renderer
  // cannot learn otherwise. `folder` is the absolute folder to start in, or
  // empty for the home: a download starts in the download folder.
  //
  // `paths` are absolute or home-relative. See
  // components/domicile/browser/file_choice.h. Null cancels, as does an
  // unhandled event or a closed pipe.
  FileChooserRequested(WebViewFileChooserMode mode,
                       array<string> accept,
                       string suggested_name,
                       string home,
                       string folder)
      => (array<string>? paths);

  // The page called window.close() and its renderer allowed it, or an
  // extension's tabs.remove named it.
  //
  // Sent only for a shell-owned page (no `window`); the shell closes it by
  // removing the element. The browser closes browser windows itself; see
  // browser_windows.mojom.
  //
  // The renderer allows window.close() only for script-opened pages or ones
  // with a single history entry, per the HTML spec.
  //
  // Sent once per call.
  CloseRequested();

  // Find results: the match count and the selected match, from 1. Zero and
  // zero means no active find.
  //
  // From FindRequestManager, which counts across all frames, including
  // cross-process ones the renderer cannot see. Sent only when the pair
  // changes; a fresh guest sends nothing.
  FindChanged(int32 matches, int32 active_match);

  // An extension asked to bring this browser window to the front, via
  // `chrome.tabs.update(id, {active: true})` or `chrome.windows.update(id,
  // {focused: true})`. The shell decides window order, so the browser only
  // asks. See //chrome/browser/domicile/domicile_desk.h.
  FocusRequested();

  // The size an extension popup's page sized itself to, in CSS pixels: Blink's
  // auto-resize, between 25x25 and 800x600, as in Chrome's toolbar popup. While
  // the page loads it only grows. Past the maximum, the page scrolls.
  //
  // Sent only for an `extension_popup` guest, after its first layout and on
  // every change.
  ContentSizeChanged(int32 width, int32 height);

  // The user opened a context menu (right click or menu key) and the page did
  // not cancel `contextmenu`. The browser draws no menu, so the shell draws
  // one from this. Sent once per menu.
  ContextMenuRequested(WebViewContextMenu menu);

  // The page asked for `permissions` and the site has no stored choice, so
  // the shell must ask the user. `origin` is the asking site. Camera and
  // microphone may come together; anything else comes alone.
  //
  // One at a time: the next request waits for the answer or for
  // PermissionRequestWithdrawn. Null, an unhandled event or a closed pipe
  // ignores the request: the page gets no grant and nothing is stored.
  PermissionRequested(url.mojom.Url origin,
                      array<WebViewPermission> permissions)
      => (WebViewPermissionAnswer? answer);

  // The browser dropped the unanswered request, for example because the page
  // navigated. Its answer, if one is sent, is ignored.
  PermissionRequestWithdrawn();

  // The page asked for a device through WebHID, WebUSB or Web Serial, so the
  // shell must let the user pick one. `title` is Chrome's question, naming
  // the site and the kind of device. `multiple` allows picking several.
  //
  // The devices follow in DevicesOffered, once listed and again as they are
  // plugged in or removed. Chrome draws a chooser as a bubble on a browser
  // window, which a guest has none of.
  //
  // `chosen` are WebViewDevice ids. Null cancels, as does an unhandled event
  // or a closed pipe. One at a time: a newer request withdraws the older one
  // first.
  DeviceRequested(string title, bool multiple) => (array<int32>? chosen);

  // The devices the open DeviceRequested offers. Sent whenever they change.
  DevicesOffered(array<WebViewDevice> devices);

  // The browser dropped the unanswered DeviceRequested, for example because the
  // page navigated. Its answer, if one is sent, is ignored.
  DeviceRequestWithdrawn();

  // The page called `alert()`, `confirm()` or `prompt()`, or its
  // `beforeunload` handler asked to stay, so the shell must show a dialog. The
  // page is paused until the answer. `origin` is the calling frame's site.
  // `default_prompt` is `prompt()`'s initial text, and empty for the others.
  //
  // `accepted` is OK; false is Cancel, as are an unhandled event and a closed
  // pipe, except for kBeforeUnload, where those leave. `user_input` is the
  // prompt's text, and ignored unless `accepted`.
  // One at a time: a page that opens another while one is open gets the
  // second dismissed at once.
  DialogRequested(url.mojom.Url origin,
                  WebViewDialogType type,
                  string message,
                  string default_prompt)
      => (bool accepted, string user_input);

  // The browser dropped the open DialogRequested, for example because the page
  // navigated or closed. Its answer, if one is sent, is ignored.
  DialogWithdrawn();

  // The page opened a link for an application, such as zoommtg: or mailto:,
  // that Chrome would ask about, so the shell must ask whether to open it.
  // `origin` is the site that asked, or an empty URL for none. `may_remember` is
  // whether the site may be let open these links without asking again: only
  // a secure site may. See //chrome/browser/domicile/domicile_external_apps.h.
  //
  // `open` launches the default application for the link's scheme.
  // `remember` lets the site open them without asking from then on; it is
  // ignored unless `open`, and sending it without `may_remember` is a bad
  // message. An unhandled event or a closed pipe opens nothing.
  ExternalAppRequested(url.mojom.Url url,
                       url.mojom.Url origin,
                       bool may_remember)
      => (bool open, bool remember);

  // A site or a proxy asked for a user name and password (HTTP
  // authentication), so the shell must ask the user. `url` is the server or
  // proxy that asked, such as https://example.com. `realm` is its name for
  // what is behind the sign-in, as the server sent it, and may be empty.
  // `proxy` is whether a proxy asked rather than the site. `secure` is false
  // when the password would cross the network unencrypted. Chrome draws its
  // sign-in dialog on the outermost WebContents' window, which for a guest is
  // the shell's. See //chrome/browser/domicile/domicile_sign_in.h.
  //
  // `sign_in` sends `username` and `password`; false cancels, and the page
  // shows the server's refusal. An unhandled event or a closed pipe cancels.
  // A newer request replaces an older one, which is canceled.
  SignInRequested(url.mojom.Url url, string realm, bool proxy, bool secure)
      => (bool sign_in, string username, string password);

  // The browser dropped the unanswered SignInRequested, for example because
  // the page navigated or another request for the same realm was answered.
  // Its answer, if one is sent, is ignored.
  SignInWithdrawn();

  // The page, or an extension in this element, needs the user to answer
  // `prompt`, which Chrome would ask with a dialog of its own drawn on the
  // shell's window. See WebViewPromptKind for what each answer means.
  //
  // `accepted` is yes; `choice` and `text` are read only for the kinds that
  // say so. An unhandled event or a closed pipe is no. A newer prompt
  // replaces an older, unanswered one, which is answered no.
  PromptRequested(WebViewPrompt prompt)
      => (bool accepted, int32 choice, string text);

  // The browser dropped the unanswered PromptRequested, for example because
  // the page navigated. Its answer, if one is sent, is ignored.
  PromptWithdrawn();

  // A control in the page asks for `picker`. The shell draws it over the page
  // and answers with the picked value, or no to keep the old one. An
  // unhandled event or a closed pipe is no. A newer picker replaces an older,
  // unanswered one, which is answered no.
  PickerRequested(WebViewPicker picker) => (bool picked, string value);

  // The page closed the unanswered picker, for example because the control
  // went away. Its answer, if one is sent, is ignored.
  PickerWithdrawn();

  // A site in the page asked to sign in with an identity provider (FedCM's
  // `navigator.credentials.get({identity})`), so the shell must show
  // `request`, a step of it. See WebViewIdentityStep for what each answer
  // means; `index` is read only for the actions that say so.
  //
  // An unhandled event or a closed pipe is kNone. A newer step replaces an
  // older, unanswered one, which is answered kNone. The engine draws no
  // dialog of its own. See //components/domicile/browser/identity_dialog.h.
  IdentityRequested(WebViewIdentityRequest request)
      => (WebViewIdentityAction action, int32 index);

  // The browser dropped the unanswered IdentityRequested, because the
  // request ended or the page navigated. Its answer, if one is sent, is
  // ignored.
  IdentityWithdrawn();

  // The page entered or left fullscreen, as a video's fullscreen button does.
  // The page fills the element's box; the shell decides whether the element
  // fills the screen. Sent only when it changes; a fresh guest sends nothing.
  PageFullscreenChanged(bool fullscreen);

  // The page turned on its first screen wake lock (`navigator.wakeLock`, a
  // playing video) or turned off its last. Sent only when it changes; a fresh
  // guest sends nothing.
  WakeLockChanged(bool held);

  // The page's site's permission settings, one per WebViewPermission. Empty
  // for a page that is not http, https or an extension's, which has none.
  //
  // Sent when the page's site or a setting changes. A fresh guest sends
  // nothing until its first commit.
  SitePermissionsChanged(array<WebViewSitePermission> permissions);

  // The page's renderer went away, or a new one replaced it, as after a
  // reload. `exit_code` is Chromium's code for the process: its wait status,
  // or the browser's own code when the browser ended it. 0 while running.
  //
  // From WebContents' crashed status. Sent only when it changes; a fresh guest
  // sends nothing.
  RenderProcessChanged(WebViewRenderProcess state, int32 exit_code);

  // The page failed to load, or a page loaded after one did (null). The page
  // under it is blank; the shell draws the error. Sent only when it changes;
  // a fresh guest sends nothing.
  PageFailureChanged(WebViewPageFailure? failure);

  // The tooltip under the pointer is now `text`, or none when empty, with the
  // pointer at (`x`, `y`) in the page's DIPs from the element's top left,
  // which are the element's CSS pixels. The engine draws no tooltip for the
  // page: the shell does. Sent only when it changes; empty while the pointer
  // is outside the page. A new one is sent once the pointer has rested on it
  // for Chrome's delay, with the pointer then.
  TooltipChanged(string text, int32 x, int32 y);

  // The page is about to navigate its main frame to `url`: a link, a form or
  // a script setting `location`. Not sent for the shell's own navigations,
  // history steps or reloads. See components/domicile/browser/will_navigate.h.
  //
  // The navigation waits for the answer. `proceed` false cancels it and the
  // page stays. An unhandled event or a closed pipe proceeds.
  WillNavigate(url.mojom.Url url) => (bool proceed);
};

// One guest, for the life of the element that requested it.
//
// A separate pipe because attaching destroys the placeholder frame, so its
// token no longer identifies the guest.
interface WebViewGuest {
  // Navigates the guest's page to `url`, as `src` does. domicile:// URLs are
  // refused and show about:blank#blocked; see
  // components/domicile/browser/web_view_url.h.
  Navigate(url.mojom.Url url);

  // Address bar controls on the guest's NavigationController.
  //
  // They go over this pipe because the guest's history lives in the browser
  // process. The element's own placeholder frame has a separate, unused
  // history.
  //
  // Return nothing; navigation is asynchronous. Going back or forward with no
  // entry is a no-op, not an error. Read `canGoBack` on the element to gray out
  // buttons.
  GoBack();
  GoForward();

  // Go back or forward in a new browser window, as a middle click on Chrome's
  // back button does: the window gets a copy of the guest's history and takes
  // the step there, and the guest stays on its page. A private guest's window
  // is private. With no entry to go to, nothing opens.
  GoBackInNewWindow();
  GoForwardInNewWindow();

  // Stops loading, via `WebContents::Stop`; NavigationController has no Stop.
  Stop();

  // Reloads the current entry. A POST entry's repost warning has no dialog
  // yet; see ROADMAP.md.
  Reload();

  // Sets the zoom factor; 1 is 100%. Applied through HostZoomMap, so it zooms
  // the whole site, as in Chrome. Reported back as
  // WebViewGuestClient.ZoomChanged.
  //
  // Must be within blink::kMinimumBrowserZoomFactor and
  // kMaximumBrowserZoomFactor. The element throws a RangeError first, so an
  // out-of-range value here is a bad message.
  SetZoom(double factor);

  // Finds `text` and selects the next match, or the previous one when
  // `forward` is false. Reported as WebViewGuestClient.FindChanged.
  //
  // Repeating the same text finds the next match; new text starts a new
  // search, as in Chrome. The browser tracks this because navigation ends a
  // find session.
  //
  // Never empty: the element sends StopFinding instead, so an empty string is
  // a bad message.
  Find(string text, bool forward);

  // Ends the find and clears highlights. `keep_selection` keeps the selected
  // match (Escape); false clears it (text cleared). Reported as
  // FindChanged(0, 0).
  StopFinding(bool keep_selection);

  // The element gained focus, by `view.focus()` or a click.
  //
  // Makes this guest the active tab for chrome.tabs. The browser gets no
  // notification when an inner WebContents gains focus. See
  // HTMLWebViewElement::SetFocused.
  Focused();

  // Runs `action` for context menu `menu`.
  // - An id older than the newest menu is a race and is dropped.
  // - An unknown id, or an action the menu does not offer (e.g. a link action
  //   with no link), is a bad message. The element rejects both first.
  RunContextMenuAction(int32 menu, WebViewContextMenuAction action);

  // Opens DevTools for the page in a new browser window. If DevTools is
  // already open, its window's element gets FocusRequested instead. See
  // //chrome/browser/domicile/domicile_devtools.h.
  Inspect();

  // Prints the page, or the focused frame's selection, through the desktop's
  // print dialog. See //chrome/browser/domicile/domicile_printing.h.
  Print();

  // The shell's document saw the pointer move off the element, so the link
  // and tooltip under it are cleared until the pointer is back over the page.
  // See WebViewGuestClient.TargetUrlChanged and TooltipChanged.
  PointerLeft();

  // Takes the page out of fullscreen, as Escape does. Reported back as
  // WebViewGuestClient.PageFullscreenChanged. Does nothing when the page is
  // not fullscreen.
  ExitPageFullscreen();

  // Loads the page a warning (WebViewPageFailure.can_proceed) stopped, as
  // Chrome's "Proceed anyway" does. Does nothing when no warning can be
  // passed.
  ProceedPastWarning();

  // Stores `setting` for `permission` on the page's site. Reported back as
  // WebViewGuestClient.SitePermissionsChanged. Dropped, and logged, when the
  // page has no site, which happens when it navigates as the shell sends.
  SetSitePermission(WebViewPermission permission,
                    WebViewPermissionSetting setting);

  // The cameras and microphones, ranked by the profile's preference. The
  // preference is the profile's, not the site's, so every guest lists the
  // same order.
  ListMediaDevices() => (WebViewMediaDevices devices);

  // Ranks device `id` first among `kind`'s, so a page that names no device
  // gets it, as Chrome's camera and microphone settings do. Answers why not
  // when no connected device of that kind has the id.
  SetMediaDevice(WebViewMediaDeviceKind kind, string id) => (string? refusal);

  // How many elements in the page's main document match the CSS `selector`,
  // read in Chrome's internal isolated world, so the page's own script cannot
  // change the answer. Works while the page is hidden. Null when the page
  // gave no number: it navigated before the read ran, or the selector is not
  // valid there. The element rejects a selector it cannot parse first.
  CountMatches(string selector) => (int32? count);
};

// A page's channel to its <webview>'s shell for the pickers Chrome draws for
// form controls. Bound for each picker by a frame in a guest; see
// PopulateChromeFrameBinders. Closing the pipe withdraws the picker.
interface PagePicker {
  // Asks once. `picked` with the new value, or not to keep the old one.
  Pick(WebViewPicker picker) => (bool picked, string value);
};
