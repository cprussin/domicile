module domicile.mojom;

import "third_party/blink/public/mojom/tokens/tokens.mojom";
import "url/mojom/url.mojom";

// A <webview> asking the browser for a guest to put behind it.
//
// WHY THE ELEMENT HAS TO ASK. Patch 0007 makes <webview> report
// FrameOwnerElementType::kIframe on purpose, so that the fork stays out of
// every switch on that enum -- which leaves the browser process unable to tell
// a <webview> from an <iframe> by looking. Nothing in the frame tree carries
// the signal, so the element carries it, over this. Keying on an explicit
// request is also what extensions' <webview> does.
//
// WHAT A GUEST BUYS, and why it is not a carve-out in AncestorThrottle: a
// guest's main frame IS a main frame, so it has no ancestor for
// X-Frame-Options or CSP frame-ancestors to be checked against, history is the
// guest's own across processes, and its storage is first-party rather than
// partitioned as a third party. See components/domicile/browser/
// web_view_guest.h.
//
// THE ACCESS CONTROL IS THE BINDER'S, not this file's, and it is the same one
// ControlChannel has: the browser binds WebViewGuestHost only for a document
// whose origin is the shell's. domicile:// is neither web-safe nor
// CORS-enabled, so no ordinary web content can hold that origin. A shell that
// asks for a guest can already ask for `Spawn`, so there is nothing here to
// protect it from itself.

// What the browser is prepared to say about the connection behind the page a
// <webview> is showing.
//
// THE BROWSER'S OWN ANSWER, NARROWED -- not a scheme, and not a second opinion.
// This is `security_state::GetSecurityLevel` over the guest's visible entry,
// which is the same function and the same entry Chrome's own omnibox draws its
// lock from: the certificate the network stack validated, the mixed content
// the page ran, the cert errors it displayed. A chrome that derived a lock
// from `https://` instead would be claiming, on every page, a thing nobody
// checked.
//
// AN ENUM OF OUR OWN RATHER THAN security_state::SecurityLevel ON THE WIRE.
// That enum carries deprecated members and numbering nobody here should depend
// on, and the mapping between it and this is one explicit switch in
// web_view_guest.cc with no default arm -- so a level Chromium adds is a
// compile error in the fork rather than a page that silently reads as neutral.
enum WebViewSecurity {
  // Neither secure nor insecure, and the browser is not making a claim:
  // about:blank, a file, an error page, a scheme that is not a connection.
  kNeutral,
  // HTTPS with a certificate that validated, and nothing on the page that
  // undoes it.
  kSecure,
  // The browser would show a "Not secure" warning: plain HTTP, or an HTTPS
  // page it considers insecure.
  kWarning,
  // A serious problem: a certificate that failed to validate, active mixed
  // content, an HTTPS connection that failed.
  kDangerous,
};

// Renderer -> browser, bound per document.
interface WebViewGuestHost {
  // Give `placeholder_frame` a guest page.
  //
  // `placeholder_frame` is the child frame the <webview>'s frame owner already
  // created -- the one an <iframe> would navigate. It is what
  // WebContents::AttachInnerWebContents wants, and it is left on about:blank
  // because attaching swaps it out and a frame with a beforeunload handler in
  // it would have to be asked first.
  //
  // The browser refuses a token that is not a child of the asking document's
  // own frame: the element may claim a guest for its own placeholder and for
  // nothing else.
  //
  // Nothing comes back. Attaching is asynchronous -- the frame has to be
  // prepared first -- and the element has nothing to do differently either
  // way; what it does next is Navigate, which is safe before the attach
  // finishes and is why this is not a callback.
  //
  // BOTH ENDS OF THE GUEST ARE NAMED HERE, which is why `client` is a
  // parameter of this call rather than a SetClient on WebViewGuest. The guest
  // is created by this message, so a client handed over in a later one would
  // leave a window in which the guest's history could change with nothing to
  // report it to -- and the element would have to either replay that change or
  // lose it. It also costs a second round trip for a pipe the element always
  // wants.
  CreateGuest(blink.mojom.LocalFrameToken placeholder_frame,
              pending_receiver<WebViewGuest> guest,
              pending_remote<WebViewGuestClient> client);
};

// The leg back: what the browser tells a <webview> about the guest behind it.
//
// THE ANSWERS ONLY THE BROWSER HAS. A guest's history is a
// NavigationController in the browser process, so `CanGoBack()` and
// `CanGoForward()` cannot be read from the renderer at all -- and an address
// bar that cannot read them cannot gray out a button that would do nothing.
// This is how they arrive.
//
// PUSHED RATHER THAN ASKED FOR, and that is the decision the shape of this
// interface records. A [Sync] getter would put a blocking browser round trip
// inside a property read, in a renderer, on whatever path a chrome renders
// from. So the browser sends the answer when it changes and the element holds
// it, which makes the read free and always available.
interface WebViewGuestClient {
  // What the guest's history can do now.
  //
  // SENT ONLY WHEN THE PAIR CHANGES. The browser notices this in
  // WebContentsDelegate::NavigationStateChanged, which fires for a title, a
  // favicon and an audio state as well, so an unfiltered forward would be a
  // message per page load event and an event per message in the page.
  //
  // A FRESH GUEST SENDS NOTHING, because it has nowhere to go in either
  // direction and neither has the element that has not heard from it. The
  // first message is the first commit that gives the guest an entry to go back
  // to -- see components/domicile/browser/web_view_guest.cc.
  HistoryChanged(bool can_go_back, bool can_go_forward);

  // Whether the guest is fetching a page, so an address bar can say so.
  //
  // THE SAME ANSWER CHROME'S OWN THROBBER IS DRIVEN BY.
  // WebContentsDelegate::LoadingStateChanged carries `should_show_loading_ui`,
  // which is false for a same-document navigation -- a fragment, a pushState
  // -- because neither is a load a browser's UI spins for. So this is not
  // "the WebContents is busy"; it is "a browser would be showing a spinner",
  // which is exactly the question an address bar is asking.
  //
  // SENT ONLY WHEN IT CHANGES, like HistoryChanged above and for the same
  // reason: the delegate call it comes from also fires for same-document
  // navigations, which resolve to the answer already held, and an unfiltered
  // forward would put a DOM event in the shell's page for each of them.
  //
  // A FRESH GUEST SENDS NOTHING. It is not loading, and neither is an element
  // that has not heard from it -- so a guest's first message is its first
  // load beginning.
  LoadingChanged(bool is_loading);

  // The page in the guest asked for a window of its own: a link with
  // target="_blank" followed, a window.open, a form submitted at a target name
  // that names no existing context.
  //
  // THE WINDOW IS NOT MADE, AND CANNOT BE HERE. A guest has no SiteInstance of
  // its own -- see components/domicile/browser/web_view_guest.h for why that is
  // a decision and not an omission -- and content CHECKs a guest's SiteInstance
  // against its WebContents in WebContentsImpl::CreateNewWindow. So the browser
  // refuses the window content would have made and sends this instead, and what
  // opens a window is the shell: a second <webview>, in a second browser window
  // it drew, pointed at this address. That is also the layering the rest of
  // this desktop has -- where a window goes is the shell's answer, and a
  // browser process that placed one would be placing it on a desktop it cannot
  // see.
  //
  // WHAT IS LOST BY REFUSING AND REPORTING, which is worth stating where the
  // decision is: the shell's window is a NAVIGATION to this address rather than
  // the window the page asked for, so the opener relationship, the handle
  // window.open returns, the target's name and a POST body do not survive. A
  // link is the case that survives whole, and a link is what this was written
  // for. Carrying the rest means handing the shell a window the browser made,
  // which is the CHECK above and a guest SiteInstance in a StoragePartition of
  // its own -- a browser window where the user is logged out of everything.
  //
  // ONE MESSAGE PER ASK, unlike the two above: this is an event rather than a
  // state, so there is nothing to compare against what was last sent. Two
  // links opened in a row are two windows.
  //
  // THE ADDRESS IS ALWAYS ONE, and that is what the browser side filters: a
  // window.open() with no address at all asks for a handle to write a document
  // into, which is exactly the part refusing does not carry, so it is refused
  // and not reported. See WebViewGuest::CreateCustomWebContents.
  NewWindowRequested(url.mojom.Url target_url);

  // WHERE THE PAGE ACTUALLY IS, AND WHAT THE BROWSER SAYS ABOUT GETTING THERE.
  //
  // THIS IS THE MESSAGE THAT MAKES A BROWSER WINDOW A BROWSER. Before it, a
  // shell knew only where it had *sent* a window: `src` is the author's
  // attribute, so a link followed, a redirect taken or a form posted left the
  // chrome showing an address the page had left, and any lock drawn beside it
  // was a claim about a different page. An address bar that cannot follow its
  // own page cannot be trusted with a padlock, which is why the address and
  // the security travel together in one message rather than in two.
  //
  // BOTH HALVES COME FROM THE ONE ENTRY -- `GetVisibleEntry()` on the guest's
  // own NavigationController. That is not a convenience, it is the property
  // that makes the pair meaningful: a URL taken from one entry beside a level
  // computed from another is a lock drawn next to an address it does not
  // describe, which is the shape of every address-bar spoof. `GetVisibleEntry`
  // is also what decides when a pending navigation may be shown at all --
  // content only lets a browser-initiated one be visible before it commits,
  // which is the rule that keeps a page from writing another site's address
  // into the bar.
  //
  // THE VIRTUAL URL, which is the one a browser shows: `view-source:` and the
  // other rewrites are the entry's virtual URL and not its real one, and a
  // chrome showing the real one would disagree with every other browser.
  //
  // SENT ONLY WHEN THE PAIR CHANGES, like HistoryChanged and LoadingChanged
  // above. It is driven from two hooks -- NavigationStateChanged for the
  // address and DidChangeVisibleSecurityState for the level -- and either can
  // fire for something the other reported, so both go through one comparison
  // against the last pair sent.
  //
  // A FRESH GUEST SENDS NOTHING. It is showing the initial entry, which
  // GetVisibleSecurityState declines to describe, and an element that has
  // heard nothing holds exactly that: no address, and a security nobody has
  // stated.
  PageChanged(url.mojom.Url url, WebViewSecurity security);
};

// One guest, for as long as the element that asked for it lives.
//
// A pipe of its own rather than more methods on WebViewGuestHost taking a
// frame token: attaching DESTROYS the placeholder frame, so the token that
// named the guest stops naming anything the moment the guest exists, and a
// second src would have nothing to send.
interface WebViewGuest {
  // Load `url` in the guest, as a top-level navigation of the guest's own
  // page. This is what `src` does, and what it does instead of navigating the
  // frame the element owns.
  Navigate(url.mojom.Url url);

  // The four controls a chrome's address bar has, on the guest's own
  // NavigationController.
  //
  // THEY HAVE TO COME OVER THIS PIPE, and that is the whole reason they are
  // here rather than in the renderer. The element is a frame owner, so it has
  // a placeholder frame with a History of its own -- and that frame has been
  // on about:blank since it was made and was swapped out by the attach. The
  // page the user is looking at is a WebContents in the browser process, whose
  // history is a NavigationController this process cannot see. So the four
  // travel, and what they buy by traveling is the half that gets BETTER: a
  // guest has a history of its own, across process changes, where a frame
  // shared the whole session's.
  //
  // Nothing comes back from any of them, for the reason Navigate returns
  // nothing: what happens next is a navigation, which is asynchronous however
  // it was asked for, and there is nothing the element would do differently
  // with an answer.
  //
  // A BACK WITH NOWHERE TO GO IS NOT AN ERROR, in any of the three that can
  // have one: `NavigationControllerImpl::GoBack` returns without navigating
  // when `CanGoBack()` is false, and an address bar pressing a button the user
  // can see is the ordinary way that happens. WHETHER it can is now reportable:
  // WebViewGuestClient above carries it, and a chrome that grays out a dead
  // button reads `canGoBack` on the element rather than pressing to find out.
  GoBack();
  GoForward();

  // Cancel whatever the guest is loading. `WebContents::Stop`, which is where
  // a pending navigation lives -- the controller has no Stop of its own.
  Stop();

  // Load the current entry again. The repost warning a POST entry would raise
  // has no dialog behind it yet: a guest refuses everything an embedder is
  // asked for, which ROADMAP.md carries as its own gap.
  Reload();
};
