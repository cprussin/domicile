module domicile.mojom;

import "third_party/blink/public/mojom/tokens/tokens.mojom";
import "url/mojom/url.mojom";

// A <webview> requests a guest from the browser.
//
// The element must ask because <webview> reports
// FrameOwnerElementType::kIframe, so the browser cannot otherwise tell it from
// an <iframe>. A guest's main frame has no ancestor for X-Frame-Options or
// frame-ancestors, keeps its own history, and gets first-party storage. See
// components/domicile/browser/web_view_guest.h.
//
// Bound only for shell-origin documents, as ControlChannel is.

// The guest's security level from security_state::GetSecurityLevel, as
// Chrome's omnibox lock uses.
//
// A separate enum so a new Chromium level fails to compile in the mapping
// switch in web_view_guest.cc.
enum WebViewSecurity {
  // No claim either way: about:blank, a file, an error page, or a non-network
  // scheme.
  kNeutral,
  // HTTPS with a valid certificate and nothing on the page that weakens it.
  kSecure,
  // The browser would show a "Not secure" warning: plain HTTP, or an HTTPS
  // page it considers insecure.
  kWarning,
  // A serious problem: a certificate that failed to validate, active mixed
  // content, an HTTPS connection that failed.
  kDangerous,
};

// What a page in a <webview> needs picked.
//
// Blink's five modes reduced to four: folder upload and folder open look the
// same to the user.
enum WebViewFileChooserMode {
  // One existing file.
  kOpen,
  // One or more existing files.
  kOpenMultiple,
  // One existing directory.
  kOpenFolder,
  // One path to write, which need not exist.
  kSave,
};

// The kind of element under a context menu's click.
enum WebViewMediaType {
  kNone,
  kImage,
  kVideo,
  kAudio,
  kCanvas,
  kFile,
  kPlugin,
};

// A right click the page did not cancel: what was under it, and what the page
// reports can be done there. The shell draws the menu from it.
struct WebViewContextMenu {
  // Identifies the menu to RunContextMenuAction. Increases for the guest's
  // life; a newer menu replaces an older one.
  int32 id;

  // Where the click was, in CSS pixels from the top left of the page's box.
  int32 x;
  int32 y;

  // The link under the click and its text, or an empty URL for none. Filtered
  // by content: a link the guest's process may not request is
  // about:blank#blocked, so opening it in a new window grants nothing.
  // "Copy link address" copies the unfiltered link, as Chrome does.
  url.mojom.Url link_url;
  string link_text;

  // The image, video or audio under the click, and what it is.
  url.mojom.Url src_url;
  WebViewMediaType media_type;
  // Whether an image has pixels to copy. A broken image has none.
  bool has_image_contents;

  // The selected text, empty for none.
  string selection_text;

  // Whether the click was in an editable element, and Blink's edit flags.
  bool is_editable;
  bool can_undo;
  bool can_redo;
  bool can_cut;
  bool can_copy;
  bool can_paste;
  bool can_delete;
  bool can_select_all;
};

// What a shell's context menu can ask the browser to do.
enum WebViewContextMenuAction {
  // Blink's edit commands, on the focused frame.
  kUndo,
  kRedo,
  kCut,
  kCopy,
  kPaste,
  kPasteAndMatchStyle,
  kDelete,
  kSelectAll,
  // Copy the link's address, or save the link. A save asks the shell where.
  kCopyLinkAddress,
  kSaveLinkAs,
  // Copy the image's pixels.
  kCopyImage,
  // Copy the image, video or audio address, or save the file.
  kCopyMediaAddress,
  kSaveMediaAs,
  // Open DevTools on the element under the click. See WebViewGuest.Inspect.
  kInspect,
};

// A permission a site asks for, and the shell shows in its site permissions.
//
// Chrome's permission types reduced to the ones a shell offers. A request for
// any other type is ignored, as before the shell could answer: the page sees
// no grant and nothing is stored.
enum WebViewPermission {
  // getUserMedia's video.
  kCamera,
  // getUserMedia's audio.
  kMicrophone,
  // The Geolocation API.
  kLocation,
  kNotifications,
  // Reading the clipboard.
  kClipboard,
  // Web MIDI with system exclusive messages.
  kMidi,
};

// A site's stored choice for a permission.
enum WebViewPermissionSetting {
  // The site must ask; the shell is asked.
  kAsk,
  kAllow,
  kBlock,
};

// The shell's answer to a permission request.
enum WebViewPermissionAnswer {
  // Stored as allowed for the site.
  kAllow,
  // Stored as blocked for the site.
  kDeny,
  // The user closed the request without choosing. Nothing is stored, but
  // Chrome blocks a site for a while after several dismissals.
  kDismiss,
};

// One permission's setting for the page's site.
struct WebViewSitePermission {
  WebViewPermission permission;
  WebViewPermissionSetting setting;
};

// Renderer -> browser, bound per document.
interface WebViewGuestHost {
  // Gives `placeholder_frame` a guest page.
  //
  // `placeholder_frame` is the child frame the <webview> created. It stays on
  // about:blank because attaching replaces it, and a beforeunload handler
  // would block that. The browser refuses a frame that is not a child of the
  // asking document.
  //
  // Returns nothing: attaching is asynchronous, and Navigate is safe before it
  // finishes.
  //
  // `client` is passed here, not set later, so no history change is missed
  // between creation and connection.
  //
  // `window` is the element's `window` attribute, a browser window id
  // (browser_windows.mojom). The browser attaches that window's page and
  // ignores `src` on connect; a later `src` navigates it. Null creates a page
  // owned by the element. An unknown window, or one another element shows, is
  // refused: the pipes close and the browser logs why.
  //
  // `extension_popup` is the element's `extensionpopup` attribute. The guest
  // is then an extension action popup, as in Chrome: popup view type, no tab
  // id, no window. Extensions that lay out differently in a popup (e.g.
  // Bitwarden) then work. See //chrome/browser/domicile/domicile_tab_helpers.h.
  // Ignored with `window`.
  //
  // `private_browsing` is the element's `private` attribute. The guest's page
  // is then in the profile's off-the-record profile: nothing it stores
  // outlives the browser, and it shares nothing with the user's pages.
  // Ignored with `window`, whose page already has its profile.
  CreateGuest(blink.mojom.LocalFrameToken placeholder_frame,
              pending_receiver<WebViewGuest> guest,
              pending_remote<WebViewGuestClient> client,
              string? window,
              bool extension_popup,
              bool private_browsing);
};

// Browser -> renderer: guest state only the browser has.
//
// Pushed rather than fetched, so reading it on the element never blocks on a
// browser round trip.
interface WebViewGuestClient {
  // Whether the guest's history can go back or forward.
  //
  // Sent only when the pair changes, because NavigationStateChanged also fires
  // for titles, favicons and audio. A fresh guest sends nothing until its first
  // commit gives it an entry to go back to.
  HistoryChanged(bool can_go_back, bool can_go_forward);

  // Whether the guest is loading, for an address bar spinner.
  //
  // Uses `should_show_loading_ui`, as Chrome's throbber does, so same-document
  // navigations do not count. Sent only when it changes. A fresh guest sends
  // nothing until its first load starts.
  LoadingChanged(bool is_loading);

  // The guest's current URL and security level, for an address bar.
  //
  // Both come from the same `GetVisibleEntry()`, so the lock always describes
  // the URL shown; mixing entries enables address bar spoofing. The URL is the
  // virtual URL, as browsers display (e.g. `view-source:`).
  //
  // Sent only when the pair changes. Two hooks drive it,
  // NavigationStateChanged and DidChangeVisibleSecurityState, so both compare
  // against the last pair sent. A fresh guest sends nothing.
  PageChanged(url.mojom.Url url, WebViewSecurity security);

  // A key with Ctrl, Alt or Meta that the page did not handle, for browser
  // shortcuts.
  //
  // Unhandled guest keys stop at the guest's WebContentsDelegate, so the shell
  // cannot see them otherwise. Comes from HandleKeyboardEvent, which runs only
  // if the page did not call preventDefault, so sites keep their own chords.
  //
  // Chords only, so ordinary typing, including passwords, is not copied into
  // the shell's document.
  //
  // `key` and `code` are KeyboardEvent values.
  UnhandledKeyDown(string key, string code, bool alt_key, bool ctrl_key,
                   bool shift_key, bool meta_key, bool repeat);

  // The page's zoom factor; 1 is 100%.
  //
  // From HostZoomMap, keyed by host as in Chrome, so it also changes when
  // another window on the site zooms or the page navigates. Sent only when it
  // changes; a fresh guest sends nothing.
  ZoomChanged(double factor);

  // The best icon the page declares: an SVG, else the largest of its icon and
  // touch icon links, else `/favicon.ico`. Empty when it has none, and sent
  // empty on each commit before the head is parsed.
  //
  // Exists because some sites show their icon only to signed-in users, which
  // the compositor's anonymous fetch cannot see. Sent only when it changes.
  FaviconChanged(url.mojom.Url icon);

  // The user pressed Ctrl+wheel and the page did not consume the wheel.
  //
  // A request, not a zoom: unlike Chrome, the shell applies the step so
  // Ctrl+wheel and Ctrl+plus share one path and one indicator.
  ZoomRequested(bool zoom_in);

  // The page needs a file picked: an `<input type="file">` or a download.
  //
  // The shell draws the picker, because the shell owns all desktop UI.
  //
  // `accept` is lower-case extensions without the dot; the browser expands
  // MIME types like `image/*`. Empty accepts anything. `suggested_name` is set
  // only for saves. `home` is the absolute home directory, which the renderer
  // cannot learn otherwise.
  //
  // `paths` are absolute or home-relative. See
  // components/domicile/browser/file_choice.h. Null cancels, as does an
  // unhandled event or a closed pipe.
  FileChooserRequested(WebViewFileChooserMode mode,
                       array<string> accept,
                       string suggested_name,
                       string home)
      => (array<string>? paths);

  // The page called window.close() and its renderer allowed it, or an
  // extension's tabs.remove named it.
  //
  // Sent only for a shell-owned page (no `window`); the shell closes it by
  // removing the element. The browser closes browser windows itself; see
  // browser_windows.mojom.
  //
  // The renderer allows window.close() only for script-opened pages or ones
  // with a single history entry, per the HTML spec.
  //
  // Sent once per call.
  CloseRequested();

  // Find results: the match count and the selected match, from 1. Zero and
  // zero means no active find.
  //
  // From FindRequestManager, which counts across all frames, including
  // cross-process ones the renderer cannot see. Sent only when the pair
  // changes; a fresh guest sends nothing.
  FindChanged(int32 matches, int32 active_match);

  // An extension asked to bring this browser window to the front, via
  // `chrome.tabs.update(id, {active: true})` or `chrome.windows.update(id,
  // {focused: true})`. The shell decides window order, so the browser only
  // asks. See //chrome/browser/domicile/domicile_desk.h.
  FocusRequested();

  // The content's preferred size in CSS pixels: its max-content width and its
  // document height at the laid-out width.
  //
  // Used to size extension popups, as Chrome does. Sent only when it changes; a
  // fresh guest sends it after its first layout.
  ContentSizeChanged(int32 width, int32 height);

  // The user opened a context menu (right click or menu key) and the page did
  // not cancel `contextmenu`. The browser draws no menu, so the shell draws
  // one from this. Sent once per menu.
  ContextMenuRequested(WebViewContextMenu menu);

  // The page asked for `permissions` and the site has no stored choice, so
  // the shell must ask the user. `origin` is the asking site. Camera and
  // microphone may come together; anything else comes alone.
  //
  // One at a time: the next request waits for the answer or for
  // PermissionRequestWithdrawn. Null, an unhandled event or a closed pipe
  // ignores the request: the page gets no grant and nothing is stored.
  PermissionRequested(url.mojom.Url origin,
                      array<WebViewPermission> permissions)
      => (WebViewPermissionAnswer? answer);

  // The browser dropped the unanswered request, for example because the page
  // navigated. Its answer, if one is sent, is ignored.
  PermissionRequestWithdrawn();

  // The page's site's permission settings, one per WebViewPermission. Empty
  // for a page that is not http or https, which has none.
  //
  // Sent when the page's site or a setting changes. A fresh guest sends
  // nothing until its first commit.
  SitePermissionsChanged(array<WebViewSitePermission> permissions);
};

// One guest, for the life of the element that requested it.
//
// A separate pipe because attaching destroys the placeholder frame, so its
// token no longer identifies the guest.
interface WebViewGuest {
  // Navigates the guest's page to `url`, as `src` does. domicile:// URLs are
  // refused and show about:blank#blocked; see
  // components/domicile/browser/web_view_url.h.
  Navigate(url.mojom.Url url);

  // Address bar controls on the guest's NavigationController.
  //
  // They go over this pipe because the guest's history lives in the browser
  // process. The element's own placeholder frame has a separate, unused
  // history.
  //
  // Return nothing; navigation is asynchronous. Going back or forward with no
  // entry is a no-op, not an error. Read `canGoBack` on the element to gray out
  // buttons.
  GoBack();
  GoForward();

  // Stops loading, via `WebContents::Stop`; NavigationController has no Stop.
  Stop();

  // Reloads the current entry. A POST entry's repost warning has no dialog
  // yet; see ROADMAP.md.
  Reload();

  // Sets the zoom factor; 1 is 100%. Applied through HostZoomMap, so it zooms
  // the whole site, as in Chrome. Reported back as
  // WebViewGuestClient.ZoomChanged.
  //
  // Must be within blink::kMinimumBrowserZoomFactor and
  // kMaximumBrowserZoomFactor. The element throws a RangeError first, so an
  // out-of-range value here is a bad message.
  SetZoom(double factor);

  // Finds `text` and selects the next match, or the previous one when
  // `forward` is false. Reported as WebViewGuestClient.FindChanged.
  //
  // Repeating the same text finds the next match; new text starts a new
  // search, as in Chrome. The browser tracks this because navigation ends a
  // find session.
  //
  // Never empty: the element sends StopFinding instead, so an empty string is
  // a bad message.
  Find(string text, bool forward);

  // Ends the find and clears highlights. `keep_selection` keeps the selected
  // match (Escape); false clears it (text cleared). Reported as
  // FindChanged(0, 0).
  StopFinding(bool keep_selection);

  // The element gained focus, by `view.focus()` or a click.
  //
  // Makes this guest the active tab for chrome.tabs. The browser gets no
  // notification when an inner WebContents gains focus. See
  // HTMLWebViewElement::SetFocused.
  Focused();

  // Runs `action` for context menu `menu`.
  // - An id older than the newest menu is a race and is dropped.
  // - An unknown id, or an action the menu does not offer (e.g. a link action
  //   with no link), is a bad message. The element rejects both first.
  RunContextMenuAction(int32 menu, WebViewContextMenuAction action);

  // Opens DevTools for the page in a new browser window. If DevTools is
  // already open, its window's element gets FocusRequested instead. See
  // //chrome/browser/domicile/domicile_devtools.h.
  Inspect();

  // Stores `setting` for `permission` on the page's site. Reported back as
  // WebViewGuestClient.SitePermissionsChanged. Dropped, and logged, when the
  // page has no site, which happens when it navigates as the shell sends.
  SetSitePermission(WebViewPermission permission,
                    WebViewPermissionSetting setting);
};
