module domicile.mojom;

import "services/viz/public/mojom/compositing/compositor_frame_sink.mojom";
import "services/viz/public/mojom/compositing/frame_sink_id.mojom";
import "services/viz/public/mojom/compositing/local_surface_id.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";
import "gpu/ipc/common/exported_shared_image.mojom";
import "ui/gfx/mojom/buffer_types.mojom";

// Tells a producer which surface to submit to.
//
// The embedder allocates and the producer adopts. That is not our invention: it
// is what RemoteFrame does for every OOPIF, where the embedding side owns the
// LocalSurfaceId's parent_sequence_number and bumps it whenever its box
// changes. Here the embedder is the page — a <canvas> pointed at a brokered
// FrameSinkId — so this call is a compositor telling a client to resize, and
// the <canvas> element's layout box is the xdg_toplevel.configure.
//
// The LocalSurfaceId carries an embed_token the embedder minted, and holding it
// is the whole of the producer's permission to submit to that surface. Nothing
// has to decide whether the page *may* embed a window.
interface SurfaceObserver {
  // The embedder is showing `size` of this producer's surface at
  // `local_surface_id`. Submit to that id, at that size, until told another.
  //
  // This is xdg_toplevel.configure.
  OnSurfaceEmbedded(viz.mojom.LocalSurfaceId local_surface_id,
                    gfx.mojom.Size size);

  // Viz asked for a frame. Only sent to a producer whose sink the browser
  // owns — one that passed no receiver to CreateFrameSink — because a producer
  // holding its own sink is already viz's client and hears this directly.
  //
  // This is wl_surface.frame.
  OnFrame(int64 deadline_us);

  // Viz has stopped sampling `buffer_id` and the producer may draw into it
  // again. Without this the compositor reuses a dmabuf viz is still reading,
  // which is a tear rather than an error.
  //
  // This is wl_buffer.release.
  OnBufferReleased(uint64 buffer_id);
};

// Brokers viz frame sinks to a compositing producer that is not a renderer.
//
// blink.mojom.EmbeddedFrameSinkProvider is the same thing for renderers, and it
// requires the caller to name a FrameSinkId it already owns — a renderer may
// only use ids in the namespace keyed by its own child process id. A producer
// outside the browser's process tree owns no such namespace, so here the
// browser allocates the id from its own and tells the caller what it got.
interface FrameSinkBroker {
  // Allocates a FrameSinkId, registers it with viz, and binds `receiver` to the
  // resulting CompositorFrameSink. The returned id is what an embedder needs to
  // name the surface this sink submits to, and `observer` is how the producer
  // hears which surface that turned out to be.
  //
  // The sink is not yet part of any frame sink hierarchy, and nothing embeds
  // the surface it submits to. Those are two separate things, measured in step
  // 2 of the spike rather than assumed:
  //
  //   - Aggregation needs an embedder to name the SurfaceId in a
  //     SurfaceDrawQuad. Registering the frame sink is not what draws it.
  //   - Hierarchy registration is what makes BeginFrames arrive. Without it a
  //     producer can still submit — with a manual BeginFrameAck — and viz still
  //     aggregates what it submitted.
  //
  // Both happen when an embedder turns up, which is what SurfaceObserver
  // announces. The producer may connect before there is a page to embed it, or
  // after; neither side waits on the other.
  //
  // `observer` is optional, and a producer that passes none can never submit:
  // it has no way to learn the LocalSurfaceId, and it may not invent one. That
  // is a sink with no surface, which is a useful thing to be able to ask for in
  // a test and nowhere else.
  // `app_id` is what the producer calls this window. It **is** dispatched on:
  // a page's <app> element names the app it wants and the broker matches this
  // string, which is how a desktop of windows embeds a different surface in
  // each. It also reaches viz as the frame sink's debug label, which is what
  // it used to be and only be.
  //
  // Two producers claiming one app id is a producer bug the broker does not
  // adjudicate: the first sink found wins the embed. There is one producer per
  // socket and it is the compositor, which keys its own surfaces by app id, so
  // a collision means it has two windows under one name.
  // `client` and `receiver` are how a producer that assembles its own
  // CompositorFrames talks to viz directly: the receiver is forwarded on and
  // the two never meet the browser again. That is what the spike's submitters
  // do, and they can, because a solid colour needs no GPU resource.
  //
  // **Pass neither to have the browser own the sink.** A producer with a
  // dmabuf cannot assemble its own frame — a TransferableResource names a
  // mailbox, and minting one needs a GPU channel this producer deliberately
  // does not have — so it imports buffers here and names them in SubmitBuffer,
  // and the browser puts the matching resource in the frame. It then hears
  // BeginFrames and releases through SurfaceObserver instead of directly.
  CreateFrameSink(
      pending_remote<viz.mojom.CompositorFrameSinkClient>? client,
      pending_receiver<viz.mojom.CompositorFrameSink>? receiver,
      pending_remote<SurfaceObserver>? observer,
      string app_id)
      => (viz.mojom.FrameSinkId frame_sink_id);

  // Imports a dmabuf and returns the id to name it by, or 0.
  //
  // This is zwp_linux_dmabuf_v1: the fds the client already sent. The browser
  // does what components/exo/buffer.cc does with them — a NativePixmap, a
  // SharedImage, a TransferableResource — because it is the process that has
  // an aura::Env to reach a SharedImageInterface through. The producer never
  // sees a mailbox.
  //
  // The buffer is kept until DestroyBuffer or until the sink goes away, so a
  // client that reuses a buffer imports it once.
  // `exported` is the SharedImage the browser made, as something another
  // client can name: a mailbox and a verified sync token, which are bytes once
  // the browser has verified them. A producer that takes it can build its own
  // TransferableResource and submit its own CompositorFrame to the sink it
  // already holds — no mailbox is minted outside the browser and no GPU channel
  // moves. Null when the browser owns the sink, where nothing outside it needs
  // to name the resource.
  // `fourcc` is the DRM format the client allocated in, and it is not
  // optional: the byte order it names is the difference between a window and
  // the same window with its red and blue swapped. A real client picks
  // ARGB8888 where the spike's own producers picked ABGR8888, which is how
  // this went unnoticed until one was pointed at the seam.
  ImportBuffer(viz.mojom.FrameSinkId frame_sink_id,
               gfx.mojom.GpuMemoryBufferHandle buffer_handle,
               gfx.mojom.Size size,
               uint32 fourcc)
      => (uint64 buffer_id, gpu.mojom.ExportedSharedImage? exported);

  // Submits a frame showing `buffer_id`, damaging `damage`.
  //
  // This is wl_surface.commit. Only meaningful for a sink the browser owns;
  // a producer holding its own sink submits to viz itself.
  SubmitBuffer(viz.mojom.FrameSinkId frame_sink_id,
               uint64 buffer_id,
               gfx.mojom.Rect damage);

  // Drops an imported buffer. Every buffer is dropped anyway when its sink is,
  // so this is for a client that destroys one of its own.
  DestroyBuffer(viz.mojom.FrameSinkId frame_sink_id, uint64 buffer_id);

  // Destroys the sink for `frame_sink_id` and invalidates the id. Every sink
  // this interface brokered is destroyed anyway when the connection drops; this
  // is for a producer outliving one of its own surfaces.
  DestroyFrameSink(viz.mojom.FrameSinkId frame_sink_id);
};
