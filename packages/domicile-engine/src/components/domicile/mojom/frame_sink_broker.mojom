module domicile.mojom;

import "components/domicile/mojom/control_channel.mojom";
import "services/viz/public/mojom/compositing/compositor_frame_sink.mojom";
import "services/viz/public/mojom/compositing/frame_sink_id.mojom";
import "services/viz/public/mojom/compositing/local_surface_id.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";
import "gpu/ipc/common/exported_shared_image.mojom";
import "ui/gfx/mojom/buffer_types.mojom";
import "mojo/public/mojom/base/shared_memory.mojom";

// Tells a producer which surface to submit to.
//
// The embedder allocates the LocalSurfaceId and the producer adopts it, as
// RemoteFrame does for OOPIFs. Here the embedder is the page, so the
// embedding element's layout box drives xdg_toplevel.configure. The
// LocalSurfaceId's embed_token is the producer's permission to submit to that
// surface. See docs/architecture/ENGINE-FORK.md.
interface SurfaceObserver {
  // The embedder shows `size` of this producer's surface at
  // `local_surface_id`. Submit to that id at that size until told otherwise.
  //
  // This is xdg_toplevel.configure. `size` is in the page's device pixels and
  // `scale` is device pixels per CSS pixel, which converts back to the logical
  // pixels a client is configured in. Per embed, since each monitor's page has
  // its own scale.
  OnSurfaceEmbedded(viz.mojom.LocalSurfaceId local_surface_id,
                    gfx.mojom.Size size,
                    double scale);

  // Viz no longer samples `buffer_id`, so the producer may draw into it.
  // Reusing a dmabuf viz is still reading causes tearing.
  //
  // This is wl_buffer.release.
  OnBufferReleased(uint64 buffer_id);
};

// One display the browser sees, for the producer to advertise.
//
// `bounds` is the display's position on the browser's desktop in DIP. On the
// DRM platform nothing sets a scale factor, so DIP equals pixels.
struct Display {
  // Derived from the EDID, so it is stable across hotplug. The producer names
  // its wl_output after it, so a replugged monitor keeps the same wl_output.
  int64 id;
  gfx.mojom.Rect bounds;

  // The panel size in millimeters, or empty if the display reports none.
  //
  // The producer puts this in wl_output.geometry, which allows zero for
  // displays with no physical size. display::Display stores a DPI instead;
  // components/domicile/browser/display_list.cc and
  // ui/ozone/platform/drm/domicile/drm_screen.cc convert between the two.
  gfx.mojom.Size physical_size_mm;

  // The monitor's name, "<MAKE> <MODEL> <SERIAL>" from its EDID, or empty if
  // the EDID gives none.
  //
  // `id` is identity; this is what a user writes in config to pick a monitor,
  // and matches what kanshi and sway use. Built by
  // ui/ozone/platform/drm/domicile/edid_name.cc and carried in
  // display::Display as `label`. It includes the serial, which
  // display::EdidParser keeps only as a hash.
  string name;

  // The CRTC refresh rate in mHz, as wl_output.mode states it, or zero if
  // there is no mode. Clients are paced by wl_surface.frame, so zero is
  // harmless.
  int32 refresh_mhz;
};

// How the producer wants one display's connector driven.
//
// `Display` is what the browser read from the hardware; this is what the
// compositor's config says to do with it. It crosses processes because the
// compositor owns the config and the browser holds DRM master. See
// docs/architecture/A-DESKTOP-ON-A-TTY.md, "Outputs".
struct DisplayLayout {
  // A `Display.id` the browser sent.
  int64 id;

  // Whether to light this connector.
  //
  // `false` comes from a profile's `enabled: false`, e.g. to turn off a laptop
  // panel when the lid is shut on a full desk.
  bool enabled;

  // The mode's position on the browser's desktop, in physical pixels. Ignored
  // when `enabled` is false.
  gfx.mojom.Point origin;

  // The monitor's rotation and its device pixels per logical pixel. The
  // browser applies both to the window on this connector, so the page lays out
  // upright in logical pixels. Read even when `enabled` is false, because the
  // window persists while the connector is dark.
  DisplayTransform transform;
  double scale;

  // The display's rectangle in the shell's logical desktop, from the profile.
  // Empty when `enabled` is false. Used to move the pointer between monitors,
  // since `origin` does not encode which monitor is beside which.
  gfx.mojom.Rect desk;
};

// Tells a producer what the displays are.
//
// No Wayland request matches this, because a Wayland compositor normally
// reads the hardware itself. On a tty the engine holds DRM master and the
// compositor has no DRM backend. See docs/architecture/A-DESKTOP-ON-A-TTY.md,
// "Outputs".
interface DisplayListObserver {
  // The full list, primary first; a missing display was unplugged. Sent once
  // the browser has read the displays, and on every change.
  OnDisplaysChanged(array<Display> displays);
};

// Which clipboard: the Ctrl-C clipboard or the primary selection.
enum Clipboard {
  kCopy,
  kPrimary,
};

// Tells a producer what was copied in the browser.
//
// The browser is not a Wayland client, so without this its copies would not
// reach the seat. See ui/ozone/platform/drm/domicile/drm_clipboard.h.
interface ClipboardObserver {
  // The copied text. The producer puts it on the seat; nothing waits for
  // that.
  OnCopied(Clipboard clipboard, string text);
};

// A captured frame's pixels.
union CapturedPixels {
  // GPU compositing: a dmabuf.
  gfx.mojom.GpuMemoryBufferHandle dmabuf;
  // Software compositing: rows `CapturedFrame.stride` bytes apart from the
  // region's start.
  mojo_base.mojom.ReadOnlySharedMemoryRegion shm;
};

// One frame of a display, as viz composited it.
struct CapturedFrame {
  CapturedPixels pixels;
  // The DRM fourcc: ARGB8888 or ABGR8888, which viz picks.
  uint32 fourcc;
  // The buffer's size. Only `content` holds the display; viz letterboxes the
  // rest when the display's aspect differs from the requested size.
  gfx.mojom.Size size;
  // Bytes per row of `shm`. Zero for a dmabuf, whose planes carry it.
  uint32 stride;
  gfx.mojom.Rect content;
  // What changed since the previous frame, in buffer pixels. Empty means
  // everything.
  gfx.mojom.Rect damage;
};

// Holds a captured frame's buffer. Closing it gives the buffer back to viz,
// which may then draw the next frame into it.
interface CapturedFrameHold {};

// Hears one display capture's frames.
interface DisplayCaptureObserver {
  // A frame, sent when the display changed and no sooner than the frame
  // rate cap allows. Read it, then close `hold`. Viz keeps a few buffers, so
  // holding every frame stalls the capture.
  OnFrameCaptured(CapturedFrame frame, pending_remote<CapturedFrameHold> hold);
};

// Controls one display capture. Closing it stops the capture.
interface DisplayCapture {
  // Captures at `size` from the next frame on, letterboxed to keep the
  // display's aspect.
  Resize(gfx.mojom.Size size);
};

// Brokers viz frame sinks to a producer that is not a renderer.
//
// blink.mojom.EmbeddedFrameSinkProvider requires a FrameSinkId in the
// caller's child-process namespace. A producer outside the browser's process
// tree has none, so the browser allocates the id from its own namespace.
interface FrameSinkBroker {
  // Allocates a FrameSinkId, registers it with viz, and binds `receiver` to
  // the CompositorFrameSink. An embedder names the surface by the returned id;
  // `observer` tells the producer which surface it got.
  //
  // The sink starts outside any frame sink hierarchy and unembedded:
  //
  //   - Drawing needs an embedder to name the SurfaceId in a SurfaceDrawQuad.
  //   - BeginFrames need hierarchy registration. Without it a producer can
  //     still submit with a manual BeginFrameAck.
  //
  // Both happen when an embedder appears, announced by SurfaceObserver. The
  // producer and page may connect in either order.
  //
  // Without `observer` the producer cannot learn a LocalSurfaceId and so
  // cannot submit. This is useful only in tests.
  //
  // `app_id` names the window. The broker matches it against an <app>
  // element's app name to pick the surface to embed. It is also the frame
  // sink's viz debug label. If two sinks share an app id, the first found wins;
  // that is a producer bug.
  //
  // A producer that builds its own CompositorFrames passes `client` and
  // `receiver`, which are forwarded to viz. The spike's submitters do this,
  // since a solid color needs no GPU resource.
  //
  // **Pass neither to have the browser own the sink.** A dmabuf producer has
  // no GPU channel to mint mailboxes, so it imports buffers with ImportBuffer
  // and names them in SubmitBuffer, and the browser builds the frame.
  // Releases then arrive through SurfaceObserver.
  CreateFrameSink(
      pending_remote<viz.mojom.CompositorFrameSinkClient>? client,
      pending_receiver<viz.mojom.CompositorFrameSink>? receiver,
      pending_remote<SurfaceObserver>? observer,
      string app_id)
      => (viz.mojom.FrameSinkId frame_sink_id);

  // Imports a dmabuf and returns its id, or 0 on failure.
  //
  // This is zwp_linux_dmabuf_v1. The browser does what
  // components/exo/buffer.cc does (NativePixmap, SharedImage,
  // TransferableResource), since it has the SharedImageInterface. The buffer
  // lives until DestroyBuffer or until the sink is destroyed.
  //
  // `exported` is the SharedImage as a mailbox and verified sync token. A
  // producer that owns its sink can use it to build its own
  // TransferableResource. Null when the browser owns the sink.
  //
  // `fourcc` is the client's DRM format. It is required because the byte order
  // decides whether red and blue are swapped.
  ImportBuffer(viz.mojom.FrameSinkId frame_sink_id,
               gfx.mojom.GpuMemoryBufferHandle buffer_handle,
               gfx.mojom.Size size,
               uint32 fourcc)
      => (uint64 buffer_id, gpu.mojom.ExportedSharedImage? exported);

  // Submits a frame showing `buffer_id` with `damage`.
  //
  // This is wl_surface.commit. Only for sinks the browser owns.
  SubmitBuffer(viz.mojom.FrameSinkId frame_sink_id,
               uint64 buffer_id,
               gfx.mojom.Rect damage);

  // Drops an imported buffer the client destroyed. Buffers are also dropped
  // with their sink.
  DestroyBuffer(viz.mojom.FrameSinkId frame_sink_id, uint64 buffer_id);

  // Destroys the sink and invalidates `frame_sink_id`. All sinks are also
  // destroyed when the connection drops.
  DestroyFrameSink(viz.mojom.FrameSinkId frame_sink_id);

  // How to drive the connectors; the reply to `OnDisplaysChanged`.
  //
  // The browser reads the hardware, but only the producer has the config.
  //
  // An empty list means no preference, and the browser lights what the
  // hardware reports. This matters when a profile that turned a panel off
  // stops matching after a monitor is unplugged: the panel must come back on.
  //
  // No reply, because the modeset completes later on the DRM thread. The
  // modeset triggers the next `OnDisplaysChanged` instead.
  ConfigureDisplays(array<DisplayLayout> layout);

  // Sets the contents of one of the desktop's clipboards.
  //
  // Pushed rather than fetched because the producer reads each selection as it
  // arrives, so pastes in a page are answered from this process's memory.
  //
  // An empty string means an empty clipboard. Send it, or the browser keeps
  // offering the previous contents.
  SetClipboard(Clipboard clipboard, string text);

  // Registers `observer` for copies made in the browser.
  //
  // Unlike `ObserveDisplays`, nothing is sent on registration. The producer
  // sets the initial clipboard with `SetClipboard`.
  ObserveClipboard(pending_remote<ClipboardObserver> observer);

  // Registers `observer` for the display list and sends the current list.
  //
  // Sending on registration means a producer that connects late need not wait
  // for a hotplug. If the browser has not read the displays yet, nothing is
  // sent until it has.
  ObserveDisplays(pending_remote<DisplayListObserver> observer);

  // Captures what a display shows, for a screen cast. Viz runs a
  // FrameSinkVideoCapturer on the root frame sink of the browser window on
  // that display.
  //
  // `display_id` is a `Display.id`. Zero names the browser's only window, for
  // a nested or headless browser, which sends no displays.
  //
  // Frames are `size` (see `DisplayCapture.Resize`), sent only on damage and
  // at most `max_fps` a second. They are dmabufs when the browser composites
  // on the GPU, shared memory otherwise.
  //
  // Replies false, and closes both pipes, when no browser window shows that
  // display.
  CaptureDisplay(int64 display_id,
                 gfx.mojom.Size size,
                 uint32 max_fps,
                 pending_receiver<DisplayCapture> capture,
                 pending_remote<DisplayCaptureObserver> observer)
      => (bool started);
};
