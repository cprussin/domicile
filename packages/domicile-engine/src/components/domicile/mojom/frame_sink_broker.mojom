module domicile.mojom;

import "services/viz/public/mojom/compositing/compositor_frame_sink.mojom";
import "services/viz/public/mojom/compositing/frame_sink_id.mojom";

// Brokers viz frame sinks to a compositing producer that is not a renderer.
//
// blink.mojom.EmbeddedFrameSinkProvider is the same thing for renderers, and it
// requires the caller to name a FrameSinkId it already owns — a renderer may
// only use ids in the namespace keyed by its own child process id. A producer
// outside the browser's process tree owns no such namespace, so here the
// browser allocates the id from its own and tells the caller what it got.
interface FrameSinkBroker {
  // Allocates a FrameSinkId, registers it with viz, and binds `receiver` to the
  // resulting CompositorFrameSink. The returned id is what an embedder needs to
  // name the surface this sink submits to.
  //
  // The sink is not yet part of any frame sink hierarchy, and nothing embeds
  // the surface it submits to. Those are two separate things, measured in step
  // 2 of the spike rather than assumed:
  //
  //   - Aggregation needs an embedder to name the SurfaceId in a
  //     SurfaceDrawQuad. Registering the frame sink is not what draws it.
  //   - Hierarchy registration is what makes BeginFrames arrive. Without it a
  //     producer can still submit — with a manual BeginFrameAck — and viz still
  //     aggregates what it submitted.
  CreateFrameSink(
      pending_remote<viz.mojom.CompositorFrameSinkClient> client,
      pending_receiver<viz.mojom.CompositorFrameSink> receiver)
      => (viz.mojom.FrameSinkId frame_sink_id);

  // Destroys the sink for `frame_sink_id` and invalidates the id. Every sink
  // this interface brokered is destroyed anyway when the connection drops; this
  // is for a producer outliving one of its own surfaces.
  DestroyFrameSink(viz.mojom.FrameSinkId frame_sink_id);
};
