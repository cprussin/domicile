import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  # The Blink half of the fork links `:mojom_blink`, and since `3d77360` the
  # template emits that variant only for a target that asks. It used to emit it
  # for everything that did not opt out, so this line reads as a no-op against
  # any older Chromium and is load-bearing against this one.
  generate_blink = true

  sources = [
    "browser_windows.mojom",
    "control_channel.mojom",
    "extension_tray.mojom",
    "external_surface.mojom",
    "frame_sink_broker.mojom",
    "web_view_guest.mojom",
  ]

  public_deps = [
    "//gpu/ipc/common:interfaces",

    # frame_sink_broker.mojom sends a captured frame in shared memory when the
    # browser composites in software.
    "//mojo/public/mojom/base",
    "//services/viz/public/mojom",
    "//services/viz/public/mojom:surfaces",

    # web_view_guest.mojom names the placeholder frame by its LocalFrameToken
    # and the guest's address by a URL. The mojom template rewrites both of
    # these per variant, so the Blink half of the fork gets the `-blink`
    # bindings of each without naming them here.
    "//third_party/blink/public/mojom/tokens",
    "//ui/gfx/geometry/mojom",
    "//ui/gfx/mojom",
    "//url/mojom:url_mojom_gurl",
  ]
}
