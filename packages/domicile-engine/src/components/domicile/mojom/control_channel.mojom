module domicile.mojom;

import "mojo/public/mojom/base/time.mojom";

// The shell's control channel to the compositor, relayed by the browser over
// its unix socket.
//
// The browser binds this only for shell-origin documents. domicile:// is not
// web-safe or CORS-enabled, so other web content cannot reach it or call
// `Spawn`. A compromised shell renderer can call any member. See
// docs/architecture/DOMICILE-SCHEME.md.
//
// Adding a member costs a near-full Blink rebuild, so batch additions.

// A key combination the desktop claims for itself.
//
// `keycode` is a Linux evdev code, as `Key` uses. The X keycode in the Wayland
// keymap is this plus 8.
struct Shortcut {
  uint32 keycode;
  bool alt;
  bool ctrl;
  bool shift;
  bool meta;
};

// The cursor a client asked the chrome to show over its surface.
//
// The `wp_cursor_shape_v1` shapes, as an enum so an unknown name fails at the
// codec. An unknown CSS cursor keyword is silently ignored. The wire names are
// in components/domicile/common/cursor_shape.h.
enum CursorShape {
  kNone,
  kDefault,
  kContextMenu,
  kHelp,
  kPointer,
  kProgress,
  kWait,
  kCell,
  kCrosshair,
  kText,
  kVerticalText,
  kAlias,
  kCopy,
  kMove,
  kNoDrop,
  kNotAllowed,
  kGrab,
  kGrabbing,
  kEResize,
  kNResize,
  kNeResize,
  kNwResize,
  kSResize,
  kSeResize,
  kSwResize,
  kWResize,
  kEwResize,
  kNsResize,
  kNeswResize,
  kNwseResize,
  kColResize,
  kRowResize,
  kAllScroll,
  kZoomIn,
  kZoomOut,
};

// A monitor's rotation.
//
// Named for the turn applied to the content, as `wl_output` and the config
// file do. A panel rotated 90 degrees counterclockwise needs kRotate90.
enum DisplayTransform {
  kNormal,
  kRotate90,
  kRotate180,
  kRotate270,
};

// The desktop's color theme.
//
// The wire names are in components/domicile/common/theme.h. This type crosses
// in both directions because the shell can set it. There is no "follow the
// system" value: this engine is the system.
enum Theme {
  kDark,
  kLight,
};

// One screen of the desktop.
//
// Geometry is in logical pixels from the config, so integers. `scale` is the
// integer `wl_output` scale clients draw at, not the shell's density.
//
// `mode_width`/`mode_height` are the panel's scanout mode, which rotation does
// not change. A portrait 4K panel is a 3840x2160 mode and an 1800x3200 logical
// box. Neither is derivable from the other, because a 1.2 display's `scale`
// is 2.
struct DisplayInfo {
  string name;
  int32 x;
  int32 y;
  uint32 width;
  uint32 height;
  uint32 scale;
  uint32 mode_width;
  uint32 mode_height;
  DisplayTransform transform;
};

// One row of the clipboard history.
//
// Carries a preview and an id, not the copied bytes, because a password
// manager's copy is a row here. The compositor keeps the bytes;
// CopyClipboardEntry takes the id back.
//
// The id is 32 bits because the compositor's JSON reaches this process as a
// base::Value, whose integers are signed 32-bit.
struct ClipboardEntry {
  uint32 id;
  string preview;
};

// One system tray icon: an application's StatusNotifierItem.
//
// `id` is what ActivateTrayItem takes. `title` is never empty; the compositor
// falls back to the item's id. `icon` is a `data:` URL, or empty if the
// compositor could not draw it.
struct TrayItem {
  string id;
  string title;
  string icon;
};

// Which button clicked a tray icon. Maps to StatusNotifierItem's Activate,
// SecondaryActivate and ContextMenu.
enum TrayAction {
  kPrimary,
  kSecondary,
  kContext,
};

// A port of an AudioDevice or a profile of an AudioCard. `available` is false
// for an empty jack or a profile that needs one; it can still be selected.
struct AudioChoice {
  string name;
  string description;
  bool available;
};

// An output (sink) or input (source). `id` is what mixer requests take.
// `volume` is the loudest channel as a fraction of the server's 100%.
// `is_default` avoids C++'s `default`. `monitor` marks an output's monitor
// among the inputs. `port` is the active port, or empty for none.
struct AudioDevice {
  string id;
  string description;
  double volume;
  bool muted;
  bool is_default;
  bool monitor;
  array<AudioChoice> ports;
  string port;
};

// A playback (sink input) or recording (source output) stream. `title` is
// empty if the application set none. `device` is the AudioDevice id, or empty
// until the next Audio resolves it.
struct AudioStream {
  string id;
  string application;
  string title;
  double volume;
  bool muted;
  string device;
};

// One meter in AudioLevels: the device or stream id, and the peak sample since
// the last report, 0.0 to 1.0 of full scale.
struct AudioLevel {
  string id;
  double peak;
};

// A sound card. `profiles` is best first; `profile` is the active one, or
// empty.
struct AudioCard {
  string id;
  string description;
  array<AudioChoice> profiles;
  string profile;
};

// One notification button. InvokeNotificationAction takes `key`; `label` is
// the button text.
struct NotificationAction {
  string key;
  string label;
};

// One org.freedesktop.Notifications notification, which the compositor
// serves. Web Notifications arrive here too, because the browser sends them
// to that server.
//
// `id` is 32 bits for ClipboardEntry's reason. `body` is plain text. `icon`
// is a `data:` URL or empty. `urgency` is "low", "normal" or "critical".
// `actions` excludes clicking the notification itself, which is `clickable`.
// `timeout_ms` is -1 to let the shell decide and 0 for no timeout. `time` is
// epoch milliseconds on the compositor's clock, a double because base::Value
// integers are 32-bit.
struct Notification {
  uint32 id;
  string app_name;
  string summary;
  string body;
  string icon;
  string urgency;
  array<NotificationAction> actions;
  bool clickable;
  int32 timeout_ms;
  double time;
};

// An application from a desktop entry, for a launcher.
//
// `command` is the argv, unquoted with field codes removed by the compositor,
// ready for Spawn. `comment` may be empty. `icon` and `preview` are `data:`
// URLs because the page cannot read the files, or empty if not found.
struct DesktopEntry {
  string id;
  string name;
  string comment;
  array<string> command;
  string icon;
  string preview;
};

// A named URL from the config, which the page opens itself. `icon` is the
// site's icon as a `data:` URL, or empty until the compositor finds it.
struct Bookmark {
  string name;
  string url;
  string icon;
};

// Page -> browser -> compositor.
interface ControlChannel {
  // Hands the browser the page's ControlChannelClient.
  //
  // A method rather than a separate interface, so access control lives in one
  // place.
  SetClient(pending_remote<ControlChannelClient> client);

  // Runs a command on the desktop machine.
  //
  // Takes an argv so no shell parses it.
  Spawn(array<string> command);

  // Searches the home directory index for `query`. Answered with
  // ControlChannelClient::Files.
  //
  // Takes no path, so a compromised renderer cannot read other directories.
  // The compositor filters, and only matches cross the channel, because a
  // full index can be tens of megabytes.
  SearchFiles(string query);

  // Previews a file a launcher found. Answered with
  // ControlChannelClient::FilePreview.
  //
  // `path` is relative to the home. The compositor answers only for paths in
  // its index, so this exposes nothing a search could not.
  PreviewFile(string path);

  // Searches installed applications for `query`. Answered with
  // ControlChannelClient::Apps. The compositor chooses the directories.
  SearchApps(string query);

  // Copies a clipboard history row, by an id from Clipboard, back onto the
  // clipboard.
  //
  // Takes no text, so a compromised renderer can only choose an existing row,
  // not write the clipboard.
  CopyClipboardEntry(uint32 entry);

  // Clicks a tray icon, by an id from Tray. Carries nothing else, for
  // CopyClipboardEntry's reason.
  ActivateTrayItem(string id, TrayAction action);

  // Dismisses notifications by ids from Notifications. Each application is
  // told. An id already closed by its application is ignored.
  DismissNotifications(array<uint32> ids);

  // Invokes a notification's action; "default" is a click on the
  // notification. The application is told only if it offered `action`.
  InvokeNotificationAction(uint32 id, string action);

  // Gives keyboard focus to a window. FocusChrome gives it back to the page.
  FocusApp(string app_id);
  FocusChrome();

  // Asks a client to close. The client may refuse, e.g. to show a save
  // dialog.
  CloseApp(string app_id);

  // Sends an <app> element's layout box size as xdg_toplevel.configure.
  //
  // Doubles because CSS pixels are fractional; rounding here would make the
  // size depend on which side measured it.
  ResizeApp(string app_id, double width, double height);

  // Reports an <app>'s bounds in the page's CSS pixels. The compositor gives
  // the client the scale of the monitor holding most of it. Layout, not the
  // compositor, positions it.
  SetAppBounds(string app_id, double x, double y, double width, double height);

  // The desktop's size and the page's device pixel ratio.
  SetDesktopSize(double width, double height);
  SetDevicePixelRatio(double ratio);

  // Sets the desktop theme from the shell's toggle.
  //
  // The compositor owns the theme so app windows match the shell: it serves
  // the settings portal GTK, Qt and Electron read. Answered with
  // ControlChannelClient::ThemeChanged to every chrome, since each monitor
  // has its own channel.
  SetTheme(Theme theme);

  // Submits a passphrase to unlock the desktop.
  //
  // Carries a secret. Nothing in this process logs it, and the compositor's
  // `Passphrase` type does not print itself. Answered with
  // ControlChannelClient::Locked to every chrome, only on success, so a page
  // cannot unlock itself. A wrong passphrase gets no answer.
  Unlock(string passphrase);

  // Locks the desktop. Answered like Unlock. With no lock configured, nothing
  // happens and nothing is sent.
  Lock();

  // Sets the backlight to `level`, 0.0 to 1.0.
  //
  // Answered with ControlChannelClient::Brightness to every chrome once the
  // kernel reports the change. The compositor writes it through logind and
  // never turns the screen fully off.
  SetBrightness(double level);

  // The shell's mixer. Ids come from ControlChannelClient::Audio; the
  // compositor rejects unknown ones. Each is answered with the next Audio to
  // every chrome once the sound server reports the change. Volume is a
  // fraction of the server's 100%.
  SetAudioVolume(string id, double volume);
  SetAudioMuted(string id, bool muted);
  // Makes a device the default for new streams.
  SetDefaultAudioDevice(string id);
  // Moves a stream to another device of the same direction.
  MoveAudioStream(string id, string device);
  // Switches a device's port, e.g. speakers to headphones.
  SetAudioPort(string id, string port);
  // Switches a sound card's profile.
  SetAudioProfile(string card, string profile);

  // Meters these devices and streams, sending peaks as AudioLevels.
  //
  // A lease: the page renews every second while meters are visible, and the
  // compositor stops metering anything not renewed, because metering a
  // microphone records it. An empty array releases all at once.
  WatchAudioLevels(array<string> ids);

  // Reports that the page captured its old frame for the theme transition.
  //
  // The compositor waits for every chrome, tells the windows, then answers
  // with ControlChannelClient::WindowsThemeChanged.
  ThemeCaptured(Theme theme);

  // Routes a key combination to the page instead of the focused client.
  GrabShortcut(Shortcut shortcut);

  // Moves the cursor to a point in the page's coordinates.
  //
  // Handled in the browser process; the compositor is not involved. A shell
  // with focus-follows-mouse needs this to move the cursor with keyboard
  // focus, and web pages cannot move the pointer. `PointerWarpTarget` limits
  // it to the pointer over this page.
  WarpPointer(double x, double y);

  // Input forwarding. Coordinates are surface-local and keycodes are evdev, as
  // Wayland clients expect.
  Key(string app_id, uint32 keycode, bool pressed);
  PointerMotion(string app_id, double x, double y);
  PointerLeave(string app_id);
  PointerButton(string app_id, uint32 button, bool pressed);
  PointerAxis(string app_id, double dx, double dy, int32 v120_x, int32 v120_y);
};

// Compositor -> browser -> page. Messages, not callbacks, because most are
// caused by clients rather than by page requests.
//
// `arrival` is `base::TimeTicks::Now()` in `ControlChannel::OnRead`, when the
// browser received the bytes. Blink exposes it on the `performance.now()`
// clock, so `event.timeStamp - event.arrival` measures IPC latency. See
// docs/architecture/ENGINE-FORK-MEASUREMENTS.md#keystroke-to-pixel.
//
// `Displays` and `Brightness` have no `arrival`, because the page stores them
// as attributes rather than event fields.
interface ControlChannelClient {
  // A window's title changed. `app_id` matches the <app> element's.
  AppTitled(string app_id, string title, mojo_base.mojom.TimeTicks arrival);

  // A window exists. `has_size` is false until the client commits a buffer,
  // because a toplevel maps before it draws. Do not treat a zero size as real.
  AppAppeared(string app_id, string title, bool has_size,
              double width, double height,
              mojo_base.mojom.TimeTicks arrival);

  AppResized(string app_id, double width, double height,
             mojo_base.mojom.TimeTicks arrival);

  // A client's minimum and maximum window size in logical units. 0 means no
  // limit on that axis, as in xdg-shell.
  AppMinSize(string app_id, double width, double height,
             mojo_base.mojom.TimeTicks arrival);
  AppMaxSize(string app_id, double width, double height,
             mojo_base.mojom.TimeTicks arrival);

  // A popup over `parent_app_id`, at (`x`, `y`) from the parent's box, in
  // logical units. Resent when the client moves it; removed by AppClosed.
  PopupPlaced(string app_id, string parent_app_id, double x, double y,
              double width, double height, bool grab,
              mojo_base.mojom.TimeTicks arrival);
  AppClosed(string app_id, mojo_base.mojom.TimeTicks arrival);

  // The cursor a client set over its surface.
  AppCursor(string app_id, CursorShape cursor,
            mojo_base.mojom.TimeTicks arrival);

  // A grabbed shortcut fired. Not named Shortcut, which would shadow the
  // struct in the generated class.
  //
  // Shell-claimed chords are matched in the browser by ShortcutRegistry, so
  // `arrival` is taken at the match rather than a socket read. It is on the
  // same clock.
  ShortcutPressed(Shortcut shortcut, mojo_base.mojom.TimeTicks arrival);

  // Which modifiers the seat holds.
  //
  // The seat outlives every window, so a dropped key release leaves modifiers
  // stuck in clients. The compositor resolves xkb's masks against the keymap,
  // so the shell does not need the keymap.
  Modifiers(bool alt, bool ctrl, bool shift, bool meta,
            mojo_base.mojom.TimeTicks arrival);

  // Every screen, sent whenever any changes.
  //
  // A full list rather than a delta, so a missed message cannot leave the page
  // wrong. The compositor always sends at least one screen, but the page must
  // handle an empty list.
  Displays(array<DisplayInfo> displays);

  // The answer to SearchFiles. `files` is the first matches: home-relative
  // paths, sorted by the compositor, directories ending in `/`. `matched` is
  // the total count. `query` is echoed so the page can match answers.
  //
  // `indexing` is true while the compositor is still walking the home, so the
  // page can show that results may be incomplete. An unreadable home sends
  // nothing; the compositor logs it.
  Files(string query,
        array<string> files,
        uint32 matched,
        bool indexing,
        mojo_base.mojom.TimeTicks arrival);

  // The answer to PreviewFile. `path` is echoed. `kind` says which fields are
  // set:
  //
  //   "text"        `text` is the start of the file
  //   "directory"   `entries` lists it, subdirectories ending in `/`
  //   "audio"       `title`, `artist`, `album` and `cover` from the file's
  //                 tags, each empty if absent, and `duration` in seconds.
  //                 `cover` is a `data:` URL
  //   "binary"      nothing else
  //   "unreadable"  nothing else: not in the index, or not readable
  //
  // A string because the page only uses it to pick a view. The browser
  // rejects any other value.
  FilePreview(string path,
              string kind,
              string text,
              array<string> entries,
              string title,
              string artist,
              string album,
              double duration,
              string cover,
              mojo_base.mojom.TimeTicks arrival);

  // The answer to SearchApps, each list best first. `query` is echoed.
  Apps(string query,
       array<DesktopEntry> apps,
       array<Bookmark> bookmarks,
       mojo_base.mojom.TimeTicks arrival);

  // The battery's `charge`, 0.0 to 1.0, and whether it is `charging`.
  //
  // The compositor polls /sys/class/power_supply and sends this when the
  // reading changes visibly, and once to each new chrome. A machine with no
  // battery sends nothing.
  //
  // navigator.getBattery() needs UPower over D-Bus, which a bare tty lacks,
  // so it always reports a full, charging battery.
  Battery(double charge, bool charging, mojo_base.mojom.TimeTicks arrival);

  // The backlight level, 0.0 to 1.0.
  //
  // Sent when it changes, by any cause, and once to each new chrome. A
  // machine with no backlight sends nothing.
  Brightness(double level);

  // The clipboard history, newest first.
  //
  // Sent whenever it changes and once to each new chrome. The history is in
  // memory only, so it starts empty.
  //
  // navigator.clipboard cannot replace this: it reads the browser's own
  // clipboard, which no Wayland client is connected to here.
  Clipboard(array<ClipboardEntry> entries, mojo_base.mojom.TimeTicks arrival);

  // Every tray icon, in registration order.
  //
  // The full list, sent whenever an icon is added, removed or changed, and
  // once to each new chrome. The compositor is the StatusNotifierItem host.
  // Empty with no session bus.
  Tray(array<TrayItem> items, mojo_base.mojom.TimeTicks arrival);

  // Every notification not yet dismissed, oldest first.
  //
  // The full list, sent whenever one is added, replaced or removed, and once
  // to each new chrome. The compositor keeps the history, so it survives a
  // page reload; the page decides which are new. Empty with no session bus.
  Notifications(array<Notification> items,
                mojo_base.mojom.TimeTicks arrival);

  // The current theme. Not named Theme, which would shadow the enum in the
  // generated class.
  //
  // Sent to each new chrome, when a config reload changes `[theme]`, and when
  // any chrome calls SetTheme, including the caller, so the compositor is the
  // single source of truth.
  ThemeChanged(Theme theme, mojo_base.mojom.TimeTicks arrival);

  // Whether the desktop is idle: true after the configured timeout without
  // input, false once input resumes.
  //
  // A state, not an edge, so a reloaded page learns the current value. Sent on
  // each change and once to each new chrome. Not sent with no idle timeout.
  //
  // The page cannot detect this itself: the shell's document stays visible
  // with the screen off, so web idle signals never fire.
  //
  // Idle is not locked; see Locked. A desktop can be idle and unlocked, or
  // locked and active.
  Idle(bool idle, mojo_base.mojom.TimeTicks arrival);

  // Whether the desktop is locked: when true, no client receives input until
  // the passphrase is entered.
  //
  // The compositor enforces the lock by not injecting the input the page
  // forwards into the Wayland seat. So a page reload, an engine restart or
  // devtools edits cannot unlock it. The page still receives its own keys, so
  // it can draw the lock screen and read the passphrase.
  //
  // A state, not an edge, so a reloaded page shows its lock screen. Sent on
  // each change and once to each new chrome. Not sent with no passphrase
  // configured.
  Locked(bool locked, mojo_base.mojom.TimeTicks arrival);

  // The theme app windows now use; the second half of ThemeChanged.
  //
  // Sent once every chrome has called ThemeCaptured, or the compositor timed
  // out, and windows have had time to repaint. Also sent to each new chrome.
  // The shell ends its transition on it.
  WindowsThemeChanged(Theme theme, mojo_base.mojom.TimeTicks arrival);

  // The shell's config section (keybindings, modes and named options) as the
  // compositor's JSON line, `type` included.
  //
  // A string because a shell's `options` are free-form, which neither mojom
  // nor WebIDL can type, so the page parses it. The browser guarantees only a
  // valid UTF-8 JSON object.
  //
  // Sent to each new chrome and when a config reload changes it.
  ShellConfig(string config, mojo_base.mojom.TimeTicks arrival);

  // All audio state: outputs, inputs, playback and recording streams, and
  // cards, each in the sound server's order.
  //
  // The full state, sent whenever the sound server reports a change and once
  // to each new chrome. Not sent with no sound server.
  Audio(array<AudioDevice> outputs,
        array<AudioDevice> inputs,
        array<AudioStream> playback,
        array<AudioStream> recording,
        array<AudioCard> cards,
        mojo_base.mojom.TimeTicks arrival);

  // Peaks for the ids WatchAudioLevels requested, about 20 times a second
  // while any are metered. Ids with no reading yet are omitted.
  AudioLevels(array<AudioLevel> levels, mojo_base.mojom.TimeTicks arrival);

  // Focus moved. `app_id` is empty when the chrome has focus.
  FocusChanged(string app_id, mojo_base.mojom.TimeTicks arrival);

  // A client requested keyboard focus and has not received it.
  //
  // The shell decides whether to grant it with FocusApp; the compositor keeps
  // focus unchanged. `app_id` is never empty.
  FocusRequested(string app_id, mojo_base.mojom.TimeTicks arrival);
};
