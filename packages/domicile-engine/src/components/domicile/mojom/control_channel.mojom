module domicile.mojom;

import "mojo/public/mojom/base/time.mojom";

// The shell's control channel to the compositor, as a renderer-to-browser
// interface rather than a socket the page opens.
//
// This replaces a WebSocket to a loopback TCP port. The port was not a page
// server with a socket beside it -- it was the desktop's control plane, and
// `Spawn` on it is arbitrary commands on the machine running the desktop. A
// loopback port is reachable by every process on the box and no header can fix
// that; what fixes it is not having a port. See docs/architecture/
// ENGINE-FORK.md, "The page is served over a TCP port, and it should not be".
//
// The browser already holds a unix socket to the compositor. This interface is
// how the page reaches it without opening one of its own.
//
// WHAT MAKES THIS SAFE IS NOT THIS FILE. A renderer that is compromised can
// call anything here, `Spawn` included. What changed is *which* renderers can:
// the browser binds this only for a document whose origin is the shell's, so
// the capability follows the origin instead of following whoever can open a
// TCP connection. domicile:// is not web-safe and not CORS-enabled, so no
// ordinary web content has that origin.

// The members the fork keeps. The bands and copy-path protocol -- place_portal,
// remove_portal, declare_bands, render_band, claim_pointer, app_composited --
// is absent on purpose: layout positions the layer now and the page has stopped
// reporting where its own boxes are. See docs/architecture/ENGINE-FORK.md.
//
// Adding a member costs a near-full Blink rebuild, so they are added in
// batches rather than one at a time.

// A key combination the desktop claims for itself.
//
// A struct rather than a string, because the compositor's protocol takes one:
// serializing this as text would mean the browser inventing a syntax and the
// compositor parsing it back, and the two halves are built from one repository
// with no reason to disagree about a keystroke. `keycode` is a Linux evdev
// code -- the same numbering `Key` forwards in, not the X keycode the Wayland
// keymap uses, which is this plus 8.
struct Shortcut {
  uint32 keycode;
  bool alt;
  bool ctrl;
  bool shift;
  bool meta;
};

// What a client asked the chrome to show over its own surface.
//
// An enum rather than the string it arrives as. `wp_cursor_shape_v1`'s shapes
// are a closed set, the compositor already has them as one
// (`domicile_protocol::CursorShape`), and carrying them across here as text
// meant nothing between the socket and the page ever asked whether a name
// named anything -- and an unknown CSS keyword is a no-op rather than an
// error, so the symptom was an arrow where a hand should be with nothing said.
// The wire names live in components/domicile/common/cursor_shape.h, which is
// the codec both ends of this go through.
enum CursorShape {
  kNone,
  kDefault,
  kContextMenu,
  kHelp,
  kPointer,
  kProgress,
  kWait,
  kCell,
  kCrosshair,
  kText,
  kVerticalText,
  kAlias,
  kCopy,
  kMove,
  kNoDrop,
  kNotAllowed,
  kGrab,
  kGrabbing,
  kEResize,
  kNResize,
  kNeResize,
  kNwResize,
  kSResize,
  kSeResize,
  kSwResize,
  kWResize,
  kEwResize,
  kNsResize,
  kNeswResize,
  kNwseResize,
  kColResize,
  kRowResize,
  kAllScroll,
  kZoomIn,
  kZoomOut,
};

// Which way up a monitor is bolted to the desk.
//
// Named for the turn the CONTENT takes rather than the one the panel did,
// which is the `wl_output` convention and the config file's: an output rotated
// a quarter turn counterclockwise needs what is drawn on it turned a quarter turn
// clockwise to come out upright, and kRotate90 is that clockwise turn.
enum DisplayTransform {
  kNormal,
  kRotate90,
  kRotate180,
  kRotate270,
};

// Which way round the desktop is drawn.
//
// An enum rather than the string it arrives as, for the reason CursorShape
// above is one: the set is closed at both ends of the wire, and carrying it
// across here as text would mean nothing between the socket and the page ever
// asked whether a name named anything. The wire names live in
// components/domicile/common/theme.h, which is the codec both directions go
// through -- and this is the one type here that crosses in BOTH, because the
// shell has a toggle on it.
//
// TWO MEMBERS, AND NO kSystem. "Follow the system" is what a program running
// on a desktop offers; this engine paints the desktop.
enum Theme {
  kDark,
  kLight,
};

// One screen of the desktop.
//
// Integers, unlike the sizes above. Those come from a layout box, where a CSS
// pixel is fractional; a display comes from the desktop's configuration, which
// names whole ones. Its geometry is logical all the same -- a `wl_output` mode
// is `width`/`height` times `scale` -- and `scale` is what clients on the
// screen draw at, not the shell's own density.
//
// EXCEPT `mode_width`/`mode_height`, which are the pixels the panel scans out
// and are not a second spelling of the logical size: a monitor on its side
// scans out exactly as it did lying down, so a portrait 4K panel is a
// 3840x2160 mode and an 1800x3200 box. Neither is derivable from the other,
// because `scale` here is the INTEGER wl_output one and a 1.2 display's is 2.
struct DisplayInfo {
  string name;
  int32 x;
  int32 y;
  uint32 width;
  uint32 height;
  uint32 scale;
  uint32 mode_width;
  uint32 mode_height;
  DisplayTransform transform;
  // This display is the whole page, so the page has to fill it: the mode above
  // is the window's own size in CSS pixels, and the logical box has to be
  // turned and scaled to cover it. False for every desktop the page's window
  // is the whole of, where the page's CSS pixels already are the desktop's
  // logical ones.
  bool fills_the_window;
};

// One thing that was copied, as a row of the clipboard's history.
//
// A preview and an id rather than the text. The compositor keeps the bytes and
// a page hands the id back with CopyClipboardEntry, so what crosses into a
// renderer is enough to draw a row and no more -- which matters because a
// password manager's copy is a row in this list.
//
// The id is 32 bits because the compositor's JSON reaches this process through
// a base::Value, whose whole numbers are a signed int. Two billion copies in
// one session is a century of copying something every second.
struct ClipboardEntry {
  uint32 id;
  string preview;
};

// Page -> browser -> compositor.
interface ControlChannel {
  // Hand the browser the page's end of the other direction.
  //
  // A method here rather than a second interface the page brokers for itself:
  // the client end means nothing to anyone who does not already hold this
  // channel, so brokering it separately would be a second place to get the
  // access control right, for no gain.
  SetClient(pending_remote<ControlChannelClient> client);

  // Run a command on the machine running the desktop.
  //
  // The argv form rather than a string, and not because it is tidier: a string
  // would have to be split by somebody, and the somebody would be a shell.
  // There is no shell in this path and there should not be one.
  Spawn(array<string> command);

  // Ask what in the home matches `query`. Answered with
  // ControlChannelClient::Files, carrying the same query.
  //
  // NO PATH, DELIBERATELY. The note at the top of this file says what makes
  // the channel safe is which renderers can reach it, not what is on it --
  // and this member is the one place that would have been untrue if it took a
  // directory: a compromised shell renderer could then read the disk a
  // directory at a time. What is searched is decided in the compositor, which
  // is also where the index lives; the query is words to match, not a place.
  //
  // THE COMPOSITOR MATCHES, AND ONLY WHAT MATCHED CROSSES. Its index is the
  // whole home, and it used to cross this channel whole so the page could
  // filter it -- tens of megabytes of JSON on a real home, parsed on this
  // process's IO thread, and a desktop that took no input while it was.
  SearchFiles(string query);

  // Ask what is in one file a launcher has reached. Answered with
  // ControlChannelClient::FilePreview, carrying the same path.
  //
  // THIS ONE DOES NAME A PATH, which SearchFiles above says it deliberately
  // does not -- and what keeps that note true is where the path is looked up.
  // It is relative to the home, as a Files answer named it, and the compositor
  // answers only for a path in its own index of the home: anything else comes
  // back `unreadable`. So it reads nothing a search could not already have
  // named, and a renderer that wanted more of the disk than that already has
  // `Spawn`.
  PreviewFile(string path);

  // Put a row of the clipboard's history back on the clipboard.
  //
  // IT NAMES A ROW AND CARRIES NO TEXT: what makes this channel safe is which
  // renderers can reach it, and a member that took bytes would let a
  // compromised shell renderer write the desktop's clipboard rather than
  // choose among what is already on it. The id is one a Clipboard message
  // carried.
  CopyClipboardEntry(uint32 entry);

  // Which window has the keyboard. FocusChrome takes it back to the page.
  FocusApp(string app_id);
  FocusChrome();

  // Ask a client to close. Not a kill: the client decides, which is why a
  // window can refuse and show a save dialog instead.
  CloseApp(string app_id);

  // The layout box, as a resize. For an <app> element the box IS the
  // xdg_toplevel.configure, which is why this exists at all.
  //
  // Doubles because the compositor's sizes are doubles, and because these come
  // from a layout box: a CSS pixel is fractional and rounding it here would
  // make a window's size depend on which half of the channel measured it.
  ResizeApp(string app_id, double width, double height);

  // The desktop's own geometry, and the scale the page is drawn at.
  SetDesktopSize(double width, double height);
  SetDevicePixelRatio(double ratio);

  // The user picked a theme off the shell's toggle.
  //
  // THE ONLY MEMBER HERE THAT TELLS THE COMPOSITOR WHAT THE DESKTOP IS rather
  // than asking it for something. Everything else on this interface is a
  // request about a window, a device or a process; this is the page saying the
  // desk is light now.
  //
  // It has to go down rather than stay in the renderer, because a theme that
  // lived in the page would be a desktop whose panels went dark and whose
  // windows stayed light. The compositor is the process the desk's clients can
  // hear -- it answers the settings portal GTK, Qt and Electron read their
  // color scheme from -- and it is the process that read the theme out of the
  // config file to begin with.
  //
  // Answered with ControlChannelClient::ThemeChanged, to every chrome rather
  // than to this one: a desk of three monitors is three of these channels, and
  // a toggle clicked on one of them is the whole desktop changing.
  SetTheme(Theme theme);

  // A key combination the compositor should route to the page rather than to
  // whichever client has focus.
  GrabShortcut(Shortcut shortcut);

  // Put the cursor where the page says, in the page's own coordinates.
  //
  // THE ONE MESSAGE ABOUT INPUT THAT GOES THE OTHER WAY, and it stops in the
  // browser process -- the compositor neither draws this pointer nor hears
  // about it. A shell whose focus follows the cursor has to take the cursor
  // with the keyboard or have the focus handed back by the next pointer event;
  // a page can read where the pointer is and cannot put it anywhere, so it
  // asks. What a page may move is the pointer over itself, which is
  // `PointerWarpTarget`'s to enforce and not this channel's to promise.
  WarpPointer(double x, double y);

  // Input forwarding. Coordinates are surface-local and keycodes are evdev,
  // because that is what a Wayland client expects to be handed.
  Key(string app_id, uint32 keycode, bool pressed);
  PointerMotion(string app_id, double x, double y);
  PointerLeave(string app_id);
  PointerButton(string app_id, uint32 button, bool pressed);
  PointerAxis(string app_id, double dx, double dy, int32 v120_x, int32 v120_y);
};

// Compositor -> browser -> page. One method, not a callback on Spawn: these
// arrive because a client did something, not because the page asked.
//
// EVERY METHOD HERE CARRIES AN `arrival`, AND IT IS NOT DECORATION. Between
// the compositor's socket and a listener in the page there is a real stage --
// a read in the browser process, a mojo message, a hop into the renderer, a
// dispatch -- and until this parameter existed nothing in a page could price
// it. `Event.timeStamp` is when the event was *constructed*, in the renderer,
// at dispatch, so measuring against it reports a few microseconds of Blink and
// calls it the IPC; that is exactly how the deleted instrument came to print
// `ipc_ms=0` every interval. `arrival` is `base::TimeTicks::Now()` taken in
// `ControlChannel::OnRead`, the moment the browser process had the bytes, and
// Blink turns it into a `DOMHighResTimeStamp` on the same clock as
// `performance.now()` -- so `event.timeStamp - event.arrival` is the stage.
// See docs/architecture/ENGINE-FORK.md, phase 2.
//
// `Displays` is the one method without one, because there is nothing to put it
// on: it dispatches a bare `Event` and the desktop is read off
// `navigator.domicile.displays` rather than carried. A parameter no event
// class can hold would be a field nothing reads.
interface ControlChannelClient {
  // A window's title changed. `app_id` is the same id an <app> element names.
  AppTitled(string app_id, string title, mojo_base.mojom.TimeTicks arrival);

  // A window exists. Size is absent until the client has committed a buffer --
  // a toplevel maps before it draws, and how big a Wayland client wants to be
  // is something it says by drawing. Believing a zero here is what opened
  // windows at nothing at all.
  AppAppeared(string app_id, string title, bool has_size,
              double width, double height,
              mojo_base.mojom.TimeTicks arrival);

  AppResized(string app_id, double width, double height,
             mojo_base.mojom.TimeTicks arrival);
  AppClosed(string app_id, mojo_base.mojom.TimeTicks arrival);

  // The cursor a client asked for over its own surface.
  AppCursor(string app_id, CursorShape cursor,
            mojo_base.mojom.TimeTicks arrival);

  // A grabbed shortcut fired. Named for the event rather than the struct,
  // which would shadow the type inside the generated class.
  //
  // Its `arrival` is the one stamp here that is not always a socket read: a
  // chord claimed by the shell is matched in the browser process by
  // ShortcutRegistry and never crosses the compositor's socket at all. It is
  // taken when the match is made, which is the same quantity -- the moment
  // this process had the message -- measured against the same clock.
  ShortcutPressed(Shortcut shortcut, mojo_base.mojom.TimeTicks arrival);

  // The seat's modifier state. One seat, outliving every window, which is why
  // a dropped key release latches modifiers into clients that never saw it.
  //
  // Which modifiers are held, not xkb's four masks: the compositor has already
  // resolved depressed/latched/locked against the keymap, and a shell asking
  // "is control down" cannot answer that from a mask without the keymap too.
  Modifiers(bool alt, bool ctrl, bool shift, bool meta,
            mojo_base.mojom.TimeTicks arrival);

  // The whole desktop, whenever any of it changes.
  //
  // Every screen every time, not a delta: the compositor re-describes the
  // desktop on a resize, a density change or a config reload, and a page that
  // had to reconcile deltas could be wrong about a screen forever after
  // missing one. An empty list is a desktop with no screens on it, which the
  // compositor does not send -- it describes at least one output -- but which
  // is an answer rather than a silence, and the page must be able to hold it.
  Displays(array<DisplayInfo> displays);

  // What matched a SearchFiles, and only that: `query` is the one answered,
  // `files` the front of what matched -- paths relative to the home
  // directory, sorted by the compositor, a directory ending in `/` -- and
  // `matched` how many there were in all.
  //
  // One of the two methods here that ARE because the page asked -- FilePreview
  // below is the other -- which is why the note above says "one method, not a
  // callback on Spawn" rather than "none". It is still a message and not a
  // reply: the page has one listener per message type and a callback would be
  // a second shape of delivery for one answer. The query comes back so the
  // page can tell answers apart.
  //
  // A home that could not be read sends nothing at all -- the compositor logs
  // it -- because a launcher drawing an empty list is how that failure would
  // otherwise look.
  //
  // `indexing` is whether the compositor's walk of the home is still running,
  // which is the difference between an incomplete answer and a wrong one: the
  // rows are a launcher's whole evidence that a file exists, so an answer from
  // an index still being built has to arrive saying so.
  Files(string query,
        array<string> files,
        uint32 matched,
        bool indexing,
        mojo_base.mojom.TimeTicks arrival);

  // What is in the file a PreviewFile named: `path` is the one answered, and
  // `kind` says which of the rest means anything.
  //
  //   "text"        `text` is the front of the file
  //   "directory"   `entries` is what is in it, a subdirectory ending in `/`
  //   "binary"      nothing else: it is a file, and not one to print
  //   "unreadable"  nothing else: not in the index, or not readable
  //
  // A string rather than an enum, because nothing on the page's side decides
  // anything with it but which of those to draw -- and the browser refuses a
  // word that is not one of the four before it gets here. An answer and not a
  // push, like Files, so the path comes back for the page to tell answers
  // apart.
  FilePreview(string path,
              string kind,
              string text,
              array<string> entries,
              mojo_base.mojom.TimeTicks arrival);

  // The machine's battery: `charge` is a fraction 0.0 through 1.0, `charging`
  // is whether a lead is in.
  //
  // Pushed, unlike Files, and with no member on ControlChannel to ask for it:
  // a charge changes on its own. The compositor polls
  // /sys/class/power_supply and sends this when the reading moves far enough
  // to draw, and once more to a chrome that has just connected.
  //
  // It exists because navigator.getBattery() does not work here. That API
  // reads UPower over D-Bus and a desktop on a bare tty has neither, so it
  // resolves with the default BatteryStatus -- charging, and full -- which no
  // page can distinguish from a real full battery. A machine with no battery
  // sends nothing rather than a zero, for the same reason.
  Battery(double charge, bool charging, mojo_base.mojom.TimeTicks arrival);

  // What has been copied on this desktop, newest first.
  //
  // Pushed like Battery: the compositor is the process a
  // wl_data_device.set_selection arrives at, so a copy is an event it already
  // hears. Sent whenever the history changes and once more to a chrome that
  // has just connected. An empty array is a desktop nothing has been copied on
  // yet, which is an answer -- and the ordinary state of one that has just
  // started, because the history is in memory and never on disk.
  //
  // A page cannot read this for itself, and navigator.clipboard is the trap
  // that looks like it can: that API answers out of this browser's own
  // clipboard, which on the platform this engine scans out on is connected to
  // no Wayland client at all.
  Clipboard(array<ClipboardEntry> entries, mojo_base.mojom.TimeTicks arrival);

  // Which way round the desktop is drawn now.
  //
  // Named for the event rather than the enum, which would shadow the type
  // inside the generated class -- the same reason ShortcutPressed is not
  // called Shortcut.
  //
  // Pushed like Battery, and the one pushed message whose cause can be this
  // page: it arrives when a chrome has just connected, when a reload of the
  // compositor's config moved `[theme]`, and when any chrome calls
  // ControlChannel::SetTheme. The sender is told again as part of that last
  // one, which is deliberate -- one path sets the theme, rather than a page
  // that believes its own click.
  ThemeChanged(Theme theme, mojo_base.mojom.TimeTicks arrival);

  // Focus moved, including to the chrome itself, in which case app_id is empty.
  FocusChanged(string app_id, mojo_base.mojom.TimeTicks arrival);

  // A client asked for the keyboard and has not been given it. The shell
  // decides: the compositor forwards the request with the seat where it was,
  // so a page that ignores this is a desktop where a background window cannot
  // take what its user is typing into. Never empty -- a request comes from a
  // client, and the chrome asking itself for focus does not cross the wire.
  FocusRequested(string app_id, mojo_base.mojom.TimeTicks arrival);
};
