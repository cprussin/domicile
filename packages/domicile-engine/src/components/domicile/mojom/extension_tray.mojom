module domicile.mojom;

// The extensions with an action, for the shell's tray.
//
// WHY A PIPE OF ITS OWN AND NOT A MESSAGE ON ControlChannel. An action's state
// lives in the browser process -- ExtensionActionManager, per profile -- and
// the compositor has never heard of it. ControlChannel is the compositor's
// socket relayed; this is the browser answering for itself, the way
// WebViewGuestHost is.
//
// THE ACCESS CONTROL IS THE BINDER'S, and it is ControlChannel's: the browser
// binds this only for a document whose origin is the shell's. An extension's
// popup is a chrome-extension:// page and cannot reach it, and neither can a
// site in a <webview>.
//
// See docs/architecture/EXTENSIONS.md in the Domicile repository.

// One extension, as the tray draws it. The state is the action's default --
// Chrome's tab -1 -- until the tray reports per <webview>.
struct TrayExtension {
  // What Activate names it by.
  string id;
  string name;
  // The action's tooltip.
  string title;
  // data:image/png;base64,..., rendered at the page's device scale factor. Not
  // a chrome-extension:// URL: action.setIcon({imageData}) sets an icon that
  // has none.
  string icon;
  string badge_text;
  // A CSS color, #rrggbbaa. Fully transparent when the extension set none.
  string badge_color;
  // The popup's address, or empty for an action whose click is Activate. A
  // string rather than a nullable url.mojom.Url, so the Blink half needs no
  // typemap for an optional KURL.
  string popup;
  // False after the extension's action.disable().
  bool enabled;
};

// Renderer -> browser, bound per document.
interface ExtensionTray {
  // Where the list goes. It is sent AT ONCE, and again whenever any of it
  // changes -- so a page that reloaded is told, rather than drawing an empty
  // tray until an extension happens to move. A second client is a bad message.
  SetClient(pending_remote<ExtensionTrayClient> client);

  // The action with no popup was clicked: dispatch its `action.onClicked`. An
  // id that names no enabled extension with an action is a click that raced
  // an uninstall, and does nothing.
  Activate(string id);
};

// Browser -> renderer.
interface ExtensionTrayClient {
  // THE WHOLE LIST, every time. An extension added, removed, or its badge set
  // are the same message, because a page reconciling deltas is a page that
  // can be wrong forever after missing one.
  ExtensionsChanged(array<TrayExtension> extensions);
};
