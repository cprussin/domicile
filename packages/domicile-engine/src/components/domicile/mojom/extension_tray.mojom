module domicile.mojom;

// Extension actions for the shell's tray.
//
// A separate interface from ControlChannel because action state lives in the
// browser process (ExtensionActionManager), not the compositor.
//
// The browser binds this only for shell-origin documents, as with
// ControlChannel, so extension popups and <webview> sites cannot reach it.
//
// See docs/architecture/EXTENSIONS.md in the Domicile repository.

// One extension's action as the tray draws it. The state is for the active
// tab (the last focused <webview>), or the action's default if there is none.
// The list is resent when the active tab changes.
struct TrayExtension {
  // The id Activate takes.
  string id;
  string name;
  // The action's tooltip.
  string title;
  // data:image/png;base64,..., at the page's device scale factor. Not a
  // chrome-extension:// URL, because action.setIcon({imageData}) icons have no
  // URL.
  string icon;
  string badge_text;
  // A CSS color, #rrggbbaa. Transparent if the extension set none.
  string badge_color;
  // The popup URL, or empty if a click only calls Activate. A string rather
  // than a nullable url.mojom.Url, so Blink needs no optional KURL typemap.
  string popup;
  // False after action.disable().
  bool enabled;
};

// Renderer -> browser, bound per document.
interface ExtensionTray {
  // Sets the list's receiver. The list is sent immediately, so a reloaded page
  // is not left empty, and again on every change. A second call is a bad
  // message.
  SetClient(pending_remote<ExtensionTrayClient> client);

  // Clicks the action, as ExtensionActionRunner::RunAction does for a toolbar
  // click. Grants activeTab on the active tab, then dispatches
  // `action.onClicked` unless the action has a popup, which the shell opens
  // itself. An unknown or disabled id is ignored; the click may have raced an
  // uninstall.
  Activate(string id);
};

// Browser -> renderer.
interface ExtensionTrayClient {
  // The full list on every change, not a delta, so a missed message cannot
  // leave the page wrong.
  ExtensionsChanged(array<TrayExtension> extensions);
};
