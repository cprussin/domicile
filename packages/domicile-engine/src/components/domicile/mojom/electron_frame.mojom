module domicile.mojom;

// An Electron app window's main frame, for its preload and IPC. See
// docs/architecture/ELECTRON-APPS.md.
//
// Both are associated with the frame's channel, so a Preload sent before a
// navigation commits reaches the renderer before the commit does, and a
// Deliver sent after reaches the document that committed.

// The browser to the renderer.
interface ElectronFrame {
  // Runs `source`, the window's preload, in the next document this frame
  // commits, before the page's own scripts, in an isolated world. Its
  // ipcRenderer talks to `host`.
  Preload(string source,
          pending_associated_remote<ElectronFrameHost> host);

  // webContents.send: the app's main process sent `args_json`, a JSON
  // array, on `channel`.
  Deliver(string channel, string args_json);
};

// The renderer to the browser, for the document that ran the preload.
interface ElectronFrameHost {
  // ipcRenderer.send. `args_json` is a JSON array.
  Send(string channel, string args_json);

  // ipcRenderer.invoke. `args_json` is a JSON array. The answer is the
  // handler's result as JSON when `ok`, or why it failed.
  Invoke(string channel, string args_json) => (bool ok, string answer);
};
