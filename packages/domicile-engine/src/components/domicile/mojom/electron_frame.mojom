module domicile.mojom;

import "mojo/public/mojom/base/values.mojom";

// An Electron app window's main frame, for its preload and IPC. See
// docs/architecture/ELECTRON-APPS.md.
//
// Both are associated with the frame's channel, so a Preload sent before a
// navigation commits reaches the renderer before the commit does, and a
// Deliver sent after reaches the document that committed.

// The browser to the renderer.
interface ElectronFrame {
  // Runs `source`, the window's preload, in the next document this frame
  // commits, before the page's own scripts, in an isolated world. Its
  // ipcRenderer talks to `host`.
  Preload(string source,
          pending_associated_remote<ElectronFrameHost> host);

  // webContents.send: the app's main process sent `args_json`, a JSON
  // array, on `channel`.
  Deliver(string channel, string args_json);

  // webContents.postMessage: `message_json` on `channel`, with a new port
  // for each of the main process's `ports`, in order.
  DeliverPost(string channel, string message_json, array<string> ports);

  // `data_json` arrived on port `port`, from the main process's end.
  DeliverToPort(string port, string data_json);

  // The main process closed port `port`.
  ClosePort(string port);

  // webContents.executeJavaScript: runs `code` in the document's main world,
  // as if the user had acted when `user_gesture`, and answers with what it
  // gave once a promise it gives settles. No result when it threw or gave
  // what has no JSON; the page's console says which.
  ExecuteJavaScript(string code, bool user_gesture)
      => (mojo_base.mojom.Value? result);
};

// The renderer to the browser, for the document that ran the preload.
interface ElectronFrameHost {
  // ipcRenderer.send. `args_json` is a JSON array.
  Send(string channel, string args_json);

  // ipcRenderer.invoke. `args_json` is a JSON array. The answer is the
  // handler's result as JSON when `ok`, or why it failed.
  Invoke(string channel, string args_json) => (bool ok, string answer);

  // ipcRenderer.sendSync: as Invoke, but the page waits for the answer, as
  // Electron's does.
  [Sync]
  SendSync(string channel, string args_json) => (bool ok, string answer);

  // ipcRenderer.postMessage. `ports` name the page's ports that went with
  // it, each "r" and a number.
  Post(string channel, string message_json, array<string> ports);

  // `data_json` on port `port`, to the main process's end.
  PostToPort(string port, string data_json);

  // The page closed port `port`.
  PortClosed(string port);
};
