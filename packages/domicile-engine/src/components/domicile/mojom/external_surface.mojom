module domicile.mojom;

import "services/viz/public/mojom/compositing/frame_sink_id.mojom";
import "services/viz/public/mojom/compositing/local_surface_id.mojom";
import "ui/gfx/geometry/mojom/geometry.mojom";

// Browser to renderer: which surface a mirroring <app> shows now.
//
// A mirror is an <app> on another page than the one configuring the window --
// a window dragged across two monitors, each a page of its own. It shows the
// surface the owning page embedded, so it is told each time that page embeds
// a new one, and never the other way round.
interface ExternalSurfaceClient {
  OnSurfaceChanged(viz.mojom.FrameSinkId frame_sink_id,
                   viz.mojom.LocalSurfaceId local_surface_id);
};

// Renderer to browser: how a page learns which surface to embed.
//
// The id cannot come from the renderer's own allocation path. A brokered
// FrameSinkId is in the browser's namespace — client id 0 — and every entry
// point of blink.mojom.EmbeddedFrameSinkProvider begins by rejecting a
// FrameSinkId whose client id is not the calling renderer's. So the id reaches
// Blink the way RemoteFrame's does: from the browser, which allocated it.
//
// Which half each side owns is the same split RemoteFrame uses. The browser
// owns the FrameSinkId, because it owns the namespace. The page owns the
// LocalSurfaceId, because it is the embedder, and the embed_token in it is the
// capability it hands to the producer.
interface ExternalSurfaceProvider {
  // The page has allocated `local_surface_id` and will show `size` of the
  // surface at it, under the frame sink `parent_frame_sink_id` — its own, so
  // BeginFrames reach the producer.
  //
  // Replies with the brokered FrameSinkId, which the page pairs with its
  // LocalSurfaceId to get the SurfaceId to embed. The reply is deferred until a
  // producer has actually been brokered a sink *for that app*: an <app>
  // element exists before the client window behind it does, and a page that
  // embeds early should wait rather than fail. Null only if the connection
  // drops first.
  //
  // A page naming a surface it was not offered gains nothing. It allocates the
  // LocalSurfaceId, so the surface it would embed is one no producer is
  // submitting to — an empty surface, not somebody else's window. That is the
  // capability argument from the LocalSurfaceId header holding in the direction
  // that matters here.
  //
  // `app_id` names which window. A page showing several windows has an <app>
  // element for each, and without a name every one of them would embed
  // whichever surface was brokered last — one window drawn several times.
  //
  // `scale` is how many of `size`'s pixels the page draws one CSS pixel with,
  // passed on to the producer so it can configure the client in logical ones.
  Embed(string app_id,
        viz.mojom.FrameSinkId parent_frame_sink_id,
        viz.mojom.LocalSurfaceId local_surface_id,
        gfx.mojom.Size size,
        double scale)
      => (viz.mojom.FrameSinkId? frame_sink_id);

  // Show `app_id`'s window here as well, as it is wherever it is embedded:
  // under `parent_frame_sink_id`, so BeginFrames reach the producer from this
  // page too, and at whatever surface the page that embedded it last chose.
  // `client` is told that surface now if there is one and again each time it
  // changes -- and the producer is told nothing, because a mirror does not
  // configure the client: two pages configuring one window would each resize
  // it to their own box in turn.
  //
  // For as long as `client` is connected. Dropping it is how a page stops
  // mirroring, and it takes this page's parent with it.
  //
  // Held until a producer has been brokered a sink for that app, like Embed.
  Mirror(string app_id,
         viz.mojom.FrameSinkId parent_frame_sink_id,
         pending_remote<ExternalSurfaceClient> client);
};
