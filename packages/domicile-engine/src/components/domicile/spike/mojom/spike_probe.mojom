module domicile.mojom;

import "ui/gfx/geometry/mojom/geometry.mojom";

// Spike only: lets the producer read back what the display compositor drew.
// Delete when domicile-compositor submits real buffers.
//
// Each method answers from a CopyOutputRequest on the browser window's root
// layer, served after viz resolves every SurfaceDrawQuad. If the producer's
// color comes back, viz aggregated its frame into the page.
interface SpikeProbe {
  // The color at the center of the browser's window. Fails if nothing has
  // been drawn yet; retry.
  SampleWindowCenter() => (bool sampled, uint32 argb);

  // The whole window for the CSS parity check, row-major SkColor (ARGB),
  // indexed by `size`. About 3 MB at 1024x768, so polling uses the methods
  // that return one pixel.
  CaptureWindow() => (bool captured, gfx.mojom.Size size, array<uint32> argb);

  // One pixel, for polling cheaply in the latency check. Fails for a `point`
  // outside the window rather than sampling the wrong pixel.
  SamplePixel(gfx.mojom.Point point) => (bool sampled, uint32 argb);
};
