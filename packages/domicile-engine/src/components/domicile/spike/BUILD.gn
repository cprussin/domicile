# Throwaway spike: a viz client in a process the browser did not launch,
# standing in for domicile-compositor, and measurements against it. See
# docs/architecture/ENGINE-FORK.md in the Domicile repository.
#
# `chrome` does not depend on these executables. Build them by name:
#
#   autoninja -C out/Domicile domicile_solid_color_submitter domicile_css_parity

# Compares what viz drew with what was submitted.
source_set("colors") {
  sources = [
    "spike_color.cc",
    "spike_color.h",
  ]

  public_deps = [
    "//base",
    "//skia",
  ]
}

# Turns a screenshot of the browser window into step 4's pass/fail results.
# Separate from the capture process so it can be unit tested.
source_set("window_diff") {
  sources = [
    "window_diff.cc",
    "window_diff.h",
  ]

  public_deps = [
    ":colors",
    "//base",
    "//skia",
    "//ui/gfx/geometry",
  ]
}

# The viz client.
source_set("producer") {
  sources = [
    "surface_producer.cc",
    "surface_producer.h",
  ]

  public_deps = [
    ":colors",
    "//base",
    "//components/domicile/mojom",
    "//components/domicile/spike/mojom",
    "//components/viz/common",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/platform",
    "//mojo/public/cpp/system",
    "//services/viz/public/mojom",
    "//skia",
    "//ui/gfx/geometry",
  ]
}

# Steps 2 and 3: checks that the center pixel of the browser window is the
# color an external process submitted.
executable("solid_color_submitter") {
  output_name = "domicile_solid_color_submitter"

  sources = [ "solid_color_submitter.cc" ]

  deps = [
    ":colors",
    ":producer",
    "//base",
    "//mojo/core/embedder",
    "//mojo/public/cpp/platform",
    "//skia",
    "//ui/gfx/geometry",
  ]
}

# Step 4: compares seven CSS properties on an <app> against an identical
# ordinary element, and measures latency from a producer's submit to display
# compositor output.
executable("css_parity") {
  output_name = "domicile_css_parity"

  sources = [
    "css_parity.cc",
    "css_parity_layout.h",
  ]

  deps = [
    ":colors",
    ":producer",
    ":window_diff",
    "//base",
    "//mojo/core/embedder",
    "//mojo/public/cpp/platform",
    "//skia",
    "//ui/gfx/geometry",
  ]
}
