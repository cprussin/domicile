// <app>: a Wayland client's window, laid out by the page.
// See docs/architecture/ENGINE-FORK.md.
//
// Domicile-only. A shell that uses it does not run in stock Chrome.

[
    RuntimeEnabled=DomicileExternalSurface,
    Exposed=Window
] interface HTMLAppElement : HTMLElement {
  [HTMLConstructor] constructor();

  // The window to show. Reflects the `app-id` attribute.
  [CEReactions, Reflect=app_id] attribute DOMString appId;

  // Whether the user is resizing the window. Reflects the `resizing`
  // attribute. While set, a new box shows without waiting for the client to
  // draw at it.
  [CEReactions, Reflect] attribute boolean resizing;
};
