// The event a <webview> dispatches when an extension asks for a popup window
// of its own: `chrome.windows.create({type: "popup", url})`.
// See docs/architecture/EXTENSIONS.md in the Domicile repository.
//
// Not a web standard and not proposed as one; it exists in Domicile's engine
// fork only, beside the element that dispatches it.
//
// NO CONSTRUCTOR AND NO EVENT-INIT DICTIONARY, for DomicileNewWindowEvent's
// reason: only the browser process ever asks for one of these.
[
    RuntimeEnabled=DomicileExternalSurface,
    Exposed=Window
] interface DomicilePopupWindowEvent : Event {
  // The window, as chrome.windows knows it. A shell names it as the
  // `popupwindow` attribute of the <webview> it opens, which makes that
  // <webview> the window's one tab.
  readonly attribute long windowId;

  // The address to show, absolute: resolved in the browser process against
  // the extension that asked.
  readonly attribute USVString url;

  // The size the extension asked for, in CSS pixels, or 0 where it asked for
  // none. Where the window goes is the shell's.
  readonly attribute long width;
  readonly attribute long height;
};
