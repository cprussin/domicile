// <webview> — web content in a browsing context of its own.
// See docs/architecture/ENGINE-FORK.md in the Domicile repository.
//
// Not a web standard and not proposed as one; it exists in Domicile's engine
// fork only. The shape is Electron's, because that is what Domicile's shells
// were written against.

[
    RuntimeEnabled=DomicileExternalSurface,
    Exposed=Window
] interface HTMLWebViewElement : HTMLElement {
  [HTMLConstructor] constructor();

  // The address showing. Reflected, so a shell's address bar has one value to
  // read and to write.
  [CEReactions, Reflect, URL] attribute USVString src;

  // The four go to the browser, which drives the guest's own
  // NavigationController -- see html_web_view_element.h. None of them raises:
  // there is nothing here for a ScriptState to be needed for and nothing a
  // caller could do about a message it cannot fail to send. A back with
  // nowhere to go is answered by not navigating, which is what an address bar
  // that cannot yet gray out its buttons asks for constantly.
  [CEReactions] undefined goBack();
  [CEReactions] undefined goForward();
  [CEReactions] undefined stop();
  [CEReactions] undefined reload();

  // Whether either of the first two would move the page, so an address bar can
  // gray out a button that would do nothing.
  //
  // READONLY PROPERTIES rather than a `domicile-history-change` event's detail,
  // and that is the whole design decision: a shell renders from state, so what
  // it needs is a value it can read at the moment it renders. An availability
  // carried only by an event is gone for a chrome that mounted after the
  // guest's first commit, which a React shell always is -- it registers its
  // listeners in its first effect flush. The event exists beside these and says
  // only "read them again"; see html_web_view_element.h for what was ruled out.
  //
  // Not reflected, because there is no content attribute behind them: these are
  // the browser's answer about a page in another process, and a content
  // attribute is the author's to write.
  readonly attribute boolean canGoBack;
  readonly attribute boolean canGoForward;

  // Whether a page is still arriving, so an address bar can show that it is.
  //
  // A READONLY PROPERTY for the reason the pair above are, and more plainly: a
  // load is a span, so a chrome that mounts in the middle of one is ordinary
  // rather than a race, and a state carried only by
  // `domicile-loading-change` would leave that window looking settled until
  // the next navigation.
  //
  // It is the browser's `should_show_loading_ui` and `IsLoading()` already
  // resolved into one answer -- "a browser would be showing a spinner" -- so
  // a same-document navigation does not set it. See
  // components/domicile/browser/web_view_guest.cc.
  readonly attribute boolean loading;

  // WHERE THE PAGE ACTUALLY IS, which `src` is not: `src` is the author's
  // attribute and says where the element was last *sent*, so a link followed
  // or a redirect taken leaves the two disagreeing. This one is the browser's,
  // read off the guest's visible entry -- the same entry a browser's own
  // address bar shows.
  //
  // The empty string until the browser has said otherwise, which is a guest
  // showing the initial entry and not an address anybody can be sent to.
  readonly attribute USVString url;

  // And what the browser says about the connection behind it. One of
  // "neutral", "secure", "warning" or "dangerous" -- `security_state`'s own
  // answer, the one Chrome draws its omnibox lock from, narrowed to the four a
  // chrome can draw. The empty string until the browser has said anything at
  // all, which a chrome must not read as "secure".
  //
  // READ IT WITH `url` AND NOT ON ITS OWN. They arrive in one message from one
  // entry so that they always describe the same page; a chrome pairing this
  // with an address from anywhere else would be drawing a padlock beside an
  // address it does not belong to.
  //
  // A DOMString rather than an IDL enum, which is the shape this would take in
  // a standards-track API: an enum return type generates a file per enum into
  // Blink's bindings, and this element deliberately adds none -- see
  // `scripts/test-the-blink-module-declares-its-files.sh` for what a generated
  // file costs to register in the fork.
  readonly attribute DOMString security;
};
