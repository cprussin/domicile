// <webview> — web content in a browsing context of its own.
// See docs/architecture/ENGINE-FORK.md in the Domicile repository.
//
// Not a web standard and not proposed as one; it exists in Domicile's engine
// fork only. The shape is Electron's, because that is what Domicile's shells
// were written against.

[
    RuntimeEnabled=DomicileExternalSurface,
    Exposed=Window
] interface HTMLWebViewElement : HTMLElement {
  [HTMLConstructor] constructor();

  // The address showing. Reflected, so a shell's address bar has one value to
  // read and to write.
  [CEReactions, Reflect, URL] attribute USVString src;

  // The four go to the browser, which drives the guest's own
  // NavigationController -- see html_web_view_element.h. None of them raises:
  // there is nothing here for a ScriptState to be needed for and nothing a
  // caller could do about a message it cannot fail to send. A back with
  // nowhere to go is answered by not navigating, which is what an address bar
  // that cannot yet grey out its buttons asks for constantly.
  [CEReactions] undefined goBack();
  [CEReactions] undefined goForward();
  [CEReactions] undefined stop();
  [CEReactions] undefined reload();
};
