// <webview>: web content in its own browsing context. Domicile-only; the API
// follows Electron's. See docs/SHELL-BROWSER-WINDOWS.md.

[
    RuntimeEnabled=DomicileExternalSurface,
    Exposed=Window
] interface HTMLWebViewElement : HTMLElement {
  [HTMLConstructor] constructor();

  // The URL the element was last sent to. Reflected.
  [CEReactions, Reflect, URL] attribute USVString src;

  // Drive the guest's NavigationController. Never throw; a back or forward
  // with nowhere to go does nothing.
  [CEReactions] undefined goBack();
  [CEReactions] undefined goForward();
  [CEReactions] undefined stop();
  [CEReactions] undefined reload();

  // Whether goBack() and goForward() would navigate. Properties so a shell
  // that mounts late reads the current value; `domicile-history-change`
  // signals a change.
  readonly attribute boolean canGoBack;
  readonly attribute boolean canGoForward;

  // Whether the browser would show a loading indicator. False for
  // same-document navigations. `domicile-loading-change` signals a change.
  readonly attribute boolean loading;

  // The guest's visible URL. Differs from `src` after a link or redirect.
  // Empty until the browser reports one.
  readonly attribute USVString url;

  // The security level of `url`: "neutral", "secure", "warning" or
  // "dangerous", as Chrome's omnibox shows it. Empty until reported; do not
  // treat empty as secure. Always read it with `url`, which arrives in the
  // same message. `domicile-page-change` signals a change to either.
  //
  // A DOMString because each IDL enum adds a generated file (see
  // scripts/test-the-blink-module-declares-its-files.sh).
  readonly attribute DOMString security;

  // The page's zoom factor; 1 is 100%. `domicile-zoom-change` signals a
  // change.
  readonly attribute double zoom;

  // Asks the browser to zoom. Throws RangeError outside 0.25 to 5, since an
  // out-of-range factor is a shell bug.
  [RaisesException] undefined setZoom(double factor);

  // The page's favicon URL, preferring SVG then the largest. Empty if none.
  // `domicile-favicon-change` signals a change.
  readonly attribute USVString favicon;

  // The address of the link under the pointer, for a status bubble. Empty
  // over no link. `domicile-target-url-change` signals a change.
  readonly attribute USVString targetUrl;

  // Finds `text` and selects the next match, or the previous one if
  // `backward`. Repeating the text finds the next match. Empty text stops
  // finding and clears the selection.
  undefined find(DOMString text, optional boolean backward = false);

  // Stops finding and keeps the selected match.
  undefined stopFinding();

  // Match count across all frames, and the selected match's 1-based index.
  // Both 0 with no find. `domicile-find-change` signals a change.
  readonly attribute long findMatches;
  readonly attribute long findActiveMatch;

  // The content's natural width (max-content) and document height, in CSS
  // pixels, as Chrome sizes extension popups. Both 0 before layout.
  // `domicile-content-size-change` signals a change.
  readonly attribute long contentWidth;
  readonly attribute long contentHeight;

  // Whether the page is fullscreen, as a video's fullscreen button makes it.
  // The page fills the element's box; the shell decides whether the element
  // fills the screen. `domicile-page-fullscreen-change` signals a change.
  readonly attribute boolean pageFullscreen;

  // Takes the page out of fullscreen, as Escape does. Does nothing when it is
  // not fullscreen.
  undefined exitPageFullscreen();

  // Open DevTools for the page in a new browser window. If DevTools is already
  // open, the <webview> showing it dispatches `domicile-focus-request`.
  undefined inspect();

  // The page's site's permission settings: each permission
  // DomicilePermissionRequestEvent names, mapped to "ask", "allow" or
  // "block". Empty for a page that is not http, https or an extension's.
  // `domicile-site-permissions-change` signals a change.
  record<DOMString, DOMString> sitePermissions();

  // Stores `setting` ("ask", "allow" or "block") for `permission` on the
  // page's site. Throws TypeError for an unknown permission or setting, and
  // InvalidStateError when `sitePermissions()` is empty.
  [RaisesException] undefined setSitePermission(DOMString permission,
                                                DOMString setting);
};
