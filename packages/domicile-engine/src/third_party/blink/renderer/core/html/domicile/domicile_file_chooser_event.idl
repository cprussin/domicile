// Dispatched by a <webview> when its page needs a file picked: an
// `<input type="file">` or a download. The shell answers on the event.
//
// Domicile-only, not a web standard. No constructor: only the browser creates
// one.
[
    RuntimeEnabled=DomicileExternalSurface,
    Exposed=Window
] interface DomicileFileChooserEvent : Event {
  // "open", "open-multiple", "open-folder" or "save". A DOMString, not an IDL
  // enum, as for HTMLWebViewElement's `security`.
  readonly attribute DOMString mode;

  // Accepted extensions, lower case without the dot. Empty accepts anything.
  readonly attribute FrozenArray<DOMString> accept;

  // The suggested name for a save; empty otherwise.
  readonly attribute DOMString suggestedName;

  // The absolute home directory, where a picker starts. The page cannot learn
  // it otherwise.
  readonly attribute DOMString home;

  // Answers with paths, absolute or home-relative, as many as `mode` allows.
  // Throws TypeError for a wrong count or a `..` path, and InvalidStateError
  // if already answered.
  [RaisesException] undefined choose(sequence<DOMString> paths);

  // Answers that nothing was picked.
  [RaisesException] undefined cancel();
};
