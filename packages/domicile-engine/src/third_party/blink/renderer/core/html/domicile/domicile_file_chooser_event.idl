// The event a <webview> dispatches when the page inside it needs a file
// picked -- an `<input type="file">` clicked, or a download that needs
// somewhere to go. See docs/architecture/ENGINE-FORK.md in the Domicile
// repository.
//
// Not a web standard and not proposed as one; it exists in Domicile's engine
// fork only, beside the element that dispatches it. No constructor and no
// event-init dictionary, for the reason DomicileNewWindowEvent has none: only
// the browser process asks for one.
[
    RuntimeEnabled=DomicileExternalSurface,
    Exposed=Window
] interface DomicileFileChooserEvent : Event {
  // "open", "open-multiple", "open-folder" or "save". A DOMString rather than
  // an IDL enum for the reason HTMLWebViewElement's `security` is one: an enum
  // is a generated file per enum, and this element adds none.
  readonly attribute DOMString mode;

  // The extensions the page will take, lower case and without the dot. Empty
  // is anything.
  readonly attribute FrozenArray<DOMString> accept;

  // A save's suggested name, and the empty string otherwise.
  readonly attribute DOMString suggestedName;

  // The absolute home directory: where a picker starts, and what its `~`
  // means. The page has no other way to learn it.
  readonly attribute DOMString home;

  // The answer: paths, absolute or relative to the home directory, as many as
  // `mode` asks for. A wrong count or a path that climbs with `..` is a
  // TypeError; a second answer is an InvalidStateError.
  [RaisesException] undefined choose(sequence<DOMString> paths);

  // The names in the directory at `path` -- absolute or relative to the home,
  // as `choose` takes -- each a directory's ending in `/`, in no order. How a
  // picker reaches what the home's index never found. Rejects with a
  // NotReadableError for a path that is not a directory the browser can read.
  // A path that climbs with `..` is a TypeError, and a chooser already
  // answered an InvalidStateError: the listing is for answering it.
  [CallWith=ScriptState, RaisesException]
  Promise<sequence<DOMString>> list(DOMString path);

  // The other answer: nothing was picked.
  [RaisesException] undefined cancel();
};
