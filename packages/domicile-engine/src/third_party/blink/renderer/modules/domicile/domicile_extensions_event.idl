[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileExtensionsEvent : Event {
  constructor(DOMString type,
              optional DomicileExtensionsEventInit eventInitDict = {});

  // The extensions with an action in this page's profile.
  //
  // The whole tray every time rather than the row that changed, for the
  // clipboard's reason: a page reconciling deltas could be wrong forever after
  // missing one. It arrives once as soon as the page is listening, so a shell
  // that reloaded is told rather than drawing an empty tray.
  //
  // No `arrival`, unlike the compositor's events: an action's state lives in
  // the browser process, and there is no socket read to stamp.
  readonly attribute FrozenArray<DomicileExtension> extensions;
};
