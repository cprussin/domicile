// One icon in the system tray.
//
// An interface rather than a dictionary because WebIDL does not allow
// dictionaries as an attribute's array element type.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileTrayItem {
  // The id DomicileHost.activateTrayItem() takes: the item's bus name and
  // object path together.
  readonly attribute DOMString id;

  // The icon's label: its tooltip title, title or id, whichever the
  // application set first. Never empty.
  readonly attribute DOMString title;

  // The image, as a `data:` URL, or empty if the compositor could not read
  // it. A URL rather than a path because the page cannot read the
  // compositor's files.
  readonly attribute DOMString icon;
};
