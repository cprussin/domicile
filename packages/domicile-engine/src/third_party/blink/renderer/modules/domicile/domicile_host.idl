// navigator.domicile — the shell's control channel to the compositor.
//
// Not a web standard and not proposed as one. It exists in Domicile's engine
// fork, on documents served over domicile://, and nowhere else.
//
// This is the typed surface rather than a message pipe: the page calls methods
// and listens for events, and the wire protocol lives in the browser process.
// The reason is that the protocol carries Spawn, and a page that cannot
// construct a message cannot construct a malformed one. The cost, which is
// real, is that adding a message means an engine release rather than editing a
// TypeScript file.
//
[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel,
    SecureContext
] interface DomicileHost : EventTarget {
  // Run a command on the machine running the desktop.
  //
  // Sequence<DOMString> rather than a single string: splitting a command line
  // is a shell's job and there is no shell in this path.
  [CallWith=ScriptState, RaisesException] undefined spawn(sequence<DOMString> command);

  // Ask what in the home matches `query`. Resolves with the answer, and also
  // dispatches it as a `files` event carrying the same query. A newer call
  // supersedes this one, which rejects with an AbortError: a launcher wants
  // the answer to what is typed now.
  //
  // IT TAKES NO PATH, AND THAT IS THE POINT RATHER THAN AN OVERSIGHT. A shell
  // is served over domicile:// so that it has an origin without a TCP port,
  // not so that it gets a filesystem. A call that named a directory would be
  // one, and every document this engine serves would have it. What gets
  // searched is the compositor's decision -- see `domicile_host::file_search`
  // -- and the query is only words to match.
  //
  // ONLY WHAT MATCHED CROSSES. The compositor's index is the whole home; a
  // page handed that to filter was a desktop that took no input while it
  // arrived.
  [CallWith=ScriptState, RaisesException] Promise<DomicileFileSearch> searchFiles(DOMString query);

  // Ask what is in one file. Resolves with the answer, and also dispatches it
  // as a `filepreview` event carrying the same path. A newer call supersedes
  // this one, as with searchFiles().
  //
  // THIS ONE TAKES A PATH, which searchFiles() above says is the point of not
  // taking one -- so what it may name is narrow: a path relative to the home,
  // as a `files` event named it (a directory without its trailing `/`). The
  // compositor answers only for a path in its own index of the home, and
  // anything else comes back "unreadable", so this reads nothing a search
  // could not already have named.
  [CallWith=ScriptState, RaisesException] Promise<DomicileFilePreview> previewFile(DOMString path);

  // Ask which installed applications match `query`. Resolves with the answer,
  // and also dispatches it as an `apps` event carrying the same query. A newer
  // call supersedes this one, as with searchFiles().
  //
  // Words, like searchFiles(): which directories hold the desktop entries is
  // the compositor's to read, and each entry comes back with the argv to hand
  // to spawn(), so nothing on the page parses an Exec line.
  [CallWith=ScriptState, RaisesException] Promise<DomicileAppSearch> searchApps(DOMString query);

  // A system call: a file, a directory, a watch or a process. `request` is
  // the call as JSON, such as `{"call":"read_file","path":"/sys/x"}`. Answered
  // with `system` events whose `data` carries `id`. The compositor checks
  // every call, the lock included. See docs/architecture/SYSTEM-ACCESS.md and
  // the SDK's `system` module, which is the way to call this.
  [CallWith=ScriptState, RaisesException] undefined callSystem(
      unsigned long id, DOMString request);

  // Put a row of the clipboard's history back on the clipboard.
  //
  // IT NAMES A ROW AND CARRIES NO TEXT: a shell is served over domicile:// so
  // that it has an origin, not so that it gets the machine, and a call that
  // took bytes would let this document write the desktop's clipboard rather
  // than choose among what has already been copied on it. `entry` is an id a clipboard event
  // carried.
  //
  // No answer, and none to want: what follows is that the next paste in any
  // window is that row, served by the compositor rather than by whichever
  // client first copied it -- which is the whole of what a clipboard manager
  // is for. An id the history has since dropped sets nothing.
  [CallWith=ScriptState, RaisesException] undefined copyClipboardEntry(unsigned long entry);

  // Click an icon in the system tray, with the button `action` names.
  //
  // It names an icon a `tray` event carried and a button, and nothing about
  // what the click does, for copyClipboardEntry's reason: that is the
  // application's. An id that names no icon now is a click that raced the
  // application going away, and does nothing; an empty one throws.
  [CallWith=ScriptState, RaisesException] undefined activateTrayItem(
      DOMString id, DomicileTrayAction action);

  // Clear notifications: ids a `notifications` event carried. Each
  // application hears its notification was dismissed, and the next
  // `notifications` event is without them. An id already gone is passed over.
  [CallWith=ScriptState, RaisesException] undefined dismissNotifications(
      sequence<unsigned long> ids);

  // Press one of a notification's actions -- "default" for the notification
  // itself. It names a notification and a key it offered, and nothing about
  // what the press does, for copyClipboardEntry's reason: that is the
  // application's. An empty action throws.
  [CallWith=ScriptState, RaisesException] undefined invokeNotificationAction(
      unsigned long id, DOMString action);

  // Which window has the keyboard. focusChrome() takes it back to the page.
  [CallWith=ScriptState, RaisesException] undefined focusApp(DOMString appId);
  [CallWith=ScriptState, RaisesException] undefined focusChrome();

  // Put the pointer at a place in this page, in the page's own coordinates --
  // the ones a PointerEvent reports as clientX/clientY.
  //
  // THE COMPANION TO MOVING THE KEYBOARD. A desktop whose focus follows the
  // cursor has to take the cursor with it when a key moves the focus, or the
  // next pointer event hands the focus back to whatever the pointer is still
  // over. Every other compositor does this itself; here the shell is a page,
  // and a page can read where the pointer is and cannot put it anywhere.
  //
  // Doubles for resizeApp's reason: a place in a page is a CSS pixel and a CSS
  // pixel is fractional. A coordinate outside this page is clamped to its own
  // box -- what a page may move is the pointer over itself -- and NaN throws.
  [CallWith=ScriptState, RaisesException] undefined warpPointer(
      double x, double y);

  // Ask a client to close. Not a kill -- the client decides, which is why a
  // window can refuse and show a save dialog instead.
  [CallWith=ScriptState, RaisesException] undefined closeApp(DOMString appId);

  // The layout box, as a resize. For an <app> the box IS the configure.
  //
  // Doubles because a CSS pixel is fractional and this comes from a layout box.
  [CallWith=ScriptState, RaisesException] undefined resizeApp(
      DOMString appId, double width, double height);

  // Where the page put an <app>, in the page's CSS pixels. The client draws at
  // the scale of the monitor holding most of that box. Layout still places the
  // window; this only tells the compositor where it ended up.
  [CallWith=ScriptState, RaisesException] undefined setAppBounds(
      DOMString appId, double x, double y, double width, double height);

  // Draw the desktop the other way round.
  //
  // THE ONE CALL HERE THAT SAYS WHAT THE DESKTOP IS rather than asking it for
  // something. It reaches the compositor and comes back as a `theme` event --
  // to every chrome on the desk, this one included, which is why a shell
  // renders from the event rather than from its own click. Three monitors are
  // three pages and the toggle is on one of them.
  //
  // It has to leave the page at all because the compositor is the only process
  // the desk's CLIENTS can hear: it answers the settings portal GTK, Qt and
  // Electron read a color scheme from, out of this same value. A theme kept in
  // the renderer would be a desktop whose panels went dark and whose windows
  // stayed light.
  //
  // A DomicileTheme rather than a DOMString, so a word that is not one of the
  // two is refused at the call instead of at the socket -- see
  // domicile_theme.idl.
  [CallWith=ScriptState, RaisesException] undefined setTheme(
      DomicileTheme theme);

  // Offer a passphrase at a locked desk.
  //
  // THE WAY OUT OF THE ONE STATE THIS PAGE CANNOT CHANGE BY DRAWING. While the
  // desk is locked the compositor puts nothing this page forwards into the
  // Wayland seat -- no client sees a keystroke or a click -- and this call is
  // the only thing that ends it. The page keeps its own keys throughout, which
  // is what makes a lock screen possible: it is the thing forwarding, so it can
  // take a passphrase while nothing it forwards arrives anywhere.
  //
  // ANSWERED WITH A `locked` EVENT AND NOT WITH A RETURN VALUE, and only when
  // the desk actually opened. A wrong passphrase produces nothing at all: the
  // compositor says so in its own log, without the passphrase in it. A page
  // that cleared its own lock screen because it believed its own keystrokes
  // would be a lock anybody with the devtools could open -- and the event goes
  // to every chrome on the desk rather than to this one, because three monitors
  // are three pages and the desk they draw has one lock.
  [CallWith=ScriptState, RaisesException] undefined unlock(DOMString passphrase);

  // Lock the desk now, whoever is at it. Answered like unlock(): with a
  // `locked` event to every chrome, and only when the desk actually shut.
  [CallWith=ScriptState, RaisesException] undefined lock();

  // Set the screen's backlight to `level`, 0.0 through 1.0.
  //
  // A request, like setTheme(): answered with `brightnesschanged` to every
  // chrome once the backlight has moved, so a slider follows the desk rather
  // than its own drag. `double` rather than `unrestricted double`, so a level
  // that is not a number throws here instead of reaching the compositor.
  [CallWith=ScriptState, RaisesException] undefined setBrightness(
      double level);

  // The mixer: set a device's or a stream's volume, a fraction of the sound
  // server's 100%; mute it; make a device the default; move a stream to
  // another device; switch a device's port or a card's profile. Each names
  // what it acts on by an id an `audio` event carried, and each is a request
  // like setBrightness(): answered with the next `audio` to every chrome. An
  // id the compositor never gave out does nothing but say so in its log.
  [CallWith=ScriptState, RaisesException] undefined setAudioVolume(
      DOMString id, double volume);
  [CallWith=ScriptState, RaisesException] undefined setAudioMuted(
      DOMString id, boolean muted);
  [CallWith=ScriptState, RaisesException] undefined setDefaultAudioDevice(
      DOMString id);
  [CallWith=ScriptState, RaisesException] undefined moveAudioStream(
      DOMString id, DOMString device);
  [CallWith=ScriptState, RaisesException] undefined setAudioPort(
      DOMString id, DOMString port);
  [CallWith=ScriptState, RaisesException] undefined setAudioProfile(
      DOMString card, DOMString profile);

  // Meter these devices and streams, by the ids an `audio` event carried,
  // and fire `audiolevels` with their peaks. A lease: call it again every
  // second while the meters are on screen; an empty list lets go at once.
  [CallWith=ScriptState, RaisesException] undefined watchAudioLevels(
      sequence<DOMString> ids);

  // This page's old frame is held for `theme`: turn the desk's windows now.
  //
  // Called from inside a shell's wipe, once the frame it wipes away from is
  // captured, so that the wipe passes across windows that turn inside it
  // rather than over windows that had already turned. Answered with a
  // `windowstheme` event once every chrome has called it and the windows have
  // had their chance to repaint -- or once the compositor stopped waiting.
  [CallWith=ScriptState, RaisesException] undefined themeCaptured(
      DomicileTheme theme);

  // Route a key combination to the page rather than to the focused client.
  //
  // The press comes back as a `shortcut` event carrying the same fields, so a
  // shell compares what it grabbed against what fired without parsing a string.
  [CallWith=ScriptState, RaisesException] undefined grabShortcut(
      DomicileShortcut shortcut);

  // The same, by name: `grabShortcut("Meta+Shift+l")`, in sway's grammar. The
  // engine finds the key the keysym is on, from the keyboard the compositor
  // describes, and finds it again whenever the layout changes. The press comes
  // back as a `shortcut` event whose `chord` is this string -- pressed in a
  // `<webview>` or on this page, where it is taken from the page.
  //
  // Throws a SyntaxError for a chord written wrong, and a NotFoundError for a
  // keysym the keyboard cannot type; before any keyboard is described, that
  // one is a console warning once it is.
  [CallWith=ScriptState, RaisesException] undefined grabShortcut(
      DOMString chord);

  // Click an extension's action, popup or not: the extension is granted
  // activeTab on the active tab, as a toolbar click grants it in Chrome. Then
  // an action with no popup has its `action.onClicked` dispatched; one with a
  // popup is the shell's to open, as a <webview> at the `popup` an
  // `extensions` event named, and is opened after this call.
  //
  // NOT THE COMPOSITOR'S. An action lives in this browser, so the call goes no
  // further than the browser process, over the tray's own pipe -- see
  // components/domicile/mojom/extension_tray.mojom. An id that names no
  // extension with an action now is a click that raced an uninstall, and does
  // nothing; an empty one throws.
  [CallWith=ScriptState, RaisesException] undefined activateExtension(
      DOMString id);

  // Input forwarding. Surface-local coordinates and evdev keycodes, because
  // that is what a Wayland client expects to be handed.
  [CallWith=ScriptState, RaisesException] undefined key(
      DOMString appId, unsigned long keycode, boolean pressed);
  [CallWith=ScriptState, RaisesException] undefined pointerMotion(
      DOMString appId, double x, double y);
  [CallWith=ScriptState, RaisesException] undefined pointerLeave(
      DOMString appId);
  [CallWith=ScriptState, RaisesException] undefined pointerButton(
      DOMString appId, unsigned long button, boolean pressed);
  [CallWith=ScriptState, RaisesException] undefined pointerAxis(
      DOMString appId, double dx, double dy, long v120X, long v120Y);

  // A window's title changed. `event.appId` is the id an <app> element names,
  // so a shell can put a title on the frame it already drew.
  attribute EventHandler onapptitled;

  // A window exists. `size` is absent until the client has committed a buffer:
  // a toplevel maps before it draws. A shell that believes a zero here opens
  // the window at nothing at all.
  attribute EventHandler onappappeared;
  attribute EventHandler onappresized;

  // The smallest and largest a client will draw its window, as `width` and
  // `height` in CSS pixels, with 0 on an axis for no limit -- xdg-shell's
  // `set_min_size` and `set_max_size`. A box outside them gets a frame that
  // does not fill it.
  attribute EventHandler onappminsize;
  attribute EventHandler onappmaxsize;

  // A client opened a popup -- a menu, a tooltip -- over one of its windows,
  // or moved one. An <app> of its own, placed at `x`, `y` from the box of
  // `parentAppId` rather than laid out, and gone with `appclosed`.
  attribute EventHandler onpopupplaced;
  attribute EventHandler onappclosed;
  attribute EventHandler onappcursor;

  // A grabbed shortcut fired, as a DomicileShortcutEvent.
  attribute EventHandler onshortcut;

  // Which modifiers the seat holds, as a DomicileModifiersEvent. One seat,
  // outliving every window.
  attribute EventHandler onmodifiers;

  // What a searchFiles() found, as a DomicileFilesEvent. Only ever an answer.
  attribute EventHandler onfiles;

  // What a previewFile() found, as a DomicileFilePreviewEvent. Only ever an
  // answer.
  attribute EventHandler onfilepreview;

  // What a searchApps() found, as a DomicileAppsEvent. Only ever an answer.
  attribute EventHandler onapps;

  // The machine's battery, as a DomicileBatteryEvent.
  //
  // NO listBattery() TO GO WITH IT: a charge is one reading, so a page that
  // has just loaded is caught up by the next push without having to ask. It
  // arrives when the reading moves far enough to draw, and once more to a page
  // that has only just connected.
  attribute EventHandler onbattery;

  // How bright the screen is, 0.0 through 1.0.
  //
  // An attribute rather than an event payload, like `displays`: a slider that
  // mounts long after the reading arrived reads it here. NULL on a machine
  // with no backlight, which never sends one, and until the first reading.
  readonly attribute double? brightness;

  // The brightness moved. Read `brightness` for where it is now.
  attribute EventHandler onbrightnesschanged;

  // Which way round the desktop is drawn, as a DomicileThemeEvent.
  //
  // Pushed like onbattery, and the one pushed event this page can cause:
  // setTheme() above is answered with it. It also arrives on connecting -- so
  // a shell paints in the desk's theme rather than painting and flipping --
  // and whenever a reload of the compositor's config moves `[theme]`.
  //
  // NOT `prefers-color-scheme`, which is the media query this looks like it
  // duplicates. That answers out of this engine's own notion of a system
  // preference, and under Domicile there is no system above the desktop to
  // have one. The theme is the compositor's, and this is how it arrives.
  attribute EventHandler ontheme;

  // Which way round the desk's windows are drawn, as a DomicileThemeEvent.
  //
  // `theme`'s other half: it arrives once the windows have turned for a
  // theme every chrome called themeCaptured() for, and on connecting. This
  // engine draws its own pages -- the sites in browser windows -- that way
  // before the event is dispatched.
  attribute EventHandler onwindowstheme;

  // What has been copied on this desktop, as a DomicileClipboardEvent.
  //
  // Pushed like onbattery: the compositor is the process a
  // wl_data_device.set_selection arrives at, so it hears a copy without
  // anybody asking. It arrives whenever the history changes, and once more to
  // a page that has only just connected.
  attribute EventHandler onclipboard;

  // Whether anybody is at this desktop, as a DomicileIdleEvent.
  //
  // Pushed like onbattery, and for a reason no page can work around: a shell
  // IS the desktop, so its document stays visible while the glass is off --
  // the compositor turns the connector off underneath the browser, which is
  // told nothing about it. document.visibilityState, the Idle Detection API
  // and every timer a page could run all read "somebody is here" on a desk
  // nobody has been at for an hour. The hands are counted in the compositor
  // because that is what every key and every pointer movement goes through.
  //
  // It arrives on the turn the answer changes, and once more to a page that
  // has only just connected -- which is why it carries where the desk stands
  // rather than which way it just went. A desktop with no idle timeout
  // configured never fires one.
  attribute EventHandler onidle;

  // Whether this desk is locked, as a DomicileLockedEvent.
  //
  // Pushed like onidle, and the state it carries is the one thing about this
  // desktop a page can neither read nor change for itself: the compositor is
  // what injects forwarded input into the seat, so a locked desk is that
  // injection not happening. It arrives on the turn the answer changes and once
  // more to a page that has only just connected -- which is the whole point,
  // because a reload is exactly what must not open the desk. A desktop with no
  // passphrase configured never fires one.
  attribute EventHandler onlocked;

  // Focus moved. `appId` is empty when the chrome itself has it.
  attribute EventHandler onfocuschanged;

  // A client asked for the keyboard; nothing has moved. The shell answers by
  // calling focusApp(), or does not, which refuses it.
  attribute EventHandler onfocusrequested;

  // The screens of the desktop.
  //
  // An attribute rather than an event payload, because the desktop is a fact
  // and not a stream. A shell reads this when it needs it -- including a
  // component that mounts long after the description arrived, which an event
  // would have left with nothing.
  //
  // NULL UNTIL THE COMPOSITOR HAS DESCRIBED THE DESKTOP, and an empty array
  // for a desktop with no screens on it. They are different states and a shell
  // renders them differently: nothing at all is what an unknown screen shows,
  // which is the right answer for "there is no such screen" and the wrong one
  // for "wait". `domicile-protocol` carries that distinction deliberately --
  // an empty `Vec` that serializes to nothing and one that serializes to `[]`
  // both come back empty, and only the second is a desktop a shell can parse
  // -- and an attribute that started empty threw it away again here.
  //
  // The compositor describes at least one output, so it does not send the
  // empty one; the `domicile` daemon, which no desktop has been described to,
  // does. Leaning on "in practice it never happens" is what made the SDK guess,
  // and this is instead of the guess.
  //
  // No [SameObject]: the compositor sends the whole desktop each time it
  // changes and a FrozenArray is frozen, so this is a different array after
  // every `displayschanged`. That is also the shape a shell wants -- an
  // identity that survived a desktop it no longer describes would be worse.
  readonly attribute FrozenArray<DomicileDisplay>? displays;

  // The desktop changed: a screen arrived or left, a display was resized, or
  // its density moved. Read `displays` for what it is now.
  attribute EventHandler ondisplayschanged;

  // Every client window on the desktop, in the order they appeared: what the
  // compositor has said about each so far. Reading it binds the channel, and
  // the compositor announces the windows already running as it does, so a
  // shell that reads late misses nothing -- it reads, then listens for
  // `windowschanged`. A different array after every change, for `displays`'s
  // reason.
  readonly attribute FrozenArray<DomicileWindow> windows;

  // A window appeared, closed, or changed: its title, size, limits, cursor or
  // popup placement. Read `windows` for what they are now.
  attribute EventHandler onwindowschanged;

  // The window holding the keyboard, or null when the shell's page holds it.
  readonly attribute DOMString? focusedWindow;

  // The compositor said where the keyboard is: `focusedWindow` may have
  // changed. Every time, and once after the windows already running are
  // replayed to a page that has just connected -- which is how a page tells a
  // window opened now from one that was running.
  attribute EventHandler onfocusedwindowchanged;

  // THE DESK'S STATE, AS ATTRIBUTES. Each is what the compositor last said,
  // null until it has said anything, and a bare `<name>changed` event says it
  // moved: a shell reads, then listens, and one that listens late misses
  // nothing. The events that carry the same payloads still fire for now; see
  // docs/architecture/WINDOW-DOMICILE.md.
  readonly attribute FrozenArray<DomicileClipboardEntry>? clipboard;
  attribute EventHandler onclipboardchanged;
  readonly attribute FrozenArray<DomicileTrayItem>? tray;
  attribute EventHandler ontraychanged;
  readonly attribute FrozenArray<DomicileNotification>? notifications;
  attribute EventHandler onnotificationschanged;
  readonly attribute FrozenArray<DomicileExtension>? extensions;
  attribute EventHandler onextensionschanged;
  readonly attribute FrozenArray<DomicileAudioDevice>? audioOutputs;
  readonly attribute FrozenArray<DomicileAudioDevice>? audioInputs;
  readonly attribute FrozenArray<DomicileAudioStream>? audioPlayback;
  readonly attribute FrozenArray<DomicileAudioStream>? audioRecording;
  readonly attribute FrozenArray<DomicileAudioCard>? audioCards;
  attribute EventHandler onaudiochanged;
  readonly attribute double? batteryCharge;
  readonly attribute boolean? batteryCharging;
  attribute EventHandler onbatterychanged;
  readonly attribute boolean? idle;
  attribute EventHandler onidlechanged;
  readonly attribute boolean? locked;
  attribute EventHandler onlockedchanged;
  readonly attribute DomicileTheme? theme;
  attribute EventHandler onthemechanged;
  readonly attribute DomicileTheme? windowsTheme;
  attribute EventHandler onwindowsthemechanged;
  // The compositor seat's modifiers -- only the keys forwarded to a client;
  // see @domicile-desktop/sdk's README before trusting them over a page's
  // own key events.
  readonly attribute boolean? altKey;
  readonly attribute boolean? ctrlKey;
  readonly attribute boolean? shiftKey;
  readonly attribute boolean? metaKey;
  attribute EventHandler onmodifierschanged;

  // The extensions with an action, as a DomicileExtensionsEvent: the whole
  // tray, whenever any of it changes and once as soon as this page listens.
  //
  // THE BROWSER'S, NOT THE COMPOSITOR'S. The extensions are the desk's config,
  // installed by this browser into its profile, and what their actions say is
  // this browser's to tell -- so it arrives over a pipe of its own rather than
  // the compositor's socket.
  attribute EventHandler onextensions;

  // The system tray, as a DomicileTrayEvent: every application showing an
  // icon, whenever any of it changes and once more when this page connects.
  attribute EventHandler ontray;

  // The shell's part of the desk's config, as a DomicileShellConfigEvent: its
  // keybindings and its options, as the JSON line the compositor sent. Pushed
  // like ontheme -- once more to a page that has only just connected, and again
  // whenever a reload of the compositor's config moved what it carries.
  attribute EventHandler onshellconfig;

  // The desk's sound, as a DomicileAudioEvent: every device, stream and card,
  // whenever the sound server says something moved and once more when this
  // page connects. Never on a desk with no sound server.
  attribute EventHandler onaudio;

  // How loud what watchAudioLevels() asked for is, as a
  // DomicileAudioLevelsEvent: some twenty times a second while anything is
  // metered.
  attribute EventHandler onaudiolevels;

  // The desk's notifications, as a DomicileNotificationsEvent: every one not
  // yet cleared, whenever any of them changes and once more when this page
  // connects.
  attribute EventHandler onnotifications;
  // The desk's browser windows, oldest first. Null until the browser lists
  // them, which it does as soon as this page listens. The browser holds each
  // page; draw one with `<webview window="id">`. A shell loaded over this one
  // gets the same windows and pages. See
  // components/domicile/mojom/browser_windows.mojom.
  //
  // A window a program opens (`domicile open-url`, a page's target="_blank",
  // an extension) appears here in the next `browserwindowschanged`. No
  // [SameObject], for `displays`' reason.
  readonly attribute FrozenArray<DomicileBrowserWindow>? browserWindows;

  // Fires when a window opens, closes, navigates or changes title. Read
  // `browserWindows` for the current list.
  attribute EventHandler onbrowserwindowschanged;

  // Opens a browser window at `url`, for the shell's own UI such as a `+`
  // button or a launcher. It appears in the next `browserwindowschanged`. A
  // domicile:// address shows blocked, as in a <webview>.
  [CallWith=ScriptState, RaisesException] undefined openBrowserWindow(
      USVString url);

  // Closes window `id`; it leaves the next `browserwindowschanged`. An unknown
  // id does nothing.
  [CallWith=ScriptState, RaisesException] undefined closeBrowserWindow(
      DOMString id);

  // An answer to callSystem(), as a MessageEvent whose `data` is the
  // compositor's `system_reply`, `system_event` or `system_end` line.
  attribute EventHandler onsystem;
};
