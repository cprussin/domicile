// An application from a desktop entry, as a launcher shows and runs it.
//
// An interface because WebIDL does not allow a dictionary as an attribute's
// array element type.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileDesktopEntry {
  // The desktop file ID: its path under `applications/`, `/` read as `-`.
  readonly attribute DOMString id;

  // `Name`, unlocalized.
  readonly attribute DOMString name;

  // `Comment`, or empty for an entry that has none.
  readonly attribute DOMString comment;

  // `Exec` as an argv, unquoted and with field codes removed by the
  // compositor. Pass it to DomicileHost.spawn().
  readonly attribute FrozenArray<DOMString> command;

  // The entry's icon as a `data:` URL, or empty if the compositor found none.
  // A URL, not a path, because the page cannot read the file itself.
  readonly attribute DOMString icon;

  // The entry's `X-Domicile-Preview` image for a launcher, as a `data:` URL,
  // or empty.
  readonly attribute DOMString preview;
};
