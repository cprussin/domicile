// A phase of a touchpad gesture claimed with grabGesture().
//
// Its own type, like DomicileShortcutEvent: a gesture belongs to no window.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileGestureEvent : Event {
  constructor(DOMString type,
              optional DomicileGestureEventInit eventInitDict = {});

  // `swipe`, `pinch` or `hold`.
  readonly attribute DOMString kind;

  // `begin`, `update` or `end`.
  readonly attribute DOMString phase;

  readonly attribute unsigned long fingers;

  // This update's motion, in the touchpad's accelerated pointer units.
  readonly attribute double dx;
  readonly attribute double dy;

  // A pinch's scale relative to its begin, and this update's rotation in
  // degrees clockwise.
  readonly attribute double scale;
  readonly attribute double rotation;

  // On an end: the gesture was abandoned rather than finished.
  readonly attribute boolean canceled;
};
