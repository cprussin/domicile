[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileAudioEvent : Event {
  constructor(DOMString type,
              optional DomicileAudioEventInit eventInitDict = {});

  // The full audio state, each list in the sound server's order. Sent whole,
  // so a page never applies deltas.
  //
  // The compositor reads it with `pactl` because a page cannot reach the sound
  // server's socket. Sent on every change and once when a page connects. No
  // sound server means no event.
  readonly attribute FrozenArray<DomicileAudioDevice> outputs;
  readonly attribute FrozenArray<DomicileAudioDevice> inputs;
  readonly attribute FrozenArray<DomicileAudioStream> playback;
  readonly attribute FrozenArray<DomicileAudioStream> recording;
  readonly attribute FrozenArray<DomicileAudioCard> cards;

  // When the browser process received the message, on `performance.now()`'s
  // clock. See DomicileAppEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
