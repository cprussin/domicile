[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileAudioEvent : Event {
  constructor(DOMString type,
              optional DomicileAudioEventInit eventInitDict = {});

  // The desk's sound, each list in the sound server's order and the whole of
  // it every time, for DomicileNotificationsEvent.items' reason.
  //
  // THE COMPOSITOR'S, because the sound server is a socket a page cannot
  // reach: it reads the server with `pactl` and pushes this whenever
  // something a mixer draws moves, and once more to a page that has just
  // connected. A desk with no sound server sends none.
  readonly attribute FrozenArray<DomicileAudioDevice> outputs;
  readonly attribute FrozenArray<DomicileAudioDevice> inputs;
  readonly attribute FrozenArray<DomicileAudioStream> playback;
  readonly attribute FrozenArray<DomicileAudioStream> recording;
  readonly attribute FrozenArray<DomicileAudioCard> cards;

  // When the browser process had this message, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival for what this is and what it is not.
  readonly attribute DOMHighResTimeStamp arrival;
};
