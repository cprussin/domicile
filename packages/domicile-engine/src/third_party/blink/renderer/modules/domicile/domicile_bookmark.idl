// A named URL from the desktop's config.
//
// An interface because WebIDL does not allow a dictionary as an attribute's
// array element type.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileBookmark {
  // The label a launcher shows.
  readonly attribute DOMString name;

  // The URL to open. The shell opens it itself.
  readonly attribute DOMString url;

  // The site's icon as a `data:` URL the compositor fetched, or empty if none
  // was found.
  readonly attribute DOMString icon;
};
