dictionary DomicileGestureEventInit : EventInit {
  DOMString kind = "swipe";
  DOMString phase = "begin";
  unsigned long fingers = 0;
  double dx = 0;
  double dy = 0;
  double scale = 1;
  double rotation = 0;
  boolean canceled = false;
};
