// What `DomicileHost.searchApps()` resolves with.
dictionary DomicileAppSearch {
  // The applications the query matched, best first. Empty is a query that
  // matched nothing, which is an answer.
  sequence<DomicileDesktopEntry> apps = [];
  // The desk's bookmarks the query matched, best first.
  sequence<DomicileBookmark> bookmarks = [];
};
