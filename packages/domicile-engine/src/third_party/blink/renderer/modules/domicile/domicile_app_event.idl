[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileAppEvent : Event {
  constructor(DOMString type, optional DomicileAppEventInit eventInitDict = {});

  readonly attribute DOMString appId;
  readonly attribute DOMString title;

  // When the browser process received the message, on `performance.now()`'s
  // clock. `timeStamp - arrival` measures the IPC to this renderer. See
  // components/domicile/mojom/control_channel.mojom.
  readonly attribute DOMHighResTimeStamp arrival;

  // False until the client commits a buffer. Ignore width and height until
  // then.
  readonly attribute boolean hasSize;
  readonly attribute double width;
  readonly attribute double height;

  // `popupplaced` only: the parent window or popup, the offset from its
  // top-left in CSS pixels, and whether the popup grabs input (menus do,
  // tooltips do not). Empty, zero and false on other events.
  readonly attribute DOMString parentAppId;
  readonly attribute double x;
  readonly attribute double y;
  readonly attribute boolean grab;
};
