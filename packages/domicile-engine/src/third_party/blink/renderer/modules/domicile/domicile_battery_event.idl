[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileBatteryEvent : Event {
  constructor(DOMString type,
              optional DomicileBatteryEventInit eventInitDict = {});

  // Charge level, 0.0 to 1.0.
  //
  // A fraction, so a shell rounds once where it draws and its label and meter
  // agree.
  //
  // Use this instead of navigator.getBattery(). That API reads UPower over
  // D-Bus, which a bare tty lacks, and Chromium then reports its default of
  // charging and full, which looks real. The compositor reads
  // /sys/class/power_supply, which needs no daemon.
  readonly attribute double charge;

  // Whether AC power is connected. True on AC even when full: a shell draws a
  // plug, not a charge rate.
  readonly attribute boolean charging;

  // When the browser process received this message, on `performance.now()`'s
  // clock. See DomicileAppEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
