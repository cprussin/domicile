[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileModifiersEvent : Event {
  constructor(DOMString type,
              optional DomicileModifiersEventInit eventInitDict = {});

  // Which modifiers are held, under the web's names. The compositor has
  // already resolved xkb's depressed/latched/locked against the keymap; a mask
  // would hand the shell a number it cannot read without the keymap too.
  readonly attribute boolean altKey;
  readonly attribute boolean ctrlKey;
  readonly attribute boolean shiftKey;
  readonly attribute boolean metaKey;
};
