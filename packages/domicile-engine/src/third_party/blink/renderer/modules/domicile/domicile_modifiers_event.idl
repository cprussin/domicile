[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileModifiersEvent : Event {
  constructor(DOMString type,
              optional DomicileModifiersEventInit eventInitDict = {});

  // xkb's four, meaning what xkb says they mean.
  readonly attribute unsigned long depressed;
  readonly attribute unsigned long latched;
  readonly attribute unsigned long locked;
  readonly attribute unsigned long group;
};
