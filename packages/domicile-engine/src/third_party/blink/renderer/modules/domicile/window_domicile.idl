[
    ImplementedAs=WindowDomicile,
    RuntimeEnabled=DomicileControlChannel,
    SecureContext
] partial interface Window {
  // `navigator.domicile`, by its other spelling: one object, and one handover
  // between the two -- whichever is read first answers, and every read after
  // either is null.
  readonly attribute DomicileHost? domicile;
};
