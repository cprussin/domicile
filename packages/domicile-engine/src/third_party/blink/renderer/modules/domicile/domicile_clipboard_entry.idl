// One clipboard history entry.
//
// An interface because WebIDL does not allow a dictionary as an attribute's
// array element type.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileClipboardEntry {
  // The id DomicileHost.copyClipboardEntry() takes.
  //
  // Assigned by the compositor and never reused, so a stale id matches
  // nothing. Not a position: reordering keeps every id.
  readonly attribute unsigned long id;

  // A preview for display, possibly truncated to one row.
  //
  // Copying the entry back restores the full content. The content stays in the
  // compositor and the page sees only this preview, which matters for copied
  // passwords.
  readonly attribute DOMString preview;
};
