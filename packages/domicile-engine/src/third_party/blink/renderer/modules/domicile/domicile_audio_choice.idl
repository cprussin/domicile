// A port of a DomicileAudioDevice, or a profile of a DomicileAudioCard:
// something to switch it to.
//
// An interface rather than a dictionary for DomicileTrayItem's reason: these
// are read off a device's or a card's array.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileAudioChoice {
  // What DomicileHost.setAudioPort() and setAudioProfile() name it by.
  readonly attribute DOMString name;

  readonly attribute DOMString description;

  // False for a port whose jack is empty, or a profile that needs one. Still
  // choosable, as every mixer lets it be.
  readonly attribute boolean available;
};
