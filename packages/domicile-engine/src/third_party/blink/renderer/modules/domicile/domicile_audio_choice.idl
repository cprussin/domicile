// A selectable port of a DomicileAudioDevice or profile of a
// DomicileAudioCard. An interface because WebIDL does not allow dictionaries as
// an attribute's array element type.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileAudioChoice {
  // The name passed to DomicileHost.setAudioPort() or setAudioProfile().
  readonly attribute DOMString name;

  readonly attribute DOMString description;

  // False for an unplugged port or a profile that needs one. Still
  // selectable, as in other mixers.
  readonly attribute boolean available;
};
