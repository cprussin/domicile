// One meter of a DomicileAudioLevelsEvent.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileAudioLevel {
  // The DomicileAudioDevice or DomicileAudioStream id it meters.
  readonly attribute DOMString id;

  // The loudest sample since the last event, 0.0 through 1.0 of full scale.
  // Linear: a meter draws it in decibels if it likes.
  readonly attribute double peak;
};
