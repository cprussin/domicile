[
    ImplementedAs=NavigatorDomicile,
    RuntimeEnabled=DomicileControlChannel,
    SecureContext
] partial interface Navigator {
  // The desktop, for the document Domicile writes to hand to the shell it
  // calls -- `Shell(root, domicile)`. Answered once per document: every read
  // after the first is null, so a shell keeps what it was handed rather than
  // reaching for a global. See NavigatorDomicile.
  readonly attribute DomicileHost? domicile;
};
