[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileAppsEvent : Event {
  constructor(DOMString type,
              optional DomicileAppsEventInit eventInitDict = {});

  // The query this answers, as DomicileHost.searchApps() was given it.
  readonly attribute DOMString query;

  // The applications the query matched, best first. An empty array is a query
  // that matched nothing, which is an answer.
  readonly attribute FrozenArray<DomicileDesktopEntry> apps;

  // When the browser process had this message, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival for what this is and what it is not.
  readonly attribute DOMHighResTimeStamp arrival;
};
