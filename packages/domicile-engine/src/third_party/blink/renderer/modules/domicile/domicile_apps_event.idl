[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileAppsEvent : Event {
  constructor(DOMString type,
              optional DomicileAppsEventInit eventInitDict = {});

  // The query passed to DomicileHost.searchApps().
  readonly attribute DOMString query;

  // Matching applications, best first. Empty if none matched.
  readonly attribute FrozenArray<DomicileDesktopEntry> apps;

  // Matching bookmarks, best first.
  readonly attribute FrozenArray<DomicileBookmark> bookmarks;

  // When the browser process received the message, on `performance.now()`'s
  // clock. See DomicileAppEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
