// A combination grabbed with grabShortcut() was pressed.
//
// Its own type because a shortcut belongs to no window: it fires regardless of
// which window has keyboard focus.
//
// Fires on press only, so one keystroke is one event.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileShortcutEvent : Event {
  constructor(DOMString type,
              optional DomicileShortcutEventInit eventInitDict = {});

  // The chord as the shell grabbed it -- `Meta+Shift+l` -- or empty for one
  // grabbed as a keycode. See DomicileHost.grabShortcut().
  readonly attribute DOMString chord;

  // The Linux evdev code, the same numbering key() forwards in.
  readonly attribute unsigned long keycode;

  readonly attribute boolean altKey;
  readonly attribute boolean ctrlKey;
  readonly attribute boolean shiftKey;
  readonly attribute boolean metaKey;

  // When the browser process received this, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
