// The event behind DomicileHost.onappcursor.
//
// Separate from DomicileAppEvent so `cursor` is always a valid shape, with no
// sentinel for events that carry none.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileAppCursorEvent : Event {
  constructor(DOMString type, optional DomicileAppCursorEventInit eventInitDict = {});

  // The window, as named by an <app>'s app-id.
  readonly attribute DOMString appId;

  // The CSS `cursor` keyword to show over the window.
  readonly attribute DomicileCursorShape cursor;

  // When the browser process received the message, on `performance.now()`'s
  // clock. `timeStamp - arrival` measures the IPC to this renderer. See
  // components/domicile/mojom/control_channel.mojom.
  readonly attribute DOMHighResTimeStamp arrival;
};
