// An audio output (sink) or input (source) in a DomicileAudioEvent.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileAudioDevice {
  // The ID passed to DomicileHost's audio methods.
  readonly attribute DOMString id;

  readonly attribute DOMString description;

  // The loudest channel's volume, where 1 is the sound server's 100%.
  readonly attribute double volume;

  readonly attribute boolean muted;

  // Whether new streams go to it.
  readonly attribute boolean isDefault;

  // Whether it is an output's monitor source, listed among the inputs.
  readonly attribute boolean monitor;

  // Ports such as speakers, headphones or line in. Often empty.
  readonly attribute FrozenArray<DomicileAudioChoice> ports;

  // The active port's name, or empty if the device has no ports.
  readonly attribute DOMString port;
};
