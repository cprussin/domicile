// One notification sent to org.freedesktop.Notifications, which the
// compositor serves. This includes a page's own Web Notifications.
//
// An interface rather than a dictionary because these are read off a
// DomicileNotificationsEvent's array; see DomicileTrayItem.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileNotification {
  // The id DomicileHost.dismissNotifications() and invokeNotificationAction()
  // take. A replaced notification keeps its id.
  readonly attribute unsigned long id;

  // The sender's application name. May be empty.
  readonly attribute DOMString appName;

  // The one-line summary.
  readonly attribute DOMString summary;

  // The body, as plain text: the compositor does not accept markup.
  readonly attribute DOMString body;

  // The image, as a `data:` URL, or empty for none. See
  // DomicileTrayItem.icon for why it is not a path.
  readonly attribute DOMString icon;

  // "low", "normal" or "critical": the spec's urgency hint. A string rather
  // than an enum because it is read only, and the SDK parses it.
  readonly attribute DOMString urgency;

  // Its buttons. A press on the notification itself is `clickable`.
  readonly attribute FrozenArray<DomicileNotificationAction> actions;

  // Whether pressing the notification invokes its "default" action.
  readonly attribute boolean clickable;

  // Requested display time in milliseconds: 0 for until dismissed, -1 for
  // the shell's default.
  readonly attribute long timeoutMs;

  // When it arrived or was last replaced, in milliseconds since the epoch on
  // the compositor's clock.
  readonly attribute double time;
};
