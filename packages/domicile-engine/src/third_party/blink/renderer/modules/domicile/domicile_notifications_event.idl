[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileNotificationsEvent : Event {
  constructor(DOMString type,
              optional DomicileNotificationsEventInit eventInitDict = {});

  // Every uncleared notification, oldest first.
  //
  // The whole list every time, so a reloaded page keeps the history; the
  // page works out which are new. Empty when there is no session bus. The
  // compositor serves org.freedesktop.Notifications because a page cannot
  // reach the session bus.
  readonly attribute FrozenArray<DomicileNotification> items;

  // When the browser process received this, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
