[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileNotificationsEvent : Event {
  constructor(DOMString type,
              optional DomicileNotificationsEventInit eventInitDict = {});

  // The desk's notifications: every one not yet cleared, oldest first.
  //
  // The whole list every time rather than the one that changed, for
  // DomicileClipboardEvent.entries' reason -- and so a page that reloads
  // keeps the history, which is the compositor's. Which are new is the
  // page's to tell. An empty array is a desk with nothing to say, and every
  // desk with no session bus.
  //
  // THE COMPOSITOR'S, BECAUSE THE BUS IS. A notification is a call to
  // org.freedesktop.Notifications on the session bus, which a page cannot
  // reach; the compositor is the server that answers it.
  readonly attribute FrozenArray<DomicileNotification> items;

  // When the browser process had this message, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival for what this is and what it is not.
  readonly attribute DOMHighResTimeStamp arrival;
};
