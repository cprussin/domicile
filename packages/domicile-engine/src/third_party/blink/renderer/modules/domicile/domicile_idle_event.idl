[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileIdleEvent : Event {
  constructor(DOMString type,
              optional DomicileIdleEventInit eventInitDict = {});

  // Whether nobody has touched this desktop for the configured timeout.
  //
  // The compositor tracks idle because only it sees every input event. Web
  // idle signals do not work here: the shell's document stays visible with
  // the screen off. The compositor resends the current state to a newly
  // connected page, which has missed any earlier changes.
  readonly attribute boolean idle;

  // When the browser process received this, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
