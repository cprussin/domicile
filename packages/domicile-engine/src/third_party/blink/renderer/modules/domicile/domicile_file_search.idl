// What `DomicileHost.searchFiles()` resolves with. See DomicileFilesEvent for
// what each member means; this is the same answer without the event.
dictionary DomicileFileSearch {
  sequence<DOMString> files = [];
  unsigned long matched = 0;
  boolean indexing = false;
};
