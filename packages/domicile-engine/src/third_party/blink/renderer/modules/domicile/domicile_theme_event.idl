// The event behind DomicileHost.ontheme.
//
// Its own interface rather than a DomicileAppEvent because it names no window.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileThemeEvent : Event {
  constructor(DOMString type, optional DomicileThemeEventInit eventInitDict = {});

  // The desktop's current theme.
  //
  // Sent on connect, so a shell can paint in it from the start; on a config
  // reload that changes it; and whenever any chrome calls setTheme(),
  // including this one.
  readonly attribute DomicileTheme theme;

  // When the browser process received this, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
