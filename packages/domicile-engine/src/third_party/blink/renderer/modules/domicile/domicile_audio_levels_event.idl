[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileAudioLevelsEvent : Event {
  constructor(DOMString type,
              optional DomicileAudioLevelsEventInit eventInitDict = {});

  // How loud each thing DomicileHost.watchAudioLevels() asked for is. Some
  // twenty times a second while anything is metered; an id the compositor has
  // heard nothing on yet is left out rather than reported as silence.
  readonly attribute FrozenArray<DomicileAudioLevel> levels;

  // When the browser process had this message, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival for what this is and what it is not.
  readonly attribute DOMHighResTimeStamp arrival;
};
