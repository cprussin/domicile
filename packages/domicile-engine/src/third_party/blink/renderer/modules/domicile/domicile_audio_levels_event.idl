[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileAudioLevelsEvent : Event {
  constructor(DOMString type,
              optional DomicileAudioLevelsEventInit eventInitDict = {});

  // Levels for the ids DomicileHost.watchAudioLevels() asked for, about 20
  // times a second while anything is metered. An id with no samples yet is
  // omitted, not reported as silence.
  readonly attribute FrozenArray<DomicileAudioLevel> levels;

  // When the browser process received this message, on `performance.now()`'s
  // clock. See DomicileAppEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
