[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileShellConfigEvent : Event {
  constructor(DOMString type,
              optional DomicileShellConfigEventInit eventInitDict = {});

  // The shell's part of the desk's config -- its keybindings, each mode's, and
  // the options the config keeps for a shell by name -- as the JSON line the
  // compositor sent, `type` and all.
  //
  // A STRING FOR THE PAGE TO PARSE, and not attributes, because a shell's
  // options are whatever its config says and WebIDL cannot type a value nobody
  // has declared. The browser has already parsed it once, so it is a JSON
  // object; what is in it is the SDK's to read.
  readonly attribute DOMString config;

  // When the browser process had this message, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival for what this is and what it is not.
  readonly attribute DOMHighResTimeStamp arrival;
};
