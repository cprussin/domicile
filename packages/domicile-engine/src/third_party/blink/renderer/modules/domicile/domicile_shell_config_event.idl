[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileShellConfigEvent : Event {
  constructor(DOMString type,
              optional DomicileShellConfigEventInit eventInitDict = {});

  // The shell's part of the desktop config (keybindings per mode, and the
  // options set for this shell by name), as the compositor's JSON line,
  // `type` included.
  //
  // A string rather than attributes because a shell's options are arbitrary
  // and WebIDL cannot type them. The browser has validated it as a JSON
  // object; the SDK reads it.
  readonly attribute DOMString config;

  // When the browser process received this, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
