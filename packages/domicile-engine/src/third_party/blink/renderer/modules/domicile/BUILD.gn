import("//third_party/blink/renderer/modules/modules.gni")

blink_modules_sources("domicile") {
  sources = [
    "domicile_app_event.cc",
    "domicile_app_event.h",
    "domicile_chord.cc",
    "domicile_chord.h",
    "domicile_browser_window.cc",
    "domicile_browser_window.h",
    "domicile_clipboard_entry.cc",
    "domicile_clipboard_entry.h",
    "domicile_display.cc",
    "domicile_display.h",
    "domicile_event_names.cc",
    "domicile_event_names.h",
    "domicile_extension.cc",
    "domicile_extension.h",
    "domicile_shortcut_event.cc",
    "domicile_shell.cc",
    "domicile_shell.h",
    "domicile_shortcut_event.h",
    "domicile_notification.cc",
    "domicile_notification.h",
    "domicile_notification_action.cc",
    "domicile_notification_action.h",
    "domicile_tray_item.cc",
    "domicile_tray_item.h",
    "domicile_window.cc",
    "domicile_window.h",
    "domicile_host.cc",
    "domicile_host.h",
  ]

  deps = [
    # The scheme and host DomicileShell runs the shell document on.
    "//components/domicile:common",
    # The wire names of the cursor shapes. `DomicileWindow.cursor` is a
    # `DomicileCursorShape` and the compositor's is a `mojom::CursorShape`, and
    # the wire name is how one becomes the other -- so the same list the
    # browser parsed the compositor's JSON with is the one that names it here.
    "//components/domicile:cursor_shape",
    "//components/domicile:display_transform",
    # And the wire names of the themes, for the same reason and in both
    # directions: `DomicileHost.theme` is a `DomicileTheme` where the
    # compositor's is a `mojom::Theme`, and `setTheme()` goes back the other
    # way.
    "//components/domicile:theme",
    "//components/domicile/mojom:mojom_blink",
    # A key pressed on the page is a DOM `code`; a chord the shell grabbed is
    # an evdev key. See DomicileHost::PageKeyDown.
    "//ui/events:dom_keycode_converter",
  ]
}
