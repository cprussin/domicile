import("//third_party/blink/renderer/modules/modules.gni")

blink_modules_sources("domicile") {
  sources = [
    "domicile_app_cursor_event.cc",
    "domicile_app_cursor_event.h",
    "domicile_app_event.cc",
    "domicile_app_event.h",
    "domicile_app_titled_event.cc",
    "domicile_app_titled_event.h",
    "domicile_battery_event.cc",
    "domicile_battery_event.h",
    "domicile_clipboard_entry.cc",
    "domicile_clipboard_entry.h",
    "domicile_clipboard_event.cc",
    "domicile_clipboard_event.h",
    "domicile_display.cc",
    "domicile_display.h",
    "domicile_file_preview_event.cc",
    "domicile_file_preview_event.h",
    "domicile_files_event.cc",
    "domicile_files_event.h",
    "domicile_idle_event.cc",
    "domicile_idle_event.h",
    "domicile_locked_event.cc",
    "domicile_locked_event.h",
    "domicile_modifiers_event.cc",
    "domicile_modifiers_event.h",
    "domicile_shortcut_event.cc",
    "domicile_shortcut_event.h",
    "domicile_theme_event.cc",
    "domicile_theme_event.h",
    "domicile_host.cc",
    "domicile_host.h",
    "navigator_domicile.cc",
    "navigator_domicile.h",
    "window_domicile.cc",
    "window_domicile.h",
  ]

  deps = [
    # The wire names of the cursor shapes. `DomicileAppCursorEvent.cursor` is a
    # `DomicileCursorShape` and the compositor's is a `mojom::CursorShape`, and
    # the wire name is how one becomes the other -- so the same list the
    # browser parsed the compositor's JSON with is the one that names it here.
    "//components/domicile:cursor_shape",
    "//components/domicile:display_transform",
    # And the wire names of the themes, for the same reason and in both
    # directions: `DomicileThemeEvent.theme` is a `DomicileTheme` where the
    # compositor's is a `mojom::Theme`, and `setTheme()` goes back the other
    # way.
    "//components/domicile:theme",
    "//components/domicile/mojom:mojom_blink",
  ]
}
