[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileTrayEvent : Event {
  constructor(DOMString type,
              optional DomicileTrayEventInit eventInitDict = {});

  // The system tray: every application showing an icon, in the order they
  // registered.
  //
  // The whole tray every time rather than the icon that changed, for
  // DomicileClipboardEvent.entries' reason. An empty array is a desk no
  // application has put an icon on, and every desk with no session bus.
  //
  // THE COMPOSITOR'S, BECAUSE THE BUS IS. An icon is a StatusNotifierItem on
  // the session bus, which a page cannot reach; the compositor is the host
  // that reads them.
  readonly attribute FrozenArray<DomicileTrayItem> items;

  // When the browser process had this message, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival for what this is and what it is not.
  readonly attribute DOMHighResTimeStamp arrival;
};
