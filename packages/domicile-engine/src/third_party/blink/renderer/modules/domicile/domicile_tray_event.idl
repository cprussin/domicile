[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileTrayEvent : Event {
  constructor(DOMString type,
              optional DomicileTrayEventInit eventInitDict = {});

  // The system tray: every application showing an icon, in registration
  // order.
  //
  // The whole tray every time; see DomicileClipboardEvent.entries. Empty when
  // there is no session bus. The compositor hosts the StatusNotifierItems
  // because a page cannot reach the session bus.
  readonly attribute FrozenArray<DomicileTrayItem> items;

  // When the browser process received this, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
