dictionary DomicileAppCursorEventInit : EventInit {
  DOMString appId = "";
  // Defaulted so the event always has a shape. Only script-constructed events
  // use this; the engine uses the other constructor.
  DomicileCursorShape cursor = "default";
  DOMHighResTimeStamp arrival = 0;
};
