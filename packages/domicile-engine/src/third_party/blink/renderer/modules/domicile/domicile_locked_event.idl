[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileLockedEvent : Event {
  constructor(DOMString type,
              optional DomicileLockedEventInit eventInitDict = {});

  // Whether this desktop is locked: no client gets input until someone
  // enters the passphrase.
  //
  // The compositor holds this state and drops forwarded input while locked,
  // so a page reload, an engine restart or devtools cannot unlock it. The page
  // still gets its own keys, so it can draw a lock screen and pass the
  // passphrase to DomicileHost.unlock().
  //
  // The compositor resends the state to a newly connected page, so a reloaded
  // page still raises its lock screen.
  readonly attribute boolean locked;

  // When the browser process received this, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
