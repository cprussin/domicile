// One extension with an action, as a shell's tray shows it.
//
// An interface because WebIDL does not allow a dictionary as an attribute's
// array element type.
//
// The state is the active tab's (the <webview> that last had focus), or the
// action's default if there is none. See docs/architecture/EXTENSIONS.md.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileExtension {
  // What DomicileHost.activateExtension() names it by.
  readonly attribute DOMString id;
  readonly attribute DOMString name;

  // The action's tooltip.
  readonly attribute DOMString title;

  // A data:image/png;base64 URL at this page's device pixel ratio. Not a
  // chrome-extension:// URL: an icon set by action.setIcon({imageData}) has
  // no URL.
  readonly attribute USVString icon;

  readonly attribute DOMString badgeText;

  // A CSS color, #rrggbbaa. Fully transparent when the extension set none.
  readonly attribute DOMString badgeColor;

  // The popup a click opens, shown in a <webview> the shell draws; null when a
  // click fires `action.onClicked`. Either way, call activateExtension().
  readonly attribute USVString? popup;

  // False after the extension's action.disable().
  readonly attribute boolean enabled;
};
