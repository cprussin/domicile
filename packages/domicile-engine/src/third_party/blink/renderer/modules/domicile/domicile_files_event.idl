[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileFilesEvent : Event {
  constructor(DOMString type,
              optional DomicileFilesEventInit eventInitDict = {});

  // The query this answers, as DomicileHost.searchFiles() was given it.
  readonly attribute DOMString query;

  // The first matches, as paths relative to the home directory
  // (`Notes/today.org`), in display order. Directories end in `/`.
  //
  // Empty means nothing matched. If the home cannot be read, the compositor
  // logs it and sends no event, so a broken desktop never reports "no files".
  readonly attribute FrozenArray<DOMString> files;

  // How many paths matched; `files` holds the first of them.
  readonly attribute unsigned long matched;

  // Whether the compositor is still building the index.
  //
  // A launcher must show that results may be incomplete; otherwise a file the
  // index has not reached yet looks missing. A shell shows that the index is
  // being built, and asks again.
  readonly attribute boolean indexing;

  // When the browser process received this message, on `performance.now()`'s
  // clock. See DomicileAppEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
