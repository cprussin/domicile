[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileFilePreviewEvent : Event {
  constructor(DOMString type,
              optional DomicileFilePreviewEventInit eventInitDict = {});

  // The path this answers, as DomicileHost.previewFile() was given it.
  readonly attribute DOMString path;

  // Which of the rest means anything: "text", "directory", "audio", "binary"
  // or "unreadable". "unreadable" is also what a path outside the compositor's
  // index of the home gets -- see previewFile().
  //
  // A DOMString rather than an enum, because it is only ever read: the
  // browser drops a message whose kind is not one of the five, so there is
  // nothing left for the bindings to refuse. DomicileDisplay.transform is the
  // same choice.
  readonly attribute DOMString kind;

  // The front of the file, for "text". Empty for every other kind.
  readonly attribute DOMString text;

  // What is in it, for "directory": names, a subdirectory ending in `/`.
  // Empty for every other kind.
  readonly attribute FrozenArray<DOMString> entries;

  // What a song says of itself, for "audio": each tag empty when it does not
  // say it. Empty for every other kind.
  readonly attribute DOMString title;
  readonly attribute DOMString artist;
  readonly attribute DOMString album;

  // How long it plays, in seconds, for "audio". Zero for every other kind.
  readonly attribute double duration;

  // The picture it carries of itself, for "audio", as a `data:` URL -- the
  // page cannot read the file to draw one of its own. Empty when there is
  // none, and for every other kind.
  readonly attribute DOMString cover;

  // When the browser process had this message, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival for what this is and what it is not.
  readonly attribute DOMHighResTimeStamp arrival;
};
