// Something playing (a sink input) or recording (a source output), as
// DomicileHost.audioPlayback and audioRecording list it.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileAudioStream {
  // What the mixer's requests on DomicileHost name it by.
  readonly attribute DOMString id;

  // Who is playing or recording it, as the application named itself.
  readonly attribute DOMString application;

  // What it is -- a song, a call -- or empty where the application said
  // nothing.
  readonly attribute DOMString title;

  readonly attribute double volume;

  readonly attribute boolean muted;

  // The DomicileAudioDevice.id it goes to, or empty for one the next event
  // settles.
  readonly attribute DOMString device;
};
