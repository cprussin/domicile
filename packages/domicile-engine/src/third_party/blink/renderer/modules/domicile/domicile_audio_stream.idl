// Something playing (a sink input) or recording (a source output), as a
// DomicileAudioEvent lists it.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileAudioStream {
  // The id DomicileHost's mixer methods take.
  readonly attribute DOMString id;

  // The application playing or recording it, as it named itself.
  readonly attribute DOMString application;

  // What it is (a song, a call), or empty if the application did not say.
  readonly attribute DOMString title;

  readonly attribute double volume;

  readonly attribute boolean muted;

  // The DomicileAudioDevice.id it goes to, or empty until the next event sets
  // it.
  readonly attribute DOMString device;
};
