[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileOpenUrlEvent : Event {
  constructor(DOMString type,
              optional DomicileOpenUrlEventInit eventInitDict = {});

  // An address somebody asked this desktop to open: `domicile open-url`,
  // which is what `BROWSER` runs for every app the desktop starts. Already a
  // valid URL -- the engine refuses one that is not, before it gets here.
  //
  // TOLD TO ONE PAGE OF THE DESK, not every one, so a desk of several monitors
  // opens one window. Which window, on which screen, and whether, is the
  // shell's.
  readonly attribute USVString url;
};
