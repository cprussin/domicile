[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileClipboardEvent : Event {
  constructor(DOMString type,
              optional DomicileClipboardEventInit eventInitDict = {});

  // The clipboard history, newest first.
  //
  // Sent whole on every change: a copy can reorder the list, and a page
  // applying deltas could lose the order after missing one.
  //
  // Empty means nothing has been copied yet. The history lives only in the
  // compositor's memory, so it starts empty.
  //
  // Use this instead of navigator.clipboard, which reads this browser's own
  // clipboard. That clipboard is connected to no Wayland client, so it shows
  // only what the shell copied.
  readonly attribute FrozenArray<DomicileClipboardEntry> entries;

  // When the browser process received this message, on `performance.now()`'s
  // clock. See DomicileAppEvent.arrival.
  readonly attribute DOMHighResTimeStamp arrival;
};
