[
    RuntimeEnabled=DomicileControlChannel,
    Exposed=Window
] interface DomicileClipboardEvent : Event {
  constructor(DOMString type,
              optional DomicileClipboardEventInit eventInitDict = {});

  // What has been copied on this desktop, newest first.
  //
  // The whole history every time rather than the row that changed: a copy
  // re-orders the list as often as it adds to it, and a page reconciling
  // deltas could be wrong about the order forever after missing one.
  //
  // An empty array is a desktop nothing has been copied on yet, which is an
  // answer -- and the ordinary state of one that has just started, because the
  // history lives in the compositor's memory and never on disk.
  //
  // THIS IS NOT navigator.clipboard, AND THAT IS THE POINT. That API answers
  // out of this browser's own clipboard, which on the platform this engine
  // scans out on is connected to no Wayland client at all -- so a shell
  // reading it would see what the shell itself copied and nothing any window
  // did. The compositor is the process a wl_data_device.set_selection arrives
  // at, and this is what it says about them.
  readonly attribute FrozenArray<DomicileClipboardEntry> entries;

  // When the browser process had this message, on `performance.now()`'s clock.
  // See DomicileModifiersEvent.arrival for what this is and what it is not.
  readonly attribute DOMHighResTimeStamp arrival;
};
