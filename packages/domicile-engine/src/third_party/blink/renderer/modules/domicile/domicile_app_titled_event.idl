// The event behind navigator.domicile.onapptitled.
//
// A real event type rather than a CustomEvent carrying a detail bag, because
// the whole point of the typed surface is that a shell does not parse anything.

[
    Exposed=Window,
    RuntimeEnabled=DomicileControlChannel
] interface DomicileAppTitledEvent : Event {
  constructor(DOMString type, optional DomicileAppTitledEventInit eventInitDict = {});

  // Which window. The same id an <app> element's app-id names.
  readonly attribute DOMString appId;

  readonly attribute DOMString title;

  // When the browser process had this message, on `performance.now()`'s
  // clock.
  //
  // NOT `timeStamp`, which is when this object was constructed -- in this
  // renderer, at dispatch -- so subtracting it from itself reports a few
  // microseconds of Blink and calls it the IPC. The difference between the two
  // IS the stage: the read off the compositor's socket, the mojo message, the
  // hop into this process and the dispatch. See
  // components/domicile/mojom/control_channel.mojom.
  readonly attribute DOMHighResTimeStamp arrival;
};
