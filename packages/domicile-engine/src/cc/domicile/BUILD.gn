# Per-monitor raster regions for a page shown on several monitors.
# Patch 0072 links this into //cc; //components/domicile:unit_tests runs the
# tests.
source_set("display_regions") {
  sources = [
    "display_regions.cc",
    "display_regions.h",
  ]

  public_deps = [
    "//base",
    "//ui/gfx/geometry",
  ]
}

source_set("unit_tests") {
  testonly = true

  sources = [ "display_regions_unittest.cc" ]

  deps = [
    ":display_regions",
    "//testing/gtest",
    "//ui/gfx/geometry",
  ]
}
