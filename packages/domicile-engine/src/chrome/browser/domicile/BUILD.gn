# The socket a running engine answers commands about its shell on.
#
# A target of its own rather than sources on //chrome/browser:browser, because
# that target has none any more -- "Do NOT add sources here; new code belongs
# in a dedicated, properly-scoped target" -- and because the whole of the fork
# in this directory is then one added dependency in a file Chromium owns.
#
# //chrome and not //components/domicile for one reason: carrying a
# `load_shell` out navigates the shell's window, and finding that window is
# //chrome/browser/ui's GlobalBrowserCollection. Everything about this that
# does not need a window is next door in //components/domicile:command_protocol,
# which is what has the tests.
source_set("domicile") {
  sources = [
    "domicile_command_socket.cc",
    "domicile_command_socket.h",
    "domicile_pointer_warp.cc",
    "domicile_pointer_warp.h",
    "domicile_shell_windows.cc",
    "domicile_shell_windows.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/web_applications",
    "//components/domicile:command_protocol",
    "//components/domicile:common",
    "//components/domicile:pointer_warp",
    "//components/domicile:shell_source",
    "//components/domicile:shell_windows",
    "//components/tabs:public",
    "//content/public/browser",
    "//net",
    # The window a page's view is in, and the host that owns its cursor. Here
    # and not in //components/domicile for the reason the whole of this
    # directory is here: a cursor is moved through an aura WindowTreeHost, and
    # nothing below //chrome/browser has one.
    "//ui/aura",
    "//ui/base",
    "//ui/display",
    # `gfx::NativeView`, which is the handle a frame's view is and the one
    # `display::Screen::GetDisplayNearestView` takes. `//ui/gfx` is the wrong
    # label for it and `ui/gfx/native_widget_types.h` is the wrong header --
    # both were true of a Chromium older than this pin, and the build said so.
    "//ui/gfx:native_ui_types",
    # `gfx::ScaleToEnclosingRect`, which a shell window's first rectangle is
    # divided by the primary display's scale with.
    "//ui/gfx/geometry",
  ]
}
