# The socket a running engine answers commands about its shell on.
#
# A target of its own rather than sources on //chrome/browser:browser, because
# that target has none any more -- "Do NOT add sources here; new code belongs
# in a dedicated, properly-scoped target" -- and because the whole of the fork
# in this directory is then one added dependency in a file Chromium owns.
#
# //chrome and not //components/domicile for one reason: carrying a
# `load_shell` out navigates the shell's window, and finding that window is
# //chrome/browser/ui's GlobalBrowserCollection. Everything about this that
# does not need a window is next door in //components/domicile:command_protocol,
# which is what has the tests.
source_set("domicile") {
  sources = [
    "domicile_command_socket.cc",
    "domicile_command_socket.h",
    "domicile_desk.cc",
    "domicile_desk.h",
    "domicile_desk_functions.cc",
    "domicile_desk_functions.h",
    "domicile_extension_installer.cc",
    "domicile_extension_installer.h",
    "domicile_extension_tray.cc",
    "domicile_extension_tray.h",
    "domicile_pointer_warp.cc",
    "domicile_pointer_warp.h",
    "domicile_shell_windows.cc",
    "domicile_shell_windows.h",
    "domicile_tab_helpers.cc",
    "domicile_tab_helpers.h",
    "domicile_window_controller.cc",
    "domicile_window_controller.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/web_applications",
    "//components/domicile:command_protocol",
    "//components/domicile:common",
    "//components/domicile:pointer_warp",
    "//components/domicile:shell_source",
    "//components/domicile:shell_windows",
    "//components/tabs:public",
    "//content/public/browser",
    "//net",
    # The extensions a desk's config names, installed into a profile: the
    # ExtensionService, the pending and unpacked installers, and the profile
    # pref holding what was installed. //chrome for the same reason as the
    # rest of this directory -- a Profile is nothing below it.
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//components/domicile:extension_installer",
    "//components/prefs",
    "//extensions/browser",
    "//extensions/common",
    "//extensions/common:mojom",
    # The shell's tray: the actions of the extensions above, read out of
    # ExtensionActionManager and heard changing through ExtensionActionDispatcher
    # (both in //chrome/browser/extensions and //extensions/browser, named
    # above), spelled for the page by :extension_tray_entry, and an icon
    # encoded to a PNG.
    "//components/domicile:extension_tray_entry",
    "//components/domicile/mojom",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//url",
    # And a <webview>'s guest made a tab: SessionTabHelper through Chrome's own
    # factory, which is //chrome/browser/sessions, and extensions::TabHelper,
    # which is //chrome/browser/extensions above.
    "//chrome/browser/sessions",
    # And every guest a tab of the desk's one window, to chrome.tabs: the
    # decisions in :desk_tabs, the guest the desk asks the shell through, the
    # tab's id and window id (SessionTabHelper, in //components/sessions),
    # the generated chrome.tabs and chrome.windows types, and the window's
    # show state.
    "//chrome/common/extensions/api",
    "//components/domicile:desk_tabs",
    "//components/domicile:web_view_guest",
    "//components/sessions",
    "//components/sessions:session_id",
    "//ui/base/mojom:ui_base_types",
    "//ui/gfx/geometry",
    # The window a page's view is in, and the host that owns its cursor. Here
    # and not in //components/domicile for the reason the whole of this
    # directory is here: a cursor is moved through an aura WindowTreeHost, and
    # nothing below //chrome/browser has one.
    "//ui/aura",
    "//ui/base",
    "//ui/display",
    # `gfx::NativeView`, which is the handle a frame's view is and the one
    # `display::Screen::GetDisplayNearestView` takes. `//ui/gfx` is the wrong
    # label for it and `ui/gfx/native_widget_types.h` is the wrong header --
    # both were true of a Chromium older than this pin, and the build said so.
    "//ui/gfx:native_ui_types",
  ]
}
