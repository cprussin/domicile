# The fork's browser-side code that needs //chrome: the command socket, the
# desk, browser windows, extensions, file dialogs, permission prompts and
# pointer warps.
#
# A separate target because //chrome/browser:browser accepts no new sources,
# and it keeps the fork to one added dependency in a Chromium-owned file.
# It lives in //chrome because it needs browser windows, profiles and aura
# hosts. Code that does not is in //components/domicile, with the tests.
source_set("domicile") {
  sources = [
    "domicile_browser_windows.cc",
    "domicile_browser_windows.h",
    "domicile_command_socket.cc",
    "domicile_command_socket.h",
    "domicile_desk.cc",
    "domicile_desk.h",
    "domicile_desk_presenters.cc",
    "domicile_desk_presenters.h",
    "domicile_desk_functions.cc",
    "domicile_desk_functions.h",
    "domicile_devtools.cc",
    "domicile_devtools.h",
    "domicile_extension_installer.cc",
    "domicile_extension_installer.h",
    "domicile_extension_tray.cc",
    "domicile_extension_tray.h",
    "domicile_file_dialogs.cc",
    "domicile_file_dialogs.h",
    "domicile_permissions.cc",
    "domicile_permissions.h",
    "domicile_pointer_warp.cc",
    "domicile_pointer_warp.h",
    "domicile_shell_windows.cc",
    "domicile_shell_windows.h",
    "domicile_tab_helpers.cc",
    "domicile_tab_helpers.h",
    "domicile_window_controller.cc",
    "domicile_window_controller.h",
  ]

  deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/web_applications",
    "//components/domicile:command_protocol",
    "//components/domicile:common",
    "//components/domicile:pointer_warp",
    "//components/domicile:shell_source",
    "//components/domicile:shell_windows",
    "//components/tabs:public",
    "//content/public/browser",
    "//net",
    # `screenshot`: reads the shell page's surface back as a PNG.
    "//components/viz/common",
    # Installs the extensions the desk's config names into the profile.
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//chrome/common:constants",
    "//components/domicile:extension_installer",
    "//components/prefs",
    "//extensions/browser",
    "//extensions/common",
    "//extensions/common:mojom",
    # The shell's tray: extension actions and their icons as PNGs.
    "//components/domicile:extension_tray_entry",
    "//components/domicile/mojom",
    "//mojo/public/cpp/bindings",
    "//skia",
    "//ui/aura/domicile:desk_targeter",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//url",
    # Tab helpers for <webview> guests (SessionTabHelper, HistoryTabHelper,
    # the favicon driver).
    "//chrome/browser/favicon",
    "//chrome/browser/history",
    "//chrome/browser/sessions",
    # Guests as tabs of the desk's one window for chrome.tabs and
    # chrome.windows.
    "//chrome/common/extensions/api",
    "//components/domicile:desk_tabs",
    "//components/domicile:web_view_guest",
    "//components/sessions",
    "//components/sessions:session_id",
    # File dialogs, answered by the shell.
    "//components/domicile:file_choice",
    "//ui/shell_dialogs",
    # Permission prompts the shell answers, and guests' cameras and
    # microphones through Chrome's dispatcher.
    "//chrome/browser/media/webrtc",
    "//components/domicile:site_permissions",
    "//components/permissions",
    # DevTools for a guest's page: Chrome's front end and its bindings.
    "//chrome/browser/devtools",
    # Tab zoom factors and range.
    "//third_party/blink/public/common",
    "//ui/base/mojom:ui_base_types",
    "//ui/gfx/geometry",
    # Pointer warps move the cursor through an aura WindowTreeHost.
    "//ui/aura",
    "//ui/base",
    "//ui/display",
    # `gfx::NativeView`, which `display::Screen::GetDisplayNearestView` takes.
    "//ui/gfx:native_ui_types",
    # One page for the desk: its geometry, and a presenter window per extra
    # display (docs/architecture/ONE-PAGE-FOR-THE-DESK.md).
    "//components/domicile:desk_geometry",
    "//ui/compositor",
    "//ui/ozone",
    "//ui/views",
  ]
}
