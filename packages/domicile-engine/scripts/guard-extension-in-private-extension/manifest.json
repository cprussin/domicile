{
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["http://127.0.0.1/*"],
      "run_at": "document_end"
    }
  ],
  "description": "Paints every page on 127.0.0.1 one flat color, for guard-extension-in-private.sh. The key fixes its id, which the config's settings name.",
  "key": "",
  "manifest_version": 3,
  "name": "Domicile private-window guard",
  "version": "1"
}
