{
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "run_at": "document_start"
    }
  ],
  "description": "Marks every page on this machine with its edit, for guard-extension-reload.sh. The key fixes its id, so it is the same extension in another directory.",
  "key": "",
  "manifest_version": 3,
  "name": "Domicile reload guard",
  "version": "1"
}
