{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "(cd ../.. && bunx bun@1.4.4 run turbo run build --filter=@domicile-desktop/site^...) && bunx bun@1.4.4 --bun next build",
  "bunVersion": "1.x",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "site": true
    }
  },
  "ignoreCommand": "bash vercel-ignore.sh",
  "installCommand": "cd ../.. && bunx bun@1.4.4 install --frozen-lockfile --filter @domicile-desktop/site --filter ./"
}
