{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "rm public/media && cp -R ../../docs/media public/media && next build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "stable": true
    }
  },
  "ignoreCommand": "bash vercel-ignore.sh",
