{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "(cd ../.. && bun run turbo run build --filter=@domicile-desktop/site^...) && bun --bun next build",
  "bunVersion": "1.4.x",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "site": true
    }
  },
  "ignoreCommand": "bash vercel-ignore.sh",
  "installCommand": "cd ../.. && bun install --frozen-lockfile --filter @domicile-desktop/site --filter ./"
}
