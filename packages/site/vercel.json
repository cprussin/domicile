{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "(cd ../.. && node_modules/.bin/turbo run build --filter=@domicile-desktop/site^...) && next build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "stable": true
    }
  },
  "ignoreCommand": "bash vercel-ignore.sh",
  "installCommand": "cd ../.. && npx -y bun@1.4.4 install --frozen-lockfile --filter @domicile-desktop/site --filter ./"
}
