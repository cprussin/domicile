{
  "dependencies": {
    "zod": "catalog:"
  },
  "description": "Domicile chrome SDK: <domicile-app>/<domicile-webview> custom elements and the client for navigator.domicile",
  "devDependencies": {
    "@cprussin/tsconfig": "catalog:",
    "@domicile/test-support": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./alias-tags": {
      "types": "./dist/alias-tags.d.ts",
      "default": "./dist/alias-tags.js"
    },
    "./app-element": {
      "types": "./dist/app-element.d.ts",
      "default": "./dist/app-element.js"
    },
    "./chrome-message": {
      "types": "./dist/chrome-message.d.ts",
      "default": "./dist/chrome-message.js"
    },
    "./connect-to-host": {
      "types": "./dist/connect-to-host.d.ts",
      "default": "./dist/connect-to-host.js"
    },
    "./cursor-shape": {
      "types": "./dist/cursor-shape.d.ts",
      "default": "./dist/cursor-shape.js"
    },
    "./desktop-size": {
      "types": "./dist/desktop-size.d.ts",
      "default": "./dist/desktop-size.js"
    },
    "./device-pixel-ratio": {
      "types": "./dist/device-pixel-ratio.d.ts",
      "default": "./dist/device-pixel-ratio.js"
    },
    "./domicile-client": {
      "types": "./dist/domicile-client.d.ts",
      "default": "./dist/domicile-client.js"
    },
    "./domicile-host": {
      "types": "./dist/domicile-host.d.ts",
      "default": "./dist/domicile-host.js"
    },
    "./element-transform": {
      "types": "./dist/element-transform.d.ts",
      "default": "./dist/element-transform.js"
    },
    "./host-message": {
      "types": "./dist/host-message.d.ts",
      "default": "./dist/host-message.js"
    },
    "./host-stream": {
      "types": "./dist/host-stream.d.ts",
      "default": "./dist/host-stream.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "default": "./dist/input.js"
    },
    "./matrix": {
      "types": "./dist/matrix.d.ts",
      "default": "./dist/matrix.js"
    },
    "./measure": {
      "types": "./dist/measure.d.ts",
      "default": "./dist/measure.js"
    },
    "./newline-frames": {
      "types": "./dist/newline-frames.d.ts",
      "default": "./dist/newline-frames.js"
    },
    "./observe-placement": {
      "types": "./dist/observe-placement.d.ts",
      "default": "./dist/observe-placement.js"
    },
    "./placement-timing": {
      "types": "./dist/placement-timing.d.ts",
      "default": "./dist/placement-timing.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./register-elements": {
      "types": "./dist/register-elements.d.ts",
      "default": "./dist/register-elements.js"
    },
    "./sample-window": {
      "types": "./dist/sample-window.d.ts",
      "default": "./dist/sample-window.js"
    },
    "./surface-coordinates": {
      "types": "./dist/surface-coordinates.d.ts",
      "default": "./dist/surface-coordinates.js"
    },
    "./webview-element": {
      "types": "./dist/webview-element.d.ts",
      "default": "./dist/webview-element.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "name": "@domicile/chrome-sdk",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:types": "tsc --noEmit",
    "test:unit": "bun test"
  },
  "type": "module",
  "version": "0.1.0"
}
