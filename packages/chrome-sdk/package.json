{
  "dependencies": {
    "zod": "catalog:"
  },
  "description": "The SDK for writing a Domicile shell: the types of the desktop a shell is handed, the <app> and <webview> elements, keybindings, and the Shell type.",
  "devDependencies": {
    "@cprussin/tsconfig": "catalog:",
    "@domicile-desktop/test-support": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./app-element": {
      "types": "./dist/app-element.d.ts",
      "default": "./dist/app-element.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "default": "./dist/audio.js"
    },
    "./bind-keys": {
      "types": "./dist/bind-keys.d.ts",
      "default": "./dist/bind-keys.js"
    },
    "./cursor-shape": {
      "types": "./dist/cursor-shape.d.ts",
      "default": "./dist/cursor-shape.js"
    },
    "./display-transform": {
      "types": "./dist/display-transform.d.ts",
      "default": "./dist/display-transform.js"
    },
    "./domicile-host": {
      "types": "./dist/domicile-host.d.ts",
      "default": "./dist/domicile-host.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "default": "./dist/extension.js"
    },
    "./fake-host": {
      "types": "./dist/fake-host.d.ts",
      "default": "./dist/fake-host.js"
    },
    "./file-preview": {
      "types": "./dist/file-preview.d.ts",
      "default": "./dist/file-preview.js"
    },
    "./key-action": {
      "types": "./dist/key-action.d.ts",
      "default": "./dist/key-action.js"
    },
    "./notification": {
      "types": "./dist/notification.d.ts",
      "default": "./dist/notification.js"
    },
    "./own-keybindings": {
      "types": "./dist/own-keybindings.d.ts",
      "default": "./dist/own-keybindings.js"
    },
    "./shell": {
      "types": "./dist/shell.d.ts",
      "default": "./dist/shell.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./tray": {
      "types": "./dist/tray.d.ts",
      "default": "./dist/tray.js"
    },
    "./webview-element": {
      "types": "./dist/webview-element.d.ts",
      "default": "./dist/webview-element.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "license": "MIT",
  "name": "@domicile-desktop/sdk",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:types": "tsc --noEmit",
    "test:unit": "bun test"
  },
  "type": "module",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cprussin/domicile.git",
    "directory": "packages/chrome-sdk"
  }
}
