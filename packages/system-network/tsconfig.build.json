{
  "compilerOptions": {
    "declaration": true,
    // Off, as in the SDK: a `.tsbuildinfo` that outlives a removed `dist`
    // makes tsc skip emitting the missing files.
    "incremental": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": []
  },
  "exclude": ["src/**/*.test.ts", "src/fake-bus.ts", "src/fake-sysfs.ts"],
  "extends": "./tsconfig.json"
}
