#!/bin/sh
# Builds a shell from an entry or a package: `domicileBuilder` in `flake.nix`,
# with the bun and workspace this package installs beside it.
here="$(dirname "$(readlink -f "$0")")"
exec "$here/bun" "$here/workspace/packages/domicile-builder/src/main.ts" \
  --domicile "$here/workspace" "$@"
